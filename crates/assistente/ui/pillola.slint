// La pillola: la faccia dell'assistente, sempre in alto al centro.
// Pillola nera, due occhi di luce, aura con i colori dei petali lungo il bordo.
import { Tema, Movimento } from "tema.slint";
import { PulsanteUi, UmoreUi, AspettoPillolaUi, LivelloUi } from "voci.slint";
import { Pulsante, TipoPulsante } from "componenti.slint";
import { Faccia, Occhi } from "faccia.slint";

// Uno strato dell'aura: la sagoma della pillola allargata di `espansione`.
component Velo inherits Rectangle {
    in property <length> espansione;
    in property <length> sagoma-larghezza;
    in property <length> sagoma-altezza;
    x: -espansione;
    y: -espansione;
    width: sagoma-larghezza + 2 * espansione;
    height: sagoma-altezza + 2 * espansione;
    border-radius: self.height / 2;
}

export component Pillola inherits Window {
    in property <UmoreUi> umore: UmoreUi.tranquillo;
    in property <string> messaggio;
    // Falso mentre la pillola è nascosta (pannello aperto): fermi anche i timer.
    in property <bool> attiva: true;
    // Come mostra le voci «In attesa» (vedi `attenzione::aspetto_pillola`): a riposo, col
    // puntino (piccola, con un puntino del colore del livello sotto gli occhi) o allargata (icona
    // della fonte + una riga + fino a 2 pulsanti).
    in property <AspettoPillolaUi> aspetto: AspettoPillolaUi.riposo;
    // Allargata per un bloccante: ferma (nessuna pulsazione) e con il bordo più spesso.
    in property <bool> ferma;
    // Livello della voce mostrata (colore del puntino e del bordo del bloccante).
    in property <LivelloUi> livello: LivelloUi.informazione;
    in property <image> icona-fonte;
    in property <[PulsanteUi]> pulsanti;
    // Ritirata: al posto della pillola una linea 300 × 5 al bordo alto (la finestra è ritagliata
    // alla linea e lascia passare i clic), del colore del livello più urgente in attesa
    // (`livello-linea`; `nessuno`: colore neutro). Opaca: la finestra ritirata è layered.
    in property <bool> ritirata;
    in property <LivelloUi> livello-linea: LivelloUi.nessuno;
    callback cliccata();
    // Clic destro sulla pillola: ritirata.
    callback ritira();
    // Clic su un pulsante della pillola allargata: l'id del pulsante.
    callback azione(string);

    // Geometria: la finestra è grande quanto la pillola più grande (la bloccante) più il margine
    // dell'aura tutt'intorno, e la pillola sta al centro, attaccata in alto: cambiando aspetto la
    // finestra non si sposta né si ridimensiona, la pillola cresce o cala attorno al centro e
    // verso il basso. Da Rust la finestra viene ritagliata a `larghezza-visibile` ×
    // `altezza-visibile` (una fascia trasparente ruberebbe i clic alle schede e alle barre
    // sotto); i pulsanti stanno dentro. Le stesse misure stanno in finestre.rs.
    // VINCOLO: tutto ciò che sporge dalla pillola (velo esterno 4 + 1 px quando pulsa, bagliore
    // dell'anello 5 px) deve stare sotto `margine-aura`: il ritaglio della finestra
    // (`regione_pillola`) taglia di netto a un margine dalla pillola, anche in basso.
    out property <length> margine-aura: 8px;
    // La linea della ritirata (300 × 5 come TwoCode).
    out property <length> larghezza-linea: 300px;
    out property <length> altezza-linea: 5px;
    out property <length> larghezza-riposo: Faccia.larghezza-pillola;
    out property <length> altezza-riposo: Faccia.altezza-pillola;
    // Che chiama (attenzione): icona della fonte + occhi + una riga + fino a 2 pulsanti.
    out property <length> larghezza-attenzione: 400px;
    out property <length> altezza-attenzione: 36px;
    // Bloccante: più grande, ferma e con il bordo più spesso (distinta per forma).
    out property <length> larghezza-bloccante: 440px;
    out property <length> altezza-bloccante: 40px;
    property <length> larghezza-allerta: ferma ? larghezza-bloccante : larghezza-attenzione;
    property <length> altezza-allerta: ferma ? altezza-bloccante : altezza-attenzione;
    out property <length> larghezza-pillola: allargata ? larghezza-allerta : larghezza-riposo;
    out property <length> altezza-pillola: allargata ? altezza-allerta : altezza-riposo;
    out property <length> larghezza-visibile: larghezza-pillola + 2 * margine-aura;
    out property <length> altezza-visibile: altezza-pillola + 2 * margine-aura;
    out property <length> larghezza-finestra: larghezza-bloccante + 2 * margine-aura;
    out property <length> altezza-finestra: altezza-bloccante + 2 * margine-aura;

    // Geometria della pillola allargata: icona della fonte a 14 px dal bordo sinistro (14 px),
    // occhi a 36 px (larghi 7 e distanti 7), poi la riga (12 px) e i pulsanti.
    // `scarto-occhi-…`: centro degli occhi rispetto al centro della finestra (x) e al centro della
    // riga alta del pannello, alta quanto la pillola a riposo (y); il pannello ci fa partire i
    // suoi quando si apre dalla pillola allargata.
    property <length> icona-dal-bordo: 14px;
    property <length> lato-icona: 14px;
    property <length> occhi-allerta-dal-bordo: icona-dal-bordo + lato-icona + 8px;
    property <length> occhio-allerta: 7px;
    property <length> altezza-occhio-allerta: 12px;
    property <length> spazio-allerta: 7px;
    property <length> mezzo-ingombro-allerta: (2 * occhio-allerta + spazio-allerta) / 2;
    out property <length> scarto-occhi-attenzione: -larghezza-attenzione / 2 + occhi-allerta-dal-bordo + mezzo-ingombro-allerta;
    out property <length> scarto-occhi-attenzione-y: (altezza-attenzione - altezza-riposo) / 2;
    out property <length> scarto-occhi-bloccante: -larghezza-bloccante / 2 + occhi-allerta-dal-bordo + mezzo-ingombro-allerta;
    out property <length> scarto-occhi-bloccante-y: (altezza-bloccante - altezza-riposo) / 2;
    out property <length> scarto-occhi-allerta: blocca ? scarto-occhi-bloccante : scarto-occhi-attenzione;
    out property <length> scarto-occhi-allerta-y: blocca ? scarto-occhi-bloccante-y : scarto-occhi-attenzione-y;

    property <bool> allargata: aspetto == AspettoPillolaUi.allargata;
    property <bool> blocca: allargata && ferma;
    property <bool> tranquillo: umore == UmoreUi.tranquillo;
    property <bool> pensa: umore == UmoreUi.pensa;
    property <bool> allerta: umore == UmoreUi.ti-cerca;
    property <bool> contento: umore == UmoreUi.contento;
    property <bool> dorme: umore == UmoreUi.dorme;

    // L'aura si muove solo quando pensa o quando un'attenzione allarga la pillola (20 s): allora
    // un timer a 20 fotogrammi al secondo campiona animation-tick() in `tempo` (dentro un callback
    // non crea dipendenze). Il bloccante sta fermo; puntino, tranquillo, contento e addormentato
    // non ridisegnano nulla tra un battito di ciglia e l'altro.
    // Con il movimento ridotto l'aura sta ferma: «pensa» è l'anello acceso fermo con gli occhi
    // alzati, «ti cerca» l'aura calda ferma (il bloccante resta distinto per colore, misura e bordo).
    property <bool> in-moto: !Movimento.ridotto && (pensa || (allargata && !ferma));
    property <duration> tempo: 0ms;
    property <duration> giro: allerta ? 1200ms : 1600ms;
    property <angle> rotazione: in-moto ? 90deg + (tempo / giro) * 360deg : 90deg;
    // Pulsazione dell'attenzione allargata (0..1, periodo 0,8 s).
    property <float> battito: in-moto && allerta ? (1 - cos((tempo / 800ms) * 360deg)) / 2 : 0;
    // Quando pensa, lo sguardo va da un lato all'altro (2,2 s).
    property <length> sguardo-x: pensa ? 3px * sin((tempo / 2200ms) * 360deg) : 0px;
    property <length> sguardo-y: pensa ? -2px : 0px;

    property <brush> iride: blocca
        ? Tema.bloccante
        : allerta
            ? @linear-gradient(rotazione, Tema.caldo-1 0%, Tema.caldo-2 35%, Tema.caldo-3 70%, Tema.caldo-4 100%)
            : @linear-gradient(rotazione, Tema.petalo-1 0%, Tema.petalo-2 20%, Tema.petalo-3 40%, Tema.petalo-4 60%, Tema.petalo-5 80%, Tema.petalo-6 100%);
    // Aura quasi spenta a riposo (tranquillo: solo un anello sottile al 45%, nessun velo né
    // bagliore), accesa negli altri umori; quasi nulla mentre dorme.
    property <float> intensita-aura: dorme ? 0.12 : tranquillo ? 0 : contento ? 1.0 : allerta ? 0.7 + 0.3 * battito : 0.75;
    // A riposo l'anello al 45% (decisione E): la pillola resta trovabile anche su una barra scura.
    property <float> opacita-anello: dorme ? 0.25 : tranquillo ? 0.45 : 1.0;
    // Bloccante: anello da 4 px contro 2, distinto per forma anche col movimento ridotto.
    // Sul pixel fisico (FE27): a 1,25 e 1,75 i lati non hanno spessori diversi.
    property <length> spessore-anello: Tema.sul-pixel(blocca ? 4px : 2px);
    property <color> bagliore-occhi: blocca ? Tema.bloccante : allerta ? Tema.caldo-2 : Tema.bagliore-occhio;

    // La riga del messaggio e se il testo non ci sta tutto. Calcolato sulle larghezze finali
    // (`larghezza-pillola`, pulsanti di adesso), non su quelle animate: Rust lo legge appena
    // impostati messaggio e pulsanti e, se è vero, mette «Apri» al posto di un consenso.
    property <length> x-riga: occhi-allerta-dal-bordo + 2 * mezzo-ingombro-allerta + 10px;
    out property <bool> testo-tagliato: riga.preferred-width > larghezza-pillola - 8px - bottoni.preferred-width - 8px - x-riga;

    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "ItsyHome";
    // Il carattere dell'assistente anche per i testi che non lo dicono (senza, Slint userebbe quello
    // di sistema: un font in più in memoria).
    default-font-family: Tema.carattere;
    width: larghezza-finestra;
    height: altezza-finestra;

    // La tastiera della pillola: l'unico elemento che può prendere il fuoco (Tab ci arriva e ci
    // resta) e che prende e ignora ogni tasto. Senza, quando nessuno accetta il fuoco Slint 1.18
    // lascia comunque il fuoco sull'ultimo elemento provato (per esempio la TouchArea di un
    // pulsante) e i tasti risalirebbero fino al pulsante. Nessun ruolo: per Narrator resta la
    // finestra. Non prende i clic.
    tastiera := FocusScope {
        focus-on-click: false;
        key-pressed(evento) => { return accept; }
    }

    // 20 fotogrammi al secondo quando pensa (pillola piccola); 12,5 per la pulsazione della pillola
    // allargata, che è più del doppio più larga (il costo cresce con l'area ridisegnata).
    Timer {
        interval: allargata ? 80ms : 50ms;
        running: attiva && !ritirata && in-moto;
        triggered => {
            tempo = animation-tick();
        }
    }

    // 300 × 5 come TwoCode, con un filo scuro di 1 px tutt'intorno: si vede anche sopra una barra
    // chiara (il grigio neutro da solo era 2,6:1 sul bianco), e il colore del livello resta.
    if ritirata: Rectangle {
        x: (root.width - self.width) / 2;
        y: margine-aura;
        width: larghezza-linea;
        height: altezza-linea;
        background: Tema.colore-livello(livello-linea);
        border-width: Tema.sul-pixel(1px);
        border-color: Tema.corpo;
    }

    pillola := Rectangle {
        visible: !ritirata;

        // Centrata: mentre la larghezza si anima resta ferma attorno al centro della finestra.
        x: (root.width - self.width) / 2;
        y: margine-aura;
        width: larghezza-pillola;
        height: altezza-pillola;
        animate width, height { duration: Movimento.ridotto ? 0ms : 220ms; easing: ease-out; }

        // Aura: due veli più larghi e tenui con gli stessi colori del bordo (trasparenza nel
        // colore invece di `opacity`, per non comporre livelli a parte). Spenti a riposo.
        if intensita-aura > 0: Velo {
            sagoma-larghezza: parent.width;
            sagoma-altezza: parent.height;
            espansione: 4px + 1px * battito;
            background: iride.with-alpha(0.18 * intensita-aura);
        }
        if intensita-aura > 0: Velo {
            sagoma-larghezza: parent.width;
            sagoma-altezza: parent.height;
            espansione: 2px;
            background: iride.with-alpha(0.42 * intensita-aura);
        }

        // Anello: il bordo colorato (2 px; 4 px, fermo, per il bloccante), sul pixel.
        Rectangle {
            border-radius: self.height / 2;
            background: opacita-anello < 1 ? iride.with-alpha(opacita-anello) : iride;
            // Bagliore sfumato sotto i veli, come il blur della bozza (niente a riposo, e niente
            // mentre l'aura si muove, che pensi o che pulsi: ricomporlo a ogni fotogramma costa
            // troppo, bastano i veli).
            // Bloccante: bagliore da 4 px, così anello e bagliore stanno sotto il margine dell'aura.
            drop-shadow-blur: intensita-aura > 0.2 && !in-moto ? (blocca ? 4px : 5px) : 0px;
            drop-shadow-color: bagliore-occhi.with-alpha(0.55 * intensita-aura);
        }

        corpo := Rectangle {
            x: spessore-anello;
            y: spessore-anello;
            width: parent.width - 2 * spessore-anello;
            height: parent.height - 2 * spessore-anello;
            border-radius: self.height / 2;
            background: Tema.corpo;
        }

        // Clic sulla pillola (fuori dai pulsanti): apre il pannello, sulla voce se è allargata.
        TouchArea {
            mouse-cursor: pointer;
            // Per Narrator (FE16): un pulsante che apre il pannello, col messaggio se chiama (i
            // pulsanti della pillola allargata gli stanno accanto, non dentro).
            accessible-role: button;
            accessible-label: allargata ? messaggio
                : aspetto == AspettoPillolaUi.puntino ? "ItsyHome, una voce in attesa" : "ItsyHome";
            accessible-action-default => { root.cliccata(); }
            clicked => {
                root.cliccata();
            }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                    root.ritira();
                }
            }
        }

        // Chi chiama: l'icona della fonte a sinistra degli occhi.
        if allargata: Image {
            x: icona-dal-bordo;
            y: (parent.height - self.height) / 2;
            width: lato-icona;
            height: lato-icona;
            source: icona-fonte;
            colorize: Tema.icona;
            accessible-role: none;
            image-rendering: smooth;
        }

        occhi := Occhi {
            umore: root.umore;
            attivo: attiva && !ritirata;
            spazio: allerta ? spazio-allerta : Faccia.spazio-occhi;
            larghezza-occhio: allerta ? occhio-allerta : Faccia.larghezza-occhio;
            altezza-occhio: allerta ? altezza-occhio-allerta : Faccia.altezza-occhio;
            bagliore: bagliore-occhi;
            // Distanza dal bordo sinistro della pillola a fine animazione, animata anch'essa:
            // allargandosi gli occhi scivolano a sinistra insieme al bordo, senza salti.
            // Allargata: il centro degli occhi è fisso (occhi-allerta-dal-bordo +
            // mezzo-ingombro-allerta) con qualunque umore, così il pannello aperto da lì li fa
            // partire dal punto giusto (`scarto-occhi-…`) anche se gli occhi sono più larghi.
            property <length> dal-bordo: allargata
                ? occhi-allerta-dal-bordo + mezzo-ingombro-allerta - self.ingombro / 2
                : (larghezza-pillola - self.ingombro) / 2;
            animate dal-bordo { duration: Movimento.ridotto ? 0ms : 220ms; easing: ease-out; }
            x: dal-bordo + sguardo-x;
            y: sguardo-y;
            width: self.ingombro;
            height: parent.height;

            // Il puntino: qualcosa è in attesa. Fermo, sotto gli occhi, 5 × 5 con un leggero
            // bagliore; il livello si legge anche dalla forma, non solo dal colore: attenzione =
            // pieno (ambra), informazione = anello (blu). Il bloccante non ha puntino (resta larga).
            if aspetto == AspettoPillolaUi.puntino: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 8px;
                width: 5px;
                height: 5px;
                border-radius: self.height / 2;
                background: livello == LivelloUi.informazione ? transparent : Tema.colore-livello(livello);
                border-width: livello == LivelloUi.informazione ? 1.5px : 0px;
                border-color: Tema.colore-livello(livello);
                drop-shadow-blur: 3px;
                drop-shadow-color: Tema.colore-livello(livello).with-alpha(0.5);
            }
        }

        // La riga: sempre presente (nascosta da piccola) perché Rust ne legge `testo-tagliato`.
        riga := Text {
            visible: allargata;
            x: x-riga;
            width: max(0px, bottoni.x - self.x - 8px);
            height: parent.height;
            text: messaggio;
            overflow: elide;
            vertical-alignment: center;
            font-family: Tema.carattere;
            font-weight: 500;
            font-size: Tema.testo-piccolo;
            color: Tema.testo;
        }

        // Fino a 2 pulsanti a destra (dentro la fascia ritagliata, quindi cliccabili).
        bottoni := HorizontalLayout {
            width: self.preferred-width;
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            height: self.preferred-height;
            // 10 px fra «Nega» e «Consenti»: un clic impreciso non concede un permesso.
            spacing: 10px;
            visible: allargata;

            // Alti 26 nell'attenzione e 28 nel bloccante (come TwoCode), larghi da 64 a 120 px:
            // un testo lungo si accorcia invece di spingere la riga fin sopra gli occhi. La tinta
            // d'azione va all'ultimo (es. «Consenti»).
            for p[i] in pulsanti: Pulsante {
                altezza: blocca ? 28px : 26px;
                raggio: Tema.raggio-s;
                largo-min: 64px;
                largo-max: 120px;
                margine-testo: 16px;
                corpo-testo: Tema.testo-piccolo;
                testo: p.testo;
                tipo: i == pulsanti.length - 1 ? TipoPulsante.azione : TipoPulsante.neutro;
                // Nella pillola niente tastiera: i pulsanti non prendono il fuoco (né da Tab né
                // altrimenti, quindi niente anello) e nessun tasto li preme. Il permesso si dà col
                // clic, o dal pannello col testo intero.
                tasti-propri: false;
                focalizzabile: false;
                anello: false;
                delicato: p.delicato;
                premuto => { root.azione(p.id); }
            }
        }
    }
}
