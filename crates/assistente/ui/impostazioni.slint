// Finestra delle Impostazioni (decisione di Paolo del 13/11: finestra dedicata, non dentro il
// pannello). Nasce quando la si apre e viene distrutta alla chiusura; si sposta e si ridimensiona,
// non si chiude perdendo il fuoco.
// - Home Assistant: elenco degli ambienti (nome, indirizzo, stato) con Connetti/Disconnetti,
//   Modifica e Rimuovi (conferma sul pulsante stesso per 4 s, che nomina l'ambiente); il modulo
//   aggiungi/modifica (nome, indirizzo, token in un campo password) prende il posto dell'elenco.
// - Dispositivi: stanze e dispositivi come la scheda «Accessories» della v2 (ordine, icona e
//   nascoste delle stanze; ordine, nascosti e preferiti dei dispositivi; ordine dei preferiti).
// - Collegamenti: le pagine web delle gestioni (nome e indirizzo, solo http/https) che il pannello
//   apre nel browser; aggiungi, modifica (il modulo prende il posto dell'elenco), elimina (con una
//   conferma dentro la finestra che nomina il collegamento) e ordine con le frecce.
// - Isola (M2, Task 4): che cosa mostra la pillola a sinistra e a destra degli occhi, da quale
//   entità meteo viene la temperatura esterna, le fonti dei tre quadranti configurabili e il
//   massimo dell'arco per le unità senza una scala naturale. I Task 7 e 9 ci aggiungono i loro
//   interruttori.
// - Sistema: «Avvia con il sistema» e «Mostra icona nella barra» (spenta di serie).
// - Informazioni: nome, versione, «© Paolo Bets», il riquadro AboutSlint (la licenza Slint
//   royalty-free 2.0, punto 2(a), chiede proprio quel widget in una schermata «Informazioni») e
//   il dettaglio tecnico degli errori.
//
// Impaginazione (R1-18): layout veri (VerticalLayout / HorizontalLayout) dalla cornice fino alle
// card, così un testo più lungo o un secondo rigo spinge giù ciò che segue invece di finirci
// sopra. Restano coordinate calcolate solo dove un layout non c'entra: la griglia delle icone, i
// livelli sovrapposti di un campo (suggerimento e testo) e la barretta di scorrimento.
//
// Tastiera: Tab / Maiusc+Tab nell'ordine naturale (sezioni, pulsanti, campi), Invio o Spazio
// premono il pulsante col fuoco. In un campo si scrive come in ogni casella (frecce, Backspace,
// selezione); Esc esce dal campo; fuori da un campo chiude il modulo aperto e poi la finestra;
// Invio in un campo salva.
// Esc a livelli: prima la conferma o il campo, poi il modulo (ambienti o collegamenti), poi la
// finestra.
import { Tema, Movimento } from "tema.slint";
import { AmbienteUi, TonoUi, RigaDispositivoUi, TipoRigaUi, CollegamentoUi, SceltaQuadranteUi } from "voci.slint";
import { AboutSlint, Palette } from "std-widgets.slint";
import { Anello, Fuoco, Pulsante, TipoPulsante, Etichetta, Scelta } from "componenti.slint";
import { Icone } from "icone.slint";

export { AmbienteUi, TonoUi, RigaDispositivoUi, TipoRigaUi, CollegamentoUi }

// Il contenuto della sezione Home Assistant: l'elenco degli ambienti o il modulo.
enum ModoAmbienti { elenco, modulo }

// Pulsante di testo delle Impostazioni: il pulsante comune (componenti.slint), raggiungibile
// con Tab, con le larghezze di questa finestra.
component Bottone inherits Pulsante {
    largo-min: 72px;
    margine-testo: 28px;
}

// La card di una riga delle Impostazioni: titolo e descrizione a sinistra, il comando (i figli:
// interruttore o pulsante) a destra, centrato. La descrizione va a capo: la card è alta almeno 64
// e cresce con lei.
component CardRiga inherits Rectangle {
    in property <string> titolo;
    in property <string> descrizione;

    height: max(64px, corpo.preferred-height);
    border-radius: Tema.raggio-xl;
    background: Tema.card-fondo;
    border-width: 1px;
    border-color: Tema.vetro-bordo;

    corpo := HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            Text {
                text: titolo;
                overflow: elide;
                font-weight: 500;
                font-size: Tema.testo-medio;
                color: Tema.testo;
            }

            if descrizione != "": Text {
                text: descrizione;
                wrap: word-wrap;
                font-size: Tema.testo-piccolo;
                color: Tema.testo-tenue;
            }
        }

        VerticalLayout {
            alignment: center;

            @children
        }
    }
}

// Una colonna che scorre (elenchi e sezioni lunghe): i figli stanno in una Flickable larga quanto
// lei e `alto-contenuto` è l'altezza della colonna dei figli (la sua `preferred-height`). La
// barretta di scorrimento disegnata (4 px, nel margine a destra) si vede solo se il contenuto non
// sta tutto.
component Scorrevole inherits Rectangle {
    in property <length> alto-contenuto;

    // Tab su un elemento fuori vista: lo porta in vista (`y` e `h` nella colonna).
    public function porta-in-vista(y: length, h: length) {
        if (y + lista.content-y < 0) {
            lista.content-y = -y;
        } else if (y + h + lista.content-y > lista.height) {
            lista.content-y = lista.height - y - h;
        }
    }

    lista := Flickable {
        // Larga quanto la colonna: un riquadro che scorre da sé (l'anteprima di Claude) non la allarga.
        content-width: self.width;
        content-height: max(self.height, root.alto-contenuto);
        interactive: root.alto-contenuto > self.height;

        @children
    }

    if lista.content-height > lista.height + 0.5px: Rectangle {
        x: parent.width + 8px;
        y: (-lista.content-y / lista.content-height) * lista.height;
        width: 4px;
        height: lista.height * lista.height / lista.content-height;
        border-radius: self.width / 2;
        background: Tema.vetro-bordo;
    }
}

// Un campo del modulo: etichetta sempre visibile a sinistra, casella a destra. Il suggerimento
// (formato atteso) compare solo a casella vuota. `errore` (vuoto = nessuno) colora il bordo e
// Narrator lo legge come descrizione del campo; il testo lo mostra chi usa il campo, sotto.
component Campo inherits Rectangle {
    in property <string> etichetta;
    in property <string> suggerimento;
    in property <bool> password;
    in property <string> errore;
    // Il nome per Narrator, se dev'essere più preciso dell'etichetta («Quadrante 1, massimo»).
    in property <string> nome-accessibile: etichetta;
    // Quanto spazio ha l'etichetta a sinistra del campo (le più lunghe ne vogliono di più).
    in property <length> larghezza-etichetta: 92px;
    in-out property <string> testo <=> input.text;
    // Esc nel campo (il fuoco torna alla finestra) e Invio (salva).
    callback esci();
    callback invio();
    // Il fuoco ha lasciato il campo (controllo al blur) e il testo è cambiato.
    callback lasciato();
    callback modificato();

    public function prendi() {
        input.focus();
    }

    height: 34px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            width: larghezza-etichetta;
            text: etichetta;
            vertical-alignment: center;
            font-size: Tema.testo-corpo;
            color: Tema.testo-etichetta;
        }

        // Col fuoco il bordo resta quello di sempre e fuori compare l'anello bianco di tutti gli
        // altri controlli (R1-17: un solo anello del fuoco nella finestra); l'errore resta arancio.
        casella := Rectangle {
            horizontal-stretch: 1;
            border-radius: Tema.raggio-m;
            border-width: errore != "" ? 2px : 1px;
            border-color: errore != "" ? Tema.caldo-2 : Tema.vetro-bordo;
            background: Tema.riquadro-fondo;

            // Suggerimento e testo stanno uno sopra l'altro, a 12 dal bordo. Il suggerimento è più
            // tenue del testo vero: non sembra un valore già scritto.
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: input.text == "" ? suggerimento : "";
                vertical-alignment: center;
                overflow: elide;
                font-size: Tema.testo-corpo;
                color: Tema.segnaposto;
            }

            input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                single-line: true;
                vertical-alignment: center;
                input-type: password ? InputType.password : InputType.text;
                font-size: Tema.testo-medio;
                color: Tema.testo;
                selection-background-color: Tema.selezione;
                selection-foreground-color: Tema.testo;
                accessible-role: text-input;
                accessible-label: nome-accessibile;
                accessible-placeholder-text: suggerimento;
                accessible-description: errore;
                edited => { root.modificato(); }
                changed has-focus => {
                    if (!self.has-focus) {
                        root.lasciato();
                    }
                }
                key-pressed(evento) => {
                    if (evento.text == Key.Escape) {
                        root.esci();
                        return accept;
                    }
                    if (evento.text == Key.Return) {
                        root.invio();
                        return accept;
                    }
                    return reject;
                }
            }

            if input.has-focus: Anello { raggio: Tema.raggio-m; }
        }
    }
}

// Una sezione nella colonna di sinistra.
component Sezione inherits FocusScope {
    in property <string> nome;
    in property <bool> attiva;
    // Posizione fra le sezioni (per Narrator: «scheda 2 di 3», quella scelta è selezionata).
    in property <int> indice;
    in property <int> quante;
    callback scelta();

    height: 36px;
    focus-on-click: false;
    accessible-role: tab;
    accessible-label: nome;
    accessible-item-selectable: true;
    accessible-item-selected: attiva;
    accessible-item-index: indice;
    accessible-item-count: quante;
    accessible-action-default => { root.scelta(); }
    key-pressed(evento) => {
        if (evento.text == Key.Return || evento.text == Key.Space) {
            root.scelta();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: self.height / 2;
        background: attiva ? Tema.scheda-attiva : area.has-hover ? Tema.scheda-sopra : transparent;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;

            Text {
                text: nome;
                vertical-alignment: center;
                overflow: elide;
                font-size: Tema.testo-medio;
                font-weight: attiva ? 500 : 400;
                color: attiva ? Tema.testo : Tema.testo-ora;
            }
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta(); }
    }

    if root.has-focus: Anello { raggio: self.height / 2; }
}

// Pallino + parola dello stato (il colore non basta mai da solo). Largo quanto il suo testo
// (`naturale`): chi lo usa lo allinea a destra.
component Stato inherits Rectangle {
    in property <string> testo;
    in property <TonoUi> tono;
    out property <length> naturale: 15px + parola.preferred-width;

    HorizontalLayout {
        spacing: 7px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: self.height / 2;
                background: tono == TonoUi.ok ? Tema.presa-accesa
                    : tono == TonoUi.attesa ? Tema.attenzione
                    : tono == TonoUi.errore ? Tema.bloccante
                    : Tema.icona-spenta;
            }
        }

        parola := Text {
            horizontal-stretch: 1;
            text: testo;
            vertical-alignment: center;
            overflow: elide;
            font-size: Tema.testo-corpo;
            color: Tema.testo-ora;
        }
    }
}

// Interruttore raggiungibile con Tab (Invio o Spazio lo commutano).
component Interruttore inherits FocusScope {
    in property <bool> acceso;
    in property <string> nome;
    callback commutato();

    width: 44px;
    height: 24px;
    focus-on-click: false;
    accessible-role: switch;
    accessible-label: nome;
    accessible-checked: acceso;
    accessible-action-default => { root.commutato(); }
    key-pressed(evento) => {
        if (evento.text == Key.Return || evento.text == Key.Space) {
            root.commutato();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: self.height / 2;
        background: acceso ? Tema.interruttore-acceso : Tema.interruttore-spento;

        // Il pomello scivola da un capo all'altro: la sua x è l'animazione.
        Rectangle {
            x: acceso ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: self.height / 2;
            background: acceso ? Tema.pomello-acceso : Tema.testo-ora;
            animate x { duration: Movimento.ridotto ? 0ms : 120ms; easing: ease-out; }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.commutato(); }
    }

    if root.has-focus: Anello { raggio: self.height / 2; }
}

// Pulsante d'icona della scheda Dispositivi (28 × 28, icona 18): raggiungibile con Tab, Invio o
// Spazio lo premono; spento (`attivo` falso) resta al suo posto ma non si raggiunge né si preme.
// `richiesta` / `mio`: quando la richiesta cambia e il pulsante è «mio», prende il fuoco (così
// il fuoco segue un dispositivo spostato su o giù).
component BottoneIcona inherits FocusScope {
    in property <image> icona;
    in property <string> nome;
    in property <bool> attivo: true;
    in property <brush> tinta: Tema.icona;
    in property <int> richiesta;
    in property <bool> mio;
    callback premuto();
    callback fuoco-preso();

    width: 28px;
    height: 28px;
    focus-on-click: false;
    focus-on-tab-navigation: attivo;
    accessible-role: button;
    accessible-label: nome;
    accessible-enabled: attivo;
    accessible-action-default => {
        if (attivo) {
            root.premuto();
        }
    }
    changed richiesta => {
        if (mio && attivo) {
            self.focus();
        }
    }
    // Un elenco rifatto (una stanza compressa, un preferito tolto) ricrea i pulsanti: quello
    // chiesto prende il fuoco appena nasce.
    init => {
        if (mio && attivo) {
            self.focus();
        }
    }
    changed has-focus => {
        if (self.has-focus) {
            root.fuoco-preso();
        }
    }
    key-pressed(evento) => {
        if (!attivo || evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta || evento.modifiers.shift) {
            return reject;
        }
        if (evento.text == Key.Return || evento.text == Key.Space) {
            root.premuto();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: Tema.raggio-s;
        background: area.has-hover && attivo ? Tema.scheda-sopra : transparent;
    }

    Image {
        source: icona;
        width: 18px;
        height: 18px;
        colorize: attivo ? tinta : Tema.traccia;
        image-rendering: smooth;
        accessible-role: none;
    }

    area := TouchArea {
        enabled: attivo;
        mouse-cursor: attivo ? pointer : default;
        clicked => { root.premuto(); }
    }

    if root.has-focus: Anello { raggio: Tema.raggio-s; }
}

// La scelta dell'icona di una stanza: le 60 icone in una griglia di 10 colonne (come il selettore
// della v2). Frecce per muoversi, Invio o Spazio per scegliere, Esc per lasciare com'era; anche col
// mouse. Il fuoco vero sta sull'icona scelta da tastiera, col suo nome, per Narrator.
component SceltaIcona inherits FocusScope {
    in property <string> titolo;
    in property <[string]> nomi;
    // L'icona della stanza adesso (evidenziata) e quella col fuoco da tastiera.
    in property <int> attuale;
    in-out property <int> scelta;
    callback scelta-fatta(int);
    callback annulla();

    property <int> colonne: 10;
    property <length> lato: 32px;
    height: corpo.preferred-height;
    accessible-role: groupbox;
    accessible-label: titolo;
    init => {
        self.focus();
    }
    key-pressed(evento) => {
        if (evento.text == Key.Escape) {
            root.annulla();
            return accept;
        }
        if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
            return reject;
        }
        if (evento.text == Key.LeftArrow) {
            scelta = max(0, scelta - 1);
        } else if (evento.text == Key.RightArrow) {
            scelta = min(nomi.length - 1, scelta + 1);
        } else if (evento.text == Key.UpArrow) {
            scelta = scelta >= colonne ? scelta - colonne : scelta;
        } else if (evento.text == Key.DownArrow) {
            scelta = scelta + colonne < nomi.length ? scelta + colonne : scelta;
        } else if (evento.text == Key.Return || evento.text == Key.Space) {
            root.scelta-fatta(scelta);
        } else if (evento.text == Key.Tab || evento.text == Key.Backtab) {
            // Il fuoco resta nella scelta finché non si sceglie o si annulla.
            return accept;
        } else {
            return reject;
        }
        return accept;
    }

    // Trattiene i clic dentro il riquadro ma fuori da un'icona (titolo, margini, spazi fra le
    // celle): senza, arriverebbero all'area sotto, che chiude la scelta come Esc (N1 del 14e).
    TouchArea {}

    Rectangle {
        border-radius: Tema.raggio-xl;
        background: Tema.riquadro-pieno;
        border-width: 1px;
        border-color: Tema.vetro-bordo;
    }

    corpo := VerticalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 10px;

        HorizontalLayout {
            height: 30px;
            spacing: 16px;

            Etichetta {
                horizontal-stretch: 1;
                text: titolo;
                overflow: elide;
            }

            Pulsante {
                testo: "Annulla";
                largo-min: 72px;
                focalizzabile: false;
                premuto => { root.annulla(); }
            }
        }

        // La griglia: le celle si contano per riga e colonna (un layout a griglia non si riempie
        // da un elenco).
        Rectangle {
            height: ceil(nomi.length / colonne) * lato;

            for nome[i] in nomi: Rectangle {
                x: mod(i, colonne) * lato;
                y: floor(i / colonne) * lato;
                width: lato - 2px;
                height: lato - 2px;
                border-radius: Tema.raggio-s;
                background: i == root.attuale ? Tema.scheda-attiva : cella.has-hover ? Tema.scheda-sopra : transparent;
                accessible-role: button;
                accessible-label: nome;
                accessible-item-selected: i == root.attuale;
                accessible-action-default => { root.scelta-fatta(i); }

                Fuoco { chiede: i == root.scelta; }

                Image {
                    source: Icone.di-stanza(i);
                    width: 18px;
                    height: 18px;
                    colorize: i == root.attuale ? Tema.icona-attiva : Tema.icona;
                    image-rendering: smooth;
                    accessible-role: none;
                }

                cella := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.scelta-fatta(i); }
                }

                if i == root.scelta: Anello { raggio: Tema.raggio-s; distanza: -1px; }
            }
        }
    }
}

// La conferma di un'eliminazione dentro la finestra (non un dialogo di sistema): nomina ciò che
// sparisce. Il fuoco parte da «Annulla»; Esc annulla; Tab resta fra i due pulsanti finché non si
// sceglie; un clic dentro il riquadro ma fuori dai pulsanti non fa nulla.
component ConfermaElimina inherits FocusScope {
    in property <string> nome;
    callback conferma();
    callback annulla();

    property <string> domanda: "Eliminare “" + nome + "”?";
    height: corpo.preferred-height;
    accessible-role: groupbox;
    accessible-label: domanda;
    init => {
        annulla.focus();
    }
    key-pressed(evento) => {
        if (evento.text == Key.Escape) {
            root.annulla();
            return accept;
        }
        if (evento.text == Key.Tab || evento.text == Key.Backtab) {
            if (annulla.has-focus) {
                elimina.focus();
            } else {
                annulla.focus();
            }
            return accept;
        }
        return reject;
    }

    TouchArea {}

    Rectangle {
        border-radius: Tema.raggio-xl;
        background: Tema.riquadro-pieno;
        border-width: 1px;
        border-color: Tema.pericolo-filo;
    }

    corpo := VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 6px;

        Text {
            text: domanda;
            overflow: elide;
            font-weight: 500;
            font-size: Tema.testo-medio;
            color: Tema.testo;
        }

        Text {
            text: "Sparisce dal pannello e dalle Impostazioni.";
            wrap: word-wrap;
            font-size: Tema.testo-corpo;
            color: Tema.testo-tenue;
        }

        HorizontalLayout {
            padding-top: 14px;
            spacing: 10px;
            alignment: end;

            annulla := Pulsante {
                testo: "Annulla";
                largo-min: 84px;
                premuto => { root.annulla(); }
            }

            elimina := Pulsante {
                testo: "Elimina";
                tipo: TipoPulsante.pericolo;
                largo-min: 84px;
                accessible-label: "Elimina “" + nome + "”";
                premuto => { root.conferma(); }
            }
        }
    }
}

// Una riga di Impostazioni › Isola: il titolo a sinistra e il selettore a destra; per un
// quadrante con un'unità senza scala naturale, sotto, il campo «Massimo» (vuoto = il
// predefinito, scritto come suggerimento).
component RigaScelta inherits Rectangle {
    in property <string> titolo;
    in property <[string]> voci;
    in property <int> indice;
    in property <bool> con-massimo;
    in property <string> massimo;
    in property <string> predefinito;
    callback scelto(int);
    // Il massimo scritto: Rust lo salva e restituisce l'errore da mostrare (vuoto = salvato).
    callback massimo-scritto(string) -> string;
    // Un controllo della riga ha preso il fuoco (Tab): chi la contiene la porta in vista.
    callback fuoco-preso();
    callback esci();
    property <string> errore;

    height: corpo.preferred-height;
    border-radius: Tema.raggio-xl;
    background: Tema.card-fondo;
    border-width: 1px;
    border-color: Tema.vetro-bordo;

    // Rifatto a ogni scelta nuova (`indice`): il testo scritto a mano scollega `testo` da
    // `massimo`, e passando da un sensore in watt a un altro il campo deve mostrare il massimo di
    // quello nuovo.
    changed indice => { root.errore = ""; }

    corpo := VerticalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;

            Text {
                horizontal-stretch: 1;
                text: titolo;
                vertical-alignment: center;
                overflow: elide;
                font-weight: 500;
                font-size: Tema.testo-medio;
                color: Tema.testo;
                accessible-role: none;
            }

            selettore := Scelta {
                width: min(240px, root.width / 2);
                etichetta: titolo;
                voci: root.voci;
                indice: root.indice;
                scelto(i) => { root.scelto(i); }
                fuoco-preso => { root.fuoco-preso(); }
            }
        }

        // Il campo e, sotto la casella, il suo errore (lo spazio c'è sempre: niente salti).
        for _ in con-massimo ? [root.indice] : []: VerticalLayout {
            spacing: 4px;

            Campo {
                etichetta: "Massimo";
                nome-accessibile: root.titolo + ", massimo";
                suggerimento: predefinito;
                errore: root.errore;
                testo: root.massimo;
                esci => { root.esci(); }
                invio => { root.errore = root.massimo-scritto(self.testo); }
                lasciato => { root.errore = root.massimo-scritto(self.testo); }
            }

            HorizontalLayout {
                padding-left: 100px;

                Text {
                    height: 16px;
                    text: root.errore;
                    overflow: elide;
                    font-size: Tema.testo-piccolo;
                    color: Tema.caldo-2;
                    accessible-role: none;
                }
            }
        }
    }
}

export component FinestraImpostazioni inherits Window {
    in property <[AmbienteUi]> ambienti;
    in-out property <bool> avvio-con-sistema;
    // L'icona nell'area di notifica (fuori da Windows non c'è: l'interruttore non si mostra).
    in-out property <bool> icona-barra;
    in property <bool> icona-barra-disponibile: true;
    // Fuori da Windows non c'è il menu né l'icona nella barra: qui sta l'unico «Esci» (Sistema).
    in property <bool> fuori-da-windows: false;
    in property <bool> config-non-salvata;
    in property <string> versione;
    in property <string> dettagli-tecnici;
    // Esito di «Prova connessione» e suo tono: lo scrive Rust.
    in-out property <string> esito-prova;
    in-out property <TonoUi> tono-prova;

    callback prova-connessione(string, string, string);
    // (id, nome, url, token) → errore da mostrare, "" se salvato.
    callback salva-ambiente(string, string, string, string) -> string;
    // id → errore da mostrare, "" se rimosso.
    callback rimuovi-ambiente(string) -> string;
    callback connetti-ambiente(string);
    callback disconnetti-casa();
    callback cambia-avvio(bool);
    callback cambia-icona-barra(bool);
    // «Esci» di Impostazioni › Sistema (solo fuori da Windows): Rust chiude l'applicazione.
    callback esci();
    callback annulla-prova();
    // Esc fuori da un campo: Rust chiude (e distrugge) la finestra.
    callback chiudi();

    // Dispositivi: le righe (le scrive Rust), i nomi delle 60 icone delle stanze e il fuoco da
    // riportare su un pulsante dopo una modifica (id della riga, azione, contatore della richiesta).
    in property <[RigaDispositivoUi]> righe-dispositivi;
    in property <[string]> nomi-icone;
    in-out property <string> fuoco-riga;
    in-out property <string> fuoco-azione;
    in-out property <int> richiesta-fuoco;
    // (azione, id della riga, chiave, area): «su», «giu», «preferito», «nascondi», «comprimi».
    callback azione-dispositivo(string, string, string, string);
    // (area, indice dell'icona in `Icone.stanze`).
    callback scegli-icona(string, int);

    // Collegamenti (Task 14f): l'elenco (lo scrive Rust) e il pulsante su cui riportare il fuoco
    // dopo una modifica (id della riga e azione «su», «giu», «modifica», «elimina»; id vuoto e
    // «aggiungi» = «Aggiungi un collegamento»), con lo stesso contatore `richiesta-fuoco`.
    in property <[CollegamentoUi]> collegamenti;
    in-out property <string> fuoco-collegamento;
    in-out property <string> fuoco-azione-collegamento;
    // Controlli dei campi (al blur e al salvataggio): l'errore da mostrare, "" se va bene.
    callback controlla-nome-collegamento(string) -> string;
    callback controlla-indirizzo-collegamento(string) -> string;
    // (id, nome, indirizzo) → errore da mostrare, "" se salvato (id vuoto = nuovo).
    callback salva-collegamento(string, string, string) -> string;
    callback elimina-collegamento(string);
    // (id, -1 su / +1 giù).
    callback sposta-collegamento(string, int);

    // Isola (M2, Task 4): le voci dei selettori (nell'ordine di `lati::scelte`) e le scelte di
    // adesso; Rust le riscrive solo se cambiano.
    in property <[string]> scelte-lati;
    in property <int> indice-lato-sinistro;
    in property <int> indice-lato-destro;
    // «Automatico» e le entità meteo.
    in property <[string]> scelte-meteo;
    in property <int> indice-meteo;
    in property <[string]> scelte-quadranti;
    in property <[SceltaQuadranteUi]> quadranti-scelti;
    // (0 sinistra / 1 destra, indice in `scelte-lati`).
    callback scegli-lato(int, int);
    callback scegli-meteo(int);
    // (posizione del quadrante 0..2, indice in `scelte-quadranti`).
    callback scegli-quadrante(int, int);
    // (posizione del quadrante, testo scritto) → errore da mostrare (vuoto = salvato).
    callback cambia-massimo(int, string) -> string;
    // Il volume del PC con la rotella sulla pillola (M2, Task 7): solo su Windows (altrove la
    // riga non c'è); acceso di serie.
    in-out property <bool> volume-rotella: true;
    in property <bool> volume-rotella-disponibile: false;
    callback cambia-volume-rotella(bool);
    // L'avviso delle cuffie Bluetooth scariche (M2, Task 9): solo su Windows; acceso di serie.
    in-out property <bool> avvisi-bt: true;
    in property <bool> avvisi-bt-disponibile: false;
    callback cambia-avvisi-bt(bool);

    // Claude Code (M3, Task 7 e 7B). Il passo: 0 a riposo, 1 anteprima di ciò che si scrive in
    // settings.json, 2 conferma dello scollegamento. Nulla si scrive prima di «Scrivi in settings.json».
    in-out property <int> claude-passo: 0;
    in-out property <string> claude-anteprima;
    in-out property <string> claude-avvisi;
    // L'esito dell'ultima azione (errore in giallo, altrimenti tenue).
    in-out property <string> claude-esito;
    in-out property <bool> claude-esito-errore;
    in property <string> claude-stato: "Non collegato";
    in property <bool> claude-collegato;
    in property <bool> claude-da-aggiornare;
    // Il file di Claude Code che si scriverebbe.
    in property <string> claude-file;
    // Fuori da Windows il collegamento non c'è: «Disponibile solo su Windows», nessun pulsante.
    in property <bool> claude-disponibile: true;
    callback claude-prepara();
    callback claude-conferma();
    // Chiude l'anteprima senza scrivere (il piano preparato si butta).
    callback claude-annulla();
    callback claude-scollega();
    // Chiave da amministratore (M3, Task 8): consumi e dati dell'organizzazione, sola lettura.
    // La chiave vive solo nel portachiavi: il campo si svuota dopo «Salva» e si vedono le ultime 4 cifre.
    in-out property <string> api-campo;
    in property <bool> api-presente;
    in property <string> api-ultime;
    in property <bool> api-occupato;
    in property <string> api-esito;
    in property <bool> api-esito-errore;
    in property <string> api-stato;
    callback api-salva(string);
    callback api-prova(string);
    callback api-togli();
    // «Dettagli delle API»: le schede dell'ultima lettura nella finestra di gestione.
    callback api-dettagli();
    // La conferma di «Togli» aperta (RC-33). Si chiude da sola se la chiave sparisce.
    property <bool> api-conferma-togli;
    changed api-presente => { api-conferma-togli = false; }
    // Una colonna sola per le etichette dei campi della sezione Claude (RC-47).
    property <length> etichette-claude: 220px;

    // Avvisi di Claude (M3, Task 12): le soglie dei limiti dell'abbonamento e della spesa del mese.
    // Rust valida, salva e restituisce l'errore da mostrare (vuoto = salvato): un valore rifiutato
    // resta nel campo, con la frase che dice cosa scrivere, e non si salva.
    in property <string> soglia-limite: "80";
    in property <string> soglia-spesa;
    callback soglia-limite-scritta(string) -> string;
    callback soglia-spesa-scritta(string) -> string;
    property <string> errore-soglia-limite;
    property <string> errore-soglia-spesa;

    // 0 Home Assistant, 1 Dispositivi, 2 Collegamenti, 3 Isola, 4 Claude, 5 Sistema, 6 Informazioni.
    in-out property <int> sezione: 0;
    // L'elenco o il modulo (aggiungi/modifica).
    property <ModoAmbienti> modo: ModoAmbienti.elenco;

    // Modulo: id dell'ambiente in modifica ("" = nuovo), campi e messaggio d'errore.
    property <string> modulo-id;
    property <string> modulo-titolo;
    property <string> campo-nome;
    property <string> campo-url;
    property <string> campo-token;
    property <string> errore-modulo;
    // Ambiente in attesa di conferma per la rimozione e conferma armata (dopo 400 ms: un doppio
    // clic non conferma per sbaglio).
    property <string> conferma-id;
    property <bool> conferma-pronta;
    property <string> errore-elenco;

    // Le misure della cornice: margini della finestra, colonna delle sezioni, spazio sopra; e
    // l'altezza delle righe degli elenchi (fissa: sono righe tutte uguali).
    property <length> margine: 28px;
    property <length> largo-sezioni: 180px;
    property <length> alto-testata: 18px;
    property <length> alto-riga: 100px;
    property <length> alto-dispositivo: 38px;
    property <length> alto-collegamento: 46px;
    // La scelta dell'icona aperta per una stanza ("" = chiusa): area, nome, icona attuale, icona
    // col fuoco, riga da cui è partita (il fuoco ci torna).
    property <string> scelta-area;
    property <string> scelta-nome;
    property <int> scelta-attuale;
    property <int> scelta-fuoco;
    property <string> scelta-riga;
    // Collegamenti: il modulo (al posto dell'elenco) con id in modifica ("" = nuovo), campi, errori
    // dei campi e generale, e se un campo è già stato toccato (il controllo al blur parte solo
    // dopo, non su un campo appena attraversato con Tab); la conferma di eliminazione aperta.
    property <bool> modulo-collegamento;
    property <string> modulo-c-id;
    property <string> modulo-c-titolo;
    property <string> campo-c-nome;
    property <string> campo-c-url;
    property <string> errore-c-nome;
    property <string> errore-c-url;
    property <string> errore-c;
    property <bool> toccato-c-nome;
    property <bool> toccato-c-url;
    property <string> conferma-c-id;
    property <string> conferma-c-nome;

    title: "ItsyHome — Impostazioni";
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 600px;
    min-height: 420px;
    default-font-family: Tema.carattere;
    background: Tema.fondo-finestra;
    forward-focus: radice;
    // Il riquadro AboutSlint segue la tavolozza dei widget standard: logo e testo chiari sul
    // fondo scuro, qualunque sia il tema di Windows.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // ─── Azioni ───

    function apri-modulo(i: int) {
        conferma-id = "";
        errore-elenco = "";
        errore-modulo = "";
        esito-prova = "";
        root.annulla-prova();
        if (i >= 0 && i < ambienti.length) {
            modulo-id = ambienti[i].id;
            modulo-titolo = "MODIFICA «" + ambienti[i].nome + "»";
            campo-nome = ambienti[i].nome;
            campo-url = ambienti[i].url;
        } else {
            modulo-id = "";
            modulo-titolo = "NUOVO AMBIENTE";
            campo-nome = "";
            campo-url = "";
        }
        campo-token = "";
        modo = ModoAmbienti.modulo;
    }

    // Chiude il modulo e svuota i campi: il token scritto non resta in memoria.
    function chiudi-modulo() {
        root.annulla-prova();
        campo-nome = "";
        campo-url = "";
        campo-token = "";
        errore-modulo = "";
        esito-prova = "";
        modo = ModoAmbienti.elenco;
        radice.focus();
    }

    function prova() {
        errore-modulo = "";
        root.prova-connessione(modulo-id, campo-url, campo-token);
    }

    function salva() {
        errore-modulo = root.salva-ambiente(modulo-id, campo-nome, campo-url, campo-token);
        if (errore-modulo == "") {
            chiudi-modulo();
        }
    }

    // Primo tocco: «Conferma» per 4 s sul pulsante stesso; secondo tocco (dopo 400 ms): via.
    function rimuovi(id: string) {
        errore-elenco = "";
        if (conferma-id == id && conferma-pronta) {
            conferma-id = "";
            errore-elenco = root.rimuovi-ambiente(id);
            radice.focus();
        } else if (conferma-id != id) {
            conferma-pronta = false;
            conferma-id = id;
            // Passando da un ambiente all'altro i 4 s ripartono.
            scadenza-conferma.restart();
            armo-conferma.restart();
        }
    }

    // Il fuoco chiesto da una modifica è arrivato: la richiesta non vale più (un elenco rifatto più
    // tardi non lo riporterebbe lì).
    function fuoco-arrivato(riga: string) {
        if (riga == fuoco-riga) {
            fuoco-riga = "";
        }
    }

    function apri-scelta-icona(area: string, nome: string, icona: int, riga: string) {
        scelta-nome = nome;
        scelta-attuale = icona;
        scelta-fuoco = max(0, icona);
        scelta-riga = riga;
        scelta-area = area;
    }

    // Chiude la scelta dell'icona: il fuoco torna sul pulsante dell'icona della stanza.
    function chiudi-scelta-icona() {
        scelta-area = "";
        fuoco-riga = scelta-riga;
        fuoco-azione = "icona";
        richiesta-fuoco += 1;
    }

    // ─── Collegamenti ───

    function apri-modulo-collegamento(i: int) {
        conferma-c-id = "";
        errore-c-nome = "";
        errore-c-url = "";
        errore-c = "";
        toccato-c-nome = false;
        toccato-c-url = false;
        if (i >= 0 && i < collegamenti.length) {
            modulo-c-id = collegamenti[i].id;
            modulo-c-titolo = "MODIFICA «" + collegamenti[i].nome + "»";
            campo-c-nome = collegamenti[i].nome;
            campo-c-url = collegamenti[i].url;
        } else {
            modulo-c-id = "";
            modulo-c-titolo = "NUOVO COLLEGAMENTO";
            campo-c-nome = "";
            campo-c-url = "";
        }
        modulo-collegamento = true;
    }

    // Chiude il modulo; `annullato`: il fuoco torna sul pulsante da cui era partito (dopo un
    // salvataggio lo decide Rust: la riga salvata).
    function chiudi-modulo-collegamento(annullato: bool) {
        if (annullato) {
            fuoco-collegamento = modulo-c-id;
            fuoco-azione-collegamento = modulo-c-id == "" ? "aggiungi" : "modifica";
            richiesta-fuoco += 1;
        }
        modulo-collegamento = false;
        campo-c-nome = "";
        campo-c-url = "";
        errore-c-nome = "";
        errore-c-url = "";
        errore-c = "";
    }

    function chiedi-elimina-collegamento(i: int) {
        if (i >= 0 && i < collegamenti.length) {
            conferma-c-nome = collegamenti[i].nome;
            conferma-c-id = collegamenti[i].id;
        }
    }

    // «Annulla» o Esc: il fuoco torna su «Elimina» della stessa riga.
    function annulla-elimina-collegamento() {
        fuoco-collegamento = conferma-c-id;
        fuoco-azione-collegamento = "elimina";
        conferma-c-id = "";
        richiesta-fuoco += 1;
    }

    function conferma-elimina-collegamento() {
        root.elimina-collegamento(conferma-c-id);
        conferma-c-id = "";
    }

    // Il fuoco chiesto è arrivato: la richiesta non vale più.
    function fuoco-collegamento-arrivato(id: string) {
        if (id == fuoco-collegamento) {
            fuoco-collegamento = "";
            fuoco-azione-collegamento = "";
        }
    }

    // Chiude l'anteprima o la conferma di Claude senza scrivere.
    function chiudi-claude() {
        claude-passo = 0;
        claude-anteprima = "";
        claude-avvisi = "";
        root.claude-annulla();
        radice.focus();
    }

    // Chiude la conferma di «Togli»: il fuoco torna alla finestra.
    function chiudi-togli() {
        api-conferma-togli = false;
        radice.focus();
    }

    // Lasciando la sezione la conferma non resta in sospeso.
    changed sezione => {
        conferma-c-id = "";
        api-conferma-togli = false;
        if (claude-passo != 0) {
            chiudi-claude();
        }
    }

    function cambia-avvio-ora() {
        avvio-con-sistema = !avvio-con-sistema;
        root.cambia-avvio(avvio-con-sistema);
    }

    function cambia-icona-barra-ora() {
        icona-barra = !icona-barra;
        root.cambia-icona-barra(icona-barra);
    }

    // Conferma della rimozione: si arma dopo 400 ms e scade dopo 4 s (timer solo in quei momenti).
    armo-conferma := Timer {
        interval: 400ms;
        running: conferma-id != "" && !conferma-pronta;
        triggered => { conferma-pronta = true; }
    }

    scadenza-conferma := Timer {
        interval: 4s;
        running: conferma-id != "";
        triggered => { conferma-id = ""; }
    }

    // Tiene il fuoco quando nessun campo o pulsante lo ha: Esc chiude la finestra. I tasti non
    // presi da un pulsante o da un campo arrivano qui.
    radice := FocusScope {
        focus-on-click: false;
        key-pressed(evento) => {
            if (evento.text == Key.Escape) {
                // Un livello alla volta: la conferma, il modulo (ambienti o collegamenti), la finestra.
                if (sezione == 4 && claude-passo != 0) {
                    chiudi-claude();
                } else if (sezione == 4 && api-conferma-togli) {
                    chiudi-togli();
                } else if (sezione == 2 && conferma-c-id != "") {
                    annulla-elimina-collegamento();
                } else if (sezione == 0 && modo == ModoAmbienti.modulo) {
                    chiudi-modulo();
                } else if (sezione == 2 && modulo-collegamento) {
                    chiudi-modulo-collegamento(true);
                } else {
                    root.chiudi();
                }
                return accept;
            }
            return reject;
        }

        // Sotto la barra di Windows il filo dei petali, come il bordo del pannello e la cornice della
        // gestione (R1-19): 1,5 px arrotondato al pixel fisico.
        filo-petali := Rectangle {
            y: 0;
            height: Tema.sul-pixel(1.5px);
            background: Tema.petali;
        }

        // Niente titolo «Impostazioni»: lo dice già la barra della finestra.

        // La colonna delle sezioni, il filo che le separa e il contenuto della sezione scelta.
        HorizontalLayout {
            padding-top: alto-testata;
            padding-bottom: 24px;
            padding-left: margine - 8px;
            padding-right: margine;
            spacing: 18px;

            // ─── Sezioni ───
            VerticalLayout {
                width: largo-sezioni;
                alignment: start;
                spacing: 6px;

                for nome[i] in ["Home Assistant", "Dispositivi", "Collegamenti", "Isola", "Claude", "Sistema", "Informazioni"]: Sezione {
                    nome: nome;
                    attiva: sezione == i;
                    indice: i;
                    quante: 7;
                    scelta => { sezione = i; }
                }
            }

            Rectangle {
                width: 1px;
                background: Tema.vetro-bordo;
            }

            // Il contenuto: c'è solo la sezione scelta, e la riempie.
            Rectangle {
                horizontal-stretch: 1;

                // ─── Home Assistant: elenco ───
                if sezione == 0 && modo == ModoAmbienti.elenco: VerticalLayout {
                    spacing: 14px;

                    // L'etichetta, l'errore dell'ultima rimozione e, con degli ambienti, il pulsante
                    // in alto a destra (a elenco vuoto sta sotto il messaggio e al centro, come nel
                    // pannello).
                    HorizontalLayout {
                        height: 30px;
                        spacing: 12px;

                        Etichetta {
                            text: "AMBIENTI";
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: errore-elenco;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: Tema.testo-corpo;
                            color: Tema.caldo-2;
                        }

                        if ambienti.length > 0: Bottone {
                            testo: "Aggiungi un ambiente";
                            premuto => { apri-modulo(-1); }
                        }
                    }

                    if ambienti.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "Nessun ambiente configurato";
                            horizontal-alignment: center;
                            font-weight: 500;
                            font-size: Tema.testo-sottotitolo;
                            color: Tema.testo;
                        }

                        Text {
                            text: "Aggiungi l'indirizzo e il token di accesso del tuo Home Assistant.";
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            font-size: Tema.testo-corpo;
                            color: Tema.testo-tenue;
                        }

                        HorizontalLayout {
                            alignment: center;
                            padding-top: 4px;

                            Bottone {
                                testo: "Aggiungi un ambiente";
                                tipo: TipoPulsante.azione;
                                premuto => { apri-modulo(-1); }
                            }
                        }
                    }

                    if ambienti.length > 0: elenco := Scorrevole {
                        vertical-stretch: 1;
                        alto-contenuto: righe-ambienti.preferred-height;

                        righe-ambienti := VerticalLayout {
                            width: parent.width;
                            alignment: start;
                            spacing: 8px;

                            for amb[i] in ambienti: riga-ambiente := Rectangle {
                                property <bool> conferma: conferma-id == amb.id;
                                height: alto-riga;
                                border-radius: Tema.raggio-xl;
                                background: conferma ? Tema.pericolo-velo : Tema.card-fondo;
                                border-width: 1px;
                                border-color: conferma ? Tema.pericolo-filo : Tema.vetro-bordo;

                                // Riga 1: nome e stato (oppure la domanda che nomina l'ambiente);
                                // riga 2: indirizzo (o cosa succede); riga 3: i pulsanti. Così ci
                                // sta anche stretta.
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 10px;
                                    padding-bottom: 12px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        height: 20px;
                                        spacing: 12px;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: conferma ? "Rimuovere «" + amb.nome + "»?" : amb.nome;
                                            overflow: elide;
                                            font-weight: 500;
                                            font-size: Tema.testo-medio;
                                            color: conferma ? Tema.caldo-1 : Tema.testo;
                                        }

                                        // A destra, al bordo della card (largo quanto la parola, al più 150).
                                        if !conferma: Stato {
                                            width: min(150px, self.naturale);
                                            testo: amb.stato;
                                            tono: amb.tono;
                                        }
                                    }

                                    Text {
                                        height: 20px;
                                        text: conferma ? "Si cancella anche il token. Conferma entro 4 s." : amb.url;
                                        overflow: elide;
                                        font-size: Tema.testo-piccolo;
                                        color: Tema.testo-tenue;
                                    }

                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 8px;
                                        alignment: start;

                                        if !conferma: Bottone {
                                            testo: amb.collegato ? "Disconnetti" : "Connetti";
                                            tipo: amb.collegato ? TipoPulsante.neutro : TipoPulsante.azione;
                                            fuoco-preso => { elenco.porta-in-vista(riga-ambiente.y, riga-ambiente.height); }
                                            premuto => {
                                                if (amb.collegato) {
                                                    root.disconnetti-casa();
                                                } else {
                                                    root.connetti-ambiente(amb.id);
                                                }
                                            }
                                        }

                                        Bottone {
                                            testo: conferma ? "Annulla" : "Modifica";
                                            fuoco-preso => { elenco.porta-in-vista(riga-ambiente.y, riga-ambiente.height); }
                                            premuto => {
                                                if (conferma) {
                                                    conferma-id = "";
                                                } else {
                                                    apri-modulo(i);
                                                }
                                            }
                                        }

                                        Bottone {
                                            testo: conferma ? "Conferma" : "Rimuovi";
                                            tipo: conferma ? TipoPulsante.pericolo : TipoPulsante.neutro;
                                            accessible-label: conferma ? "Conferma la rimozione di " + amb.nome : "Rimuovi " + amb.nome;
                                            fuoco-preso => { elenco.porta-in-vista(riga-ambiente.y, riga-ambiente.height); }
                                            premuto => { rimuovi(amb.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ─── Home Assistant: modulo aggiungi/modifica ───
                if sezione == 0 && modo == ModoAmbienti.modulo: VerticalLayout {
                    x: 0;
                    width: min(560px, parent.width);
                    alignment: start;
                    spacing: 10px;
                    // Il modulo nasce col fuoco nel primo campo.
                    init => { nome.prendi(); }

                    Etichetta {
                        height: 34px;
                        text: modulo-titolo;
                        overflow: elide;
                    }

                    nome := Campo {
                        etichetta: "Nome";
                        suggerimento: "es. Casa";
                        testo <=> campo-nome;
                        esci => { radice.focus(); }
                        invio => { salva(); }
                    }

                    Campo {
                        etichetta: "Indirizzo";
                        suggerimento: "es. homeassistant.local:8123";
                        testo <=> campo-url;
                        esci => { radice.focus(); }
                        invio => { salva(); }
                    }

                    Campo {
                        etichetta: "Token";
                        suggerimento: modulo-id == "" ? "Incolla il token di accesso a lunga durata" : "Lascia vuoto per non cambiarlo";
                        password: true;
                        testo <=> campo-token;
                        esci => { radice.focus(); }
                        invio => { salva(); }
                    }

                    // I pulsanti e il messaggio partono dove partono le caselle.
                    HorizontalLayout {
                        padding-left: 100px;
                        padding-top: 8px;
                        spacing: 10px;
                        alignment: start;

                        Bottone {
                            testo: "Prova connessione";
                            premuto => { prova(); }
                        }

                        Bottone {
                            testo: "Salva";
                            tipo: TipoPulsante.azione;
                            premuto => { salva(); }
                        }

                        Bottone {
                            testo: "Annulla";
                            premuto => { chiudi-modulo(); }
                        }
                    }

                    // Un messaggio alla volta: l'errore del modulo, altrimenti l'esito della prova.
                    HorizontalLayout {
                        padding-left: 100px;

                        Text {
                            text: errore-modulo != "" ? errore-modulo : esito-prova;
                            wrap: word-wrap;
                            font-size: Tema.testo-corpo;
                            color: errore-modulo != "" || tono-prova == TonoUi.errore ? Tema.caldo-2
                                : tono-prova == TonoUi.ok ? Tema.presa-accesa
                                : Tema.testo-tenue;
                            accessible-role: text;
                        }
                    }
                }

                // ─── Dispositivi ───
                // Come la scheda «Accessories» della v2: i preferiti in cima, poi le stanze con i loro
                // dispositivi, nascosti compresi. Frecce su/giù per l'ordine (al posto del
                // trascinamento della v2, che con la tastiera non si poteva usare), stella, occhio,
                // icona della stanza, stanze comprimibili. Ogni modifica è salvata subito e si vede
                // subito nel pannello.
                if sezione == 1: VerticalLayout {
                    VerticalLayout {
                        height: 52px;
                        alignment: start;

                        Etichetta {
                            height: 26px;
                            text: "STANZE E DISPOSITIVI";
                        }

                        // Le istruzioni servono solo se c'è qualcosa da ordinare.
                        if righe-dispositivi.length > 0: Text {
                            height: 18px;
                            text: "Ordine con le frecce, preferiti con la stella, nascosti con l'occhio.";
                            overflow: elide;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }
                    }

                    // L'elenco e, sopra, la scelta dell'icona quando è aperta.
                    Rectangle {
                        vertical-stretch: 1;

                        if righe-dispositivi.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "Nessun dispositivo da gestire";
                                horizontal-alignment: center;
                                font-weight: 500;
                                font-size: Tema.testo-sottotitolo;
                                color: Tema.testo;
                            }

                            Text {
                                text: "I dispositivi compaiono qui quando la casa è collegata (sezione Home Assistant).";
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                font-size: Tema.testo-corpo;
                                color: Tema.testo-tenue;
                            }
                        }

                        if righe-dispositivi.length > 0: elenco-dispositivi := Scorrevole {
                            alto-contenuto: righe.preferred-height;

                            righe := VerticalLayout {
                                width: parent.width;
                                alignment: start;
                                spacing: 4px;

                                for riga[i] in righe-dispositivi: riga-dispositivo := Rectangle {
                                    property <bool> testata: riga.tipo == TipoRigaUi.testata-preferiti || riga.tipo == TipoRigaUi.testata-stanza;
                                    property <string> tra-virgolette: "«" + riga.nome + "»";
                                    height: alto-dispositivo;
                                    border-radius: Tema.raggio-m;
                                    background: testata ? Tema.card-fondo : transparent;

                                    // Una testata: comprimi, icona (28 ciascuno), nome. Un
                                    // dispositivo: rientrato, icona del genere e nome. Poi i comandi.
                                    HorizontalLayout {
                                        padding-left: testata ? 4px : 50px;
                                        padding-right: 4px;

                                        // Testate: comprimi/espandi.
                                        if testata: VerticalLayout {
                                            alignment: center;

                                            BottoneIcona {
                                                icona: riga.compressa ? Icone.destra : Icone.giu;
                                                nome: (riga.compressa ? "Espandi " : "Comprimi ") + tra-virgolette;
                                                richiesta: root.richiesta-fuoco;
                                                mio: riga.id == root.fuoco-riga && root.fuoco-azione == "comprimi";
                                                fuoco-preso => {
                                                    elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                    fuoco-arrivato(riga.id);
                                                }
                                                premuto => { root.azione-dispositivo("comprimi", riga.id, riga.chiave, riga.area); }
                                            }
                                        }

                                        if testata: Rectangle { width: 2px; }

                                        // L'icona di una testata: quella della stanza (si sceglie, se
                                        // è una stanza vera) o la stella dei preferiti, nel posto di
                                        // un pulsante.
                                        if testata: VerticalLayout {
                                            width: 28px;
                                            alignment: center;

                                            if riga.tipo == TipoRigaUi.testata-stanza && riga.puo-icona: BottoneIcona {
                                                icona: Icone.di-stanza(riga.icona);
                                                nome: "Cambia icona di " + tra-virgolette;
                                                richiesta: root.richiesta-fuoco;
                                                mio: riga.id == root.fuoco-riga && root.fuoco-azione == "icona";
                                                fuoco-preso => {
                                                    elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                    fuoco-arrivato(riga.id);
                                                }
                                                premuto => { root.apri-scelta-icona(riga.chiave, riga.nome, riga.icona, riga.id); }
                                            }

                                            if !(riga.tipo == TipoRigaUi.testata-stanza && riga.puo-icona): HorizontalLayout {
                                                alignment: center;

                                                Image {
                                                    width: 18px;
                                                    height: 18px;
                                                    source: riga.tipo == TipoRigaUi.testata-preferiti ? Icone.stella-piena : Icone.di-stanza(riga.icona);
                                                    colorize: riga.tipo == TipoRigaUi.testata-preferiti ? Tema.luce-accesa
                                                        : riga.nascosto ? Tema.icona-spenta : Tema.icona;
                                                    image-rendering: smooth;
                                                    accessible-role: none;
                                                }
                                            }
                                        }

                                        // L'icona del genere di un dispositivo.
                                        if !testata: VerticalLayout {
                                            alignment: center;

                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: Icone.di-genere(riga.genere);
                                                colorize: riga.nascosto ? Tema.icona-spenta : Tema.icona;
                                                image-rendering: smooth;
                                                accessible-role: none;
                                            }
                                        }

                                        Rectangle { width: testata ? 6px : 10px; }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-top: 3px;
                                            alignment: start;

                                            Text {
                                                height: 17px;
                                                text: riga.nome;
                                                overflow: elide;
                                                font-weight: testata ? 500 : 400;
                                                font-size: Tema.testo-corpo;
                                                color: riga.nascosto ? Tema.testo-tenue : Tema.testo;
                                            }

                                            Text {
                                                height: 14px;
                                                text: riga.sotto;
                                                overflow: elide;
                                                font-size: Tema.testo-piccolo;
                                                color: Tema.testo-tenue;
                                            }
                                        }

                                        Rectangle { width: 8px; }

                                        // Al massimo quattro pulsanti da 28 (più gli spazi), allineati a destra.
                                        VerticalLayout {
                                            alignment: center;

                                            HorizontalLayout {
                                                width: 120px;
                                                spacing: 2px;
                                                alignment: end;

                                                // L'ordine: stanze vere, preferiti, dispositivi.
                                                if riga.tipo != TipoRigaUi.testata-preferiti && (riga.tipo != TipoRigaUi.testata-stanza || riga.puo-icona): BottoneIcona {
                                                    icona: Icone.su;
                                                    nome: "Sposta su " + tra-virgolette;
                                                    attivo: riga.su;
                                                    richiesta: root.richiesta-fuoco;
                                                    mio: riga.id == root.fuoco-riga && root.fuoco-azione == "su";
                                                    fuoco-preso => {
                                                        elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                        fuoco-arrivato(riga.id);
                                                    }
                                                    premuto => { root.azione-dispositivo("su", riga.id, riga.chiave, riga.area); }
                                                }

                                                if riga.tipo != TipoRigaUi.testata-preferiti && (riga.tipo != TipoRigaUi.testata-stanza || riga.puo-icona): BottoneIcona {
                                                    icona: Icone.giu;
                                                    nome: "Sposta giù " + tra-virgolette;
                                                    attivo: riga.giu;
                                                    richiesta: root.richiesta-fuoco;
                                                    mio: riga.id == root.fuoco-riga && root.fuoco-azione == "giu";
                                                    fuoco-preso => {
                                                        elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                        fuoco-arrivato(riga.id);
                                                    }
                                                    premuto => { root.azione-dispositivo("giu", riga.id, riga.chiave, riga.area); }
                                                }

                                                // La stella: preferito sì/no (i dispositivi e i preferiti stessi).
                                                if !testata: BottoneIcona {
                                                    icona: riga.preferito ? Icone.stella-piena : Icone.stella;
                                                    tinta: riga.preferito ? Tema.luce-accesa : Tema.icona;
                                                    nome: riga.preferito ? "Togli " + tra-virgolette + " dai preferiti" : "Aggiungi " + tra-virgolette + " ai preferiti";
                                                    richiesta: root.richiesta-fuoco;
                                                    mio: riga.id == root.fuoco-riga && root.fuoco-azione == "preferito";
                                                    fuoco-preso => {
                                                        elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                        fuoco-arrivato(riga.id);
                                                    }
                                                    premuto => { root.azione-dispositivo("preferito", riga.id, riga.chiave, riga.area); }
                                                }

                                                // L'occhio: nascosto sì/no, del dispositivo o di tutta la stanza.
                                                if riga.tipo == TipoRigaUi.dispositivo || riga.tipo == TipoRigaUi.testata-stanza: BottoneIcona {
                                                    icona: riga.nascosto ? Icone.occhio-chiuso : Icone.occhio;
                                                    nome: (riga.nascosto ? "Mostra " : "Nascondi ")
                                                        + (riga.tipo == TipoRigaUi.testata-stanza ? "la stanza " : "") + tra-virgolette;
                                                    richiesta: root.richiesta-fuoco;
                                                    mio: riga.id == root.fuoco-riga && root.fuoco-azione == "nascondi";
                                                    fuoco-preso => {
                                                        elenco-dispositivi.porta-in-vista(riga-dispositivo.y, riga-dispositivo.height);
                                                        fuoco-arrivato(riga.id);
                                                    }
                                                    premuto => { root.azione-dispositivo("nascondi", riga.id, riga.chiave, riga.area); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Finché la scelta dell'icona è aperta l'elenco sotto non risponde al mouse
                        // (un clic fuori dal riquadro la chiude, come Esc).
                        if scelta-area != "": TouchArea {
                            clicked => { chiudi-scelta-icona(); }
                        }

                        // La scelta dell'icona copre l'elenco finché non si sceglie o si annulla.
                        if scelta-area != "": SceltaIcona {
                            x: 0;
                            y: 0;
                            width: min(parent.width, 352px);
                            titolo: "ICONA DI «" + scelta-nome + "»";
                            nomi: root.nomi-icone;
                            attuale: scelta-attuale;
                            scelta <=> scelta-fuoco;
                            scelta-fatta(i) => {
                                root.scegli-icona(scelta-area, i);
                                chiudi-scelta-icona();
                            }
                            annulla => { chiudi-scelta-icona(); }
                        }
                    }
                }

                // ─── Collegamenti: elenco ───
                // Le pagine delle gestioni nell'ordine del pannello. Frecce su/giù per l'ordine,
                // matita per il modulo, cestino con la conferma. Ogni modifica è salvata subito e si
                // vede subito nel pannello.
                if sezione == 2 && !modulo-collegamento: Rectangle {
                    VerticalLayout {
                        spacing: 4px;

                        // Con dei collegamenti il pulsante sta in alto a destra; a elenco vuoto, sotto
                        // il messaggio e al centro (come nel pannello).
                        HorizontalLayout {
                            height: 30px;
                            spacing: 12px;

                            Etichetta {
                                horizontal-stretch: 1;
                                text: "COLLEGAMENTI";
                            }

                            if collegamenti.length > 0: Bottone {
                                testo: "Aggiungi un collegamento";
                                chiede-fuoco: fuoco-azione-collegamento == "aggiungi";
                                fuoco-preso => {
                                    if (fuoco-azione-collegamento == "aggiungi") {
                                        fuoco-azione-collegamento = "";
                                    }
                                }
                                premuto => { apri-modulo-collegamento(-1); }
                            }
                        }

                        Text {
                            height: 22px;
                            text: "Le pagine delle tue gestioni: il pannello le apre nel browser predefinito.";
                            overflow: elide;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }

                        area-collegamenti := Rectangle {
                            vertical-stretch: 1;

                            if collegamenti.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: "Nessun collegamento";
                                    horizontal-alignment: center;
                                    font-weight: 500;
                                    font-size: Tema.testo-sottotitolo;
                                    color: Tema.testo;
                                }

                                Text {
                                    text: "Aggiungi le pagine che usi per le tue gestioni (router, NAS, server…): si aprono con un clic dal pannello.";
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: Tema.testo-tenue;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    padding-top: 4px;

                                    Bottone {
                                        testo: "Aggiungi un collegamento";
                                        tipo: TipoPulsante.azione;
                                        chiede-fuoco: fuoco-azione-collegamento == "aggiungi";
                                        fuoco-preso => {
                                            if (fuoco-azione-collegamento == "aggiungi") {
                                                fuoco-azione-collegamento = "";
                                            }
                                        }
                                        premuto => { apri-modulo-collegamento(-1); }
                                    }
                                }
                            }

                            if collegamenti.length > 0: elenco-collegamenti := Scorrevole {
                                alto-contenuto: righe-collegamenti.preferred-height;

                                righe-collegamenti := VerticalLayout {
                                    width: parent.width;
                                    alignment: start;
                                    spacing: 4px;

                                    for c[i] in collegamenti: riga-collegamento := Rectangle {
                                        property <string> tra-virgolette: "«" + c.nome + "»";
                                        height: alto-collegamento;
                                        border-radius: Tema.raggio-m;
                                        background: Tema.card-fondo;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 4px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                alignment: center;

                                                Image {
                                                    width: 18px;
                                                    height: 18px;
                                                    source: Icone.collegamento;
                                                    colorize: Tema.icona;
                                                    image-rendering: smooth;
                                                    accessible-role: none;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-top: 5px;
                                                alignment: start;
                                                spacing: 1px;

                                                Text {
                                                    height: 18px;
                                                    text: c.nome;
                                                    overflow: elide;
                                                    font-weight: 500;
                                                    font-size: Tema.testo-corpo;
                                                    color: Tema.testo;
                                                }

                                                Text {
                                                    height: 15px;
                                                    text: c.url;
                                                    overflow: elide;
                                                    font-size: Tema.testo-piccolo;
                                                    color: Tema.testo-tenue;
                                                }
                                            }

                                            // Quattro pulsanti da 28 (più gli spazi), allineati a destra.
                                            VerticalLayout {
                                                alignment: center;

                                                HorizontalLayout {
                                                    width: 120px;
                                                    spacing: 2px;
                                                    alignment: end;

                                                    BottoneIcona {
                                                        icona: Icone.su;
                                                        nome: "Sposta su " + tra-virgolette;
                                                        attivo: i > 0 && conferma-c-id == "";
                                                        richiesta: root.richiesta-fuoco;
                                                        mio: c.id == root.fuoco-collegamento && root.fuoco-azione-collegamento == "su";
                                                        fuoco-preso => {
                                                            elenco-collegamenti.porta-in-vista(riga-collegamento.y, riga-collegamento.height);
                                                            fuoco-collegamento-arrivato(c.id);
                                                        }
                                                        premuto => { root.sposta-collegamento(c.id, -1); }
                                                    }

                                                    BottoneIcona {
                                                        icona: Icone.giu;
                                                        nome: "Sposta giù " + tra-virgolette;
                                                        attivo: i < collegamenti.length - 1 && conferma-c-id == "";
                                                        richiesta: root.richiesta-fuoco;
                                                        mio: c.id == root.fuoco-collegamento && root.fuoco-azione-collegamento == "giu";
                                                        fuoco-preso => {
                                                            elenco-collegamenti.porta-in-vista(riga-collegamento.y, riga-collegamento.height);
                                                            fuoco-collegamento-arrivato(c.id);
                                                        }
                                                        premuto => { root.sposta-collegamento(c.id, 1); }
                                                    }

                                                    BottoneIcona {
                                                        icona: Icone.matita;
                                                        nome: "Modifica " + tra-virgolette;
                                                        // Con la conferma aperta le righe sotto sono spente:
                                                        // Narrator e UIA non le invocano (il mouse lo ferma
                                                        // già l'area sopra).
                                                        attivo: conferma-c-id == "";
                                                        richiesta: root.richiesta-fuoco;
                                                        mio: c.id == root.fuoco-collegamento && root.fuoco-azione-collegamento == "modifica";
                                                        fuoco-preso => {
                                                            elenco-collegamenti.porta-in-vista(riga-collegamento.y, riga-collegamento.height);
                                                            fuoco-collegamento-arrivato(c.id);
                                                        }
                                                        premuto => { apri-modulo-collegamento(i); }
                                                    }

                                                    BottoneIcona {
                                                        icona: Icone.cestino;
                                                        nome: "Elimina " + tra-virgolette;
                                                        attivo: conferma-c-id == "";
                                                        richiesta: root.richiesta-fuoco;
                                                        mio: c.id == root.fuoco-collegamento && root.fuoco-azione-collegamento == "elimina";
                                                        fuoco-preso => {
                                                            elenco-collegamenti.porta-in-vista(riga-collegamento.y, riga-collegamento.height);
                                                            fuoco-collegamento-arrivato(c.id);
                                                        }
                                                        premuto => { chiedi-elimina-collegamento(i); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Con la conferma aperta il resto della sezione non risponde al mouse: un clic
                    // fuori dal riquadro annulla, come Esc.
                    if conferma-c-id != "": TouchArea {
                        clicked => { annulla-elimina-collegamento(); }
                    }

                    // La conferma sta in cima all'elenco.
                    if conferma-c-id != "": ConfermaElimina {
                        x: 0;
                        y: area-collegamenti.y;
                        width: min(parent.width, 400px);
                        nome: conferma-c-nome;
                        conferma => { conferma-elimina-collegamento(); }
                        annulla => { annulla-elimina-collegamento(); }
                    }
                }

                // ─── Collegamenti: modulo aggiungi/modifica ───
                if sezione == 2 && modulo-collegamento: VerticalLayout {
                    x: 0;
                    width: min(560px, parent.width);
                    alignment: start;
                    spacing: 10px;
                    // Il modulo nasce col fuoco nel primo campo.
                    init => { nome-collegamento.prendi(); }

                    // Al salvataggio si controllano tutti e due i campi; il fuoco va sul primo sbagliato.
                    function salva() {
                        toccato-c-nome = true;
                        toccato-c-url = true;
                        errore-c-nome = root.controlla-nome-collegamento(campo-c-nome);
                        errore-c-url = root.controlla-indirizzo-collegamento(campo-c-url);
                        if (errore-c-nome != "") {
                            nome-collegamento.prendi();
                        } else if (errore-c-url != "") {
                            indirizzo-collegamento.prendi();
                        } else {
                            errore-c = root.salva-collegamento(modulo-c-id, campo-c-nome, campo-c-url);
                            if (errore-c == "") {
                                chiudi-modulo-collegamento(false);
                            }
                        }
                    }

                    Etichetta {
                        height: 34px;
                        text: modulo-c-titolo;
                        overflow: elide;
                    }

                    // Ogni campo con la sua riga sotto (l'errore, o cosa si accetta), allineata alla casella.
                    VerticalLayout {
                        spacing: 2px;

                        nome-collegamento := Campo {
                            etichetta: "Nome";
                            suggerimento: "es. Proxmox";
                            errore: errore-c-nome;
                            testo <=> campo-c-nome;
                            esci => { radice.focus(); }
                            invio => { salva(); }
                            modificato => {
                                toccato-c-nome = true;
                                // L'errore sparisce appena il nome va bene.
                                if (errore-c-nome != "") {
                                    errore-c-nome = root.controlla-nome-collegamento(campo-c-nome);
                                }
                            }
                            lasciato => {
                                if (toccato-c-nome) {
                                    errore-c-nome = root.controlla-nome-collegamento(campo-c-nome);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 100px;

                            Text {
                                height: 16px;
                                text: errore-c-nome;
                                overflow: elide;
                                font-size: Tema.testo-piccolo;
                                color: Tema.caldo-2;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        indirizzo-collegamento := Campo {
                            etichetta: "Indirizzo";
                            suggerimento: "es. https://esempio.lan:8006";
                            errore: errore-c-url;
                            testo <=> campo-c-url;
                            esci => { radice.focus(); }
                            invio => { salva(); }
                            modificato => {
                                toccato-c-url = true;
                                if (errore-c-url != "") {
                                    errore-c-url = root.controlla-indirizzo-collegamento(campo-c-url);
                                }
                            }
                            lasciato => {
                                if (toccato-c-url) {
                                    errore-c-url = root.controlla-indirizzo-collegamento(campo-c-url);
                                }
                            }
                        }

                        // Sotto l'indirizzo: l'errore, altrimenti cosa si accetta.
                        HorizontalLayout {
                            padding-left: 100px;

                            Text {
                                height: 16px;
                                text: errore-c-url != "" ? errore-c-url : "Solo http:// o https://; senza, si aggiunge https://.";
                                overflow: elide;
                                font-size: Tema.testo-piccolo;
                                color: errore-c-url != "" ? Tema.caldo-2 : Tema.testo-tenue;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 100px;
                        padding-top: 2px;
                        spacing: 10px;
                        alignment: start;

                        Bottone {
                            testo: "Salva";
                            tipo: TipoPulsante.azione;
                            premuto => { salva(); }
                        }

                        Bottone {
                            testo: "Annulla";
                            premuto => { chiudi-modulo-collegamento(true); }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 100px;

                        Text {
                            text: errore-c;
                            wrap: word-wrap;
                            font-size: Tema.testo-corpo;
                            color: Tema.caldo-2;
                            accessible-role: text;
                        }
                    }
                }

                // ─── Isola ───
                if sezione == 3: isola := Scorrevole {
                    alto-contenuto: colonna.preferred-height + 8px;

                    colonna := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;

                        Etichetta {
                            height: 30px;
                            text: "PILLOLA";
                        }

                        RigaScelta {
                            titolo: "A sinistra degli occhi";
                            voci: scelte-lati;
                            indice: indice-lato-sinistro;
                            scelto(i) => { root.scegli-lato(0, i); }
                            fuoco-preso => { isola.porta-in-vista(self.y, self.height); }
                        }

                        RigaScelta {
                            titolo: "A destra degli occhi";
                            voci: scelte-lati;
                            indice: indice-lato-destro;
                            scelto(i) => { root.scegli-lato(1, i); }
                            fuoco-preso => { isola.porta-in-vista(self.y, self.height); }
                        }

                        // Su Windows, sotto i selettori, la rassicurazione quando uno dei due vale «Rete».
                        if !fuori-da-windows && (scelte-lati[indice-lato-sinistro] == "Rete" || scelte-lati[indice-lato-destro] == "Rete"): Text {
                            text: "«Rete»: solo l'icona della connessione. Il nome della rete non compare mai nella pillola.";
                            wrap: word-wrap;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }

                        // Dove l'app gira (Windows) la nota «solo su Windows» non serve: la mostra solo chi non ha la fonte.
                        if fuori-da-windows: Text {
                            text: "«Rete»: solo su Windows, solo l'icona della connessione. Il nome della rete non compare mai nella pillola.";
                            wrap: word-wrap;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }

                        if volume-rotella-disponibile: card-volume := CardRiga {
                            titolo: "Volume con la rotella sulla pillola";
                            descrizione: "Due punti a scatto; al posto degli occhi compare la barra del volume.";

                            Interruttore {
                                nome: "Volume con la rotella sulla pillola";
                                acceso: volume-rotella;
                                commutato => {
                                    volume-rotella = !volume-rotella;
                                    root.cambia-volume-rotella(volume-rotella);
                                }
                                changed has-focus => {
                                    if (self.has-focus) {
                                        isola.porta-in-vista(card-volume.y, card-volume.height);
                                    }
                                }
                            }
                        }

                        // Un avviso non è un aspetto della pillola: ha la sua sezione.
                        if avvisi-bt-disponibile: Etichetta {
                            height: 30px;
                            text: "AVVISI";
                        }

                        if avvisi-bt-disponibile: card-bt := CardRiga {
                            titolo: "Avvisa quando le cuffie Bluetooth sono scariche";
                            descrizione: "Una volta al giorno, al 20% o meno.";

                            Interruttore {
                                nome: "Avvisa quando le cuffie Bluetooth sono scariche";
                                acceso: avvisi-bt;
                                commutato => {
                                    avvisi-bt = !avvisi-bt;
                                    root.cambia-avvisi-bt(avvisi-bt);
                                }
                                changed has-focus => {
                                    if (self.has-focus) {
                                        isola.porta-in-vista(card-bt.y, card-bt.height);
                                    }
                                }
                            }
                        }

                        Etichetta {
                            height: 30px;
                            text: "METEO";
                        }

                        RigaScelta {
                            titolo: "Meteo da";
                            voci: scelte-meteo;
                            indice: indice-meteo;
                            scelto(i) => { root.scegli-meteo(i); }
                            fuoco-preso => { isola.porta-in-vista(self.y, self.height); }
                        }

                        Etichetta {
                            height: 30px;
                            text: "QUADRANTI";
                        }

                        for q[i] in quadranti-scelti: RigaScelta {
                            titolo: "Quadrante " + (i + 1);
                            voci: scelte-quadranti;
                            indice: q.indice;
                            con-massimo: q.con-massimo;
                            massimo: q.massimo;
                            predefinito: q.predefinito;
                            scelto(n) => { root.scegli-quadrante(i, n); }
                            massimo-scritto(testo) => { return root.cambia-massimo(i, testo); }
                            fuoco-preso => { isola.porta-in-vista(self.y, self.height); }
                            esci => { radice.focus(); }
                        }

                        if fuori-da-windows: Text {
                            text: "«GPU»: solo su Windows.";
                            wrap: word-wrap;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }
                    }
                }

                // ─── Claude ───
                if sezione == 4: claude := Scorrevole {
                    alto-contenuto: colonna-claude.preferred-height + 8px;

                    colonna-claude := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;

                        Etichetta {
                            height: 30px;
                            text: "CLAUDE CODE";
                        }

                        // RC-46: una card sola per Claude Code, con lo stato e le azioni di adesso
                        // (collega; da collegato scollega, e aggiorna se serve). «Collega» ha la tinta
                        // d'azione: è l'unica cosa da fare.
                        card-stato := CardRiga {
                            titolo: claude-stato;
                            descrizione: !claude-disponibile
                                ? "Il collegamento con le sessioni di Claude Code è solo per Windows; la lettura dei consumi via API funziona ovunque."
                                : claude-collegato
                                    ? "Le sessioni di Claude Code compaiono nella pillola, coi permessi da consentire. «Scollega» toglie da settings.json solo le voci di isola."
                                    : "Le sessioni di Claude Code compaiono nella pillola, coi permessi da consentire.";

                            HorizontalLayout {
                                spacing: 10px;

                                if claude-passo == 0 && claude-disponibile && claude-collegato: Bottone {
                                    testo: "Scollega";
                                    premuto => {
                                        claude-esito = "";
                                        claude-passo = 2;
                                    }
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            claude.porta-in-vista(card-stato.y, card-stato.height);
                                        }
                                    }
                                }

                                if claude-passo == 0 && claude-disponibile && (!claude-collegato || claude-da-aggiornare): Bottone {
                                    testo: claude-da-aggiornare ? "Aggiorna il collegamento" : "Collega Claude Code";
                                    tipo: TipoPulsante.azione;
                                    premuto => {
                                        claude-esito = "";
                                        root.claude-prepara();
                                    }
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            claude.porta-in-vista(card-stato.y, card-stato.height);
                                        }
                                    }
                                }
                            }
                        }

                        // L'anteprima di ciò che si scrive: nulla è scritto finché non si preme «Scrivi».
                        if claude-passo == 1: card-anteprima := Rectangle {
                            height: corpo-anteprima.preferred-height;
                            border-radius: Tema.raggio-xl;
                            background: Tema.card-fondo;
                            border-width: 1px;
                            border-color: Tema.vetro-bordo;
                            // Il fuoco parte da «Annulla»: Invio per sbaglio non scrive.
                            init => { annulla-claude.focus(); }
                            accessible-role: groupbox;
                            accessible-label: "Anteprima della scrittura in settings.json";

                            corpo-anteprima := VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "Così resteranno le voci di isola in settings.json";
                                    font-weight: 500;
                                    font-size: Tema.testo-medio;
                                    color: Tema.testo;
                                }

                                // RC-40: il percorso non ha spazi; a capo dove finisce la riga (non
                                // dopo «C:» da solo).
                                Text {
                                    text: claude-file;
                                    wrap: char-wrap;
                                    font-family: Tema.carattere-mono;
                                    font-size: Tema.testo-piccolo;
                                    color: Tema.testo-tenue;
                                }

                                // Il riquadro mono: scorre col mouse e, con il fuoco dentro, con le
                                // frecce. Basso abbastanza da lasciare in vista i pulsanti (RC-31).
                                Rectangle {
                                    height: 120px;
                                    border-radius: Tema.raggio-m;
                                    background: Tema.riquadro-fondo;
                                    border-width: 1px;
                                    border-color: Tema.vetro-bordo;
                                    clip: true;

                                    Flickable {
                                        content-width: max(self.width, anteprima-testo.preferred-width + 24px);
                                        content-height: max(self.height, anteprima-testo.preferred-height + 16px);

                                        anteprima-testo := TextInput {
                                            x: 12px;
                                            y: 8px;
                                            width: parent.content-width - 24px;
                                            height: parent.content-height - 16px;
                                            text: claude-anteprima;
                                            read-only: true;
                                            wrap: no-wrap;
                                            font-family: Tema.carattere-mono;
                                            font-size: Tema.testo-piccolo;
                                            color: Tema.testo;
                                            accessible-label: "Voci di isola come resteranno in settings.json";
                                        }
                                    }
                                }

                                if claude-avvisi != "": Text {
                                    text: claude-avvisi;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: Tema.caldo-1;
                                }

                                Text {
                                    text: "Il resto di settings.json resta com'è (la prima volta ne tengo una copia accanto). Le sessioni di Claude Code avviate dopo il collegamento lo useranno.";
                                    wrap: word-wrap;
                                    font-size: Tema.testo-piccolo;
                                    color: Tema.testo-tenue;
                                }

                                // In vista tutta la riga dei pulsanti: la sua posizione nella colonna è
                                // quella della card più la sua nella card (RC-31: prima si passava la
                                // posizione nella card, e la riga restava mezza sotto il bordo).
                                pulsanti-anteprima := HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    alignment: end;

                                    annulla-claude := Bottone {
                                        testo: "Annulla";
                                        premuto => { chiudi-claude(); }
                                        changed has-focus => {
                                            if (self.has-focus) {
                                                claude.porta-in-vista(card-anteprima.y + pulsanti-anteprima.y, pulsanti-anteprima.height + 16px);
                                            }
                                        }
                                    }

                                    Bottone {
                                        testo: "Scrivi in settings.json";
                                        tipo: TipoPulsante.azione;
                                        premuto => { root.claude-conferma(); }
                                        changed has-focus => {
                                            if (self.has-focus) {
                                                claude.porta-in-vista(card-anteprima.y + pulsanti-anteprima.y, pulsanti-anteprima.height + 16px);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // La conferma dello scollegamento: nomina ciò che succede.
                        if claude-passo == 2: card-scollega := Rectangle {
                            height: corpo-scollega.preferred-height;
                            border-radius: Tema.raggio-xl;
                            background: Tema.riquadro-pieno;
                            border-width: 1px;
                            border-color: Tema.pericolo-filo;
                            init => { annulla-scollega.focus(); }
                            accessible-role: groupbox;
                            accessible-label: "Conferma dello scollegamento da Claude Code";

                            corpo-scollega := VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                Text {
                                    text: "Togliere il collegamento con Claude Code?";
                                    font-weight: 500;
                                    font-size: Tema.testo-medio;
                                    color: Tema.testo;
                                }

                                Text {
                                    text: "Da settings.json escono solo le voci di isola (hook e barra di stato); il resto resta com'è.";
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: Tema.testo-tenue;
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    alignment: end;

                                    annulla-scollega := Bottone {
                                        testo: "Annulla";
                                        premuto => { chiudi-claude(); }
                                        changed has-focus => {
                                            if (self.has-focus) {
                                                claude.porta-in-vista(card-scollega.y, card-scollega.height);
                                            }
                                        }
                                    }

                                    Bottone {
                                        testo: "Scollega";
                                        tipo: TipoPulsante.pericolo;
                                        premuto => { root.claude-scollega(); }
                                        changed has-focus => {
                                            if (self.has-focus) {
                                                claude.porta-in-vista(card-scollega.y, card-scollega.height);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // La nota è di Claude Code: sta con il suo blocco, non in fondo alla sezione.
                        Text {
                            text: "Con isola chiusa Claude Code prosegue da solo: i permessi li decidi nel terminale.";
                            wrap: word-wrap;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }

                        if claude-esito != "": Text {
                            text: claude-esito;
                            wrap: word-wrap;
                            font-size: Tema.testo-corpo;
                            color: claude-esito-errore ? Tema.caldo-1 : Tema.testo-tenue;
                        }

                        // Chiave da amministratore: consumi e dati dell'organizzazione, solo letture.
                        // Un blocco a sé (RC-46): funziona anche senza collegare Claude Code.
                        Etichetta {
                            height: 30px;
                            text: "CHIAVE DA AMMINISTRATORE";
                        }

                        card-api := Rectangle {
                            height: colonna-api.preferred-height;
                            border-radius: Tema.raggio-xl;
                            background: Tema.card-fondo;
                            border-width: 1px;
                            border-color: Tema.vetro-bordo;

                            colonna-api := VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 14px;
                                spacing: 8px;

                                Text {
                                    text: "Crea una chiave da amministratore con scadenza nella Console (Impostazioni › Admin keys). Serve solo per leggere consumi e dati dell'organizzazione: non modifica nulla.";
                                    wrap: word-wrap;
                                    font-size: Tema.testo-piccolo;
                                    color: Tema.testo-tenue;
                                }

                                if !api-presente: Campo {
                                    etichetta: "Chiave";
                                    larghezza-etichetta: etichette-claude;
                                    suggerimento: "sk-ant-admin01-…";
                                    nome-accessibile: "Chiave da amministratore";
                                    password: true;
                                    testo <=> api-campo;
                                    invio => { root.api-salva(api-campo); }
                                }

                                if api-presente: Text {
                                    text: "•••• " + api-ultime;
                                    font-size: Tema.testo-medio;
                                    color: Tema.testo;
                                    accessible-role: text;
                                    accessible-label: "Chiave salvata, finisce con " + api-ultime;
                                }

                                // Con la conferma di «Togli» aperta i pulsanti lasciano il posto a lei.
                                if !api-conferma-togli: HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    alignment: start;

                                    if !api-presente: Bottone {
                                        testo: "Salva";
                                        tipo: TipoPulsante.azione;
                                        premuto => { root.api-salva(api-campo); }
                                    }

                                    Bottone {
                                        testo: api-occupato ? "Provo…" : "Prova";
                                        premuto => {
                                            if (!api-occupato) {
                                                root.api-prova(api-campo);
                                            }
                                        }
                                    }

                                    if api-presente: Bottone {
                                        testo: "Togli";
                                        premuto => { api-conferma-togli = true; }
                                    }

                                    // Le schede delle API anche da qui, appena c'è la chiave (RC-46).
                                    if api-presente: Bottone {
                                        testo: "Dettagli delle API";
                                        tipo: TipoPulsante.azione;
                                        premuto => { root.api-dettagli(); }
                                    }
                                }

                                // RC-33: la conferma di «Togli», come quella di «Scollega»: una chiave
                                // da amministratore la Console la mostra una volta sola.
                                if api-conferma-togli: conferma-api := Rectangle {
                                    height: corpo-togli.preferred-height;
                                    border-radius: Tema.raggio-l;
                                    background: Tema.riquadro-pieno;
                                    border-width: 1px;
                                    border-color: Tema.pericolo-filo;
                                    init => { annulla-togli.focus(); }
                                    accessible-role: groupbox;
                                    accessible-label: "Conferma: togliere la chiave da amministratore";

                                    corpo-togli := VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;

                                        Text {
                                            text: "Togliere la chiave da amministratore?";
                                            font-weight: 500;
                                            font-size: Tema.testo-medio;
                                            color: Tema.testo;
                                        }

                                        Text {
                                            text: "Esce dal portachiavi e le letture si fermano. Per rimetterla serve la chiave intera, che la Console mostra una volta sola.";
                                            wrap: word-wrap;
                                            font-size: Tema.testo-corpo;
                                            color: Tema.testo-tenue;
                                        }

                                        HorizontalLayout {
                                            height: 30px;
                                            spacing: 10px;
                                            alignment: end;

                                            annulla-togli := Bottone {
                                                testo: "Annulla";
                                                premuto => { chiudi-togli(); }
                                                changed has-focus => {
                                                    if (self.has-focus) {
                                                        claude.porta-in-vista(card-api.y + conferma-api.y, conferma-api.height);
                                                    }
                                                }
                                            }

                                            conferma-togli := Bottone {
                                                testo: "Togli";
                                                tipo: TipoPulsante.pericolo;
                                                premuto => {
                                                    chiudi-togli();
                                                    root.api-togli();
                                                }
                                                changed has-focus => {
                                                    if (self.has-focus) {
                                                        claude.porta-in-vista(card-api.y + conferma-api.y, conferma-api.height);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if api-esito != "": Text {
                                    text: api-esito;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: api-esito-errore ? Tema.caldo-1 : Tema.testo-tenue;
                                }

                                if api-stato != "": Text {
                                    text: api-stato;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-piccolo;
                                    color: Tema.testo-tenue;
                                }
                            }
                        }

                        // Avvisi: una sola volta per finestra di limite, per gradino di spesa e per mese.
                        Etichetta {
                            height: 30px;
                            text: "AVVISI";
                        }

                        Rectangle {
                            height: colonna-avvisi.preferred-height;
                            border-radius: Tema.raggio-xl;
                            background: Tema.card-fondo;
                            border-width: 1px;
                            border-color: Tema.vetro-bordo;

                            colonna-avvisi := VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 14px;
                                spacing: 8px;

                                Text {
                                    text: "Isola ti avvisa una sola volta quando i limiti dell'abbonamento o la spesa delle API superano questi valori. Lascia vuota la soglia di spesa per non avere l'avviso.";
                                    wrap: word-wrap;
                                    font-size: Tema.testo-piccolo;
                                    color: Tema.testo-tenue;
                                }

                                Campo {
                                    etichetta: "Avvisa quando un limite supera (%)";
                                    larghezza-etichetta: etichette-claude;
                                    suggerimento: "80";
                                    testo: root.soglia-limite;
                                    errore: errore-soglia-limite;
                                    invio => { errore-soglia-limite = root.soglia-limite-scritta(self.testo); }
                                    lasciato => { errore-soglia-limite = root.soglia-limite-scritta(self.testo); }
                                }

                                if errore-soglia-limite != "": Text {
                                    text: errore-soglia-limite;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: Tema.caldo-1;
                                    accessible-role: none;
                                }

                                Campo {
                                    etichetta: "Soglia di spesa mensile ($)";
                                    larghezza-etichetta: etichette-claude;
                                    suggerimento: "Per esempio 250";
                                    testo: root.soglia-spesa;
                                    errore: errore-soglia-spesa;
                                    invio => { errore-soglia-spesa = root.soglia-spesa-scritta(self.testo); }
                                    lasciato => { errore-soglia-spesa = root.soglia-spesa-scritta(self.testo); }
                                }

                                if errore-soglia-spesa != "": Text {
                                    text: errore-soglia-spesa;
                                    wrap: word-wrap;
                                    font-size: Tema.testo-corpo;
                                    color: Tema.caldo-1;
                                    accessible-role: none;
                                }
                            }
                        }

                    }
                }

                // ─── Sistema ───
                if sezione == 5: VerticalLayout {
                    alignment: start;
                    spacing: 12px;

                    Etichetta {
                        height: 32px;
                        text: "SISTEMA";
                    }

                    CardRiga {
                        titolo: "Avvia con il sistema";
                        descrizione: "Apre l'assistente quando accedi al computer.";

                        Interruttore {
                            nome: "Avvia con il sistema";
                            acceso: avvio-con-sistema;
                            commutato => { cambia-avvio-ora(); }
                        }
                    }

                    if icona-barra-disponibile: CardRiga {
                        titolo: "Mostra icona nella barra";
                        descrizione: "L'icona vicino all'orologio, con lo stesso menu del «…» del pannello.";

                        Interruttore {
                            nome: "Mostra icona nella barra";
                            acceso: icona-barra;
                            commutato => { cambia-icona-barra-ora(); }
                        }
                    }

                    // Fuori da Windows (niente menu né icona nella barra) l'unico modo per uscire.
                    if fuori-da-windows: CardRiga {
                        titolo: "Esci dall'assistente";
                        descrizione: "Chiude pillola e pannello. Per riaprirlo, avvialo di nuovo.";

                        Bottone {
                            testo: "Esci";
                            premuto => { root.esci(); }
                        }
                    }

                    if config-non-salvata: Text {
                        text: "Le impostazioni non sono state salvate su disco: il dettaglio è in Informazioni.";
                        wrap: word-wrap;
                        font-size: Tema.testo-corpo;
                        color: Tema.caldo-1;
                    }
                }

                // ─── Informazioni ───
                if sezione == 6: VerticalLayout {
                    alignment: start;

                    Text {
                        height: 30px;
                        text: "ItsyHome assistente · versione " + versione;
                        vertical-alignment: center;
                        font-weight: 500;
                        font-size: Tema.testo-titolo;
                        color: Tema.testo;
                    }

                    Text {
                        height: 22px;
                        text: "© Paolo Bets";
                        vertical-alignment: center;
                        font-size: Tema.testo-corpo;
                        color: Tema.testo-ora;
                    }

                    // Attribuzione richiesta dalla licenza Slint royalty-free 2.0, punto 2(a)
                    // (https://github.com/slint-ui/slint/blob/master/LICENSES/LicenseRef-Slint-Royalty-free-2.0.md):
                    // «Display the `AboutSlint` widget in an "About" screen or dialog that is
                    // accessible from the top level menu of the Application.» Il testo non dice se
                    // il widget si possa rimpicciolire o scurire (R1-25): resta com'è.
                    // Largo quanto il logo (alto 48, circa 105 di larghezza) più 12 di margine interno
                    // per lato, e spostato indietro di quel margine: il logo parte allineato a
                    // «© Paolo Bets».
                    Rectangle {
                        height: 106px;

                        AboutSlint {
                            x: -12px;
                            y: 6px;
                            width: 130px;
                            height: 96px;
                        }
                    }

                    Etichetta {
                        height: 30px;
                        text: "DETTAGLI TECNICI";
                    }

                    // Nessun errore: una frase nel carattere normale, in alto (non a metà della finestra).
                    if dettagli-tecnici == "": Text {
                        text: "Nessun errore registrato.";
                        font-size: Tema.testo-corpo;
                        color: Tema.testo-tenue;
                    }

                    if dettagli-tecnici != "": Scorrevole {
                        vertical-stretch: 1;
                        alto-contenuto: dettagli.preferred-height;

                        dettagli := Text {
                            y: 0;
                            width: parent.width;
                            height: self.preferred-height;
                            text: dettagli-tecnici;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            font-family: Tema.carattere-mono;
                            font-size: Tema.testo-piccolo;
                            color: Tema.testo-tenue;
                        }
                    }
                }
            }
        }
    }
}
