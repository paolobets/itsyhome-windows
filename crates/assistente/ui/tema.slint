// Tema condiviso: i token del ridisegno (nero, grigi pieni, bianco = azione) e i caratteri
// (Inter e JetBrains Mono NL — SIL OFL). Unico posto dei colori: fuori da questo file nessun
// letterale di colore (`#…`, `rgb(…)`, `rgba(…)`), solo token di ruolo; lo controlla un test
// (`ui_senza_colori_a_mano`). Una tinta cambiata qui cambia ovunque.
// Solo i pesi 500 e 700 di Inter e il 500 del mono sono incorporati: ogni finestra parte da
// `default-font-weight: 500`, il 700 si chiede dove serve.
import "../assets/font/Inter-Medium.ttf";
import "../assets/font/Inter-Bold.ttf";
import "../assets/font/JetBrainsMonoNL-Medium.ttf";
import { LivelloUi, TonoModuloUi } from "voci.slint";

// Movimento ridotto (impostazione di Windows «Effetti di animazione», scritta da Rust in ogni
// finestra: vedi `sistema::movimento`). Vero: niente pulsazioni né scivolamenti, solo cambi
// istantanei o dissolvenze brevi.
export global Movimento {
    in property <bool> ridotto: false;
}

export global Tema {
    // ─── Grigi: il nero è il fondo, i grigi sono superfici piene (niente trasparenze) ───
    // Fondo di ogni finestra e dell'isola: nero vero, come TwoCode.
    out property <color> nero: #000000;
    // Carta: carte, righe, campi (sul nero si leggono con il filo accanto).
    out property <color> g1: #0f0f11;
    // Riga scelta o sotto il mouse.
    out property <color> g2: #18181b;
    // Pulsante secondario.
    out property <color> g3: #242428;
    // Pulsante secondario al passaggio del mouse.
    out property <color> g4: #303035;
    // Filo fra le superfici: bordo di una carta, riga di separazione.
    out property <color> filo: #232327;
    // Bordo di un controllo (campo, casella): almeno 3:1 sulla carta, per vederne il contorno.
    out property <color> bordo-ctl: #74747c;

    // ─── Testi: tre gradini, tutti sopra 4,5:1 sul nero e sulle carte ───
    out property <color> testo: #ffffff;
    // Secondario: ora, etichette, dettagli (sostituisce `testo-ora` e `testo-etichetta`).
    out property <color> testo-2: #c4c4ca;
    // Terziario: stati, suggerimenti.
    out property <color> testo-tenue: #9b9ba3;
    // Azione primaria: bianco con testo nero, ovunque; il grigio pieno è la secondaria.
    out property <color> primario: #ffffff;
    out property <color> testo-su-primario: #000000;
    // Il primario al passaggio del mouse: un filo più scuro, ancora ≥ 4,5:1 col testo nero.
    out property <color> primario-sopra: #e4e4e7;

    // ─── Toni: dicono lo stato, sempre accompagnati dalla parola o dalla forma ───
    // I sei colori dei petali (i colori dei cerchi dei collegamenti) e l'aura calda.
    out property <color> petalo-1: #c084fc;
    out property <color> petalo-2: #818cf8;
    out property <color> petalo-3: #60a5fa;
    out property <color> petalo-4: #22d3ee;
    out property <color> petalo-5: #2dd4bf;
    out property <color> petalo-6: #e879f9;
    out property <color> caldo-1: #fbbf24;
    out property <color> caldo-2: #fb923c;
    out property <color> caldo-3: #f472b6;
    out property <color> caldo-4: #e879f9;
    // Al lavoro (arancio), ti aspetta (ambra), guarda (blu), fatto (verde acqua), errore (rosa).
    out property <color> attivo: caldo-2;
    out property <color> aspetta: caldo-1;
    out property <color> guarda: petalo-3;
    out property <color> fatto: petalo-5;
    out property <color> errore: caldo-3;
    // Costo in dollari (verde acqua più chiaro del «fatto»).
    out property <color> dollaro: #7ce4d7;
    // La luce che sale dal basso nella pillola e nell'isola: le stesse tinte dei toni, ma più
    // scure, perché sul nero la radiale non abbagli.
    out property <color> luce-attivo: rgb(251, 137, 43);
    out property <color> luce-aspetta: rgb(220, 160, 4);
    out property <color> luce-guarda: rgb(17, 121, 248);
    // Gli occhi hanno la tinta dello stato, più chiara della luce (il bagliore è il loro colore).
    out property <color> occhio-lavora: #fcb67d;
    out property <color> occhio-chiede: #fcd56e;
    out property <color> occhio-guarda: #a2cafc;
    // Occhi di chi non ha niente da dire: bianchi, col bagliore del loro colore.
    out property <color> occhio: #ffffff;
    // L'occhio che dorme (trattino): più tenue.
    out property <color> occhio-dorme: occhio.with-alpha(0.6);
    out property <color> bagliore-occhio: occhio;
    // Velo sopra il corpo quando una voce si prende la scena: nero all'82 %.
    out property <color> velo: nero.with-alpha(0.82);

    // ─── Superfici dei componenti (derivano dai grigi: una sola regola per tutta l'app) ───
    out property <color> icona: testo-2;
    out property <color> icona-attiva: testo;
    // Icona di un dispositivo spento: dà almeno 3:1 sul nero e sulle carte.
    out property <color> icona-spenta: bordo-ctl;
    // Suggerimento di un campo vuoto: più tenue del testo vero (testo bianco), non sembra un
    // valore già scritto.
    out property <color> segnaposto: testo-tenue;
    // Traccia degli archi e delle barre: grigio pieno, la scala si legge anche con un valore piccolo.
    out property <color> traccia: g4;
    out property <color> vetro-bordo: filo;
    out property <color> capsula: g1;
    out property <color> scheda-sopra: g2;
    out property <color> scheda-attiva: g3;
    // Fondo delle card (voci chiuse, righe delle Impostazioni, card tenui della Casa) e dei
    // riquadri (voce espansa, casella di un campo): la carta. La sfumatura in fondo al testo
    // lungo svanisce in lei (`g1` con trasparenza 0).
    out property <color> card-fondo: g1;
    out property <color> riquadro-fondo: g1;

    // Pulsanti (un solo stile, vedi componenti.slint): neutro (grigio pieno), azione (bianco con
    // testo nero), pericolo (rosa dell'errore).
    out property <color> neutro-fondo: g3;
    out property <color> neutro-sopra: g4;
    out property <color> azione-fondo: primario;
    out property <color> azione-sopra: primario-sopra;
    out property <color> azione-bordo: primario;
    out property <color> pericolo-fondo: errore.with-alpha(0.22);
    out property <color> pericolo-sopra: errore.with-alpha(0.34);
    out property <color> pericolo-bordo: errore.with-alpha(0.55);
    // Riga in attesa di conferma della rimozione (Impostazioni).
    out property <color> pericolo-velo: errore.with-alpha(0.08);
    out property <color> pericolo-filo: errore.with-alpha(0.35);
    // Interruttore delle Impostazioni: acceso = primario (bianco) col pomello nero, spento grigio.
    out property <color> interruttore-acceso: primario;
    out property <color> interruttore-spento: g4;
    out property <color> pomello-acceso: testo-su-primario;
    // Testo selezionato in un campo.
    out property <color> selezione: guarda.with-alpha(0.45);

    // Stato dei dispositivi: il colore compare solo quando sono accesi.
    out property <color> luce-accesa: #fcd34d;
    out property <color> presa-accesa: #5eead4;
    // Card di una luce o di una presa accesa: bordo e fondo nella loro tinta.
    out property <color> luce-bordo: rgba(253, 230, 138, 0.35);
    out property <brush> luce-card: @linear-gradient(160deg, rgba(253, 230, 138, 0.28) 0%, rgba(251, 191, 36, 0.10) 100%);
    out property <color> presa-bordo: rgba(94, 234, 212, 0.32);
    out property <brush> presa-card: @linear-gradient(160deg, rgba(94, 234, 212, 0.24) 0%, rgba(45, 212, 191, 0.08) 100%);
    // Puntini dei layout: quello spento.
    out property <color> puntino: bordo-ctl;
    // Anello del fuoco da tastiera: 2 px bianchi più 1 px nero fuori (come quello di Windows),
    // visibile sul nero e sul bianco del primario.
    out property <color> anello: #ffffff;
    out property <color> anello-esterno: #000000;
    // Suggerimento (tooltip) delle icone del dock.
    out property <color> suggerimento: g2;
    // Menu «⋯» del pannello: fondo pieno come i suggerimenti (si legge sopra qualunque vista) e
    // ombra che lo stacca dal corpo, quasi nero. Le righe si staccano dal fondo a gradini:
    // fondo g2 < riga sotto il mouse g3 < riga evidenziata g4 (lo controlla un test).
    out property <color> menu-fondo: suggerimento;
    out property <color> menu-sopra: g3;
    out property <color> menu-scelta: g4;
    out property <color> menu-ombra: rgba(0, 0, 0, 0.55);

    // Livelli dell'attenzione (riga «In attesa», puntino e bordo della pillola): stessa tinta dei
    // toni (spec §5.2): bloccante = aspetta (ambra), attenzione e informazione = guarda (blu). Il
    // colore è sempre accompagnato dalla parola del livello o dalla forma.
    out property <color> bloccante: aspetta;
    out property <color> attenzione: guarda;
    out property <color> informazione: guarda;

    // Riquadri Wi-Fi e Bluetooth accesi nella vista PC (M2, Task 8): fondo e bordo dal tono
    // «guarda», icona piena. Il testo resta `testo` (contrasto invariato sul fondo tenue).
    out property <color> radio-acceso: guarda;
    out property <color> radio-acceso-fondo: radio-acceso.with-alpha(0.20);
    out property <color> radio-acceso-bordo: radio-acceso.with-alpha(0.50);

    // Glifo della batteria collegata all'alimentatore: il verde acqua del «fatto».
    out property <color> batteria-carica: fatto;

    // `nessuno` (linea della ritirata senza voci in attesa): grigio neutro.
    public pure function colore-livello(livello: LivelloUi) -> color {
        if (livello == LivelloUi.bloccante) { return bloccante; }
        if (livello == LivelloUi.attenzione) { return attenzione; }
        if (livello == LivelloUi.informazione) { return informazione; }
        return testo-tenue;
    }

    // Il colore di un tono di modulo (capsula, segni): i cinque toni coi loro colori; calmo col
    // testo secondario, vuoto e fermo col terziario (tenue: lo dice anche la parola). Una carta
    // dice «Fatto» solo finché non è visto: blu `petalo-3` (spec §5.2, «fatto non visto»); il verde
    // acqua `fatto` è del fatto visto, che sulla carta torna calmo.
    public pure function colore-tono(t: TonoModuloUi) -> color {
        if (t == TonoModuloUi.attivo) { return attivo; }
        if (t == TonoModuloUi.aspetta) { return aspetta; }
        if (t == TonoModuloUi.guarda) { return guarda; }
        if (t == TonoModuloUi.fatto) { return petalo-3; }
        if (t == TonoModuloUi.errore) { return errore; }
        if (t == TonoModuloUi.calmo) { return testo-2; }
        return testo-tenue;
    }

    // La luce dal basso di un tono (spec §13.3): solo al lavoro, guarda e aspetta (`Tono::luce`);
    // gli altri toni non hanno luce (trasparente).
    public pure function luce-tono(t: TonoModuloUi) -> color {
        if (t == TonoModuloUi.attivo) { return luce-attivo; }
        if (t == TonoModuloUi.aspetta) { return luce-aspetta; }
        if (t == TonoModuloUi.guarda) { return luce-guarda; }
        return transparent;
    }

    // I colori dei cerchi dei collegamenti (iniziale del nome): sei toni, i petali (mai i caldi:
    // quelli dicono avviso o errore), scelti dal nome in Rust (`collegamenti::tono`). Tutti chiari: la lettera in `nero`
    // ci sta sopra con più di 4,5:1 (lo controlla un test, come il numero di toni).
    public pure function colore-collegamento(tono: int) -> color {
        if (tono == 0) { return petalo-1; }
        if (tono == 1) { return petalo-2; }
        if (tono == 2) { return petalo-3; }
        if (tono == 3) { return petalo-4; }
        if (tono == 4) { return petalo-5; }
        return petalo-6;
    }

    // L'arco (di un limite, della spesa) diventa caldo ALLA soglia o sopra (frazione 0..1, come le voci
    // d'avviso): quella dell'utente per i limiti, l'80 % della soglia di spesa, l'85 % per il PC.
    public pure function oltre-soglia(frazione: float, soglia: float) -> bool {
        return frazione >= soglia;
    }

    // ─── Scale (FE11): raggi e corpi del testo, pochi valori e sempre gli stessi ───
    // Raggi: pulsanti della pillola e suggerimenti 8, pulsanti 10, voci e card piccole 12, card
    // e riquadri 16, il pannello 22. Le forme a capsula usano metà dell'altezza.
    out property <length> raggio-s: 8px;
    out property <length> raggio-m: 10px;
    out property <length> raggio-l: 12px;
    out property <length> raggio-xl: 16px;
    out property <length> raggio-pannello: 22px;
    // Angoli bassi dell'isola (TwoCode): proporzionali all'altezza, 34.
    out property <length> raggio-isola: 34px;
    // Corpi del testo: etichette e righe piccole 12, testo 13, campi e nomi 14, titoli 15,
    // frecce e titolo di un elenco vuoto 16, vista vuota di un'app 17, intestazione di finestra
    // 20, ora grande 68.
    out property <length> testo-piccolo: 12px;
    out property <length> testo-corpo: 13px;
    out property <length> testo-medio: 14px;
    out property <length> testo-titolo: 15px;
    out property <length> testo-sottotitolo: 16px;
    out property <length> testo-vuoto: 17px;
    out property <length> testo-intestazione: 20px;
    out property <length> testo-ora-grande: 68px;
    // Etichetta mono maiuscola (nome della scheda della barra e della carta): JetBrains Mono NL
    // 500, 11 px, tracking .07em. Gli stessi valori di `Stile::Etichetta` in `moduli/misura.rs`
    // (che ne misura la larghezza) e di `MisuraTesto`: chi la disegna usa questi token, così
    // misura e disegno non si separano. Non è il componente `Etichetta` (12 px, delle sezioni).
    out property <length> etichetta-corpo: 11px;
    out property <length> etichetta-spaziatura: 0.77px;
    // Mono maiuscolo della riga alta (data e meteo), 12 px: tracking .07em.
    out property <length> riga-alta-spaziatura: 0.84px;

    // ─── Pixel fisici (FE27) ───
    // Scala della finestra (1, 1,25, 1,75…): la scrive Rust per ogni finestra, all'avvio e quando
    // cambia (monitor o DPI). `sul-pixel` arrotonda uno spessore al pixel fisico più vicino (almeno
    // uno): un filo di 1,5 px a 1,75 diventa 3 px fisici netti invece di 2,625 sfocati. Solo per
    // spessori da 1 px in su: uno più sottile diventerebbe 1 px pieno anche a scala 1.
    in property <float> scala: 1;
    public pure function sul-pixel(spessore: length) -> length {
        return max(1, round(spessore / 1px * scala)) / scala * 1px;
    }

    // Inter per le parole; JetBrains Mono NL (la versione senza legature) per numeri, ore,
    // durate ed etichette maiuscole, con spaziatura .07em.
    out property <string> carattere: "Inter";
    out property <string> carattere-mono: "JetBrains Mono NL";
}
