// Tema condiviso: colori del marchio HIRIS e caratteri (Inter Tight, JetBrains Mono — SIL OFL).
import "../assets/font/InterTight-Regular.ttf";
import "../assets/font/InterTight-Medium.ttf";
import "../assets/font/JetBrainsMono-Regular.ttf";

// Movimento ridotto (impostazione di Windows «Effetti di animazione», scritta da Rust in ogni
// finestra: vedi `sistema::movimento`). Vero: niente pulsazioni né scivolamenti, solo cambi
// istantanei o dissolvenze brevi.
export global Movimento {
    in property <bool> ridotto: false;
}

export global Tema {
    // I sei colori dei petali, nell'ordine dell'aura.
    out property <color> petalo-1: #c084fc;
    out property <color> petalo-2: #818cf8;
    out property <color> petalo-3: #60a5fa;
    out property <color> petalo-4: #22d3ee;
    out property <color> petalo-5: #2dd4bf;
    out property <color> petalo-6: #e879f9;

    // Aura calda di "ti cerca".
    out property <color> caldo-1: #fbbf24;
    out property <color> caldo-2: #fb923c;
    out property <color> caldo-3: #f472b6;
    out property <color> caldo-4: #e879f9;

    out property <color> fondo-alto: #2a0a4e;
    out property <color> fondo-basso: #0a0015;
    out property <color> corpo: #07030f;
    out property <color> occhio: #f5efff;
    out property <color> bagliore-occhio: #c084fc;
    out property <color> testo: #f3eefc;
    out property <color> icona: rgba(236, 230, 250, 0.62);
    out property <color> icona-attiva: #ffffff;

    // Pannello: testi secondari, quadranti spenti, vetro leggero di schede e card.
    out property <color> testo-ora: #d9d0ee;
    out property <color> testo-tenue: #a49cb8;
    out property <color> testo-etichetta: #cfc6e6;
    // Traccia degli archi e delle barre: circa 1,9:1 sulle card, la scala si legge anche con
    // un valore piccolo (#24183a era 1,15:1).
    out property <color> traccia: rgba(236, 230, 250, 0.16);
    out property <color> vetro-bordo: rgba(255, 255, 255, 0.08);
    out property <color> capsula: rgba(255, 255, 255, 0.035);
    out property <color> scheda-sopra: rgba(255, 255, 255, 0.06);
    out property <color> scheda-attiva: rgba(255, 255, 255, 0.09);

    // Stato dei dispositivi: il colore compare solo quando sono accesi.
    out property <color> luce-accesa: #fcd34d;
    out property <color> presa-accesa: #5eead4;
    // Icona di un dispositivo spento: .45 dà almeno 3:1 sul fondo e sulle card (.32 era 2,3:1).
    out property <color> icona-spenta: rgba(236, 230, 250, 0.45);
    // Puntini dei layout: quello spento.
    out property <color> puntino: rgba(236, 230, 250, 0.45);
    // Anello del fuoco da tastiera (2 px, a 2 px dall'elemento).
    out property <color> anello: #f5efff;
    // Suggerimento (tooltip) delle icone del dock.
    out property <color> suggerimento: #1b1428;

    // Livelli dell'attenzione (riga «In attesa», puntino e bordo della pillola). Il colore è
    // sempre accompagnato dalla parola del livello o dalla forma (bloccante: pillola ferma).
    out property <color> bloccante: #f87171;
    out property <color> attenzione: #fbbf24;
    out property <color> informazione: #60a5fa;

    public pure function colore-livello(livello: string) -> color {
        if (livello == "bloccante") { return bloccante; }
        if (livello == "attenzione") { return attenzione; }
        return informazione;
    }

    out property <string> carattere: "Inter Tight";
    out property <string> carattere-mono: "JetBrains Mono";
}
