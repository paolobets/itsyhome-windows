// Tema condiviso: colori del marchio HIRIS e caratteri (Inter Tight, JetBrains Mono — SIL OFL).
// Unico posto dei colori: fuori da questo file nessun letterale di colore (`#…`, `rgb(…)`,
// `rgba(…)`), solo token di ruolo; lo controlla un test (`ui_senza_colori_a_mano`). Una tinta
// cambiata qui cambia ovunque.
import "../assets/font/InterTight-Regular.ttf";
import "../assets/font/InterTight-Medium.ttf";
import "../assets/font/JetBrainsMono-Regular.ttf";
import { LivelloUi } from "voci.slint";

// Movimento ridotto (impostazione di Windows «Effetti di animazione», scritta da Rust in ogni
// finestra: vedi `sistema::movimento`). Vero: niente pulsazioni né scivolamenti, solo cambi
// istantanei o dissolvenze brevi.
export global Movimento {
    in property <bool> ridotto: false;
}

export global Tema {
    // I sei colori dei petali, nell'ordine dell'aura.
    out property <color> petalo-1: #c084fc;
    out property <color> petalo-2: #818cf8;
    out property <color> petalo-3: #60a5fa;
    out property <color> petalo-4: #22d3ee;
    out property <color> petalo-5: #2dd4bf;
    out property <color> petalo-6: #e879f9;
    // I petali in fila (bordo del pannello, filo delle Impostazioni e della cornice).
    out property <brush> petali: @linear-gradient(90deg, petalo-1 0%, petalo-2 20%, petalo-3 40%, petalo-4 60%, petalo-5 80%, petalo-6 100%);

    // Aura calda di "ti cerca".
    out property <color> caldo-1: #fbbf24;
    out property <color> caldo-2: #fb923c;
    out property <color> caldo-3: #f472b6;
    out property <color> caldo-4: #e879f9;

    out property <color> fondo-alto: #2a0a4e;
    out property <color> fondo-basso: #0a0015;
    // Fondo delle finestre (Impostazioni, cornice): dal viola al quasi nero.
    out property <brush> fondo-finestra: @linear-gradient(160deg, fondo-alto 0%, fondo-basso 55%);
    out property <color> corpo: #07030f;
    out property <color> occhio: #f5efff;
    // L'occhio che dorme (trattino): più tenue.
    out property <color> occhio-dorme: occhio.with-alpha(0.6);
    out property <color> bagliore-occhio: #c084fc;
    out property <color> testo: #f3eefc;
    out property <color> icona: rgba(236, 230, 250, 0.62);
    out property <color> icona-attiva: #ffffff;

    // Pannello: testi secondari, quadranti spenti, vetro leggero di schede e card.
    out property <color> testo-ora: #d9d0ee;
    out property <color> testo-tenue: #a49cb8;
    out property <color> testo-etichetta: #cfc6e6;
    // Suggerimento di un campo vuoto: più tenue del testo vero (circa 4,5:1 contro 15:1), non
    // sembra un valore già scritto.
    out property <color> segnaposto: rgba(236, 230, 250, 0.40);
    // Traccia degli archi e delle barre: circa 1,9:1 sulle card, la scala si legge anche con
    // un valore piccolo (#24183a era 1,15:1).
    out property <color> traccia: rgba(236, 230, 250, 0.16);
    out property <color> vetro-bordo: rgba(255, 255, 255, 0.08);
    out property <color> capsula: rgba(255, 255, 255, 0.035);
    out property <color> scheda-sopra: rgba(255, 255, 255, 0.06);
    out property <color> scheda-attiva: rgba(255, 255, 255, 0.09);
    // Fondo delle card (voci chiuse, righe delle Impostazioni, card tenui della Casa).
    out property <color> card-fondo: rgba(255, 255, 255, 0.04);
    // Fondo di un riquadro più chiaro (voce espansa, casella di un campo).
    out property <color> riquadro-fondo: rgba(255, 255, 255, 0.05);
    // Il colore pieno del riquadro sul corpo del pannello (corpo + bianco al 5%): la sfumatura in
    // fondo al testo lungo svanisce in questo.
    out property <color> riquadro-pieno: #130f1b;
    out property <color> riquadro-svanito: riquadro-pieno.with-alpha(0);
    // Card "vetro" dei layout: riflesso appena accennato (e un po' di più sotto il mouse).
    out property <brush> card-vetro: @linear-gradient(160deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 100%);
    out property <brush> card-vetro-sopra: @linear-gradient(160deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.04) 100%);

    // Pulsanti (un solo stile, vedi componenti.slint): neutro, azione (verde acqua), pericolo.
    out property <color> neutro-fondo: rgba(255, 255, 255, 0.09);
    out property <color> neutro-sopra: rgba(255, 255, 255, 0.16);
    out property <color> azione-fondo: petalo-5.with-alpha(0.20);
    out property <color> azione-sopra: petalo-5.with-alpha(0.30);
    // Il bordo del primario: se ne vede il contorno (1,4:1 contro 1,2:1 del neutro).
    out property <color> azione-bordo: petalo-5.with-alpha(0.45);
    out property <color> pericolo-fondo: bloccante.with-alpha(0.22);
    out property <color> pericolo-sopra: bloccante.with-alpha(0.34);
    out property <color> pericolo-bordo: bloccante.with-alpha(0.55);
    // Riga in attesa di conferma della rimozione (Impostazioni).
    out property <color> pericolo-velo: bloccante.with-alpha(0.08);
    out property <color> pericolo-filo: bloccante.with-alpha(0.35);
    // Interruttore delle Impostazioni.
    out property <color> interruttore-acceso: petalo-5.with-alpha(0.55);
    out property <color> interruttore-spento: rgba(255, 255, 255, 0.14);
    out property <color> pomello-acceso: #ffffff;
    // Testo selezionato in un campo.
    out property <color> selezione: petalo-2.with-alpha(0.45);

    // Bagliori del fondo del pannello (indaco in alto a sinistra, verde acqua in basso a destra).
    out property <color> bagliore-indaco: petalo-2.with-alpha(0.10);
    out property <color> bagliore-acqua: petalo-5.with-alpha(0.07);
    // Ora grande del layout Orologio.
    out property <brush> ora-grande: @linear-gradient(90deg, #e9d5ff 0%, #a5b4fc 50%, #67e8f9 100%);

    // Stato dei dispositivi: il colore compare solo quando sono accesi.
    out property <color> luce-accesa: #fcd34d;
    out property <color> presa-accesa: #5eead4;
    // Card di una luce o di una presa accesa: bordo e fondo nella loro tinta.
    out property <color> luce-bordo: rgba(253, 230, 138, 0.35);
    out property <brush> luce-card: @linear-gradient(160deg, rgba(253, 230, 138, 0.28) 0%, rgba(251, 191, 36, 0.10) 100%);
    out property <color> presa-bordo: rgba(94, 234, 212, 0.32);
    out property <brush> presa-card: @linear-gradient(160deg, rgba(94, 234, 212, 0.24) 0%, rgba(45, 212, 191, 0.08) 100%);
    // Icona di un dispositivo spento: .45 dà almeno 3:1 sul fondo e sulle card (.32 era 2,3:1).
    out property <color> icona-spenta: rgba(236, 230, 250, 0.45);
    // Puntini dei layout: quello spento.
    out property <color> puntino: rgba(236, 230, 250, 0.45);
    // Anello del fuoco da tastiera (2 px, a 2 px dall'elemento).
    out property <color> anello: #f5efff;
    // Suggerimento (tooltip) delle icone del dock.
    out property <color> suggerimento: #1b1428;
    // Menu «⋯» del pannello (Task 8): fondo pieno come i suggerimenti (si legge sopra qualunque
    // vista) e ombra che lo stacca dal corpo, quasi nero.
    out property <color> menu-fondo: suggerimento;
    out property <color> menu-ombra: rgba(0, 0, 0, 0.55);

    // Livelli dell'attenzione (riga «In attesa», puntino e bordo della pillola). Il colore è
    // sempre accompagnato dalla parola del livello o dalla forma (bloccante: pillola ferma).
    out property <color> bloccante: #f87171;
    out property <color> attenzione: #fbbf24;
    out property <color> informazione: #60a5fa;

    // Riquadri Wi-Fi e Bluetooth accesi nella vista PC (M2, Task 8): fondo e bordo dal petalo 3,
    // icona piena. Il testo resta `testo` (contrasto invariato sul fondo tenue).
    out property <color> radio-acceso: petalo-3;
    out property <color> radio-acceso-fondo: radio-acceso.with-alpha(0.20);
    out property <color> radio-acceso-bordo: radio-acceso.with-alpha(0.50);

    // Glifo della batteria collegata all'alimentatore (verde, dal petalo 5 un po' più verso il verde).
    out property <color> batteria-carica: #34d399;

    // `nessuno` (linea della ritirata senza voci in attesa): grigio neutro.
    public pure function colore-livello(livello: LivelloUi) -> color {
        if (livello == LivelloUi.bloccante) { return bloccante; }
        if (livello == LivelloUi.attenzione) { return attenzione; }
        if (livello == LivelloUi.informazione) { return informazione; }
        return testo-tenue;
    }

    // I colori dei cerchi dei collegamenti (iniziale del nome): sei toni, i petali (mai i caldi:
    // quelli dicono avviso o errore), scelti dal nome in Rust (`collegamenti::tono`). Tutti chiari: la lettera in `corpo` (scura) ci sta
    // sopra con più di 4,5:1 (lo controlla un test, come il numero di toni).
    public pure function colore-collegamento(tono: int) -> color {
        if (tono == 0) { return petalo-1; }
        if (tono == 1) { return petalo-2; }
        if (tono == 2) { return petalo-3; }
        if (tono == 3) { return petalo-4; }
        if (tono == 4) { return petalo-5; }
        return petalo-6;
    }

    // L'arco (di un limite, della spesa) diventa caldo ALLA soglia o sopra (frazione 0..1, come le voci
    // d'avviso): quella dell'utente per i limiti, l'80 % della soglia di spesa, l'85 % per il PC.
    public pure function oltre-soglia(frazione: float, soglia: float) -> bool {
        return frazione >= soglia;
    }

    // ─── Scale (FE11): raggi e corpi del testo, pochi valori e sempre gli stessi ───
    // Raggi: pulsanti della pillola e suggerimenti 8, pulsanti 10, voci e card piccole 12, card
    // e riquadri 16, il pannello 22. Le forme a capsula usano metà dell'altezza.
    out property <length> raggio-s: 8px;
    out property <length> raggio-m: 10px;
    out property <length> raggio-l: 12px;
    out property <length> raggio-xl: 16px;
    out property <length> raggio-pannello: 22px;
    // Corpi del testo: etichette e righe piccole 12, testo 13, campi e nomi 14, titoli 15,
    // frecce e titolo di un elenco vuoto 16, vista vuota di un'app 17, intestazione di finestra
    // 20, ora grande 68.
    out property <length> testo-piccolo: 12px;
    out property <length> testo-corpo: 13px;
    out property <length> testo-medio: 14px;
    out property <length> testo-titolo: 15px;
    out property <length> testo-sottotitolo: 16px;
    out property <length> testo-vuoto: 17px;
    out property <length> testo-intestazione: 20px;
    out property <length> testo-ora-grande: 68px;

    // ─── Pixel fisici (FE27) ───
    // Scala della finestra (1, 1,25, 1,75…): la scrive Rust per ogni finestra, all'avvio e quando
    // cambia (monitor o DPI). `sul-pixel` arrotonda uno spessore al pixel fisico più vicino (almeno
    // uno): un filo di 1,5 px a 1,75 diventa 3 px fisici netti invece di 2,625 sfocati. Solo per
    // spessori da 1 px in su: uno più sottile diventerebbe 1 px pieno anche a scala 1.
    in property <float> scala: 1;
    public pure function sul-pixel(spessore: length) -> length {
        return max(1, round(spessore / 1px * scala)) / scala * 1px;
    }

    out property <string> carattere: "Inter Tight";
    out property <string> carattere-mono: "JetBrains Mono";
}
