// La riga «In attesa» in cima alla Panoramica (bozza bozza-in-attesa.html, spec §3bis): le voci di
// tutte le fonti con i 3 livelli. Barretta colorata per livello e, sotto il titolo, sempre la
// parola del livello (il colore non basta da solo). Fino a 2 voci larghe visibili più «+N».
// Clic su una voce o su «+N» = la Coda su quella voce (ridisegno F1, Task 7: la voce espansa sul
// posto non c'è più; la riga stessa se ne va col Task 8).
import { Tema } from "tema.slint";
import { VoceAttesaUi } from "voci.slint";
import { Anello, Fuoco } from "componenti.slint";

// Quante voci «In attesa» stanno chiuse nella riga (R1-22): due card larghe, così i titoli si
// leggono; da tre voci in su le altre stanno dietro «+N» (indice `visibili` nel fuoco).
export global Attesa {
    out property <int> visibili: 2;
}

// Una voce chiusa: barretta, titolo, «livello · fonte».
component VoceChiusa inherits Rectangle {
    in property <VoceAttesaUi> voce;
    in property <bool> anello;
    callback scelta();

    border-radius: Tema.raggio-l;
    background: area.has-hover ? Tema.scheda-sopra : Tema.card-fondo;
    // Per Narrator: un pulsante che apre la Coda su questa voce, col fuoco vero quando l'anello c'è.
    accessible-role: button;
    accessible-label: voce.titolo + ", " + voce.sotto;
    accessible-action-default => { root.scelta(); }

    Fuoco { chiede: anello; }

    Rectangle {
        x: 10px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: self.width / 2;
        background: Tema.colore-livello(voce.livello);
    }

    Text {
        x: 21px;
        y: 5px;
        width: parent.width - self.x - 10px;
        text: voce.titolo;
        overflow: elide;
        font-size: Tema.testo-corpo;
        color: Tema.testo;
    }

    Text {
        x: 21px;
        y: parent.height - self.height - 5px;
        width: parent.width - self.x - 10px;
        text: voce.sotto;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta(); }
    }

    if anello: Anello { raggio: parent.border-radius; }
}

export component RigaAttesa inherits Rectangle {
    in property <[VoceAttesaUi]> voci;
    // Voce col fuoco da tastiera (-1 = nessuna; `Attesa.visibili` = «+N»).
    in property <int> fuoco: -1;
    // Clic su una voce (o su «+N»: la prima nascosta, indice `Attesa.visibili`): la Coda su di lei.
    callback scelta(int);

    property <int> visibili: min(Attesa.visibili, voci.length);
    property <int> altre: voci.length - visibili;
    property <length> spazio: 8px;
    property <length> largo-altre: altre > 0 ? 48px : 0px;
    property <length> largo-voce: (self.width - largo-altre - (altre > 0 ? spazio : 0px) - (visibili - 1) * spazio) / max(1, visibili);

    // Solo le voci visibili, create una per una (FE4): le altre stanno in «+N».
    for i in visibili: VoceChiusa {
        x: i * (largo-voce + spazio);
        width: largo-voce;
        height: root.height;
        voce: root.voci[i];
        anello: i == root.fuoco;
        scelta => { root.scelta(i); }
    }

    if altre > 0: Rectangle {
        x: root.width - largo-altre;
        width: largo-altre;
        height: root.height;
        border-radius: Tema.raggio-l;
        background: area-altre.has-hover ? Tema.scheda-sopra : Tema.card-fondo;
        accessible-role: button;
        // Dice quale voce nasconde: la prima delle nascoste (il suo titolo).
        accessible-label: (altre == 1 ? "Un'altra voce in attesa" : "Altre " + altre + " voci in attesa") + ": " + root.voci[visibili].titolo;
        accessible-action-default => { root.scelta(Attesa.visibili); }

        Fuoco { chiede: root.fuoco == Attesa.visibili; }

        Text {
            text: "+" + altre;
            font-size: Tema.testo-corpo;
            font-weight: 500;
            color: Tema.testo-2;
        }

        area-altre := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.scelta(Attesa.visibili); }
        }

        if root.fuoco == Attesa.visibili: Anello { raggio: parent.border-radius; }
    }
}
