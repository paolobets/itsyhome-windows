// Il pannello unico dell'assistente (spec §3bis). Riga alta: occhi al centro (dove stavano quelli
// della pillola), a sinistra data e meteo (solo nella Panoramica; nelle app resta vuota), l'ora a
// destra e dopo di lei «⋯» (Task 14i: il menu dell'isola senza «Apri», con
// Impostazioni in testa); niente «‹ Indietro» (Task 14g: alla Panoramica si torna dal
// dock, con Backspace o Alt+←; nella vista Casa «Preferiti» è la prima voce dell'elenco). Centro: la
// Panoramica (riga «In attesa» se c'è qualcosa, poi il layout Orologio o Quadranti, cambiabili
// con i puntini, le frecce e la rotella) o la vista di un'app. In basso il dock di sole app, solo icone.
//
// Tastiera: Tab / Maiusc+Tab fra «In attesa», contenuto, dock e «⋯» (in giro: da «⋯» Tab torna in
// cima; Invio o Spazio lì aprono il menu); frecce dentro la zona
// (in «In attesa» ←/→ fra le voci e, a voce espansa, ↓ ai pulsanti e ↑ di nuovo alla voce; nella
// Panoramica ←/→ cambiano layout, nel dock cambiano icona; in Casa Tab passa dall'elenco alle
// card: ↑/↓ fra «Preferiti» e le stanze e → alle card, le frecce fra le card, ← dalla prima colonna all'elenco
// e ↑ dalla prima riga a «Riprova» quando c'è; Casa vuota e non connessa: «Apri Impostazioni»);
// In Collegamenti le frecce fra le card, ↑ dalla prima riga a «Modifica»; Invio apre la pagina.
// Nella vista Claude ↑/↓ fra le righe delle sessioni, Invio le apre (`apri-sessione`); scollegato Invio
// apre le Impostazioni sulla scheda Claude.
// Nella vista PC il contenuto sono il cursore del volume e, su Windows, i riquadri Wi-Fi e
// Bluetooth e le righe «Reti Wi-Fi ›» e «Dispositivi Bluetooth ›» (M2, Task 8): Tab e Maiusc+Tab
// passano dall'uno all'altro prima di lasciare la vista; sul cursore ←/→ ±2 punti, Home/Fine
// 0/100, Invio o Spazio muto sì/no; fra riquadri e righe le frecce (← → nella riga, ↑ ↓ fra
// riquadri e righe), Invio o Spazio accendono/spengono o aprono la pagina di Windows.
// Invio o Spazio attivano (su una stanza o «Preferiti»: la sceglie e porta alle card; su una voce: la espande o la
// riduce; un permesso, «Consenti», solo con Ctrl+Invio, e la voce che lo chiede si apre col fuoco
// su «Nega»); Backspace o Alt+← = indietro (prima torna a «Preferiti»); Esc un livello alla
// volta: riduce la voce espansa, torna a «Preferiti», poi chiude il pannello; ↑/↓ sulla voce espansa
// scorrono il testo lungo.
// Un unico FocusScope tiene il fuoco e l'anello (visibile solo da tastiera) segue la
// zona scelta.
import { Tema, Movimento } from "tema.slint";
import { Faccia, Occhi } from "faccia.slint";
import { Anello, Fuoco, Fuochi } from "componenti.slint";
import { Icone } from "icone.slint";
import { VoceAppUi, StatPcUi, PreferitoUi, SensoreUi, PulsanteUi, VoceAttesaUi, UmoreUi, StanzaUi, CollegamentoUi, QuadranteUi, FonteQuadranteUi, TipoReteUi, TintaBatteriaUi, RigaSessioneUi, LimiteClaudeUi } from "voci.slint";
import { Attesa, RigaAttesa, VoceEspansa } from "attesa.slint";
import { VistaPc } from "viste/pc.slint";
import { VistaClaude } from "viste/claude.slint";
import { VistaCasa } from "viste/casa.slint";
import { VistaCollegamenti } from "viste/collegamenti.slint";
import { LayoutOrologio } from "layout/orologio.slint";
import { LayoutQuadranti } from "layout/quadranti.slint";

export { VoceAppUi, StatPcUi, PreferitoUi, SensoreUi, PulsanteUi, VoceAttesaUi, StanzaUi, RigaSessioneUi, LimiteClaudeUi }

// Una scheda del dock: solo l'icona (bersaglio 36 × 32, icona 20); quella attiva sta in una
// capsula "vetro" e diventa bianca. Il nome compare in un suggerimento dopo una breve sosta del
// mouse, o subito quando la scheda ha il fuoco da tastiera.
component Scheda inherits Rectangle {
    in property <image> icona;
    in property <string> nome;
    in property <bool> attiva;
    in property <bool> anello;
    // Posizione nel dock (per Narrator: «scheda 2 di 4»).
    in property <int> indice;
    in property <int> quante;
    callback scelta();
    property <bool> sosta: false;

    width: 36px;
    height: 32px;
    border-radius: self.height / 2;
    background: attiva ? Tema.scheda-attiva : area.has-hover ? Tema.scheda-sopra : transparent;
    accessible-role: tab;
    accessible-label: nome;
    accessible-item-selectable: true;
    accessible-item-selected: attiva;
    accessible-item-index: indice;
    accessible-item-count: quante;
    accessible-action-default => { root.scelta(); }

    Fuoco { chiede: anello; }

    Image {
        source: icona;
        width: 20px;
        height: 20px;
        accessible-role: none;
        colorize: attiva ? Tema.icona-attiva : Tema.icona;
        image-rendering: smooth;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta(); }
        changed has-hover => {
            if (!self.has-hover) {
                root.sosta = false;
            }
        }
    }

    // Gira solo mentre il mouse è fermo sopra la scheda e il suggerimento non c'è ancora.
    Timer {
        interval: 600ms;
        running: area.has-hover && !root.sosta;
        triggered => { root.sosta = true; }
    }

    if anello: Anello { raggio: parent.border-radius; }

    if (sosta && area.has-hover) || anello: Rectangle {
        y: -32px;
        height: 24px;
        width: suggerimento.preferred-width + 18px;
        x: (parent.width - self.width) / 2;
        border-radius: Tema.raggio-s;
        background: Tema.suggerimento;
        border-width: 1px;
        border-color: Tema.vetro-bordo;

        suggerimento := Text {
            text: root.nome;
            font-size: Tema.testo-piccolo;
            color: Tema.testo;
        }
    }
}

// Zona del pannello col fuoco da tastiera.
enum Zona { attesa, stanze, contenuto, dock, menu }

export component Pannello inherits Window {
    in property <UmoreUi> umore: UmoreUi.tranquillo;
    in property <string> ora;
    in property <string> data;
    // Parte sinistra della riga alta, solo nella Panoramica (nelle app resta vuota): data breve e
    // meteo secondo il layout, scritti da Rust solo quando cambiano; il nome è per Narrator.
    in property <string> riga-sinistra;
    in property <string> riga-sinistra-nome;
    // Layout della Panoramica (indice del puntino: 0 Orologio, 1 Quadranti, come `layout.rs`).
    in-out property <int> layout: 0;
    out property <int> numero-layout: 2;
    // L'ora piccola della riga alta: nascosta nel layout Orologio della Panoramica (c'è la grande).
    out property <bool> ora-riga-visibile: !(vista == "panoramica" && layout == 0 && !espansa);
    // L'app mostrata al centro; "panoramica" è la schermata principale. È l'id di un'app del
    // registro (un dato, non uno stato con un nome: resta una stringa).
    in-out property <string> vista: "panoramica";
    // L'app aperta per ultima dal dock (indice in `app`) e se non ha una vista sua (oggi nessuna:
    // le Impostazioni hanno una finestra loro).
    property <int> indice-vista: 0;
    property <bool> vista-vuota: vista != "panoramica" && vista != "casa" && vista != "claude" && vista != "pc" && vista != "collegamenti"
        && indice-vista >= 0 && indice-vista < app.length && app[indice-vista].id == vista;
    in property <[VoceAppUi]> app;
    // Statistiche del PC, aggiornate ogni 2 s solo a pannello aperto.
    in property <StatPcUi> pc;
    // La vista Claude (M3, Task 9): i dati li scrive Rust, e solo mentre la vista è aperta.
    // `claude-collegato`: Claude Code è collegato; le righe sono al più tre sessioni, `claude-altre`
    // quante restano fuori; i due limiti (`presente` falso = senza anello) e la spesa API del mese.
    in property <bool> claude-collegato;
    in property <[RigaSessioneUi]> claude-righe;
    in property <int> claude-altre;
    in property <LimiteClaudeUi> claude-cinque-ore;
    in property <LimiteClaudeUi> claude-sette-giorni;
    // La soglia d'avviso dell'utente come frazione (80 % di serie): sopra, l'arco dei limiti e
    // della spesa è caldo, nella vista Claude e nei quadranti (RC-44). La scrive Rust.
    in property <float> claude-soglia: 0.8;
    in property <string> claude-spesa;
    in property <string> claude-spesa-nota;
    // La chiave da amministratore c'è: la vista mostra «Dettagli» (schede delle API).
    in property <bool> claude-dettagli;
    // Il volume del PC nella vista PC (M2, Task 7): `volume-disponibile` solo su Windows con
    // un'uscita audio (altrimenti la riga non c'è); `volume` 0..1 lo scrive Rust (stato letto) e
    // il cursore (subito, senza aspettare Windows).
    in property <bool> volume-disponibile: false;
    in-out property <float> volume: 0;
    in property <bool> volume-muto: false;
    // Un livello 0..1 scelto col cursore o con la tastiera; muto sì/no dall'altoparlante o Invio.
    callback imposta-volume(float);
    callback muto-volume(bool);
    // Le connessioni nella vista PC (M2, Task 8, solo Windows: altrove `connessioni-disponibili`
    // resta falso e la colonna ha solo la rete). Gli stati li scrive Rust: le radio lette
    // (`radio-lette`), presenti e accese (l'acceso cambia subito al clic e torna allo stato vero
    // se Windows rifiuta), il nome della rete (solo a vista PC aperta), l'icona della rete
    // (`rete-nota`, `rete`, `tacche`) e la riga in ambra di un rifiuto (`errore-radio`).
    in property <bool> connessioni-disponibili: false;
    in property <bool> radio-lette: false;
    in property <bool> wifi-presente: false;
    in-out property <bool> wifi-acceso: false;
    in property <bool> bt-presente: false;
    in-out property <bool> bt-acceso: false;
    in property <string> nome-rete;
    in property <bool> rete-nota: false;
    in property <TipoReteUi> rete: TipoReteUi.nessuna;
    in property <int> tacche: 0;
    in-out property <bool> errore-radio: false;
    // (0 Wi-Fi / 1 Bluetooth, acceso voluto) e la pagina di Windows (0 reti Wi-Fi, 1 Bluetooth).
    callback commuta-radio(int, bool);
    callback apri-pagina(int);
    // La riga «CUFFIE» della vista PC (M2, Task 9, solo Windows): la scrive Rust dopo una lettura
    // fatta entrando nella vista; senza dispositivi connessi con la batteria leggibile non c'è.
    in property <bool> cuffie-presenti: false;
    in property <string> cuffie-dettaglio;
    in property <string> cuffie-testo;
    in property <float> cuffie-frazione: 0;
    in property <TintaBatteriaUi> cuffie-tinta: TintaBatteriaUi.normale;
    in property <string> cuffie-descrizione;
    // Vero mentre il pannello è aperto: guida l'animazione di apertura e il battito degli occhi.
    in-out property <bool> aperto;
    // Casa: i preferiti (al massimo 8), la riga di stato, i sensori dei Quadranti (al massimo 3).
    in property <[PreferitoUi]> preferiti;
    in property <[SensoreUi]> sensori;
    // I tre quadranti configurabili (Impostazioni › Isola): di serie quelli di M1. Rust li
    // riscrive solo quando cambia la scelta o un valore della casa che mostrano.
    in property <[QuadranteUi]> quadranti: [
        { fonte: FonteQuadranteUi.cpu, etichetta: "CPU" },
        { fonte: FonteQuadranteUi.ram, etichetta: "RAM" },
        { fonte: FonteQuadranteUi.disco, etichetta: "DISCO" },
    ];
    // Le stanze della vista Casa e i dispositivi della stanza aperta (li dà Rust a `apri-stanza`).
    in property <[StanzaUi]> stanze;
    in property <[PreferitoUi]> dispositivi;
    // Le luci accese adesso (le scrive Rust) e se la vista Casa le mostra al posto dei preferiti:
    // il clic su «N luci accese» della Panoramica. Una luce spenta esce dall'elenco subito.
    in property <[PreferitoUi]> luci;
    in-out property <bool> filtro-luci: false;
    // «Spegni tutte» nella testata della vista Casa filtrata: un comando per ogni luce accesa.
    callback spegni-tutte();
    // La stanza aperta (indice in `stanze`, -1 = nessuna). Rust la riallinea se le stanze cambiano.
    in-out property <int> stanza-aperta: -1;
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    // La casa non è configurata (nessun Home Assistant scelto): la riga «Casa» e il quadrante CASA
    // diventano un invito che porta alle Impostazioni (R1-13).
    in property <bool> casa-da-configurare;
    // Senza connessione: l'ora degli ultimi dati («dati delle 10:42») e se ha senso «Riprova».
    in property <string> dati-delle;
    in property <bool> casa-riprovabile;
    // I collegamenti veloci (Task 14f) e l'errore dell'ultimo che non si è aperto (lo scrive Rust).
    in property <[CollegamentoUi]> collegamenti;
    in-out property <string> errore-collegamenti;
    // Da dove partono gli occhi all'apertura, rispetto al centro: aprendo da "ti cerca" sono
    // dove stavano quelli della pillola allargata e, appena il pannello è comparso, scivolano al centro.
    in property <length> partenza-occhi: 0px;
    // Lo stesso in altezza, rispetto al centro della riga alta: la pillola che chiama è più alta.
    in property <length> partenza-occhi-y: 0px;
    // Le voci «In attesa», già in ordine (bloccante, attenzione, informazione; poi le più recenti).
    in property <[VoceAttesaUi]> attese;
    // Id della voce espansa sul posto ("" = nessuna). Rust la azzera se la voce sparisce e la
    // imposta quando il pannello si apre dalla pillola che chiama.
    in-out property <string> voce-aperta;
    // Posizione della voce espansa in `attese` (-1 = nessuna): va sempre insieme a `voce-aperta`.
    in-out property <int> indice-aperta: -1;
    callback tocca(string);
    // Un pulsante di una voce in attesa: (id della voce, id del pulsante).
    callback azione(string, string);
    // Clic su un puntino: quel layout.
    callback scegli-layout(int);
    // Frecce, rotella e Invio sui puntini: +1 il successivo, -1 il precedente (lo decide Rust).
    callback scorri-layout(int);
    callback apri-app(string);
    // La vista è cambiata (Rust decide quali fonti lente del PC campionare).
    callback vista-cambiata();
    callback chiudi();
    // «Riprova» nella testata della vista Casa (stessa azione della voce «Casa non raggiungibile»).
    callback riprova-casa();
    // Una stanza della vista Casa aperta (area) o chiusa.
    callback apri-stanza(string);
    callback chiudi-stanza();
    // Una sessione di Claude Code scelta (l'impronta): la porta davanti (Task 10).
    callback apri-sessione(string);
    // «Impostazioni» nello stato scollegato della vista Claude: le Impostazioni sulla scheda Claude.
    callback gestisci-claude();
    // «Dettagli» della vista Claude: le schede delle API nella finestra di gestione.
    callback apri-dettagli-claude();
    // Un collegamento scelto (id): Rust lo apre nel browser e chiude il pannello.
    callback apri-collegamento(string);
    // «Modifica» o «Aggiungi un collegamento»: le Impostazioni sulla scheda Collegamenti.
    callback gestisci-collegamenti();
    // «⋯»: il menu dell'isola (nativo, lo apre Rust), sotto il pulsante e allineato al suo bordo
    // destro: (bordo destro, bordo basso) del pulsante in coordinate logiche della finestra, e se
    // viene da tastiera o da Narrator (allora la prima voce parte evidenziata). Fuori da Windows,
    // dove il menu nativo non c'è, Rust apre direttamente le Impostazioni.
    callback menu(length, length, bool);

    // Geometria (logica). La riga alta è alta quanto la pillola a riposo, così gli occhi cadono dove
    // stavano i suoi (vedi `posizione_pannello` in finestre.rs). Pannello 800 × 300: zona
    // centrale 764 × 188, poi la riga dei puntini (solo nella Panoramica) e il dock.
    out property <length> larghezza-pannello: 800px;
    property <length> margine: 18px;
    out property <length> altezza-riga: Faccia.altezza-pillola;
    property <length> altezza-dock: 38px;
    property <length> dock-y: root.height - altezza-dock - 12px;
    property <length> altezza-puntini: 20px;
    property <length> puntini-y: dock-y - altezza-puntini - 4px;
    out property <length> centro-x: margine;
    out property <length> centro-y: altezza-riga + 4px;
    out property <length> centro-l: root.width - 2 * margine;
    out property <length> centro-a: puntini-y - 2px - centro-y;
    // Riga «In attesa» (solo nella Panoramica e solo se c'è qualcosa): il layout sta sotto.
    property <bool> con-attese: vista == "panoramica" && attese.length > 0;
    property <length> altezza-attese: 42px;
    property <length> sotto-attese: con-attese ? altezza-attese + 6px : 0px;
    // Le voci «In attesa» diminuiscono (3 → 2): il fuoco su «+N», che non c'è più, va alla card più
    // vicina invece di perdersi.
    property <int> n-attese: attese.length;
    changed n-attese => {
        fuoco-attesa = max(0, min(fuoco-attesa, min(attese.length, Attesa.visibili + 1) - 1));
    }
    property <bool> espansa: con-attese && indice-aperta >= 0 && indice-aperta < attese.length;

    // ─── Scorrimento fra le viste (280 ms) ───
    // Cambiando vista il contenuto (non la riga alta né il dock) parte da 26 px verso il lato
    // della scheda scelta (più a destra nel dock: da destra; più a sinistra, e la Panoramica che è
    // la prima: da sinistra) e arriva al suo posto dissolvendosi dentro. Con «Effetti di animazione»
    // spento niente scarto, solo una dissolvenza da 120 ms. Il `Timer` gira solo i 16 ms del cambio:
    // fuori dall'animazione non c'è nulla da ridisegnare.
    out property <length> scarto-contenuto: 0px;
    property <float> opacita-contenuto: 1;
    property <bool> in-arrivo: true;
    property <int> posizione-prec: 0;
    animate scarto-contenuto { duration: in-arrivo ? 280ms : 0ms; easing: ease-out; }
    animate opacita-contenuto { duration: in-arrivo ? (Movimento.ridotto ? 120ms : 280ms) : 0ms; easing: ease-out; }

    // Posizione di una vista nel dock (la Panoramica è la prima); sconosciuta: dopo la Panoramica.
    pure function posizione(v: string) -> int {
        return v == "panoramica" ? 0
            : app[0].id == v ? 0 : app[1].id == v ? 1 : app[2].id == v ? 2 : app[3].id == v ? 3
            : app[4].id == v ? 4 : app[5].id == v ? 5 : app[6].id == v ? 6 : app[7].id == v ? 7 : 1;
    }

    // La riga «N luci accese» smette di essere il bersaglio da tastiera (luci spente, casa
    // disconnessa, altro layout): il fuoco vero torna a `tasti`, non resta su un elemento fermo.
    changed fuoco-luci-valido => {
        if (!fuoco-luci-valido && fuoco-luci-el.has-focus) {
            tasti.focus();
        }
    }

    changed vista => {
        fuoco-dettagli = false;
        root.vista-cambiata();
        let nuova = posizione(vista);
        if (nuova != posizione-prec) {
            // Prima il punto di partenza, senza animazione (`in-arrivo` falso = 0 ms); poi, 16 ms
            // dopo, l'arrivo animato.
            in-arrivo = false;
            scarto-contenuto = Movimento.ridotto ? 0px : nuova > posizione-prec ? 26px : -26px;
            opacita-contenuto = 0;
            arrivo.running = true;
            arrivo.restart();
        }
        posizione-prec = nuova;
    }

    // Diventa vero poco dopo l'apertura, quando i primi fotogrammi hanno già disegnato gli occhi
    // al punto di partenza: solo allora lo scarto si anima (le proprietà si calcolano solo
    // quando servono, quindi un cambio nello stesso istante dell'apertura non si vedrebbe).
    property <bool> occhi-al-centro: partenza-occhi == 0px && partenza-occhi-y == 0px;

    // ─── Tastiera ───
    // Zona col fuoco. All'apertura il fuoco va sul contenuto.
    property <Zona> zona: Zona.contenuto;
    // L'anello si vede solo dopo un tasto; un clic lo spegne.
    property <bool> da-tastiera: false;
    property <int> fuoco-dock: 0;
    property <int> fuoco-casa: 0;
    property <int> colonne-casa: 4;
    // Le card della vista Casa: i dispositivi della stanza aperta, altrimenti i preferiti.
    property <bool> in-stanza: stanza-aperta >= 0 && stanza-aperta < stanze.length;
    // La riga «N luci accese» della Panoramica si può usare (e raggiungere da tastiera): casa
    // connessa e almeno una luce accesa. `fuoco-luci`: il fuoco da tastiera è su di lei (↓ o Tab
    // dal contenuto; Invio o Spazio aprono la Casa filtrata, altrove Invio cambia layout).
    property <bool> luci-cliccabili: casa-pronta && luci.length > 0;
    // La stessa riga, quando è un invito alle Impostazioni (casa non configurata), si usa allo
    // stesso modo: clic, Tab, Invio.
    property <bool> casa-cliccabile: luci-cliccabili || casa-da-configurare;
    // Il bersaglio della riga da tastiera esiste: nei Quadranti solo il quadrante CASA (senza
    // sensori) dice «N luci accese».
    property <bool> luci-da-tastiera: casa-cliccabile && (layout == 0 || sensori.length == 0);
    property <bool> fuoco-luci: false;
    property <bool> fuoco-luci-valido: fuoco-luci && luci-da-tastiera && vista == "panoramica" && !espansa && zona == Zona.contenuto;
    // La testata della Casa filtrata ha i suoi pulsanti solo a casa connessa: altrimenti dice lo
    // stato (e «Riprova») come la Casa completa.
    property <bool> testata-filtro: filtro-luci && casa-pronta;
    property <[PreferitoUi]> griglia: filtro-luci ? luci : in-stanza ? dispositivi : preferiti;
    property <int> fuoco-casa-valido: min(fuoco-casa, griglia.length - 1);
    // Voce dell'elenco della vista Casa col fuoco: -1 = «Preferiti», poi l'indice della stanza.
    property <int> fuoco-stanza: -1;
    property <int> fuoco-stanza-valido: max(-1, min(fuoco-stanza, stanze.length - 1));
    // Vista Claude: riga col fuoco (↑/↓), sempre dentro le righe che ci sono.
    // Il fuoco segue la sessione (l'impronta), non la posizione: se le righe si riordinano resta
    // sulla stessa sessione. Senza una scelta (o se la sessione è sparita) è la prima riga.
    property <string> fuoco-sessione-id;
    // Il fuoco da tastiera è su «Dettagli» (sotto l'ultima riga, o da solo se non c'è altro).
    property <bool> fuoco-dettagli;
    property <bool> claude-primo: !claude-collegato || claude-righe.length > 0;
    property <bool> fuoco-dettagli-valido: claude-dettagli && (fuoco-dettagli || !claude-primo);
    property <int> fuoco-sessione-valido: claude-righe.length > 0 && claude-righe[0].id == fuoco-sessione-id ? 0
        : claude-righe.length > 1 && claude-righe[1].id == fuoco-sessione-id ? 1
        : claude-righe.length > 2 && claude-righe[2].id == fuoco-sessione-id ? 2 : 0;
    // Collegamenti: card col fuoco (-1 = «Modifica» nella testata), 3 colonne.
    property <int> fuoco-collegamento: 0;
    property <int> fuoco-collegamento-valido: min(fuoco-collegamento, collegamenti.length - 1);
    property <int> colonne-collegamenti: 3;
    // Vista PC: elemento col fuoco (0 volume, 1 Wi-Fi, 2 Bluetooth, 3 «Reti Wi-Fi ›»,
    // 4 «Dispositivi Bluetooth ›»); se non c'è, il primo che c'è dopo (o prima).
    property <int> fuoco-pc: 0;
    property <int> fuoco-pc-valido: pc-ha(fuoco-pc) ? fuoco-pc
        : pc-successivo(fuoco-pc) >= 0 ? pc-successivo(fuoco-pc) : pc-precedente(fuoco-pc);
    // «Riprova» nella testata della vista Casa: casa non connessa che si può riprovare.
    property <bool> riprova-visibile: !casa-pronta && casa-riprovabile && (griglia.length > 0 || stanze.length > 0);
    // «In attesa»: voce col fuoco (da chiusa 0..1, 2 = «+N», vedi `Attesa.visibili`) e pulsante della voce espansa
    // (-1 = la voce stessa).
    property <int> fuoco-attesa: 0;
    property <int> fuoco-pulsante: -1;
    // Testo della voce espansa: richieste di scorrimento da tastiera (contatori: ogni scatto è un
    // passo) e se è già in fondo (lo dice la voce stessa).
    property <int> testo-su: 0;
    property <int> testo-giu: 0;
    property <bool> testo-a-fondo: true;
    // Rotella: spostamento accumulato e pausa dopo un cambio (un touchpad manda molti piccoli passi).
    property <length> rotella: 0px;
    property <bool> rotella-ferma: false;

    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "ItsyHome — pannello";
    default-font-family: Tema.carattere;
    width: larghezza-pannello;
    height: 300px;
    forward-focus: tasti;

    // Vista PC: l'elemento `i` c'è (e prende il fuoco). Un riquadro senza radio («Non presente»)
    // o non ancora letto no.
    pure function pc-ha(i: int) -> bool {
        if (i == 0) {
            return volume-disponibile;
        }
        if (i == 1) {
            return connessioni-disponibili && radio-lette && wifi-presente;
        }
        if (i == 2) {
            return connessioni-disponibili && radio-lette && bt-presente;
        }
        return (i == 3 || i == 4) && connessioni-disponibili;
    }

    // Il primo elemento della vista PC dopo `i` (-1 nessuno), e prima.
    pure function pc-successivo(i: int) -> int {
        return i < 0 && pc-ha(0) ? 0 : i < 1 && pc-ha(1) ? 1 : i < 2 && pc-ha(2) ? 2
            : i < 3 && pc-ha(3) ? 3 : i < 4 && pc-ha(4) ? 4 : -1;
    }

    pure function pc-precedente(i: int) -> int {
        return i > 4 && pc-ha(4) ? 4 : i > 3 && pc-ha(3) ? 3 : i > 2 && pc-ha(2) ? 2
            : i > 1 && pc-ha(1) ? 1 : i > 0 && pc-ha(0) ? 0 : -1;
    }

    pure function ha-zona(z: Zona) -> bool {
        if (z == Zona.attesa) {
            return con-attese;
        }
        if (z == Zona.stanze) {
            return vista == "casa" && stanze.length > 0;
        }
        if (z == Zona.contenuto) {
            // Con una voce espansa il layout è coperto: niente fuoco lì.
            if (espansa) {
                return false;
            }
            // Casa vuota e non connessa: il fuoco va su «Apri Impostazioni». Collegamenti: le card,
            // o «Aggiungi un collegamento» se non ce ne sono.
            // PC: il cursore del volume, i riquadri e le righe delle connessioni, se ci sono.
            // Claude: «Impostazioni» se non è collegato, altrimenti le righe (se ce ne sono).
            return vista == "panoramica" || vista == "collegamenti" || (vista == "casa" && (griglia.length > 0 || filtro-luci || !casa-pronta))
                || (vista == "claude" && (!claude-collegato || claude-righe.length > 0 || claude-dettagli))
                || (vista == "pc" && pc-successivo(-1) >= 0);
        }
        return true;
    }

    pure function zona-dopo(z: Zona, avanti: bool) -> Zona {
        if (avanti) {
            return z == Zona.attesa ? Zona.stanze : z == Zona.stanze ? Zona.contenuto
                : z == Zona.contenuto ? Zona.dock : z == Zona.dock ? Zona.menu : Zona.attesa;
        }
        return z == Zona.menu ? Zona.dock : z == Zona.dock ? Zona.contenuto : z == Zona.contenuto ? Zona.stanze
            : z == Zona.stanze ? Zona.attesa : Zona.menu;
    }

    // Tab nella vista PC: prima gli elementi del contenuto (volume, riquadri, righe), poi la zona
    // seguente; entrando nel contenuto si parte dal primo (o dall'ultimo, all'indietro).
    function premi-tab(avanti: bool) {
        if (zona == Zona.contenuto && vista == "pc" && !espansa) {
            let n = avanti ? pc-successivo(fuoco-pc-valido) : pc-precedente(fuoco-pc-valido);
            if (n >= 0) {
                fuoco-pc = n;
                return;
            }
        }
        // Panoramica con «N luci accese» cliccabile: dal contenuto Tab va prima a lei, e Maiusc+Tab
        // da lei torna al layout.
        if (zona == Zona.contenuto && vista == "panoramica" && !espansa && luci-da-tastiera) {
            if (avanti && !fuoco-luci-valido) {
                fuoco-luci = true;
                return;
            }
            if (!avanti && fuoco-luci-valido) {
                tasti.focus();
                fuoco-luci = false;
                return;
            }
        }
        passa-zona(avanti);
        fuoco-luci = zona == Zona.contenuto && vista == "panoramica" && !avanti && luci-da-tastiera;
        if (zona == Zona.contenuto && vista == "pc") {
            fuoco-pc = avanti ? pc-successivo(-1) : pc-precedente(5);
        }
    }

    // Wi-Fi (0) o Bluetooth (1): l'interruttore si sposta subito (lo stato vero torna da Rust, e
    // se Windows rifiuta torna com'era) e la riga del rifiuto di prima sparisce.
    function commuta(tipo: int) {
        errore-radio = false;
        if (tipo == 0) {
            wifi-acceso = !wifi-acceso;
            root.commuta-radio(0, wifi-acceso);
        } else {
            bt-acceso = !bt-acceso;
            root.commuta-radio(1, bt-acceso);
        }
    }

    // Tab: la zona seguente che esiste in questa vista (dock e «⋯» ci sono sempre).
    function passa-zona(avanti: bool) {
        zona = zona-dopo(zona, avanti);
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        fuoco-pulsante = -1;
    }

    // La voce `i` chiede un permesso (ha un pulsante delicato; al massimo 2 pulsanti per voce).
    pure function chiede-permesso(i: int) -> bool {
        if (i < 0 || i >= attese.length) {
            return false;
        }
        return (attese[i].pulsanti.length > 0 && attese[i].pulsanti[0].delicato)
            || (attese[i].pulsanti.length > 1 && attese[i].pulsanti[1].delicato);
    }

    // Il primo pulsante non delicato della voce `i` («Nega»), qualunque sia l'ordine scelto dalla
    // fonte; -1 se sono tutti delicati (allora il fuoco resta sulla voce).
    pure function primo-non-delicato(i: int) -> int {
        if (attese[i].pulsanti.length > 0 && !attese[i].pulsanti[0].delicato) {
            return 0;
        }
        if (attese[i].pulsanti.length > 1 && !attese[i].pulsanti[1].delicato) {
            return 1;
        }
        return -1;
    }

    // Espande la voce `i`: il fuoco da tastiera va su «In attesa» (il layout sotto è coperto).
    // Se la voce chiede un permesso il fuoco parte da «Nega» (il pulsante non delicato): Invio lì nega,
    // e «Consenti» vuole Ctrl+Invio.
    function apri-voce(i: int) {
        if (i >= 0 && i < attese.length) {
            voce-aperta = attese[i].id;
            indice-aperta = i;
            zona = Zona.attesa;
            fuoco-attesa = min(i, Attesa.visibili);
            fuoco-pulsante = chiede-permesso(i) ? primo-non-delicato(i) : -1;
        }
    }

    // Da Rust: il pannello si apre dalla pillola che chiama, sulla voce `i` già espansa.
    public function espandi(i: int) {
        apri-voce(i);
    }

    function riduci-voce() {
        voce-aperta = "";
        indice-aperta = -1;
        fuoco-pulsante = -1;
    }

    // Apre la stanza `i` della vista Casa; `alle-card`: da tastiera il fuoco passa ai suoi dispositivi.
    function apri-stanza-i(i: int, alle-card: bool) {
        if (i >= 0 && i < stanze.length) {
            // Le card cambiano tutte: se una aveva il fuoco sparisce, il fuoco passa prima a `tasti`.
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            filtro-luci = false;
            stanza-aperta = i;
            fuoco-stanza = i;
            fuoco-casa = 0;
            root.apri-stanza(stanze[i].area-id);
            if (alle-card) {
                zona = Zona.contenuto;
            }
        }
    }

    // Chiude la stanza aperta: torna «Preferiti» (selezionata, e col fuoco da tastiera).
    function chiudi-stanza-ora() {
        if (stanza-aperta >= 0) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            fuoco-stanza = -1;
            stanza-aperta = -1;
            fuoco-casa = 0;
            root.chiudi-stanza();
            if (zona == Zona.contenuto && ha-zona(Zona.stanze)) {
                zona = Zona.stanze;
            }
        }
    }

    // La Casa filtrata sulle luci accese (clic su «N luci accese» della Panoramica): la vista Casa
    // con l'elenco delle luci accese, il fuoco sulla prima.
    // Casa non configurata: la stessa riga porta alle Impostazioni (R1-13).
    function mostra-luci() {
        if (casa-da-configurare) {
            root.apri-app("impostazioni");
        } else {
            vai("casa");
            filtro-luci = true;
            fuoco-casa = 0;
        }
    }

    // Torna all'elenco completo (Preferiti). Il fuoco da tastiera sta sulle card o nella testata,
    // che cambiano tutte: passa prima a `tasti`, e poi alla prima card.
    function esci-filtro() {
        if (filtro-luci) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            filtro-luci = false;
            fuoco-casa = 0;
        }
    }

    // Clic o Invio su una stanza: la apre. Sulla stanza già aperta (la scheda selezionata) non
    // cambia nulla, come su «Preferiti»: da tastiera il fuoco torna alle card. Ai preferiti si
    // torna con «Preferiti», Esc o Backspace.
    function scegli-stanza(i: int, alle-card: bool) {
        if (i != stanza-aperta) {
            apri-stanza-i(i, alle-card);
        } else if (alle-card && griglia.length > 0 && ha-zona(Zona.contenuto)) {
            zona = Zona.contenuto;
            fuoco-casa = 0;
        }
    }

    // Clic o Invio su «Preferiti»: la stanza aperta si chiude; da tastiera il fuoco passa alle
    // card, come scegliendo una stanza.
    function scegli-preferiti(alle-card: bool) {
        chiudi-stanza-ora();
        esci-filtro();
        fuoco-stanza = -1;
        if (alle-card && griglia.length > 0 && ha-zona(Zona.contenuto)) {
            zona = Zona.contenuto;
            fuoco-casa = 0;
        }
    }

    function vai(v: string) {
        // La vista che se ne va (con «In attesa»; «Indietro» non c'è più) può avere l'elemento col fuoco:
        // distrutto lui, il pannello resterebbe senza fuoco e senza tastiera. Il fuoco passa prima
        // a `tasti`; l'elemento scelto nella vista nuova lo riprende da sé (`Fuoco`). Il dock resta.
        if (zona != Zona.dock) {
            tasti.focus();
        }
        if (stanza-aperta >= 0) {
            stanza-aperta = -1;
            root.chiudi-stanza();
        }
        filtro-luci = false;
        fuoco-luci = false;
        vista = v;
        fuoco-casa = 0;
        fuoco-pc = 0;
        fuoco-stanza = -1;
        fuoco-collegamento = 0;
        if (!ha-zona(zona)) {
            zona = ha-zona(Zona.contenuto) ? Zona.contenuto : Zona.dock;
        }
    }

    // Backspace o Alt+←, un livello alla volta: prima la stanza aperta, poi la Panoramica.
    function indietro() {
        if (filtro-luci) {
            esci-filtro();
        } else if (stanza-aperta >= 0) {
            chiudi-stanza-ora();
        } else if (vista != "panoramica") {
            fuoco-dock = 0;
            vai("panoramica");
        }
    }

    function apri(i: int, id: string) {
        fuoco-dock = i;
        indice-vista = i;
        vai(id);
        root.apri-app(id);
    }

    // «⋯»: il menu sotto il pulsante, al suo bordo destro. Chiuso il menu senza scelta il fuoco
    // resta qui (la zona è «⋯»).
    function apri-menu(tastiera: bool) {
        zona = Zona.menu;
        root.menu(piu.absolute-position.x + piu.width, piu.absolute-position.y + piu.height, tastiera);
    }

    function scegli(i: int) {
        root.layout = i;
        root.scegli-layout(i);
    }

    // Il volume scelto da tastiera o dal cursore: subito nel pannello, poi a Rust.
    function cambia-volume(v: float) {
        volume = min(max(v, 0), 1);
        root.imposta-volume(volume);
    }

    // ←/→ nella vista PC: ±`punti` dal punto intero di adesso.
    function passo-volume(punti: int) {
        cambia-volume((round(volume * 100) + punti) / 100);
    }

    function freccia(k: string) {
        if (zona == Zona.dock) {
            if (k == Key.LeftArrow) {
                fuoco-dock = max(0, fuoco-dock - 1);
            } else if (k == Key.RightArrow) {
                fuoco-dock = min(app.length - 1, fuoco-dock + 1);
            }
        } else if (zona == Zona.attesa && espansa) {
            if (fuoco-pulsante >= 0) {
                if (k == Key.LeftArrow) {
                    fuoco-pulsante = max(0, fuoco-pulsante - 1);
                } else if (k == Key.RightArrow) {
                    fuoco-pulsante = min(attese[indice-aperta].pulsanti.length - 1, fuoco-pulsante + 1);
                } else if (k == Key.UpArrow) {
                    fuoco-pulsante = -1;
                }
            } else if (k == Key.LeftArrow && indice-aperta > 0) {
                apri-voce(indice-aperta - 1);
            } else if (k == Key.RightArrow && indice-aperta < attese.length - 1) {
                apri-voce(indice-aperta + 1);
            } else if (k == Key.UpArrow) {
                // Sulla voce ↑/↓ scorrono il testo lungo; ↓ in fondo al testo passa ai pulsanti.
                testo-su += 1;
            } else if (k == Key.DownArrow && !testo-a-fondo) {
                testo-giu += 1;
            } else if (k == Key.DownArrow && indice-aperta >= 0 && attese[indice-aperta].pulsanti.length > 0) {
                fuoco-pulsante = 0;
            }
        } else if (zona == Zona.attesa) {
            if (k == Key.LeftArrow) {
                fuoco-attesa = max(0, min(fuoco-attesa, Attesa.visibili) - 1);
            } else if (k == Key.RightArrow) {
                fuoco-attesa = min(min(attese.length, Attesa.visibili + 1) - 1, fuoco-attesa + 1);
            }
        } else if (zona == Zona.contenuto && vista == "panoramica") {
            if (k == Key.DownArrow && luci-da-tastiera) {
                fuoco-luci = true;
            } else if (k == Key.UpArrow) {
                tasti.focus();
                fuoco-luci = false;
            } else if (k == Key.LeftArrow) {
                root.scorri-layout(-1);
            } else if (k == Key.RightArrow) {
                root.scorri-layout(1);
            }
        } else if (zona == Zona.stanze) {
            if (k == Key.UpArrow) {
                fuoco-stanza = max(-1, fuoco-stanza-valido - 1);
            } else if (k == Key.DownArrow) {
                fuoco-stanza = min(stanze.length - 1, fuoco-stanza-valido + 1);
            } else if (k == Key.RightArrow && ha-zona(Zona.contenuto)) {
                zona = Zona.contenuto;
                fuoco-casa = 0;
            }
        } else if (zona == Zona.contenuto && vista == "pc" && fuoco-pc-valido == 0) {
            // Il cursore del volume: ←/→ due punti.
            if (k == Key.LeftArrow) {
                passo-volume(-2);
            } else if (k == Key.RightArrow) {
                passo-volume(2);
            }
        } else if (zona == Zona.contenuto && vista == "pc" && fuoco-pc-valido > 0) {
            // Riquadri (1 Wi-Fi, 2 Bluetooth) e sotto le righe (3 sotto il Wi-Fi, 4 sotto il
            // Bluetooth): ←/→ nella riga, ↑/↓ fra riquadri e righe.
            if (k == Key.RightArrow && (fuoco-pc-valido == 1 || fuoco-pc-valido == 3) && pc-ha(fuoco-pc-valido + 1)) {
                fuoco-pc = fuoco-pc-valido + 1;
            } else if (k == Key.LeftArrow && (fuoco-pc-valido == 2 || fuoco-pc-valido == 4) && pc-ha(fuoco-pc-valido - 1)) {
                fuoco-pc = fuoco-pc-valido - 1;
            } else if (k == Key.DownArrow && fuoco-pc-valido <= 2) {
                fuoco-pc = fuoco-pc-valido + 2;
            } else if (k == Key.UpArrow && fuoco-pc-valido >= 3) {
                fuoco-pc = pc-ha(fuoco-pc-valido - 2) ? fuoco-pc-valido - 2 : pc-precedente(fuoco-pc-valido);
            }
        } else if (zona == Zona.contenuto && vista == "claude" && ((claude-collegato && claude-righe.length > 0) || claude-dettagli)) {
            // ↑/↓ fra le righe, ai bordi si resta; dall'ultima riga ↓ porta su «Dettagli», ↑ torna.
            if (k == Key.UpArrow) {
                if (fuoco-dettagli-valido) {
                    fuoco-dettagli = false;
                } else if (claude-collegato && claude-righe.length > 0) {
                    fuoco-sessione-id = claude-righe[max(0, fuoco-sessione-valido - 1)].id;
                }
            } else if (k == Key.DownArrow && !fuoco-dettagli-valido) {
                if (claude-dettagli && (!claude-collegato || fuoco-sessione-valido == claude-righe.length - 1)) {
                    fuoco-dettagli = true;
                } else if (claude-collegato && claude-righe.length > 0) {
                    fuoco-sessione-id = claude-righe[min(claude-righe.length - 1, fuoco-sessione-valido + 1)].id;
                }
            }
        } else if (zona == Zona.contenuto && vista == "collegamenti" && collegamenti.length > 0) {
            // -1 = «Modifica» nella testata: ↑ dalla prima riga, ↓ torna alle card.
            if (fuoco-collegamento < 0) {
                if (k == Key.DownArrow) {
                    fuoco-collegamento = 0;
                }
            } else if (k == Key.LeftArrow) {
                fuoco-collegamento = max(0, fuoco-collegamento-valido - 1);
            } else if (k == Key.RightArrow) {
                fuoco-collegamento = min(collegamenti.length - 1, fuoco-collegamento-valido + 1);
            } else if (k == Key.UpArrow && fuoco-collegamento-valido >= colonne-collegamenti) {
                fuoco-collegamento = fuoco-collegamento-valido - colonne-collegamenti;
            } else if (k == Key.UpArrow) {
                fuoco-collegamento = -1;
            } else if (k == Key.DownArrow && fuoco-collegamento-valido + colonne-collegamenti < collegamenti.length) {
                fuoco-collegamento = fuoco-collegamento-valido + colonne-collegamenti;
            }
        } else if (zona == Zona.contenuto && vista == "casa" && griglia.length > 0) {
            // -1 = «Riprova» nella testata (solo se c'è): ↑ dalla prima riga, ↓ torna alle card.
            // Nella Casa filtrata la testata ha «Spegni tutte» (-1) e «Tutta la casa» (-2).
            if (fuoco-casa < 0) {
                if (k == Key.DownArrow) {
                    fuoco-casa = 0;
                } else if (testata-filtro && k == Key.RightArrow) {
                    fuoco-casa = -2;
                } else if (testata-filtro && k == Key.LeftArrow) {
                    fuoco-casa = -1;
                }
            } else if (k == Key.LeftArrow && mod(fuoco-casa-valido, colonne-casa) == 0 && ha-zona(Zona.stanze)) {
                // Dalla prima colonna all'elenco, sulla voce selezionata (la stanza aperta o
                // «Preferiti»).
                zona = Zona.stanze;
                fuoco-stanza = stanza-aperta;
            } else if (k == Key.LeftArrow) {
                fuoco-casa = max(0, fuoco-casa-valido - 1);
            } else if (k == Key.RightArrow) {
                fuoco-casa = min(griglia.length - 1, fuoco-casa-valido + 1);
            } else if (k == Key.UpArrow && fuoco-casa-valido >= colonne-casa) {
                fuoco-casa = fuoco-casa-valido - colonne-casa;
            } else if (k == Key.UpArrow && (riprova-visibile || testata-filtro)) {
                fuoco-casa = -1;
            } else if (k == Key.DownArrow && fuoco-casa-valido + colonne-casa < griglia.length) {
                fuoco-casa = fuoco-casa-valido + colonne-casa;
            }
        }
    }

    // Invio / Spazio sulla zona col fuoco; `ctrl`: Ctrl+Invio, l'unico tasto che concede un
    // permesso (su un pulsante delicato Invio e Spazio da soli non fanno nulla).
    function attiva(ctrl: bool) {
        if (ctrl) {
            if (zona == Zona.attesa && espansa && fuoco-pulsante >= 0 && indice-aperta >= 0
                    && attese[indice-aperta].pulsanti[fuoco-pulsante].delicato) {
                root.azione(voce-aperta, attese[indice-aperta].pulsanti[fuoco-pulsante].id);
            }
            return;
        }
        if (zona == Zona.attesa && espansa) {
            if (fuoco-pulsante >= 0 && indice-aperta >= 0) {
                if (!attese[indice-aperta].pulsanti[fuoco-pulsante].delicato) {
                    root.azione(voce-aperta, attese[indice-aperta].pulsanti[fuoco-pulsante].id);
                }
            } else {
                riduci-voce();
            }
        } else if (zona == Zona.attesa) {
            apri-voce(min(fuoco-attesa, attese.length - 1));
        } else if (zona == Zona.dock) {
            apri(fuoco-dock, app[fuoco-dock].id);
        } else if (zona == Zona.menu) {
            apri-menu(true);
        } else if (zona == Zona.stanze && fuoco-stanza-valido < 0) {
            scegli-preferiti(true);
        } else if (zona == Zona.stanze) {
            scegli-stanza(fuoco-stanza-valido, true);
        } else if (vista == "panoramica" && fuoco-luci-valido) {
            mostra-luci();
        } else if (vista == "panoramica") {
            root.scorri-layout(1);
        } else if (vista == "claude") {
            if (fuoco-dettagli-valido) {
                root.apri-dettagli-claude();
            } else if (!claude-collegato) {
                root.gestisci-claude();
            } else if (claude-righe.length > 0) {
                root.apri-sessione(claude-righe[fuoco-sessione-valido].id);
            }
        } else if (vista == "collegamenti") {
            if (collegamenti.length == 0 || fuoco-collegamento < 0) {
                root.gestisci-collegamenti();
            } else {
                root.apri-collegamento(collegamenti[fuoco-collegamento-valido].id);
            }
        } else if (vista == "pc") {
            // Sul cursore del volume: muto sì/no, come l'altoparlante; sui riquadri acceso/spento;
            // sulle righe la pagina di Windows.
            if (fuoco-pc-valido == 0) {
                root.muto-volume(!volume-muto);
            } else if (fuoco-pc-valido == 1 || fuoco-pc-valido == 2) {
                commuta(fuoco-pc-valido - 1);
            } else if (fuoco-pc-valido == 3 || fuoco-pc-valido == 4) {
                root.apri-pagina(fuoco-pc-valido - 3);
            }
        } else if (vista == "casa" && filtro-luci && (griglia.length == 0 || (testata-filtro && fuoco-casa == -2))) {
            // Nessuna luce accesa, o «Tutta la casa» nella testata: l'elenco completo.
            esci-filtro();
        } else if (vista == "casa" && griglia.length == 0) {
            root.apri-app("impostazioni");
        } else if (vista == "casa" && testata-filtro && fuoco-casa == -1) {
            // Le luci si spengono tutte: il pulsante sparisce, il fuoco passa prima a `tasti`.
            tasti.focus();
            root.spegni-tutte();
        } else if (vista == "casa" && fuoco-casa < 0) {
            if (riprova-visibile) {
                root.riprova-casa();
            }
        } else if (vista == "casa" && fuoco-casa-valido >= 0 && griglia[fuoco-casa-valido].toccabile) {
            if (filtro-luci) {
                // La luce spenta esce dall'elenco: il fuoco passa prima a `tasti`, poi alla riga
                // che prende il suo posto (o alla più vicina).
                tasti.focus();
            }
            root.tocca(griglia[fuoco-casa-valido].entity-id);
        }
    }

    // Tiene la tastiera di tutto il pannello: intercetta ogni tasto prima dell'elemento col fuoco
    // (`capture-key-pressed`), che sia lui o un elemento dentro. Il fuoco vero va sull'elemento
    // scelto da tastiera (FE13: Narrator ne legge ruolo e nome); col mouse, o se quell'elemento
    // non c'è più, torna qui.
    tasti := FocusScope {
        accessible-role: groupbox;
        accessible-label: "Pannello di ItsyHome";
        capture-key-pressed(evento) => {
            // Un livello alla volta: con una voce espansa il primo Esc la riduce; con una stanza
            // aperta torna a «Preferiti»; poi chiude il pannello.
            if (evento.text == Key.Escape) {
                if (espansa) {
                    riduci-voce();
                } else if (filtro-luci && vista == "casa") {
                    esci-filtro();
                } else if (stanza-aperta >= 0) {
                    chiudi-stanza-ora();
                } else {
                    root.chiudi();
                }
                return accept;
            }
            if (evento.text == Key.Tab || evento.text == Key.Backtab) {
                da-tastiera = true;
                premi-tab(evento.text == Key.Tab && !evento.modifiers.shift);
                return accept;
            }
            if (evento.text == Key.Backspace || (evento.text == Key.LeftArrow && evento.modifiers.alt)) {
                if (vista == "panoramica") {
                    return reject;
                }
                da-tastiera = true;
                indietro();
                return accept;
            }
            // Ctrl+Invio esatto (niente Alt, AltGr, Maiusc o Win) prima del rifiuto dei modificatori:
            // concede il permesso col fuoco.
            if (evento.text == Key.Return && evento.modifiers.control && !evento.modifiers.alt
                    && !evento.modifiers.meta && !evento.modifiers.shift) {
                da-tastiera = true;
                attiva(true);
                return accept;
            }
            // Invio o Spazio con qualunque altro modificatore: presi qui e ignorati. Rifiutati,
            // arriverebbero all'elemento col fuoco vero (un pulsante, magari «Consenti»).
            if (evento.text == Key.Return || evento.text == Key.Space) {
                if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta || evento.modifiers.shift) {
                    return accept;
                }
            }
            if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
                return reject;
            }
            if (evento.text == Key.LeftArrow || evento.text == Key.RightArrow || evento.text == Key.UpArrow || evento.text == Key.DownArrow) {
                da-tastiera = true;
                freccia(evento.text);
                return accept;
            }
            if (evento.text == Key.Return || evento.text == Key.Space) {
                da-tastiera = true;
                attiva(false);
                return accept;
            }
            // Home/Fine sul cursore del volume: 0 e 100.
            if ((evento.text == Key.Home || evento.text == Key.End) && zona == Zona.contenuto && vista == "pc"
                    && fuoco-pc-valido == 0) {
                da-tastiera = true;
                cambia-volume(evento.text == Key.Home ? 0 : 1);
                return accept;
            }
            return reject;
        }

        // Apertura: il pannello scende dalla riga degli occhi e compare (opacità + altezza, 200 ms).
        // Con il movimento ridotto non scende: compare soltanto, in dissolvenza (120 ms).
        corpo := Rectangle {
            y: 0;
            height: aperto ? root.height : altezza-riga;
            opacity: aperto ? 1 : 0;
            animate height { duration: Movimento.ridotto ? 0ms : 200ms; easing: ease-out; }
            animate opacity { duration: Movimento.ridotto ? 120ms : 200ms; easing: ease-out; }
            border-radius: Tema.raggio-pannello;
            clip: true;
            // Anello sottile con i colori dei petali, come il bordo dell'isola nella bozza (fermo).
            background: Tema.petali;

            // Filo di 1,5 px arrotondato al pixel fisico (FE27): a 1,25 e 1,75 non si sfoca.
            Rectangle {
                property <length> filo: Tema.sul-pixel(1.5px);
                x: filo;
                y: filo;
                width: parent.width - 2 * filo;
                height: parent.height - 2 * filo;
                border-radius: parent.border-radius - filo;
                clip: true;
                background: Tema.corpo;

                // Due bagliori appena percettibili (indaco in alto a sinistra, verde acqua in basso a destra).
                // Quadrati con la sfumatura che svanisce prima dei lati: nessun bordo visibile.
                Rectangle {
                    x: -100px;
                    y: -220px;
                    width: 440px;
                    height: 440px;
                    background: @radial-gradient(circle, Tema.bagliore-indaco 0%, transparent 60%);
                }

                Rectangle {
                    x: parent.width - 230px;
                    y: parent.height - 190px;
                    width: 400px;
                    height: 400px;
                    background: @radial-gradient(circle, Tema.bagliore-acqua 0%, transparent 60%);
                }
            }

            // Riga alta: occhi al centro, ora a destra e poi «⋯».
            // Il battito di ciglia (dentro Occhi) solo a pannello aperto.
            occhi := Occhi {
                umore: root.umore;
                attivo: aperto;
                // Restano sugli occhi della pillola mentre il pannello compare, poi vanno al centro
                // (solo lo scarto è animato: un cambio d'umore li ricentra subito).
                property <length> scarto: occhi-al-centro ? 0px : partenza-occhi;
                property <length> scarto-y: occhi-al-centro ? 0px : partenza-occhi-y;
                animate scarto, scarto-y { duration: Movimento.ridotto ? 0ms : 240ms; easing: ease-in-out; }
                x: (parent.width - self.ingombro) / 2 + self.scarto;
                y: self.scarto-y;
                width: self.ingombro;
                height: altezza-riga;
                accessible-role: button;
                accessible-label: "Chiudi il pannello";
                accessible-action-default => { root.chiudi(); }

                TouchArea {
                    // Un po' più larga degli occhi, per non doverli centrare al pixel.
                    x: -12px;
                    width: parent.width + 24px;
                    mouse-cursor: pointer;
                    clicked => { root.chiudi(); }
                }
            }

            // Data e meteo, a sinistra degli occhi, solo nella Panoramica.
            if vista == "panoramica" && riga-sinistra != "": Text {
                x: 12px;
                y: 0;
                width: max(0px, (parent.width - occhi.ingombro) / 2 - 12px - 8px);
                height: altezza-riga;
                text: riga-sinistra;
                overflow: elide;
                vertical-alignment: center;
                font-family: Tema.carattere-mono;
                font-size: Tema.testo-piccolo;
                color: Tema.testo-tenue;
                accessible-role: text;
                accessible-label: riga-sinistra-nome;
            }

            // L'ora piccola in alto a destra: nel layout Orologio della Panoramica c'è già quella
            // grande al centro, ripeterla è rumore (R1-14); una voce espansa copre il centro e la
            // riporta.
            Text {
                visible: ora-riga-visibile;
                x: 0;
                y: 0;
                width: piu.x - 6px;
                height: altezza-riga;
                text: ora;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: Tema.carattere-mono;
                font-size: Tema.testo-corpo;
                color: Tema.testo-ora;
            }

            // «⋯» (Task 14i): il menu dell'isola senza «Apri», con Impostazioni in testa. Bersaglio
            // 28 × 28, capsula tenue al passaggio come le schede del dock, anello da tastiera.
            piu := Rectangle {
                width: 28px;
                height: 28px;
                x: parent.width - 12px - self.width;
                y: (altezza-riga - self.height) / 2;
                border-radius: self.height / 2;
                background: area-piu.has-hover ? Tema.scheda-sopra : transparent;
                accessible-role: button;
                accessible-label: "Altre opzioni";
                accessible-action-default => { apri-menu(true); }

                fuoco-menu := Fuoco { chiede: da-tastiera && zona == Zona.menu; }

                Image {
                    source: Icone.altre-opzioni;
                    width: 18px;
                    height: 18px;
                    accessible-role: none;
                    colorize: Tema.icona;
                    image-rendering: smooth;
                }

                area-piu := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        da-tastiera = false;
                        apri-menu(false);
                    }
                }

                // Dentro la riga alta (il corpo ritaglia): l'anello sta a filo del bersaglio.
                if da-tastiera && zona == Zona.menu: Anello {
                    raggio: parent.border-radius;
                    distanza: 0px;
                }
            }

            // «In attesa»: in cima alla Panoramica, solo se c'è qualcosa.
            if con-attese && !espansa: RigaAttesa {
                x: centro-x;
                y: centro-y;
                width: centro-l;
                height: altezza-attese;
                voci: root.attese;
                fuoco: da-tastiera && zona == Zona.attesa ? fuoco-attesa : -1;
                scelta(i) => {
                    da-tastiera = false;
                    apri-voce(i);
                }
            }

            // Una voce espansa sul posto: copre la riga e il layout (nessuna vista nuova).
            if espansa: VoceEspansa {
                x: centro-x;
                y: centro-y;
                width: centro-l;
                height: centro-a;
                voce: root.attese[indice-aperta];
                posizione: indice-aperta;
                totale: root.attese.length;
                fuoco: !(da-tastiera && zona == Zona.attesa) ? -1 : fuoco-pulsante >= 0 ? fuoco-pulsante : -2;
                scorri-su: root.testo-su;
                scorri-giu: root.testo-giu;
                fondo(a-fondo) => { root.testo-a-fondo = a-fondo; }
                riduci => {
                    da-tastiera = false;
                    riduci-voce();
                }
                precedente => {
                    da-tastiera = false;
                    apri-voce(indice-aperta > 0 ? indice-aperta - 1 : root.attese.length - 1);
                }
                successiva => {
                    da-tastiera = false;
                    apri-voce(indice-aperta < root.attese.length - 1 ? indice-aperta + 1 : 0);
                }
                azione(p) => {
                    da-tastiera = false;
                    root.azione(voce-aperta, p);
                }
            }

            // Centro: la Panoramica (solo sintesi, nessun comando) o la vista dell'app.
            Rectangle {
                x: centro-x + scarto-contenuto;
                y: centro-y + sotto-attese;
                width: centro-l;
                height: centro-a - sotto-attese;
                visible: !espansa;
                opacity: opacita-contenuto;

                // Il fuoco vero della riga «N luci accese»: un elemento sempre presente (mai dentro un
                // `if`: distrutto col fuoco addosso, il pannello resterebbe senza tastiera) che i layout
                // non possiedono. Quando smette di valere il fuoco torna a `tasti`.
                fuoco-luci-el := Fuoco {
                    width: parent.width;
                    height: parent.height;
                    chiede: fuoco-luci-valido && da-tastiera;
                    accessible-role: button;
                    accessible-enabled: fuoco-luci-valido;
                    accessible-label: !fuoco-luci-valido ? ""
                        : casa-da-configurare ? (layout == 0 ? "Collega la casa: apri le Impostazioni" : "CASA, Collega la casa: apri le Impostazioni")
                        : layout == 0 ? "Casa · " + stato-casa + ": mostra le luci accese"
                        : "CASA, " + stato-casa + ": mostra le luci accese";
                    accessible-action-default => { mostra-luci(); }
                }
                // La rotella sulla Panoramica cambia layout (in giù il successivo). Sta sotto i layout,
                // che hanno il loro clic («N luci accese»).
                if vista == "panoramica": TouchArea {
                    width: parent.width;
                    height: parent.height;
                    scroll-event(evento) => {
                        if (rotella-ferma) {
                            return accept;
                        }
                        rotella += abs(evento.delta-x) > abs(evento.delta-y) ? evento.delta-x : evento.delta-y;
                        silenzio-rotella.running = true;
                        silenzio-rotella.restart();
                        if (abs(rotella) >= 24px) {
                            root.scorri-layout(rotella < 0 ? 1 : -1);
                            rotella = 0px;
                            rotella-ferma = true;
                        }
                        return accept;
                    }
                }

                if vista == "panoramica" && layout == 0: LayoutOrologio {
                    width: parent.width;
                    height: parent.height;
                    ora: root.ora;
                    data: root.data;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    pc: root.pc;
                    luci-cliccabili: root.luci-cliccabili;
                    casa-invito: root.casa-da-configurare;
                    anello-luci: root.fuoco-luci-valido && root.da-tastiera;
                    apri-luci => { mostra-luci(); }
                }
                if vista == "panoramica" && layout == 1: LayoutQuadranti {
                    width: parent.width;
                    height: parent.height;
                    stat: root.pc;
                    sensori: root.sensori;
                    quadranti: root.quadranti;
                    ora: root.ora;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    luci-cliccabili: root.luci-cliccabili;
                    casa-invito: root.casa-da-configurare;
                    anello-luci: root.fuoco-luci-valido && root.da-tastiera;
                    apri-luci => { mostra-luci(); }
                }

                if vista == "casa": VistaCasa {
                    width: parent.width;
                    height: parent.height;
                    voci: root.griglia;
                    stanze: root.stanze;
                    stanza-aperta: root.stanza-aperta;
                    // Ogni fuoco della vista chiede anche `vista == "casa"`: lasciando la vista, la
                    // zona nuova non deve accendere il fuoco su un elemento che sta sparendo (il suo
                    // `changed` girerebbe dopo, su un elemento distrutto, e il pannello resterebbe
                    // senza tastiera).
                    fuoco-stanza: da-tastiera && zona == Zona.stanze && vista == "casa" && fuoco-stanza-valido >= 0 ? fuoco-stanza-valido : -1;
                    fuoco-preferiti: da-tastiera && zona == Zona.stanze && vista == "casa" && fuoco-stanza-valido < 0;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    dati-delle: root.dati-delle;
                    riprova: riprova-visibile;
                    colonne: root.colonne-casa;
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "casa" ? fuoco-casa-valido : -1;
                    fuoco-riprova: da-tastiera && zona == Zona.contenuto && vista == "casa" && fuoco-casa < 0 && !testata-filtro;
                    fuoco-impostazioni: da-tastiera && zona == Zona.contenuto && vista == "casa";
                    filtro-luci: root.filtro-luci;
                    fuoco-spegni: da-tastiera && zona == Zona.contenuto && vista == "casa" && testata-filtro && fuoco-casa == -1 && griglia.length > 0;
                    fuoco-tutta: da-tastiera && zona == Zona.contenuto && vista == "casa" && filtro-luci && ((testata-filtro && fuoco-casa == -2) || griglia.length == 0);
                    tocca(id) => {
                        da-tastiera = false;
                        root.tocca(id);
                    }
                    scegli-stanza(i) => {
                        da-tastiera = false;
                        scegli-stanza(i, false);
                    }
                    scegli-preferiti => {
                        da-tastiera = false;
                        scegli-preferiti(false);
                    }
                    riprova-casa => {
                        da-tastiera = false;
                        root.riprova-casa();
                    }
                    spegni-tutte => {
                        da-tastiera = false;
                        root.spegni-tutte();
                    }
                    mostra-tutta => {
                        da-tastiera = false;
                        esci-filtro();
                    }
                    apri-impostazioni => {
                        da-tastiera = false;
                        root.apri-app("impostazioni");
                    }
                }

                if vista == "claude": VistaClaude {
                    width: parent.width;
                    height: parent.height;
                    collegato: root.claude-collegato;
                    righe: root.claude-righe;
                    altre: root.claude-altre;
                    cinque-ore: root.claude-cinque-ore;
                    sette-giorni: root.claude-sette-giorni;
                    soglia: root.claude-soglia;
                    spesa: root.claude-spesa;
                    spesa-nota: root.claude-spesa-nota;
                    dettagli-visibili: root.claude-dettagli;
                    fuoco-dettagli: da-tastiera && zona == Zona.contenuto && vista == "claude" && fuoco-dettagli-valido;
                    // Come nelle altre viste, il fuoco chiede anche la vista (lasciandola non si
                    // accende su un elemento che sta sparendo).
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "claude" && claude-collegato && !fuoco-dettagli-valido ? fuoco-sessione-valido : -1;
                    fuoco-impostazioni: da-tastiera && zona == Zona.contenuto && vista == "claude" && !claude-collegato && !fuoco-dettagli-valido;
                    apri-sessione(id) => {
                        da-tastiera = false;
                        root.apri-sessione(id);
                    }
                    gestisci => {
                        da-tastiera = false;
                        root.gestisci-claude();
                    }
                    dettagli => {
                        da-tastiera = false;
                        root.apri-dettagli-claude();
                    }
                }

                if vista == "collegamenti": VistaCollegamenti {
                    width: parent.width;
                    height: parent.height;
                    voci: root.collegamenti;
                    errore: root.errore-collegamenti;
                    colonne: root.colonne-collegamenti;
                    // Come nella vista Casa: ogni fuoco chiede anche la vista, perché lasciandola
                    // la zona nuova non accenda il fuoco su un elemento che sta sparendo.
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "collegamenti" ? fuoco-collegamento-valido : -1;
                    fuoco-modifica: da-tastiera && zona == Zona.contenuto && vista == "collegamenti" && fuoco-collegamento < 0;
                    fuoco-aggiungi: da-tastiera && zona == Zona.contenuto && vista == "collegamenti";
                    apri(id) => {
                        da-tastiera = false;
                        root.apri-collegamento(id);
                    }
                    gestisci => {
                        da-tastiera = false;
                        root.gestisci-collegamenti();
                    }
                }

                if vista == "pc": VistaPc {
                    width: parent.width;
                    height: parent.height;
                    stat: root.pc;
                    volume-disponibile: root.volume-disponibile;
                    volume: root.volume;
                    volume-muto: root.volume-muto;
                    connessioni-disponibili: root.connessioni-disponibili;
                    radio-lette: root.radio-lette;
                    wifi-presente: root.wifi-presente;
                    wifi-acceso: root.wifi-acceso;
                    bt-presente: root.bt-presente;
                    bt-acceso: root.bt-acceso;
                    nome-rete: root.nome-rete;
                    rete-nota: root.rete-nota;
                    rete: root.rete;
                    tacche: root.tacche;
                    errore-radio: root.errore-radio;
                    cuffie-presenti: root.cuffie-presenti;
                    cuffie-dettaglio: root.cuffie-dettaglio;
                    cuffie-testo: root.cuffie-testo;
                    cuffie-frazione: root.cuffie-frazione;
                    cuffie-tinta: root.cuffie-tinta;
                    cuffie-descrizione: root.cuffie-descrizione;
                    // Come nelle altre viste, il fuoco chiede anche la vista (lasciandola non si
                    // accende su un elemento che sta sparendo).
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "pc" ? fuoco-pc-valido : -1;
                    commuta-radio(tipo, acceso) => {
                        da-tastiera = false;
                        fuoco-pc = tipo + 1;
                        commuta(tipo);
                    }
                    apri-pagina(i) => {
                        da-tastiera = false;
                        root.apri-pagina(i);
                    }
                    imposta-volume(v) => {
                        da-tastiera = false;
                        cambia-volume(v);
                    }
                    muto-volume(si) => {
                        da-tastiera = false;
                        root.muto-volume(si);
                    }
                }

                // Vista di un'app senza contenuti propri: solo il titolo (oggi nessuna; le Impostazioni
                // hanno una finestra loro).
                // Una sola, e creata solo se serve (FE4): l'app è quella scelta per ultima nel dock.
                if vista-vuota: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: center;

                        Image {
                            source: app[indice-vista].icona;
                            accessible-role: none;
                            width: 38px;
                            height: 38px;
                            colorize: Tema.icona;
                            image-rendering: smooth;
                        }
                    }

                    Text {
                        text: app[indice-vista].nome;
                        horizontal-alignment: center;
                        font-weight: 500;
                        font-size: Tema.testo-vuoto;
                        color: Tema.testo;
                    }
                }
            }

            // Puntini dei layout, solo nella Panoramica e non sotto una voce espansa (il layout è
            // coperto): quello attivo è allungato. Bersagli 24 × 24 (WCAG 2.2), disegno invariato.
            if vista == "panoramica" && !espansa: HorizontalLayout {
                x: 0;
                width: parent.width;
                y: puntini-y;
                height: altezza-puntini;
                alignment: center;

                Rectangle {
                    // Gruppo dei puntini: l'anello del fuoco li circonda tutti.
                    accessible-role: tab-list;
                    accessible-label: "Layout della Panoramica";

                    HorizontalLayout {
                        for nome[i] in ["Orologio", "Quadranti"]: Rectangle {
                            property <bool> attivo: i == layout;
                            width: max(24px, (attivo ? 14px : 6px) + 8px);
                            height: altezza-puntini;
                            accessible-role: tab;
                            accessible-label: "Layout " + nome;
                            accessible-item-selectable: true;
                            accessible-item-selected: attivo;
                            accessible-item-index: i;
                            accessible-item-count: 2;
                            accessible-action-default => { scegli(i); }

                            // Il fuoco vero sul layout attivo: ←/→ lo cambiano e il fuoco lo segue.
                            Fuoco { chiede: attivo && da-tastiera && zona == Zona.contenuto && !fuoco-luci-valido; }

                            Rectangle {
                                width: attivo ? 14px : 6px;
                                height: 6px;
                                border-radius: self.height / 2;
                                background: attivo ? Tema.testo : Tema.puntino;
                            }

                            // Più alta della riga (20): 24 × 24 senza spostare dock e layout.
                            TouchArea {
                                y: (parent.height - self.height) / 2;
                                height: 24px;
                                mouse-cursor: pointer;
                                clicked => {
                                    da-tastiera = false;
                                    scegli(i);
                                }
                            }
                        }
                    }

                    // Solo ai lati: sopra e sotto c'è appena posto fra layout e dock.
                    if da-tastiera && zona == Zona.contenuto: Anello {
                        distanza-y: -2px;
                        raggio-anello: self.height / 2;
                    }
                }
            }

            // Dock centrato: solo le app del registro, solo icone (il nome nel suggerimento).
            HorizontalLayout {
                x: 0;
                width: parent.width;
                y: dock-y;
                height: altezza-dock;
                alignment: center;

                Rectangle {
                    border-radius: altezza-dock / 2;
                    background: Tema.capsula;
                    accessible-role: tab-list;
                    accessible-label: "App";
                    // Mezzo pixel come prima: `sul-pixel` lo porterebbe a 1 px pieno a scala 1.
                    border-width: 0.5px;
                    border-color: Tema.vetro-bordo;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 4px;

                        for voce[i] in app: Scheda {
                            icona: voce.icona;
                            nome: voce.nome;
                            indice: i;
                            quante: app.length;
                            attiva: vista == voce.id;
                            anello: da-tastiera && zona == Zona.dock && fuoco-dock == i;
                            scelta => {
                                da-tastiera = false;
                                apri(i, voce.id);
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 400ms;
        running: rotella-ferma;
        triggered => {
            rotella-ferma = false;
            rotella = 0px;
        }
    }

    // Fa partire l'arrivo animato del contenuto, 16 ms dopo il punto di partenza.
    arrivo := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            in-arrivo = true;
            scarto-contenuto = 0px;
            opacita-contenuto = 1;
        }
    }

    // Dopo un breve silenzio della rotella l'accumulo riparte da zero: piccoli passi di gesti
    // diversi del touchpad non si sommano fino a cambiare layout. Gira solo durante lo scorrimento.
    silenzio-rotella := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            rotella = 0px;
            self.running = false;
        }
    }

    // Il fuoco vero sugli elementi solo a pannello sceso (vedi `Fuochi`): l'apertura dura 200 ms.
    init => { Fuochi.pronti = false; }
    Timer {
        interval: 220ms;
        running: aperto && !Fuochi.pronti;
        triggered => { Fuochi.pronti = true; }
    }

    // C'è un elemento per la zona e l'indice col fuoco da tastiera? Se no (clic col mouse, voce
    // sparita, Casa svuotata) il fuoco torna a `tasti`, che tiene comunque la tastiera.
    property <bool> bersaglio: zona == Zona.attesa ? (espansa || (con-attese && (fuoco-attesa < min(Attesa.visibili, attese.length) || (fuoco-attesa == Attesa.visibili && attese.length > Attesa.visibili))))
        : zona == Zona.stanze ? ha-zona(Zona.stanze)
        : zona == Zona.contenuto ? ha-zona(Zona.contenuto) && (vista == "panoramica" || vista == "collegamenti" || vista == "claude" || vista == "pc"
            || (griglia.length > 0 ? (fuoco-casa >= 0 || riprova-visibile) : !casa-pronta))
        : true;
    property <bool> fuoco-su-elemento: da-tastiera && bersaglio;
    changed fuoco-su-elemento => {
        if (!self.fuoco-su-elemento) {
            tasti.focus();
        }
    }

    Timer {
        interval: 160ms;
        running: aperto && !occhi-al-centro;
        triggered => {
            occhi-al-centro = true;
        }
    }

}
