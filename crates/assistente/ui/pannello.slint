// Il pannello unico dell'assistente (spec §3bis), nella cornice nera del ridisegno F1
// (`guscio/cornice.slint`): isola 800 × 340 con le orecchie (finestra 820 × 340), la luce del tono
// più urgente dal basso. Riga alta 44: occhi al centro (partono da dove stavano quelli della
// pillola), a sinistra data e meteo (solo nella Panoramica; nelle app resta vuota), l'ora a destra
// e dopo di lei «⋯» (Task 14i: il menu dell'isola senza «Apri», con Impostazioni in testa); niente
// «‹ Indietro» (Task 14g: alla Panoramica si torna dalla barra, con Backspace o Alt+←; nella vista
// Casa «Preferiti» è la prima voce dell'elenco). Corpo 752 × 224 a (34, 44): la Panoramica
// (`guscio/panoramica.slint`: l'orologio grande o, al suo posto, la voce che ti aspetta, e sotto
// le carte dei moduli; «N in attesa ›» nella riga alta. In Orologio, Task 9: fascia e tessere, gli
// avvisi nella fascia) o la vista di un'app. Barra bassa 64:
// ricerca (inerte in F1), le schede con la capsula che scivola, il volume.
//
// Tastiera: nella Panoramica Tab / Maiusc+Tab seguono l'ordine che calcola Rust
// (`prossimo-fuoco`, `moduli::panoramica::ordine_tab`): voce («Nega» → «Consenti» o «Apri» →
// «+N»), «N in attesa ›», carte (corpo → azione), schede, ricerca, volume, «⋯». Nelle altre viste
// fra stanze, contenuto, schede, ricerca, volume (se c'è) e «⋯» (in
// giro: da «⋯» Tab torna in cima; Invio o Spazio lì aprono il menu, che è in Slint dentro il
// pannello — `menu.slint`, RC-58: con il menu aperto i tasti sono suoi e Esc chiude solo lui);
// Invio o Spazio sul volume: muto sì/no; frecce dentro la zona
// (nella Coda ↑/↓ fra le righe,
// → ai pulsanti (si entra su «Nega» se c'è, altrimenti sul primo), ← indietro fino alla riga,
// Invio sul pulsante (mai su un consenso); un permesso si apre (Invio, «Apri», clic) col testo
// intero: ↑/↓ lo scorrono, «Consenti» c'è solo dopo il fondo del testo e solo con Ctrl+Invio
// esatto, Esc o Backspace lo richiudono; nella
// Panoramica ←/→ fra i bersagli (voce e carte), ↑/↓ fra la voce e le carte; Invio su una carta
// apre la sua pagina, sul suo bottone fa l'azione; sulla voce Invio preme «Nega» (mai un consenso:
// «Consenti» solo con Ctrl+Invio esatto); nelle schede ←/→ cambiano scheda; in Casa Tab passa dall'elenco alle
// card: ↑/↓ fra «Preferiti» e le stanze e → alle card, le frecce fra le card, ← dalla prima colonna all'elenco
// e ↑ dalla prima riga a «Riprova» quando c'è; Casa vuota e non connessa: «Apri Impostazioni»);
// In Collegamenti le frecce fra le card, ↑ dalla prima riga a «Modifica»; Invio apre la pagina.
// Nella pagina Agenti (impianto Elenco + dettaglio, ridisegno F2) ↑/↓ fra le righe delle sessioni
// (↑ dalla prima porta a «Dettagli» della testata, se c'è; ↓ torna), → al pulsante del dettaglio e
// ← di nuovo alla riga; Invio sulla riga di una sessione apre il terminale, sul pulsante lo preme;
// la riga col permesso ha per dettaglio il permesso stesso (Task 7): → o Invio portano su «Nega»
// (mai una decisione), lì i tasti sono quelli del permesso («Consenti» dopo il fondo del testo e
// solo con Ctrl+Invio esatto), ← dal primo bersaglio torna alla riga; scollegato Invio preme
// «Collega»; Backspace un livello (dettaglio → elenco → Panoramica).
// Nella vista PC il contenuto sono il cursore del volume e, su Windows, i riquadri Wi-Fi e
// Bluetooth e le righe «Reti Wi-Fi ›» e «Dispositivi Bluetooth ›» (M2, Task 8): Tab e Maiusc+Tab
// passano dall'uno all'altro prima di lasciare la vista; sul cursore ←/→ ±2 punti, Home/Fine
// 0/100, Invio o Spazio muto sì/no; fra riquadri e righe le frecce (← → nella riga, ↑ ↓ fra
// riquadri e righe), Invio o Spazio accendono/spengono o aprono la pagina di Windows.
// Invio o Spazio attivano (su una stanza o «Preferiti»: la sceglie e porta alle card; su «N in
// attesa ›»: apre la Coda); Backspace o Alt+← = indietro (prima torna a
// «Preferiti»; dalla Coda alla Panoramica); Esc un livello alla volta: torna a «Preferiti», poi
// chiude il pannello.
// Un unico FocusScope tiene il fuoco e l'anello (visibile solo da tastiera) segue la
// zona scelta.
import { Tema, Movimento } from "tema.slint";
import { Occhi } from "faccia.slint";
import { Anello, Fuoco, Fuochi, Inerzia } from "componenti.slint";
import { ContornoIsola, RigaAlta, Barra } from "guscio/cornice.slint";
import { SchedaBarraUi, StatPcUi, PreferitoUi, PulsanteUi, VoceAttesaUi, UmoreUi, StanzaUi, CollegamentoUi, TipoReteUi, TintaBatteriaUi, VoceMenuUi, SchermoMenuUi, ModuloUi, TonoModuloUi, LivelloUi, RigaModuloUi, SintesiUi, StatoPaginaUi, TipoStatoPaginaUi } from "voci.slint";
import { ImpiantoElenco } from "impianti/elenco.slint";
import { ImpiantoElencoDettaglio, GeometriaElencoDettaglio } from "impianti/elenco_dettaglio.slint";
import { TestataPagina, StatoPagina } from "guscio/pagina.slint";
import { Permesso, Permessi } from "guscio/permesso.slint";
import { MenuScuro } from "menu.slint";
import { VistaPc } from "viste/pc.slint";
import { VistaCasa } from "viste/casa.slint";
import { VistaCollegamenti } from "viste/collegamenti.slint";
import { Panoramica, Bersagli } from "guscio/panoramica.slint";

export { SchedaBarraUi, StatPcUi, PreferitoUi, PulsanteUi, VoceAttesaUi, StanzaUi }

// Zona del pannello col fuoco da tastiera (`dock`: le schede della barra).
enum Zona { attesa, stanze, contenuto, dock, ricerca, volume, menu }

export component Pannello inherits Window {
    in property <UmoreUi> umore: UmoreUi.tranquillo;
    in property <string> ora;
    in property <string> data;
    // Le cifre dell'ora grande, già divise da Rust («0», «9», «:», «4», «5»), scritte con `ora`.
    in property <[string]> ora-cifre;
    // Parte sinistra della riga alta, solo nella Panoramica (nelle app resta vuota): data breve e
    // meteo, scritti da Rust solo quando cambiano; il nome è per Narrator.
    in property <string> riga-sinistra;
    in property <string> riga-sinistra-nome;
    // La voce che ti aspetta si vede al posto dell'orologio: la prima voce in attesa, se è
    // bloccante, nella Panoramica. Le altre voci le conta il suo «+N».
    out property <bool> voce-mostrata: vista == "panoramica" && attese.length > 0 && attese[0].livello == LivelloUi.bloccante;
    out property <bool> voce-altre: voce-mostrata && attese.length > 1;
    // «N in attesa ›» della riga alta (`moduli::panoramica::in_attesa_non_mostrate`, scritto da
    // Rust solo quando cambia): le voci in attesa che la Panoramica non mostra già.
    in property <int> in-attesa;
    // La modalità della Panoramica (Impostazioni › Isola › Panoramica): 0 Griglia, 1 Orologio.
    // La scrive Rust all'apertura (`ModoPanoramica::indice`). Nell'Orologio «N in attesa ›» non
    // sta nella riga alta ma nella fascia («{n} avvisi ›», stesso bersaglio e posto di Tab).
    in property <int> panoramica;
    property <bool> orologio: panoramica == 1;
    // La fascia dell'Orologio (`moduli::panoramica::fascia`, scritta da Rust solo se cambia).
    in property <string> fascia-testo;
    in property <string> fascia-nome;
    in property <string> fascia-avvisi;
    // L'ora piccola della riga alta: nascosta quando la Panoramica mostra l'orologio grande.
    out property <bool> ora-riga-visibile: !(vista == "panoramica" && !voce-mostrata);
    // Il bersaglio col fuoco nella Panoramica (`Bersagli`: 2k la carta k, 2k + 1 la sua azione,
    // 100/101/102 la voce, -1 nessuno). Tab lo muove con `prossimo-fuoco` (l'ordine lo decide Rust
    // da ciò che c'è adesso).
    in-out property <int> fuoco: -1;
    callback prossimo-fuoco(int, bool) -> int;
    // L'app mostrata al centro; "panoramica" è la schermata principale. È l'id di un'app del
    // registro (un dato, non uno stato con un nome: resta una stringa); "coda" è la Coda del guscio
    // (le voci in attesa), che non ha una scheda.
    in-out property <string> vista: "panoramica";
    // Le schede della barra (la Panoramica e i moduli del registro, nell'ordine): nome, geometria,
    // segno e nome per Narrator li scrive Rust (`Ponte::scrivi_schede`) all'apertura, a ogni cambio
    // di vista e quando cambia il tono di un modulo; solo le righe cambiate.
    in property <[SchedaBarraUi]> schede;
    // La rotella sul pulsante del volume (impostazione «volume con la rotella», solo Windows).
    in property <bool> rotella-volume;
    // I moduli per le carte della Panoramica (ridisegno F1), nell'ordine del registro, e il tono
    // più urgente fra tutti (la luce dell'isola). Li scrive Rust (`Ponte::moduli_scrivi`), solo
    // quando cambiano; le carte che li mostrano arrivano col Task 8.
    in property <[ModuloUi]> moduli;
    in property <TonoModuloUi> tono-isola;
    // Statistiche del PC, aggiornate ogni 2 s solo a pannello aperto.
    in property <StatPcUi> pc;
    // La pagina Agenti sull'impianto Elenco + dettaglio (ridisegno F2, Task 6): tutto già pronto da
    // `moduli::pagina_agenti`, scritto da Rust solo a pagina aperta e solo se cambia. La sintesi
    // della testata (titolo, limiti, spesa, «Dettagli»), lo stato della pagina (l'elenco o una
    // frase con al più un'azione) e le righe, tutte, nell'ordine fermo deciso da Rust.
    in property <SintesiUi> elenco-sintesi;
    in property <StatoPaginaUi> elenco-stato;
    in property <[RigaModuloUi]> elenco-righe;
    // La riga scelta (indice): il dettaglio è il suo. Rust la tiene sulla stessa sessione, o sulla
    // più vicina se la sua sparisce; ↑/↓ e il clic la muovono.
    in-out property <int> elenco-fuoco: 0;
    // Dove sta il fuoco da tastiera nella pagina: -1 l'azione della testata, 0 l'elenco (o il
    // pulsante dello stato), 1 il pulsante del dettaglio. Si legge sempre in `elenco-lato-valido`.
    in-out property <int> elenco-lato: 0;
    // Il volume del PC nella vista PC (M2, Task 7) e nella barra (ridisegno F1):
    // `volume-disponibile` solo su Windows con un'uscita audio (altrimenti la riga e il pulsante
    // non ci sono); `volume` 0..1 lo scrive Rust (stato letto) e il cursore o la rotella (subito,
    // senza aspettare Windows).
    in property <bool> volume-disponibile: false;
    in-out property <float> volume: 0;
    in property <bool> volume-muto: false;
    // Un livello 0..1 scelto col cursore o con la tastiera; muto sì/no dall'altoparlante o Invio.
    callback imposta-volume(float);
    callback muto-volume(bool);
    // Le connessioni nella vista PC (M2, Task 8, solo Windows: altrove `connessioni-disponibili`
    // resta falso e la colonna ha solo la rete). Gli stati li scrive Rust: le radio lette
    // (`radio-lette`), presenti e accese (l'acceso cambia subito al clic e torna allo stato vero
    // se Windows rifiuta), il nome della rete (solo a vista PC aperta), l'icona della rete
    // (`rete-nota`, `rete`, `tacche`) e la riga in ambra di un rifiuto (`errore-radio`).
    in property <bool> connessioni-disponibili: false;
    in property <bool> radio-lette: false;
    in property <bool> wifi-presente: false;
    in-out property <bool> wifi-acceso: false;
    in property <bool> bt-presente: false;
    in-out property <bool> bt-acceso: false;
    in property <string> nome-rete;
    in property <bool> rete-nota: false;
    in property <TipoReteUi> rete: TipoReteUi.nessuna;
    in property <int> tacche: 0;
    in-out property <bool> errore-radio: false;
    // (0 Wi-Fi / 1 Bluetooth, acceso voluto) e la pagina di Windows (0 reti Wi-Fi, 1 Bluetooth).
    callback commuta-radio(int, bool);
    callback apri-pagina(int);
    // La riga «CUFFIE» della vista PC (M2, Task 9, solo Windows): la scrive Rust dopo una lettura
    // fatta entrando nella vista; senza dispositivi connessi con la batteria leggibile non c'è.
    in property <bool> cuffie-presenti: false;
    in property <string> cuffie-dettaglio;
    in property <string> cuffie-testo;
    in property <float> cuffie-frazione: 0;
    in property <TintaBatteriaUi> cuffie-tinta: TintaBatteriaUi.normale;
    in property <string> cuffie-descrizione;
    // Vero mentre il pannello è aperto: guida l'animazione di apertura e il battito degli occhi.
    in-out property <bool> aperto;
    // Casa: i preferiti (al massimo 8) e la riga di stato.
    in property <[PreferitoUi]> preferiti;
    // Le stanze della vista Casa e i dispositivi della stanza aperta (li dà Rust a `apri-stanza`).
    in property <[StanzaUi]> stanze;
    in property <[PreferitoUi]> dispositivi;
    // Le luci accese adesso (le scrive Rust) e se la vista Casa le mostra al posto dei preferiti:
    // il clic sulla carta Casa con luci accese. Una luce spenta esce dall'elenco subito.
    in property <[PreferitoUi]> luci;
    in-out property <bool> filtro-luci: false;
    // «Spegni tutte» nella testata della vista Casa filtrata: un comando per ogni luce accesa.
    callback spegni-tutte();
    // La stanza aperta (indice in `stanze`, -1 = nessuna). Rust la riallinea se le stanze cambiano.
    in-out property <int> stanza-aperta: -1;
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    // La casa non è configurata (nessun Home Assistant scelto): la vista Casa vuota invita alle
    // Impostazioni (R1-13).
    in property <bool> casa-da-configurare;
    // Senza connessione: l'ora degli ultimi dati («dati delle 10:42») e se ha senso «Riprova».
    in property <string> dati-delle;
    in property <bool> casa-riprovabile;
    // I collegamenti veloci (Task 14f) e l'errore dell'ultimo che non si è aperto (lo scrive Rust).
    in property <[CollegamentoUi]> collegamenti;
    in-out property <string> errore-collegamenti;
    // Da dove partono gli occhi all'apertura, rispetto al centro: aprendo da "ti cerca" sono
    // dove stavano quelli della pillola allargata e, appena il pannello è comparso, scivolano al centro.
    in property <length> partenza-occhi: 0px;
    // Lo stesso in altezza, rispetto al centro della riga alta: la pillola che chiama è più alta.
    in property <length> partenza-occhi-y: 0px;
    // Le voci «In attesa», già in ordine (bloccante, attenzione, informazione; poi le più recenti):
    // la voce che ti aspetta della Panoramica e la Coda. `moduli-in-attesa`: da quanti moduli
    // vengono (la testata della Coda), scritto da Rust solo quando cambia.
    in property <[VoceAttesaUi]> attese;
    in property <int> moduli-in-attesa;
    callback tocca(string);
    // Un pulsante di una voce in attesa nella Coda: (id della voce, id del pulsante).
    callback azione(string, string);
    // Un pulsante della voce che ti aspetta, nella Panoramica (clic, Narrator, Invio, Ctrl+Invio):
    // Rust lo ignora nei 600 ms dopo che la voce mostrata è cambiata (un doppio clic su «Nega»
    // non risponde anche alla voce che prende il suo posto), poi è un'`azione`.
    callback azione-voce(string, string);
    // Un permesso si apre nella Coda, il suo «Consenti» compare (fondo del testo visto) o la voce
    // che ti aspetta compare nella Panoramica: Rust riarma «Consenti» per 600 ms
    // (`claude_superficie_compare`).
    callback consenti-compare();
    // I riarmi della guardia di Rust a pannello aperto (ridisegno F2, Task 4; pre-flight C5): +1
    // se e solo se `dal` si sposta, scritto da Rust. A ogni incremento «Nega» e «Consenti» della
    // voce che ti aspetta e del permesso aperto si vedono inerti per i 600 ms in cui Rust li ignora.
    in property <int> armamenti;
    // L'unico `Inerzia` (ruling del Task 4, dubbio 4): fisso, fuori da ogni `if` e `for`, passa
    // `inerte` alla voce che ti aspetta, ai due permessi (Coda e dettaglio di Agenti) e alle righe
    // della Coda col permesso. Una sola animazione per riarmo.
    inerzia := Inerzia { armamenti: root.armamenti; }
    out property <bool> inerte: inerzia.inerte;    // Dove sta adesso la voce con questo id fra le `attese` (-1: non c'è più). Lo dice Rust, che
    // tiene il modello: il permesso aperto nella Coda segue il suo id quando cambia posto, e si
    // chiude solo quando l'id sparisce (pre-flight C14).
    callback indice-voce(string) -> int;
    // Il bottone d'azione di una carta: (id del modulo, id dell'azione). Lo traduce Rust
    // (`Ponte::azione_modulo`).
    callback azione-modulo(string, string);
    callback apri-app(string);
    // La vista è cambiata (Rust decide quali fonti lente del PC campionare).
    callback vista-cambiata();
    callback chiudi();
    // «Riprova» nella testata della vista Casa (stessa azione della voce «Casa non raggiungibile»).
    callback riprova-casa();
    // Una stanza della vista Casa aperta (area) o chiusa.
    callback apri-stanza(string);
    callback chiudi-stanza();
    // Un'azione di una pagina (id del modulo, id dell'azione, id della riga o ""): il terminale di
    // una sessione, «Collega», «Dettagli» (il permesso di una riga no: si decide nel dettaglio,
    // da `azione-voce`). Va chiamata solo subito dopo
    // il gesto dell'utente; la traduce Rust (`Ponte::azione_pagina`).
    callback azione-pagina(string, string, string);
    // Un collegamento scelto (id): Rust lo apre nel browser e chiude il pannello.
    callback apri-collegamento(string);
    // «Modifica» o «Aggiungi un collegamento»: le Impostazioni sulla scheda Collegamenti.
    callback gestisci-collegamenti();
    // «⋯»: il menu dell'isola (RC-58: Slint, dentro il pannello, sotto il pulsante e allineato al suo
    // bordo destro). Prima di aprirlo `menu()` chiede a Rust le voci di adesso (`voci-menu`,
    // `schermi-menu`, `menu-schermo-scelto`: le stesse di `voci_pannello`, quindi anche la ritirata
    // e i monitor del momento); se Rust non ne dà (fuori da Windows, dove il menu non c'è e Rust apre
    // direttamente le Impostazioni) il menu non si apre. `scelta-menu(id)`: la voce scelta, che Rust
    // ritraduce nel suo comando.
    callback menu();
    callback scelta-menu(string);
    // La lettera premuta a menu aperto (come nei menu nativi): Rust dice la prossima riga che
    // comincia così dopo `da` (-1 = nessuna); `sotto`: nel sottomenu «Schermo».
    callback cerca-iniziale-menu(string, bool, int) -> int;
    in property <[VoceMenuUi]> voci-menu;
    in property <[SchermoMenuUi]> schermi-menu;
    in property <int> menu-schermo-scelto: -1;

    // Geometria (logica, vedi `finestre.rs`): finestra 820 × 340 = isola 800 più le orecchie di
    // 10; riga alta 44 (gli occhi a metà, 6 sotto quelli della pillola: partono da lì), corpo
    // 752 × 224 a (34, 44), barra 64 in fondo. Nel corpo la Panoramica o la vista.
    out property <length> larghezza-finestra: 820px;
    out property <length> larghezza-isola: 800px;
    out property <length> altezza-pannello: 340px;
    out property <length> altezza-riga: 44px;
    property <length> altezza-barra: 64px;
    property <length> corpo-a: altezza-pannello - altezza-riga - altezza-barra - 8px;
    out property <length> centro-x: 34px;
    out property <length> centro-y: altezza-riga;
    out property <length> centro-l: larghezza-finestra - 2 * centro-x;
    // Panoramica, Coda e viste usano tutto il corpo (224; ridisegno F1, Task 10).
    out property <length> centro-a: corpo-a;
    // «⋯» nella riga alta: 32 × 32, 22 dal fianco destro dell'isola.
    property <length> piu-x: (larghezza-finestra + larghezza-isola) / 2 - 22px - 32px;
    property <length> piu-y: (altezza-riga - 32px) / 2;
    // Nella Coda la riga col fuoco è già tenuta dentro le righe che ci sono (`coda-riga`); qui
    // l'indice scritto la raggiunge, così una riga che arriva dopo non si prende il fuoco da sola.
    property <int> n-attese: attese.length;
    changed n-attese => {
        fuoco-coda-riga = coda-riga;
        segui-permesso-aperto();
    }
    // Il permesso aperto nella Coda segue il suo id (pre-flight C14: la validità la decide l'id,
    // non la riga): se una voce prima di lui sparisce o arriva resta aperto e la riga col fuoco
    // lo raggiunge; se il suo id non c'è più (risolto, o un altro permesso al suo posto) si chiude
    // e il fuoco torna sulla riga. Lo chiamano i cambi del numero di voci e dell'id alla riga col
    // fuoco (una voce sostituita sul posto).
    property <string> id-alla-riga: attese[coda-riga].id;
    changed id-alla-riga => { segui-permesso-aperto(); }
    function segui-permesso-aperto() {
        if (coda-aperta != "") {
            let i = root.indice-voce(coda-aperta);
            if (i < 0) {
                chiudi-permesso();
            } else {
                fuoco-coda-riga = i;
                coda-voce-aperta = attese[i];
            }
        }
    }

    // ─── Panoramica: il pool di fuoco (spike 11 §1) ───
    // Il pool vale solo nella Panoramica col fuoco sul contenuto.
    property <bool> pool-attivo: vista == "panoramica" && zona == Zona.contenuto;
    property <int> carte: min(4, moduli.length);
    // Dove va il fuoco quando la voce che ti aspetta compare o cambia: su «Nega»; senza «Nega» (una
    // voce col solo pulsante delicato) su «Apri», che porta al permesso intero; se quel pulsante è
    // «Consenti» (testo intero nella voce) mai su di lui, ma su «+N» o sulla prima carta (-1 se non
    // c'è nulla). Mai un consenso.
    pure function bersaglio-iniziale-voce() -> int {
        if (panoramica-el.indice-nega >= 0) {
            return Bersagli.nega;
        }
        if (panoramica-el.indice-altro >= 0 && attese[0].pulsanti[panoramica-el.indice-altro].delicato
            && !panoramica-el.voce-intera) {
            return Bersagli.consenti;
        }
        if (voce-altre) {
            return Bersagli.altre;
        }
        return carte > 0 ? 0 : -1;
    }
    // Porta il fuoco della Panoramica su `id`. Se cambia, col fuoco sul contenuto, il fuoco vero
    // passa prima a `tasti`: l'elemento di prima può essere sparito (il «Nega» di una voce che non
    // l'ha più) e quello nuovo lo riprende da sé (`chiede-fuoco`); se non c'è, la tastiera resta.
    function sposta-fuoco-voce(id: int) {
        if (id != fuoco && zona == Zona.contenuto) {
            tasti.focus();
        }
        fuoco = id;
    }
    // La voce compare (anche entrando nella Panoramica): il fuoco va al suo bersaglio iniziale e,
    // se è un permesso, «Consenti» si arma di nuovo. La voce sparisce col fuoco addosso (permesso
    // risolto nel terminale): il fuoco va alla prima carta, non si perde.
    changed voce-mostrata => {
        if (voce-mostrata) {
            if (Permessi.chiede(attese[0])) {
                root.consenti-compare();
            }
            if (zona == Zona.contenuto) {
                sposta-fuoco-voce(bersaglio-iniziale-voce());
            }
        } else if (fuoco >= Bersagli.nega && fuoco <= Bersagli.altre) {
            fuoco = carte > 0 ? 0 : -1;
        }
    }
    // Un'altra voce al posto della prima: mai il fuoco sul consenso o su «+N» di una richiesta che
    // non si è scelta, né su un «Nega» che la voce nuova non ha (rimandato n1 di F1); torna al
    // bersaglio iniziale.
    property <string> voce-id: voce-mostrata ? attese[0].id : "";
    changed voce-id => {
        if (voce-mostrata && fuoco >= Bersagli.nega && fuoco <= Bersagli.altre) {
            sposta-fuoco-voce(bersaglio-iniziale-voce());
        }
    }
    // La stessa voce si aggiorna e il suo testo ora sta tutto: il pulsante delicato da «Apri»
    // diventa «Consenti». «Consenti» è comparso, quindi si riarma; e se il fuoco era su «Apri»
    // se ne va (pre-flight C20): mai un consenso col fuoco addosso senza averlo scelto.
    changed voce-intera => {
        if (voce-mostrata && panoramica-el.voce-intera && panoramica-el.indice-altro >= 0
            && attese[0].pulsanti[panoramica-el.indice-altro].delicato) {
            root.consenti-compare();
            if (fuoco == Bersagli.consenti) {
                sposta-fuoco-voce(bersaglio-iniziale-voce());
            }
        }
    }
    property <bool> voce-intera: panoramica-el.voce-intera;
    // «+N» sparisce col fuoco addosso (le altre voci risolte): il fuoco torna al bersaglio
    // iniziale della voce.
    changed voce-altre => {
        if (!voce-altre && fuoco == Bersagli.altre) {
            sposta-fuoco-voce(voce-mostrata ? bersaglio-iniziale-voce() : (carte > 0 ? 0 : -1));
        }
    }
    // Le carte calano col fuoco sull'ultima: il fuoco va alla più vicina.
    changed carte => {
        if (fuoco >= 0 && fuoco < 2 * 4 && floor(fuoco / 2) >= carte) {
            fuoco = carte > 0 ? (carte - 1) * 2 : -1;
        }
    }
    // «N in attesa ›» sparisce col fuoco addosso: il fuoco va al contenuto.
    changed in-attesa => {
        if (in-attesa == 0 && zona == Zona.attesa) {
            zona = Zona.contenuto;
            fuoco = voce-mostrata ? bersaglio-iniziale-voce() : (carte > 0 ? 0 : -1);
        }
    }

    // ─── Scorrimento fra le viste (280 ms) ───
    // Cambiando vista il contenuto (non la riga alta né la barra) parte da 26 px verso il lato
    // della scheda scelta (più a destra nella barra: da destra; più a sinistra, e la Panoramica che è
    // la prima: da sinistra) e arriva al suo posto dissolvendosi dentro. Con «Effetti di animazione»
    // spento niente scarto, solo una dissolvenza da 120 ms. Il `Timer` gira solo i 16 ms del cambio:
    // fuori dall'animazione non c'è nulla da ridisegnare.
    out property <length> scarto-contenuto: 0px;
    property <float> opacita-contenuto: 1;
    property <bool> in-arrivo: true;
    property <int> posizione-prec: 0;
    animate scarto-contenuto { duration: in-arrivo ? 280ms : 0ms; easing: ease-out; }
    animate opacita-contenuto { duration: in-arrivo ? (Movimento.ridotto ? 120ms : 280ms) : 0ms; easing: ease-out; }

    // Posizione di una vista fra le schede (-1: nessuna scheda la mostra).
    pure function scheda-di(v: string) -> int {
        return schede[0].id == v ? 0 : schede[1].id == v ? 1 : schede[2].id == v ? 2 : schede[3].id == v ? 3
            : schede[4].id == v ? 4 : schede[5].id == v ? 5 : schede[6].id == v ? 6 : schede[7].id == v ? 7 : -1;
    }

    // Posizione di una vista nella barra (la Panoramica è la prima); sconosciuta: dopo la Panoramica.
    pure function posizione(v: string) -> int {
        return v == "panoramica" ? 0 : scheda-di(v) >= 0 ? scheda-di(v) : 1;
    }

    // L'uscita audio sparisce col fuoco sul volume: il fuoco va al vicino (la ricerca), non si perde.
    changed volume-disponibile => {
        if (!volume-disponibile && zona == Zona.volume) {
            zona = Zona.ricerca;
        }
    }

    changed vista => {
        root.vista-cambiata();
        let nuova = posizione(vista);
        if (nuova != posizione-prec) {
            // Prima il punto di partenza, senza animazione (`in-arrivo` falso = 0 ms); poi, 16 ms
            // dopo, l'arrivo animato.
            in-arrivo = false;
            scarto-contenuto = Movimento.ridotto ? 0px : nuova > posizione-prec ? 26px : -26px;
            opacita-contenuto = 0;
            arrivo.running = true;
            arrivo.restart();
        }
        posizione-prec = nuova;
    }

    // Diventa vero poco dopo l'apertura, quando i primi fotogrammi hanno già disegnato gli occhi
    // al punto di partenza: solo allora lo scarto si anima (le proprietà si calcolano solo
    // quando servono, quindi un cambio nello stesso istante dell'apertura non si vedrebbe).
    property <bool> occhi-al-centro: partenza-occhi == 0px && partenza-occhi-y == 0px;

    // ─── Tastiera ───
    // Zona col fuoco. All'apertura il fuoco va sul contenuto.
    property <Zona> zona: Zona.contenuto;
    // L'anello si vede solo dopo un tasto; un clic lo spegne.
    property <bool> da-tastiera: false;
    property <int> fuoco-dock: 0;
    property <int> fuoco-casa: 0;
    property <int> colonne-casa: 4;
    // Le card della vista Casa: i dispositivi della stanza aperta, altrimenti i preferiti.
    property <bool> in-stanza: stanza-aperta >= 0 && stanza-aperta < stanze.length;
    // La carta Casa porta alla Casa filtrata sulle luci accese: casa connessa e almeno una luce.
    property <bool> luci-cliccabili: casa-pronta && luci.length > 0;
    // La testata della Casa filtrata ha i suoi pulsanti solo a casa connessa: altrimenti dice lo
    // stato (e «Riprova») come la Casa completa.
    property <bool> testata-filtro: filtro-luci && casa-pronta;
    property <[PreferitoUi]> griglia: filtro-luci ? luci : in-stanza ? dispositivi : preferiti;
    property <int> fuoco-casa-valido: min(fuoco-casa, griglia.length - 1);
    // Voce dell'elenco della vista Casa col fuoco: -1 = «Preferiti», poi l'indice della stanza.
    property <int> fuoco-stanza: -1;
    property <int> fuoco-stanza-valido: max(-1, min(fuoco-stanza, stanze.length - 1));
    // Pagina Agenti: la riga scelta è un indice (`elenco-fuoco`), sempre dentro le righe che ci
    // sono (l'ordine è fermo a pannello aperto e quando ne cambia il numero Rust lo rimette sulla
    // stessa sessione o sulla più vicina). Il lato col fuoco vale solo se il suo elemento c'è:
    // «Dettagli» sparito (la chiave tolta) o un dettaglio senza pulsante riportano all'elenco;
    // senza elenco il fuoco sta sul pulsante dello stato, o su quello della testata.
    property <bool> elenco-pieno: elenco-stato.tipo == TipoStatoPaginaUi.pieno && elenco-righe.length > 0;
    property <bool> elenco-testata: elenco-sintesi.azione-testo != "";
    property <bool> elenco-stato-azione: !elenco-pieno && elenco-stato.azione-testo != "";
    property <int> elenco-riga: max(0, min(elenco-fuoco, elenco-righe.length - 1));
    property <int> elenco-lato-valido: elenco-lato < 0 && elenco-testata ? -1
        : elenco-pieno ? (elenco-lato > 0 && (agenti-con-permesso || elenco-righe[elenco-riga].azione-testo != "") ? 1 : 0)
        : elenco-stato-azione ? 0 : elenco-testata ? -1 : 0;
    // Il permesso nel dettaglio di Agenti (ridisegno F2, Task 7): la riga scelta ha un permesso
    // (`voce`) e al suo posto fra le attese (`attesa`) c'è proprio quella voce, per id; altrimenti
    // il dettaglio è quello della riga (un permesso di un altro non si mostra mai). Lo mostra il
    // `Permesso` fisso `agenti-permesso`; i tasti si decidono su questo, mai su un'azione.
    property <bool> agenti-con-permesso: elenco-pieno && elenco-righe[elenco-riga].voce != ""
        && attese[elenco-righe[elenco-riga].attesa].id == elenco-righe[elenco-riga].voce;
    property <VoceAttesaUi> agenti-voce: agenti-con-permesso ? attese[elenco-righe[elenco-riga].attesa] : voce-vuota;
    property <bool> agenti-permesso-mostrato: vista == "agenti" && agenti-con-permesso;
    // L'id del permesso mostrato ("" nessuno). Cambia quando la scelta arriva su un permesso senza
    // un gesto sul permesso (↑/↓, clic su una riga, la pagina che si apre, la riga col fuoco tolta
    // che lascia il posto a un'altra, un permesso al posto di un altro): «Consenti» c'è o può
    // comparire, quindi si riarma (Review Focus 4). Il fuoco nel permesso riparte da «Nega». Se il
    // fuoco era nel dettaglio (`elenco-lato` 1) e il dettaglio cambia sotto di lui senza che lo si
    // sia scelto — il permesso risolto nel terminale, un permesso al posto del terminale — torna
    // sulla riga: mai una decisione su ciò che non si è scelto (Review Focus 1).
    property <string> agenti-permesso-id: agenti-permesso-mostrato ? agenti-voce.id : "";
    changed agenti-permesso-id => {
        if (elenco-lato == 1) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            elenco-lato = 0;
        }
        agenti-permesso.entra();
        if (agenti-permesso-id != "") {
            root.consenti-compare();
        }
    }
    // Dalla riga al permesso del dettaglio (→ o Invio): il fuoco su «Nega».
    function entra-agenti-permesso() {
        elenco-lato = 1;
        agenti-permesso.entra();
    }
    // Collegamenti: card col fuoco (-1 = «Modifica» nella testata), 3 colonne.
    property <int> fuoco-collegamento: 0;
    property <int> fuoco-collegamento-valido: min(fuoco-collegamento, collegamenti.length - 1);
    property <int> colonne-collegamenti: 3;
    // Vista PC: elemento col fuoco (0 volume, 1 Wi-Fi, 2 Bluetooth, 3 «Reti Wi-Fi ›»,
    // 4 «Dispositivi Bluetooth ›»); se non c'è, il primo che c'è dopo (o prima).
    property <int> fuoco-pc: 0;
    property <int> fuoco-pc-valido: pc-ha(fuoco-pc) ? fuoco-pc
        : pc-successivo(fuoco-pc) >= 0 ? pc-successivo(fuoco-pc) : pc-precedente(fuoco-pc);
    // «Riprova» nella testata della vista Casa: casa non connessa che si può riprovare.
    property <bool> riprova-visibile: !casa-pronta && casa-riprovabile && (griglia.length > 0 || stanze.length > 0);
    // Coda: il fuoco è un indice, come `claude-fuoco`. `fuoco-coda-riga` la riga scritta da tasti e
    // clic, `coda-riga` quella valida (sempre dentro le righe che ci sono: l'ultima tolta col fuoco
    // addosso lo passa alla precedente). Il pulsante col fuoco (-1 = la riga) vale solo per la voce
    // in cui si è entrati (`coda-voce-pulsanti`): se al suo posto arriva un'altra voce, o la riga
    // sparisce, il fuoco torna sulla riga e mai sul consenso di un'altra richiesta.
    property <int> fuoco-coda-riga: 0;
    property <int> fuoco-coda-pulsante: -1;
    property <string> coda-voce-pulsanti;
    property <int> coda-riga: max(0, min(fuoco-coda-riga, attese.length - 1));
    // Un permesso aperto (`coda-aperta`, l'id; vuoto = nessuno) nel componente `Permesso` fisso
    // (`coda-permesso`), che tiene da sé testo, fondo visto e fuoco. Resta aperto finché il suo id
    // c'è (`segui-permesso-aperto`). `coda-voce-aperta`: la sua voce, copiata all'apertura e a ogni
    // spostamento; il permesso la mostra solo nell'istante in cui la riga col fuoco non lo
    // raggiunge ancora, così non vede mai un'altra voce (che lo farebbe ripartire da capo).
    property <string> coda-aperta;
    property <VoceAttesaUi> coda-voce-aperta;
    property <VoceAttesaUi> voce-vuota;
    property <bool> coda-aperta-valida: coda-aperta != "";
    // Il pulsante col fuoco nella riga (chiusa: il delicato è «Apri»).
    property <int> coda-pulsante: attese.length > 0 && !coda-aperta-valida && fuoco-coda-pulsante >= 0
        && fuoco-coda-pulsante < attese[coda-riga].pulsanti.length && attese[coda-riga].id == coda-voce-pulsanti
        ? fuoco-coda-pulsante : -1;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "ItsyHome — pannello";
    default-font-family: Tema.carattere;
    default-font-weight: 500;
    width: larghezza-finestra;
    height: altezza-pannello;
    forward-focus: tasti;

    // Vista PC: l'elemento `i` c'è (e prende il fuoco). Un riquadro senza radio («Non presente»)
    // o non ancora letto no.
    pure function pc-ha(i: int) -> bool {
        if (i == 0) {
            return volume-disponibile;
        }
        if (i == 1) {
            return connessioni-disponibili && radio-lette && wifi-presente;
        }
        if (i == 2) {
            return connessioni-disponibili && radio-lette && bt-presente;
        }
        return (i == 3 || i == 4) && connessioni-disponibili;
    }

    // Il primo elemento della vista PC dopo `i` (-1 nessuno), e prima.
    pure function pc-successivo(i: int) -> int {
        return i < 0 && pc-ha(0) ? 0 : i < 1 && pc-ha(1) ? 1 : i < 2 && pc-ha(2) ? 2
            : i < 3 && pc-ha(3) ? 3 : i < 4 && pc-ha(4) ? 4 : -1;
    }

    pure function pc-precedente(i: int) -> int {
        return i > 4 && pc-ha(4) ? 4 : i > 3 && pc-ha(3) ? 3 : i > 2 && pc-ha(2) ? 2
            : i > 1 && pc-ha(1) ? 1 : i > 0 && pc-ha(0) ? 0 : -1;
    }

    pure function ha-zona(z: Zona) -> bool {
        if (z == Zona.attesa) {
            // «N in attesa ›» della riga alta.
            return vista == "panoramica" && in-attesa > 0;
        }
        if (z == Zona.stanze) {
            return vista == "casa" && stanze.length > 0;
        }
        if (z == Zona.contenuto) {
            // Casa vuota e non connessa: il fuoco va su «Apri Impostazioni». Collegamenti: le card,
            // o «Aggiungi un collegamento» se non ce ne sono.
            // PC: il cursore del volume, i riquadri e le righe delle connessioni, se ci sono.
            // Agenti: le righe, il pulsante dello stato («Collega») o quello della testata.
            // Coda: le righe, o «Torna alla Panoramica» se è vuota.
            return vista == "panoramica" || vista == "collegamenti" || vista == "coda" || (vista == "casa" && (griglia.length > 0 || filtro-luci || !casa-pronta))
                || (vista == "agenti" && (elenco-pieno || elenco-stato-azione || elenco-testata))
                || (vista == "pc" && pc-successivo(-1) >= 0);
        }
        if (z == Zona.volume) {
            // Senza uscita audio il pulsante non c'è.
            return volume-disponibile;
        }
        return true;
    }

    // L'ordine di Tab fuori dalla Panoramica: stanze, contenuto, schede, ricerca, volume, «⋯» (e in
    // giro; «N in attesa ›» c'è solo nella Panoramica).
    pure function zona-dopo(z: Zona, avanti: bool) -> Zona {
        if (avanti) {
            return z == Zona.attesa ? Zona.stanze : z == Zona.stanze ? Zona.contenuto
                : z == Zona.contenuto ? Zona.dock : z == Zona.dock ? Zona.ricerca
                : z == Zona.ricerca ? Zona.volume : z == Zona.volume ? Zona.menu : Zona.attesa;
        }
        return z == Zona.menu ? Zona.volume : z == Zona.volume ? Zona.ricerca : z == Zona.ricerca ? Zona.dock
            : z == Zona.dock ? Zona.contenuto : z == Zona.contenuto ? Zona.stanze
            : z == Zona.stanze ? Zona.attesa : Zona.menu;
    }

    // Tab nella vista PC: prima gli elementi del contenuto (volume, riquadri, righe), poi la zona
    // seguente; entrando nel contenuto si parte dal primo (o dall'ultimo, all'indietro).
    function premi-tab(avanti: bool) {
        // Panoramica: l'ordine lo calcola Rust; un bersaglio che non c'è (il secondo pulsante di
        // una voce che ne ha uno) si salta.
        if (vista == "panoramica") {
            let n1 = root.prossimo-fuoco(id-attuale(), avanti);
            let n2 = esiste(n1) ? n1 : root.prossimo-fuoco(n1, avanti);
            let n3 = esiste(n2) ? n2 : root.prossimo-fuoco(n2, avanti);
            vai-a(n3);
            return;
        }
        if (zona == Zona.contenuto && vista == "pc") {
            let n = avanti ? pc-successivo(fuoco-pc-valido) : pc-precedente(fuoco-pc-valido);
            if (n >= 0) {
                fuoco-pc = n;
                return;
            }
        }
        passa-zona(avanti);
        if (zona == Zona.contenuto && vista == "pc") {
            fuoco-pc = avanti ? pc-successivo(-1) : pc-precedente(5);
        }
    }

    // Il bersaglio di adesso col numero della Panoramica (`Bersagli`).
    function id-attuale() -> int {
        return zona == Zona.dock ? Bersagli.scheda + fuoco-dock : zona == Zona.ricerca ? Bersagli.ricerca
            : zona == Zona.volume ? Bersagli.volume : zona == Zona.menu ? Bersagli.menu
            : zona == Zona.attesa ? Bersagli.in-attesa : fuoco;
    }

    // Il bersaglio `id` c'è adesso nella Panoramica.
    pure function esiste(id: int) -> bool {
        if (id == Bersagli.nega) {
            return voce-mostrata && panoramica-el.indice-nega >= 0;
        }
        if (id == Bersagli.consenti) {
            return voce-mostrata && panoramica-el.indice-altro >= 0;
        }
        if (id == Bersagli.altre) {
            return voce-altre;
        }
        if (id >= 0 && id < 2 * 4) {
            return floor(id / 2) < carte && (mod(id, 2) == 0 || moduli[floor(id / 2)].con-azione);
        }
        return true;
    }

    // Porta il fuoco della Panoramica sul bersaglio `id`.
    function vai-a(id: int) {
        if (id >= Bersagli.scheda && id < Bersagli.ricerca) {
            zona = Zona.dock;
            fuoco-dock = id - Bersagli.scheda;
        } else if (id == Bersagli.ricerca) {
            zona = Zona.ricerca;
        } else if (id == Bersagli.volume) {
            zona = Zona.volume;
        } else if (id == Bersagli.menu) {
            zona = Zona.menu;
        } else if (id == Bersagli.in-attesa) {
            zona = Zona.attesa;
        } else {
            zona = Zona.contenuto;
            fuoco = id;
        }
    }

    // ←/→ nella Panoramica: il bersaglio accanto fra voce e carte (le schede e il resto no).
    function freccia-panoramica(avanti: bool) {
        let n1 = root.prossimo-fuoco(fuoco, avanti);
        let n2 = esiste(n1) ? n1 : root.prossimo-fuoco(n1, avanti);
        if ((n2 >= 0 && n2 < 2 * 4) || (n2 >= Bersagli.nega && n2 <= Bersagli.altre)) {
            fuoco = n2;
        }
    }

    // Invio (o Ctrl+Invio) su un bersaglio della Panoramica.
    function attiva-panoramica(ctrl: bool) {
        if (fuoco >= 0 && fuoco < 2 * 4) {
            if (!ctrl) {
                scegli-carta(fuoco);
            }
        } else if (fuoco == Bersagli.altre) {
            if (!ctrl) {
                apri-elenco(1);
            }
        } else if (fuoco == Bersagli.nega || fuoco == Bersagli.consenti) {
            premi-voce(fuoco, ctrl ? 2 : 1);
        }
    }

    // Un pulsante della voce che ti aspetta (`id` 100 o 101), con un gesto: 0 clic o Narrator,
    // 1 Invio, 2 Ctrl+Invio esatto. Un consenso: col clic sì (l'armamento lo controlla Rust), da
    // tastiera solo con Ctrl+Invio, e solo se il testo intero si legge nella voce; altrimenti il
    // pulsante è «Apri» e porta al permesso aperto della Coda (il testo intero, «Consenti» dopo
    // il fondo). Ctrl+Invio su un pulsante che non concede non fa nulla.
    function premi-voce(id: int, gesto: int) {
        let i = id == Bersagli.nega ? panoramica-el.indice-nega : panoramica-el.indice-altro;
        if (!voce-mostrata || i < 0) {
            return;
        }
        let p = attese[0].pulsanti[i];
        if (!p.delicato) {
            if (gesto < 2) {
                root.azione-voce(attese[0].id, p.id);
            }
        } else if (!panoramica-el.voce-intera) {
            if (gesto < 2) {
                apri-coda(0);
            }
        } else if (gesto != 1) {
            root.azione-voce(attese[0].id, p.id);
        }
    }

    // Clic, Narrator o Invio sulla carta k (`2k`) o sul suo bottone (`2k + 1`): la pagina del
    // modulo (la carta Casa con luci accese: la Casa filtrata), o l'azione.
    function scegli-carta(id: int) {
        let k = floor(id / 2);
        if (k >= carte) {
            return;
        }
        if (mod(id, 2) == 1) {
            if (moduli[k].con-azione) {
                root.azione-modulo(moduli[k].id, moduli[k].azione-id);
            }
        } else if (moduli[k].id == "casa" && luci-cliccabili) {
            mostra-luci();
        } else if (scheda-di(moduli[k].id) >= 0) {
            apri(scheda-di(moduli[k].id), moduli[k].id);
        }
    }

    // La Coda come elenco, col fuoco sulla riga `i` (mai un permesso aperto: «+N» e «N in attesa ›»
    // stanno dove la Coda aperta mette i suoi pulsanti).
    function apri-elenco(i: int) {
        vai("coda");
        zona = Zona.contenuto;
        fuoco-coda-riga = max(0, min(i, attese.length - 1));
        fuoco-coda-pulsante = -1;
    }

    // Wi-Fi (0) o Bluetooth (1): l'interruttore si sposta subito (lo stato vero torna da Rust, e
    // se Windows rifiuta torna com'era) e la riga del rifiuto di prima sparisce.
    function commuta(tipo: int) {
        errore-radio = false;
        if (tipo == 0) {
            wifi-acceso = !wifi-acceso;
            root.commuta-radio(0, wifi-acceso);
        } else {
            bt-acceso = !bt-acceso;
            root.commuta-radio(1, bt-acceso);
        }
    }

    // Tab: la zona seguente che esiste in questa vista (schede, ricerca e «⋯» ci sono sempre: al
    // più tre zone di fila mancano).
    function passa-zona(avanti: bool) {
        zona = zona-dopo(zona, avanti);
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        // Rientrando nella Coda il fuoco torna sulla riga, mai su un pulsante; nella pagina Agenti
        // dal permesso del dettaglio alla sua riga (mai di nuovo su un «Consenti» lasciato).
        fuoco-coda-pulsante = -1;
        if (agenti-con-permesso && elenco-lato == 1) {
            elenco-lato = 0;
        }
    }

    // Il primo pulsante non delicato della voce `i` («Nega»), qualunque sia l'ordine scelto dalla
    // fonte; -1 se sono tutti delicati.
    pure function primo-non-delicato(i: int) -> int {
        if (attese[i].pulsanti.length > 0 && !attese[i].pulsanti[0].delicato) {
            return 0;
        }
        if (attese[i].pulsanti.length > 1 && !attese[i].pulsanti[1].delicato) {
            return 1;
        }
        return -1;
    }

    // Apre la Coda sulla voce `i`: il fuoco sulla sua riga. Un permesso si apre subito col testo
    // intero (dalla pillola e da «Apri» della voce che ti aspetta si arriva qui).
    function apri-coda(i: int) {
        vai("coda");
        zona = Zona.contenuto;
        scegli-riga-coda(i);
    }

    // Da Rust: il pannello si apre dalla pillola su un permesso, già aperto nella Coda.
    public function apri-coda-su(i: int) {
        apri-coda(i);
    }

    // La riga `i` della Coda scelta (clic, apertura): un permesso si apre, le altre prendono il fuoco.
    function scegli-riga-coda(i: int) {
        fuoco-coda-riga = max(0, min(i, attese.length - 1));
        fuoco-coda-pulsante = -1;
        if (attese.length > 0 && Permessi.chiede(attese[coda-riga])) {
            apri-permesso();
        }
    }

    // Apre il permesso della riga col fuoco nel componente del guscio: il testo intero, il fuoco
    // su «Nega» (o sul testo se non c'è). «Consenti» aspetta il fondo del testo.
    function apri-permesso() {
        coda-aperta = attese[coda-riga].id;
        coda-voce-aperta = attese[coda-riga];
        fuoco-coda-riga = coda-riga;
        fuoco-coda-pulsante = -1;
        coda-permesso.entra();
        // Una superficie col permesso compare: «Consenti» si arma di nuovo (anche contro il
        // secondo clic di un doppio clic su «Apri»).
        root.consenti-compare();
    }

    // Chiude il permesso aperto: di nuovo l'elenco, il fuoco sulla sua riga.
    function chiudi-permesso() {
        coda-aperta = "";
        coda-voce-aperta = voce-vuota;
        fuoco-coda-pulsante = -1;
    }

    // Un pulsante della riga `i` della Coda premuto (clic, Invio): su un permesso la decisione
    // passa dalla guardia di Rust (`azione-voce`), le altre voci sono un'`azione`.
    function premi-riga(voce: string, pulsante: string, permesso: bool) {
        if (permesso) {
            root.azione-voce(voce, pulsante);
        } else {
            root.azione(voce, pulsante);
        }
    }

    // Dalla riga ai suoi pulsanti (→ o Invio): si entra su «Nega» se c'è (il primo non delicato),
    // altrimenti sul primo («Apri» per un permesso). Invio lì nega.
    function entra-pulsanti() {
        if (attese.length > 0 && attese[coda-riga].pulsanti.length > 0) {
            coda-voce-pulsanti = attese[coda-riga].id;
            fuoco-coda-riga = coda-riga;
            fuoco-coda-pulsante = max(0, primo-non-delicato(coda-riga));
        }
    }

    // ←/→ fra i pulsanti della riga; ← dal primo torna alla riga.
    function pulsante-coda(passo: int) {
        let n = coda-pulsante + passo;
        if (n >= 0 && n < attese[coda-riga].pulsanti.length) {
            fuoco-coda-pulsante = n;
        } else if (n < 0) {
            fuoco-coda-pulsante = -1;
        }
    }

    // ↑/↓ nella Coda: la riga accanto (ai bordi si resta), il fuoco sulla riga.
    function riga-coda(passo: int) {
        fuoco-coda-riga = max(0, min(attese.length - 1, coda-riga + passo));
        fuoco-coda-pulsante = -1;
    }

    // Apre la stanza `i` della vista Casa; `alle-card`: da tastiera il fuoco passa ai suoi dispositivi.
    function apri-stanza-i(i: int, alle-card: bool) {
        if (i >= 0 && i < stanze.length) {
            // Le card cambiano tutte: se una aveva il fuoco sparisce, il fuoco passa prima a `tasti`.
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            filtro-luci = false;
            stanza-aperta = i;
            fuoco-stanza = i;
            fuoco-casa = 0;
            root.apri-stanza(stanze[i].area-id);
            if (alle-card) {
                zona = Zona.contenuto;
            }
        }
    }

    // Chiude la stanza aperta: torna «Preferiti» (selezionata, e col fuoco da tastiera).
    function chiudi-stanza-ora() {
        if (stanza-aperta >= 0) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            fuoco-stanza = -1;
            stanza-aperta = -1;
            fuoco-casa = 0;
            root.chiudi-stanza();
            if (zona == Zona.contenuto && ha-zona(Zona.stanze)) {
                zona = Zona.stanze;
            }
        }
    }

    // La Casa filtrata sulle luci accese (clic sulla carta Casa con luci accese): la vista Casa
    // con l'elenco delle luci accese, il fuoco sulla prima.
    function mostra-luci() {
        fuoco-dock = max(0, scheda-di("casa"));
        vai("casa");
        filtro-luci = true;
        fuoco-casa = 0;
    }

    // Torna all'elenco completo (Preferiti). Il fuoco da tastiera sta sulle card o nella testata,
    // che cambiano tutte: passa prima a `tasti`, e poi alla prima card.
    function esci-filtro() {
        if (filtro-luci) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            filtro-luci = false;
            fuoco-casa = 0;
        }
    }

    // Clic o Invio su una stanza: la apre. Sulla stanza già aperta (la scheda selezionata) non
    // cambia nulla, come su «Preferiti»: da tastiera il fuoco torna alle card. Ai preferiti si
    // torna con «Preferiti», Esc o Backspace.
    function scegli-stanza(i: int, alle-card: bool) {
        if (i != stanza-aperta) {
            apri-stanza-i(i, alle-card);
        } else if (alle-card && griglia.length > 0 && ha-zona(Zona.contenuto)) {
            zona = Zona.contenuto;
            fuoco-casa = 0;
        }
    }

    // Clic o Invio su «Preferiti»: la stanza aperta si chiude; da tastiera il fuoco passa alle
    // card, come scegliendo una stanza.
    function scegli-preferiti(alle-card: bool) {
        chiudi-stanza-ora();
        esci-filtro();
        fuoco-stanza = -1;
        if (alle-card && griglia.length > 0 && ha-zona(Zona.contenuto)) {
            zona = Zona.contenuto;
            fuoco-casa = 0;
        }
    }

    function vai(v: string) {
        // La vista che se ne va (con «In attesa»; «Indietro» non c'è più) può avere l'elemento col fuoco:
        // distrutto lui, il pannello resterebbe senza fuoco e senza tastiera. Il fuoco passa prima
        // a `tasti`; l'elemento scelto nella vista nuova lo riprende da sé (`Fuoco`). Le schede restano.
        if (zona != Zona.dock) {
            tasti.focus();
        }
        if (stanza-aperta >= 0) {
            stanza-aperta = -1;
            root.chiudi-stanza();
        }
        filtro-luci = false;
        vista = v;
        // Nella Panoramica il fuoco riparte dal bersaglio iniziale della voce che ti aspetta (di
        // solito «Nega»), altrimenti da nessuno.
        fuoco = v == "panoramica" && voce-mostrata ? bersaglio-iniziale-voce() : -1;
        fuoco-casa = 0;
        fuoco-pc = 0;
        fuoco-stanza = -1;
        fuoco-collegamento = 0;
        fuoco-coda-riga = 0;
        fuoco-coda-pulsante = -1;
        elenco-lato = 0;
        chiudi-permesso();
        if (!ha-zona(zona)) {
            zona = ha-zona(Zona.contenuto) ? Zona.contenuto : Zona.dock;
        }
    }

    // Backspace o Alt+←, un livello alla volta: prima la stanza aperta, poi la Panoramica.
    function indietro() {
        if (vista == "coda" && coda-aperta-valida) {
            chiudi-permesso();
        } else if (vista == "agenti" && elenco-lato-valido == 1) {
            // Dal dettaglio all'elenco, sulla sua riga.
            elenco-lato = 0;
        } else if (filtro-luci) {
            esci-filtro();
        } else if (stanza-aperta >= 0) {
            chiudi-stanza-ora();
        } else if (vista != "panoramica") {
            fuoco-dock = 0;
            vai("panoramica");
        }
    }

    function apri(i: int, id: string) {
        fuoco-dock = i;
        vai(id);
        root.apri-app(id);
    }

    // La rotella sul pulsante del volume: ±`punti` dal punto intero di adesso, nei limiti (al
    // limite nessun comando).
    function rotella-volume-passo(punti: int) {
        let nuovo = min(max((round(volume * 100) + punti) / 100, 0), 1);
        if (nuovo != volume) {
            cambia-volume(nuovo);
        }
    }

    // «⋯»: il menu sotto il pulsante, al suo bordo destro. Chiuso il menu senza scelta il fuoco
    // torna qui (la zona è «⋯»). Senza voci (Rust non le ha date) non si apre.
    function apri-menu(tastiera: bool) {
        zona = Zona.menu;
        da-tastiera = tastiera;
        root.menu();
        if (voci-menu.length > 0) {
            menu-scuro.apri(tastiera);
        }
    }

    // Il volume scelto da tastiera o dal cursore: subito nel pannello, poi a Rust.
    function cambia-volume(v: float) {
        volume = min(max(v, 0), 1);
        root.imposta-volume(volume);
    }

    // ←/→ nella vista PC: ±`punti` dal punto intero di adesso.
    function passo-volume(punti: int) {
        cambia-volume((round(volume * 100) + punti) / 100);
    }

    // Le frecce nella pagina Agenti. ↑/↓ fra le righe (ai bordi si resta; ↑ dalla prima porta
    // all'azione della testata se c'è, ↓ da lì torna); dal dettaglio ↑/↓ riportano all'elenco sulla
    // riga accanto. → dalla riga al pulsante del dettaglio, ← di nuovo alla riga. Senza elenco
    // ↑/↓ passano fra il pulsante dello stato e quello della testata.
    function freccia-agenti(k: string) {
        if (elenco-lato-valido == 1 && agenti-con-permesso) {
            // Nel permesso i tasti li governa il componente (↑/↓ scorrono il testo, ←/→ fra
            // «Nega» e «Consenti»); ← dal primo bersaglio torna alla riga (`lascia`).
            agenti-permesso.tasto(k, false);
            return;
        }
        if (k == Key.RightArrow && elenco-lato-valido == 0 && agenti-con-permesso) {
            entra-agenti-permesso();
            return;
        }
        if (k == Key.UpArrow) {
            if (elenco-lato-valido >= 0 && elenco-pieno && elenco-riga > 0) {
                elenco-fuoco = elenco-riga - 1;
                elenco-lato = 0;
            } else if (elenco-lato-valido >= 0 && elenco-testata) {
                elenco-lato = -1;
            }
        } else if (k == Key.DownArrow) {
            if (elenco-lato-valido < 0) {
                elenco-lato = 0;
            } else if (elenco-pieno) {
                elenco-fuoco = min(elenco-righe.length - 1, elenco-riga + 1);
                elenco-lato = 0;
            }
        } else if (k == Key.RightArrow && elenco-lato-valido == 0 && elenco-pieno
            && elenco-righe[elenco-riga].azione-testo != "") {
            elenco-lato = 1;
        } else if (k == Key.LeftArrow && elenco-lato-valido == 1) {
            elenco-lato = 0;
        }
    }

    // Invio nella pagina Agenti: sulla testata o sullo stato il loro pulsante; sul pulsante del
    // dettaglio la sua azione; nel permesso del dettaglio lo governa il componente (preme solo
    // «Nega», mai un consenso); sulla riga di una sessione il terminale (decisione di Paolo), sulla
    // riga col permesso solo il fuoco su «Nega»: mai una decisione (pre-flight C6, C7). Una riga
    // con una `voce` che non è quella al suo posto fra le attese non fa nulla.
    function attiva-agenti() {
        if (elenco-lato-valido < 0) {
            if (elenco-testata) {
                root.azione-pagina("agenti", elenco-sintesi.azione-id, "");
            }
        } else if (!elenco-pieno) {
            if (elenco-stato-azione) {
                root.azione-pagina("agenti", elenco-stato.azione-id, "");
            }
        } else if (elenco-lato-valido == 1 && agenti-con-permesso) {
            agenti-permesso.tasto(Key.Return, false);
        } else if (elenco-lato-valido == 1 || elenco-righe[elenco-riga].voce == "") {
            root.azione-pagina("agenti", elenco-righe[elenco-riga].azione-id, elenco-righe[elenco-riga].id);
        } else if (agenti-con-permesso) {
            entra-agenti-permesso();
        }
    }

    function freccia(k: string) {
        if (zona == Zona.dock) {
            if (k == Key.LeftArrow) {
                fuoco-dock = max(0, fuoco-dock - 1);
            } else if (k == Key.RightArrow) {
                fuoco-dock = min(schede.length - 1, fuoco-dock + 1);
            }
        } else if (zona == Zona.contenuto && vista == "coda" && coda-aperta-valida) {
            // Permesso aperto: i tasti li governa il componente del guscio. Nella Coda `lascia`
            // non fa nulla (l'elenco non si vede): si torna con Esc o Backspace.
            coda-permesso.tasto(k, false);
        } else if (zona == Zona.contenuto && vista == "coda" && attese.length > 0) {
            // ↑/↓ fra le righe; → ai pulsanti e fra loro; ← indietro fino alla riga.
            if (k == Key.UpArrow) {
                riga-coda(-1);
            } else if (k == Key.DownArrow) {
                riga-coda(1);
            } else if (k == Key.RightArrow && coda-pulsante < 0) {
                entra-pulsanti();
            } else if (k == Key.RightArrow) {
                pulsante-coda(1);
            } else if (k == Key.LeftArrow && coda-pulsante >= 0) {
                pulsante-coda(-1);
            }
        } else if (zona == Zona.contenuto && vista == "panoramica") {
            // ←/→ fra voce e carte; ↑ dalle carte alla voce, ↓ dalla voce alle carte.
            if (k == Key.LeftArrow) {
                freccia-panoramica(false);
            } else if (k == Key.RightArrow) {
                freccia-panoramica(true);
            } else if (k == Key.UpArrow && fuoco < Bersagli.nega && voce-mostrata
                && bersaglio-iniziale-voce() >= Bersagli.nega) {
                // ↑ dalle carte alla voce: il suo bersaglio iniziale, se è sulla voce.
                fuoco = bersaglio-iniziale-voce();
            } else if (k == Key.DownArrow && (fuoco < 0 || fuoco >= Bersagli.nega) && carte > 0) {
                fuoco = 0;
            }
        } else if (zona == Zona.stanze) {
            if (k == Key.UpArrow) {
                fuoco-stanza = max(-1, fuoco-stanza-valido - 1);
            } else if (k == Key.DownArrow) {
                fuoco-stanza = min(stanze.length - 1, fuoco-stanza-valido + 1);
            } else if (k == Key.RightArrow && ha-zona(Zona.contenuto)) {
                zona = Zona.contenuto;
                fuoco-casa = 0;
            }
        } else if (zona == Zona.contenuto && vista == "pc" && fuoco-pc-valido == 0) {
            // Il cursore del volume: ←/→ due punti.
            if (k == Key.LeftArrow) {
                passo-volume(-2);
            } else if (k == Key.RightArrow) {
                passo-volume(2);
            }
        } else if (zona == Zona.contenuto && vista == "pc" && fuoco-pc-valido > 0) {
            // Riquadri (1 Wi-Fi, 2 Bluetooth) e sotto le righe (3 sotto il Wi-Fi, 4 sotto il
            // Bluetooth): ←/→ nella riga, ↑/↓ fra riquadri e righe.
            if (k == Key.RightArrow && (fuoco-pc-valido == 1 || fuoco-pc-valido == 3) && pc-ha(fuoco-pc-valido + 1)) {
                fuoco-pc = fuoco-pc-valido + 1;
            } else if (k == Key.LeftArrow && (fuoco-pc-valido == 2 || fuoco-pc-valido == 4) && pc-ha(fuoco-pc-valido - 1)) {
                fuoco-pc = fuoco-pc-valido - 1;
            } else if (k == Key.DownArrow && fuoco-pc-valido <= 2) {
                fuoco-pc = fuoco-pc-valido + 2;
            } else if (k == Key.UpArrow && fuoco-pc-valido >= 3) {
                fuoco-pc = pc-ha(fuoco-pc-valido - 2) ? fuoco-pc-valido - 2 : pc-precedente(fuoco-pc-valido);
            }
        } else if (zona == Zona.contenuto && vista == "agenti") {
            freccia-agenti(k);
        } else if (zona == Zona.contenuto && vista == "collegamenti" && collegamenti.length > 0) {
            // -1 = «Modifica» nella testata: ↑ dalla prima riga, ↓ torna alle card.
            if (fuoco-collegamento < 0) {
                if (k == Key.DownArrow) {
                    fuoco-collegamento = 0;
                }
            } else if (k == Key.LeftArrow) {
                fuoco-collegamento = max(0, fuoco-collegamento-valido - 1);
            } else if (k == Key.RightArrow) {
                fuoco-collegamento = min(collegamenti.length - 1, fuoco-collegamento-valido + 1);
            } else if (k == Key.UpArrow && fuoco-collegamento-valido >= colonne-collegamenti) {
                fuoco-collegamento = fuoco-collegamento-valido - colonne-collegamenti;
            } else if (k == Key.UpArrow) {
                fuoco-collegamento = -1;
            } else if (k == Key.DownArrow && fuoco-collegamento-valido + colonne-collegamenti < collegamenti.length) {
                fuoco-collegamento = fuoco-collegamento-valido + colonne-collegamenti;
            }
        } else if (zona == Zona.contenuto && vista == "casa" && griglia.length > 0) {
            // -1 = «Riprova» nella testata (solo se c'è): ↑ dalla prima riga, ↓ torna alle card.
            // Nella Casa filtrata la testata ha «Spegni tutte» (-1) e «Tutta la casa» (-2).
            if (fuoco-casa < 0) {
                if (k == Key.DownArrow) {
                    fuoco-casa = 0;
                } else if (testata-filtro && k == Key.RightArrow) {
                    fuoco-casa = -2;
                } else if (testata-filtro && k == Key.LeftArrow) {
                    fuoco-casa = -1;
                }
            } else if (k == Key.LeftArrow && mod(fuoco-casa-valido, colonne-casa) == 0 && ha-zona(Zona.stanze)) {
                // Dalla prima colonna all'elenco, sulla voce selezionata (la stanza aperta o
                // «Preferiti»).
                zona = Zona.stanze;
                fuoco-stanza = stanza-aperta;
            } else if (k == Key.LeftArrow) {
                fuoco-casa = max(0, fuoco-casa-valido - 1);
            } else if (k == Key.RightArrow) {
                fuoco-casa = min(griglia.length - 1, fuoco-casa-valido + 1);
            } else if (k == Key.UpArrow && fuoco-casa-valido >= colonne-casa) {
                fuoco-casa = fuoco-casa-valido - colonne-casa;
            } else if (k == Key.UpArrow && (riprova-visibile || testata-filtro)) {
                fuoco-casa = -1;
            } else if (k == Key.DownArrow && fuoco-casa-valido + colonne-casa < griglia.length) {
                fuoco-casa = fuoco-casa-valido + colonne-casa;
            }
        }
    }

    // Invio / Spazio sulla zona col fuoco; `ctrl`: Ctrl+Invio, l'unico tasto che concede un
    // permesso (su un pulsante delicato Invio e Spazio da soli non fanno nulla).
    function attiva(ctrl: bool) {
        if (ctrl) {
            // Solo un consenso col fuoco da tastiera nel permesso aperto della Coda (dopo il fondo
            // del testo: lo controlla il componente) o sulla voce che ti aspetta (col testo intero
            // nella voce); altrove Ctrl+Invio non fa nulla.
            if (zona == Zona.contenuto && vista == "coda" && coda-aperta-valida) {
                coda-permesso.tasto(Key.Return, true);
            } else if (zona == Zona.contenuto && vista == "agenti" && elenco-lato-valido == 1 && agenti-con-permesso) {
                agenti-permesso.tasto(Key.Return, true);
            } else if (pool-attivo) {
                attiva-panoramica(true);
            }
            return;
        }
        if (zona == Zona.attesa) {
            apri-elenco(0);
        } else if (zona == Zona.dock) {
            apri(fuoco-dock, schede[fuoco-dock].id);
        } else if (zona == Zona.ricerca) {
            // La ricerca arriva in F5: per ora non fa nulla.
        } else if (zona == Zona.volume) {
            root.muto-volume(!volume-muto);
        } else if (zona == Zona.menu) {
            apri-menu(true);
        } else if (zona == Zona.stanze && fuoco-stanza-valido < 0) {
            scegli-preferiti(true);
        } else if (zona == Zona.stanze) {
            scegli-stanza(fuoco-stanza-valido, true);
        } else if (vista == "panoramica") {
            attiva-panoramica(false);
        } else if (vista == "agenti") {
            attiva-agenti();
        } else if (vista == "coda") {
            // Vuota: «Torna alla Panoramica». Sulla riga Invio entra nei pulsanti (su «Nega»), su un
            // pulsante lo preme, mai se è un consenso.
            // Una riga di permesso (o il suo «Apri») apre il testo intero.
            // Nel permesso aperto Invio lo governa il componente (preme solo un non delicato).
            if (attese.length == 0) {
                fuoco-dock = 0;
                vai("panoramica");
            } else if (coda-aperta-valida) {
                coda-permesso.tasto(Key.Return, false);
            } else if (coda-pulsante < 0 && Permessi.chiede(attese[coda-riga])) {
                apri-permesso();
            } else if (coda-pulsante < 0) {
                entra-pulsanti();
            } else if (!attese[coda-riga].pulsanti[coda-pulsante].delicato) {
                premi-riga(attese[coda-riga].id, attese[coda-riga].pulsanti[coda-pulsante].id, Permessi.chiede(attese[coda-riga]));
            } else {
                apri-permesso();
            }
        } else if (vista == "collegamenti") {
            if (collegamenti.length == 0 || fuoco-collegamento < 0) {
                root.gestisci-collegamenti();
            } else {
                root.apri-collegamento(collegamenti[fuoco-collegamento-valido].id);
            }
        } else if (vista == "pc") {
            // Sul cursore del volume: muto sì/no, come l'altoparlante; sui riquadri acceso/spento;
            // sulle righe la pagina di Windows.
            if (fuoco-pc-valido == 0) {
                root.muto-volume(!volume-muto);
            } else if (fuoco-pc-valido == 1 || fuoco-pc-valido == 2) {
                commuta(fuoco-pc-valido - 1);
            } else if (fuoco-pc-valido == 3 || fuoco-pc-valido == 4) {
                root.apri-pagina(fuoco-pc-valido - 3);
            }
        } else if (vista == "casa" && filtro-luci && (griglia.length == 0 || (testata-filtro && fuoco-casa == -2))) {
            // Nessuna luce accesa, o «Tutta la casa» nella testata: l'elenco completo.
            esci-filtro();
        } else if (vista == "casa" && griglia.length == 0) {
            root.apri-app("impostazioni");
        } else if (vista == "casa" && testata-filtro && fuoco-casa == -1) {
            // Le luci si spengono tutte: il pulsante sparisce, il fuoco passa prima a `tasti`.
            tasti.focus();
            root.spegni-tutte();
        } else if (vista == "casa" && fuoco-casa < 0) {
            if (riprova-visibile) {
                root.riprova-casa();
            }
        } else if (vista == "casa" && fuoco-casa-valido >= 0 && griglia[fuoco-casa-valido].toccabile) {
            if (filtro-luci) {
                // La luce spenta esce dall'elenco: il fuoco passa prima a `tasti`, poi alla riga
                // che prende il suo posto (o alla più vicina).
                tasti.focus();
            }
            root.tocca(griglia[fuoco-casa-valido].entity-id);
        }
    }

    // Tiene la tastiera di tutto il pannello: intercetta ogni tasto prima dell'elemento col fuoco
    // (`capture-key-pressed`), che sia lui o un elemento dentro. Il fuoco vero va sull'elemento
    // scelto da tastiera (FE13: Narrator ne legge ruolo e nome); col mouse, o se quell'elemento
    // non c'è più, torna qui.
    tasti := FocusScope {
        accessible-role: groupbox;
        accessible-label: "Pannello di ItsyHome";
        capture-key-pressed(evento) => {
            // Menu «⋯» aperto: i tasti sono suoi (Esc chiude solo lui, un livello alla volta). Le
            // combinazioni con Alt, Ctrl o Win restano al sistema.
            if (menu-scuro.aperto) {
                if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
                    return reject;
                }
                da-tastiera = true;
                menu-scuro.tasto(evento.text, evento.modifiers.shift);
                return accept;
            }
            // Un livello alla volta: con una stanza aperta torna a «Preferiti»; poi chiude il
            // pannello (anche dalla Coda).
            if (evento.text == Key.Escape) {
                if (vista == "coda" && coda-aperta-valida) {
                    chiudi-permesso();
                } else if (filtro-luci && vista == "casa") {
                    esci-filtro();
                } else if (stanza-aperta >= 0) {
                    chiudi-stanza-ora();
                } else {
                    root.chiudi();
                }
                return accept;
            }
            if (evento.text == Key.Tab || evento.text == Key.Backtab) {
                da-tastiera = true;
                premi-tab(evento.text == Key.Tab && !evento.modifiers.shift);
                return accept;
            }
            if (evento.text == Key.Backspace || (evento.text == Key.LeftArrow && evento.modifiers.alt)) {
                if (vista == "panoramica") {
                    return reject;
                }
                da-tastiera = true;
                indietro();
                return accept;
            }
            // Ctrl+Invio esatto (niente Alt, AltGr, Maiusc o Win) prima del rifiuto dei modificatori:
            // concede il permesso col fuoco.
            if (evento.text == Key.Return && evento.modifiers.control && !evento.modifiers.alt
                    && !evento.modifiers.meta && !evento.modifiers.shift) {
                da-tastiera = true;
                attiva(true);
                return accept;
            }
            // Invio o Spazio con qualunque altro modificatore: presi qui e ignorati. Rifiutati,
            // arriverebbero all'elemento col fuoco vero (un pulsante, magari «Consenti»).
            if (evento.text == Key.Return || evento.text == Key.Space) {
                if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta || evento.modifiers.shift) {
                    return accept;
                }
            }
            if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
                return reject;
            }
            if (evento.text == Key.LeftArrow || evento.text == Key.RightArrow || evento.text == Key.UpArrow || evento.text == Key.DownArrow) {
                da-tastiera = true;
                freccia(evento.text);
                return accept;
            }
            if (evento.text == Key.Return || evento.text == Key.Space) {
                da-tastiera = true;
                attiva(false);
                return accept;
            }
            // Home/Fine sul cursore del volume: 0 e 100.
            if ((evento.text == Key.Home || evento.text == Key.End) && zona == Zona.contenuto && vista == "pc"
                    && fuoco-pc-valido == 0) {
                da-tastiera = true;
                cambia-volume(evento.text == Key.Home ? 0 : 1);
                return accept;
            }
            return reject;
        }

        // Apertura: il pannello scende dalla riga degli occhi e compare (opacità + altezza, 200 ms).
        // Con il movimento ridotto non scende: compare soltanto, in dissolvenza (120 ms).
        corpo := Rectangle {
            y: 0;
            height: aperto ? root.height : altezza-riga;
            opacity: aperto ? 1 : 0;
            animate height { duration: Movimento.ridotto ? 0ms : 200ms; easing: ease-out; }
            animate opacity { duration: Movimento.ridotto ? 120ms : 200ms; easing: ease-out; }
            clip: true;

            // L'isola nera con le orecchie e la luce del tono più urgente (ferma: si accende e si
            // spegne solo al cambio di tono).
            ContornoIsola {
                x: 0;
                y: 0;
                width: root.larghezza-finestra;
                height: root.altezza-pannello;
                tono: root.tono-isola;
            }

            // Riga alta: data e meteo a sinistra, ora e «⋯» a destra; gli occhi al centro.
            riga-alta := RigaAlta {
                x: 0;
                y: 0;
                width: root.larghezza-finestra;
                height: altezza-riga;
                sinistra: root.riga-sinistra;
                sinistra-nome: root.riga-sinistra-nome;
                sinistra-visibile: vista == "panoramica";
                // Nell'Orologio gli avvisi li dice la fascia (stesso bersaglio, stesso posto di Tab).
                in-attesa: vista == "panoramica" && !root.orologio ? root.in-attesa : 0;
                fuoco-in-attesa: da-tastiera && zona == Zona.attesa && vista == "panoramica" && !root.orologio && root.in-attesa > 0;
                anello-in-attesa: da-tastiera && zona == Zona.attesa;
                in-attesa-premuto => {
                    da-tastiera = false;
                    apri-elenco(0);
                }
                ora: root.ora;
                ora-visibile: ora-riga-visibile;
                ingombro-occhi: occhi.ingombro;
                piu-x: root.piu-x;
                piu-y: root.piu-y;
                fuoco-menu-chiesto: da-tastiera && zona == Zona.menu && !menu-scuro.aperto;
                anello-menu: da-tastiera && zona == Zona.menu && !menu-scuro.aperto;
                menu-aperto: menu-scuro.aperto;
                // Col mouse senza anello; da Narrator come da tastiera.
                menu-premuto(narratore) => { apri-menu(narratore); }
            }

            // Il battito di ciglia (dentro Occhi) solo a pannello aperto.
            occhi := Occhi {
                umore: root.umore;
                attivo: aperto;
                // Restano sugli occhi della pillola mentre il pannello compare, poi vanno al centro
                // (solo lo scarto è animato: un cambio d'umore li ricentra subito).
                property <length> scarto: occhi-al-centro ? 0px : partenza-occhi;
                property <length> scarto-y: occhi-al-centro ? 0px : partenza-occhi-y;
                animate scarto, scarto-y { duration: Movimento.ridotto ? 0ms : 240ms; easing: ease-in-out; }
                x: (parent.width - self.ingombro) / 2 + self.scarto;
                y: self.scarto-y;
                width: self.ingombro;
                height: altezza-riga;
                accessible-role: button;
                accessible-label: "Chiudi il pannello";
                accessible-action-default => { root.chiudi(); }

                TouchArea {
                    // Un po' più larga degli occhi, per non doverli centrare al pixel.
                    x: -12px;
                    width: parent.width + 24px;
                    mouse-cursor: pointer;
                    clicked => { root.chiudi(); }
                }
            }

            // Centro: la Panoramica, la Coda o la vista dell'app.
            Rectangle {
                x: centro-x + scarto-contenuto;
                y: centro-y;
                width: centro-l;
                height: centro-a;
                opacity: opacita-contenuto;

                // La Panoramica (Griglia o Orologio): sempre presente (i suoi bersagli di fuoco
                // non nascono e muoiono con la vista), visibile solo nella Panoramica.
                panoramica-el := Panoramica {
                    visible: vista == "panoramica";
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: corpo-a;
                    moduli: root.moduli;
                    ora: root.ora;
                    cifre-ora: root.ora-cifre;
                    orologio: root.orologio;
                    fascia-testo: root.fascia-testo;
                    fascia-nome: root.fascia-nome;
                    fascia-avvisi: vista == "panoramica" && root.in-attesa > 0 ? root.fascia-avvisi : "";
                    fuoco-avvisi: da-tastiera && zona == Zona.attesa && vista == "panoramica" && root.in-attesa > 0;
                    anello-avvisi: da-tastiera && zona == Zona.attesa;
                    avvisi-premuto => {
                        da-tastiera = false;
                        apri-elenco(0);
                    }
                    voce-mostrata: root.voce-mostrata;
                    voce: root.attese[0];
                    inerte: root.inerte;
                    altre: root.voce-mostrata ? root.attese.length - 1 : 0;
                    fuoco: pool-attivo ? root.fuoco : -1;
                    anello: da-tastiera && pool-attivo;
                    scelta(id) => {
                        da-tastiera = false;
                        zona = Zona.contenuto;
                        root.fuoco = id;
                        if (id == Bersagli.altre) {
                            apri-elenco(1);
                        } else if (id == Bersagli.nega || id == Bersagli.consenti) {
                            premi-voce(id, 0);
                        } else {
                            scegli-carta(id);
                        }
                    }
                    ripara(id) => { root.fuoco = id; }
                }

                if vista == "casa": VistaCasa {
                    width: parent.width;
                    height: parent.height;
                    voci: root.griglia;
                    stanze: root.stanze;
                    stanza-aperta: root.stanza-aperta;
                    // Ogni fuoco della vista chiede anche `vista == "casa"`: lasciando la vista, la
                    // zona nuova non deve accendere il fuoco su un elemento che sta sparendo (il suo
                    // `changed` girerebbe dopo, su un elemento distrutto, e il pannello resterebbe
                    // senza tastiera).
                    fuoco-stanza: da-tastiera && zona == Zona.stanze && vista == "casa" && fuoco-stanza-valido >= 0 ? fuoco-stanza-valido : -1;
                    fuoco-preferiti: da-tastiera && zona == Zona.stanze && vista == "casa" && fuoco-stanza-valido < 0;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    dati-delle: root.dati-delle;
                    riprova: riprova-visibile;
                    colonne: root.colonne-casa;
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "casa" ? fuoco-casa-valido : -1;
                    fuoco-riprova: da-tastiera && zona == Zona.contenuto && vista == "casa" && fuoco-casa < 0 && !testata-filtro;
                    fuoco-impostazioni: da-tastiera && zona == Zona.contenuto && vista == "casa";
                    filtro-luci: root.filtro-luci;
                    fuoco-spegni: da-tastiera && zona == Zona.contenuto && vista == "casa" && testata-filtro && fuoco-casa == -1 && griglia.length > 0;
                    fuoco-tutta: da-tastiera && zona == Zona.contenuto && vista == "casa" && filtro-luci && ((testata-filtro && fuoco-casa == -2) || griglia.length == 0);
                    tocca(id) => {
                        da-tastiera = false;
                        root.tocca(id);
                    }
                    scegli-stanza(i) => {
                        da-tastiera = false;
                        scegli-stanza(i, false);
                    }
                    scegli-preferiti => {
                        da-tastiera = false;
                        scegli-preferiti(false);
                    }
                    riprova-casa => {
                        da-tastiera = false;
                        root.riprova-casa();
                    }
                    spegni-tutte => {
                        da-tastiera = false;
                        root.spegni-tutte();
                    }
                    mostra-tutta => {
                        da-tastiera = false;
                        esci-filtro();
                    }
                    apri-impostazioni => {
                        da-tastiera = false;
                        root.apri-app("impostazioni");
                    }
                }

                // La pagina Agenti (ridisegno F2, Task 6): la testata comune con la sintesi, poi
                // l'impianto Elenco + dettaglio o, senza elenco, lo stato della pagina. Come nelle
                // altre viste, ogni fuoco chiede anche la vista (lasciandola non si accende su un
                // elemento che sta sparendo).
                if vista == "agenti": Rectangle {
                    width: parent.width;
                    height: parent.height;

                    TestataPagina {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        titolo: root.elenco-sintesi.titolo;
                        sotto: root.elenco-sintesi.sotto;
                        tono: root.elenco-sintesi.tono;
                        l1: root.elenco-sintesi.l1;
                        l2: root.elenco-sintesi.l2;
                        spesa: root.elenco-sintesi.spesa;
                        spesa-nota: root.elenco-sintesi.spesa-nota;
                        azione-testo: root.elenco-sintesi.azione-testo;
                        fuoco-azione: da-tastiera && zona == Zona.contenuto && vista == "agenti" && root.elenco-lato-valido < 0;
                        azione => {
                            da-tastiera = false;
                            root.azione-pagina("agenti", root.elenco-sintesi.azione-id, "");
                        }
                    }

                    if root.elenco-pieno: ImpiantoElencoDettaglio {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        righe: root.elenco-righe;
                        dettaglio-permesso: root.agenti-con-permesso;
                        fuoco: root.elenco-riga;
                        lato: root.elenco-lato-valido;
                        con-fuoco: da-tastiera && zona == Zona.contenuto && vista == "agenti";
                        // Il clic su una riga la sceglie: il dettaglio è il suo, nessun evento a Rust.
                        scelta(i) => {
                            da-tastiera = false;
                            zona = Zona.contenuto;
                            root.elenco-fuoco = i;
                            root.elenco-lato = 0;
                        }
                        azione(azione, riga) => {
                            da-tastiera = false;
                            root.azione-pagina("agenti", azione, riga);
                        }
                    }

                    if !root.elenco-pieno: StatoPagina {
                        x: 0;
                        y: 48px;
                        width: parent.width;
                        height: parent.height - self.y;
                        stato: root.elenco-stato;
                        con-fuoco: da-tastiera && zona == Zona.contenuto && vista == "agenti" && root.elenco-lato-valido >= 0;
                        azione => {
                            da-tastiera = false;
                            root.azione-pagina("agenti", root.elenco-stato.azione-id, "");
                        }
                    }
                }

                // La Coda minima: le voci in attesa sull'impianto Elenco, con i loro pulsanti.
                if vista == "coda": ImpiantoElenco {
                    width: parent.width;
                    height: parent.height;
                    voci: root.attese;
                    moduli: root.moduli-in-attesa;
                    fuoco-riga: root.coda-riga;
                    fuoco-pulsante: root.coda-pulsante;
                    aperta: root.coda-aperta-valida;
                    // Come nelle altre viste, il fuoco chiede anche la vista (lasciandola non si
                    // accende su un elemento che sta sparendo).
                    con-fuoco: da-tastiera && zona == Zona.contenuto && vista == "coda";
                    inerte: root.inerte;
                    // Un clic su un pulsante di una riga è un gesto; su un permesso passa dalla
                    // guardia di Rust.
                    azione(voce, pulsante, permesso) => {
                        da-tastiera = false;
                        premi-riga(voce, pulsante, permesso);
                    }
                    // Clic su una riga (un permesso si apre col testo intero) o sul suo «Apri».
                    riga-scelta(i) => {
                        da-tastiera = false;
                        zona = Zona.contenuto;
                        scegli-riga-coda(i);
                    }
                    torna => {
                        da-tastiera = false;
                        fuoco-dock = 0;
                        vai("panoramica");
                    }
                }

                // Il permesso aperto della Coda (ridisegno F2, Task 3): il componente del guscio,
                // fisso e mai dentro un `if` (pre-flight C1, C2: il pannello gli passa i tasti per
                // id, e non nasce al momento dell'apertura); si vede solo a permesso aperto, al
                // posto dell'elenco, coi pulsanti in alto (lontani dalle righe e da «+N»).
                coda-permesso := Permesso {
                    visible: vista == "coda" && root.coda-aperta-valida;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    voce: root.coda-aperta-valida && root.attese[root.coda-riga].id == root.coda-aperta
                        ? root.attese[root.coda-riga] : root.coda-voce-aperta;
                    pulsanti-in-alto: true;
                    con-torna: true;
                    inerte: root.inerte;
                    con-fuoco: da-tastiera && zona == Zona.contenuto && vista == "coda" && root.coda-aperta-valida;
                    // Un clic, Narrator, Invio su «Nega» o Ctrl+Invio esatto su «Consenti»: la
                    // decisione passa dalla guardia di Rust (600 ms dopo ogni riarmo).
                    decidi(pulsante) => {
                        if (root.coda-aperta-valida) {
                            root.azione-voce(root.coda-aperta, pulsante);
                        }
                    }
                    // «Consenti» compare (fondo del testo visto): Rust lo arma di nuovo.
                    visto-fondo => {
                        if (root.coda-aperta-valida) {
                            root.consenti-compare();
                        }
                    }
                    // Un clic su un pulsante: l'anello da tastiera si spegne.
                    usato-mouse => { da-tastiera = false; }
                    // «Torna all'elenco» (mouse): di nuovo l'elenco, sulla riga del permesso.
                    torna => { chiudi-permesso(); }
                    // Nella Coda l'elenco non si vede: ← e ↑ in cima non escono (Esc, Backspace e
                    // «Torna all'elenco» sì).
                    lascia => { }
                }

                // Il permesso nel dettaglio della pagina Agenti (ridisegno F2, Task 7): il secondo
                // componente del guscio fisso, mai dentro un `if` (pre-flight C1), sopra il posto
                // che l'impianto lascia vuoto (`GeometriaElencoDettaglio`). Pulsanti in basso a
                // destra: lontani dalle righe a sinistra e dal pulsante del dettaglio, in alto a
                // destra, che c'era prima (nessun pulsante nasce sotto un clic precedente).
                agenti-permesso := Permesso {
                    visible: root.agenti-permesso-mostrato;
                    x: GeometriaElencoDettaglio.x-dettaglio;
                    y: GeometriaElencoDettaglio.cima;
                    width: parent.width - self.x;
                    height: parent.height - self.y;
                    voce: root.agenti-voce;
                    pulsanti-in-alto: false;
                    con-torna: false;
                    inerte: root.inerte;
                    con-fuoco: da-tastiera && zona == Zona.contenuto && vista == "agenti" && root.elenco-lato-valido == 1
                        && root.agenti-con-permesso;
                    // Un clic, Narrator, Invio su «Nega» o Ctrl+Invio esatto su «Consenti»: la
                    // decisione passa dalla guardia di Rust (600 ms dopo ogni riarmo).
                    decidi(pulsante) => {
                        if (root.agenti-permesso-mostrato) {
                            root.azione-voce(root.agenti-voce.id, pulsante);
                        }
                    }
                    // «Consenti» compare (fondo del testo visto): Rust lo arma di nuovo (pre-flight C8).
                    visto-fondo => {
                        if (root.agenti-permesso-mostrato) {
                            root.consenti-compare();
                        }
                    }
                    usato-mouse => { da-tastiera = false; }
                    // ← dal primo bersaglio o ↑ dal testo in cima: di nuovo la riga.
                    lascia => { root.elenco-lato = 0; }
                }

                if vista == "collegamenti": VistaCollegamenti {
                    width: parent.width;
                    height: parent.height;
                    voci: root.collegamenti;
                    errore: root.errore-collegamenti;
                    colonne: root.colonne-collegamenti;
                    // Come nella vista Casa: ogni fuoco chiede anche la vista, perché lasciandola
                    // la zona nuova non accenda il fuoco su un elemento che sta sparendo.
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "collegamenti" ? fuoco-collegamento-valido : -1;
                    fuoco-modifica: da-tastiera && zona == Zona.contenuto && vista == "collegamenti" && fuoco-collegamento < 0;
                    fuoco-aggiungi: da-tastiera && zona == Zona.contenuto && vista == "collegamenti";
                    apri(id) => {
                        da-tastiera = false;
                        root.apri-collegamento(id);
                    }
                    gestisci => {
                        da-tastiera = false;
                        root.gestisci-collegamenti();
                    }
                }

                if vista == "pc": VistaPc {
                    width: parent.width;
                    height: parent.height;
                    stat: root.pc;
                    volume-disponibile: root.volume-disponibile;
                    volume: root.volume;
                    volume-muto: root.volume-muto;
                    connessioni-disponibili: root.connessioni-disponibili;
                    radio-lette: root.radio-lette;
                    wifi-presente: root.wifi-presente;
                    wifi-acceso: root.wifi-acceso;
                    bt-presente: root.bt-presente;
                    bt-acceso: root.bt-acceso;
                    nome-rete: root.nome-rete;
                    rete-nota: root.rete-nota;
                    rete: root.rete;
                    tacche: root.tacche;
                    errore-radio: root.errore-radio;
                    cuffie-presenti: root.cuffie-presenti;
                    cuffie-dettaglio: root.cuffie-dettaglio;
                    cuffie-testo: root.cuffie-testo;
                    cuffie-frazione: root.cuffie-frazione;
                    cuffie-tinta: root.cuffie-tinta;
                    cuffie-descrizione: root.cuffie-descrizione;
                    // Come nelle altre viste, il fuoco chiede anche la vista (lasciandola non si
                    // accende su un elemento che sta sparendo).
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "pc" ? fuoco-pc-valido : -1;
                    commuta-radio(tipo, acceso) => {
                        da-tastiera = false;
                        fuoco-pc = tipo + 1;
                        commuta(tipo);
                    }
                    apri-pagina(i) => {
                        da-tastiera = false;
                        root.apri-pagina(i);
                    }
                    imposta-volume(v) => {
                        da-tastiera = false;
                        cambia-volume(v);
                    }
                    muto-volume(si) => {
                        da-tastiera = false;
                        root.muto-volume(si);
                    }
                }
            }


            // La barra bassa: ricerca, schede, volume. Ferma: cambiando pagina si muove solo il corpo.
            Barra {
                x: (root.larghezza-finestra - root.larghezza-isola) / 2;
                y: root.altezza-pannello - self.height;
                width: root.larghezza-isola;
                schede: root.schede;
                attiva: scheda-di(vista);
                fuoco-scheda: da-tastiera && zona == Zona.dock ? fuoco-dock : -1;
                fuoco-ricerca: da-tastiera && zona == Zona.ricerca;
                fuoco-volume: da-tastiera && zona == Zona.volume && volume-disponibile;
                volume: root.volume;
                volume-muto: root.volume-muto;
                volume-disponibile: root.volume-disponibile;
                rotella-volume: root.rotella-volume;
                scelta(i) => {
                    da-tastiera = false;
                    apri(i, root.schede[i].id);
                }
                muto-volume(si) => {
                    da-tastiera = false;
                    root.muto-volume(si);
                }
                passo-volume(punti) => { rotella-volume-passo(punti); }
            }

            // Il menu «⋯» sopra tutto il resto (ultimo figlio): sotto il pulsante, a filo del suo
            // bordo destro. Un clic fuori lo chiude e basta; un tasto qualunque è suo (`tasti`).
            menu-scuro := MenuScuro {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                voci: root.voci-menu;
                schermi: root.schermi-menu;
                schermo-scelto: root.menu-schermo-scelto;
                destra: root.piu-x + 32px;
                alto: root.piu-y + 32px + 4px;
                anello: da-tastiera;
                scelta(id) => { root.scelta-menu(id); }
                usato-mouse => { da-tastiera = false; }
                cerca-iniziale(lettera, sotto, da) => { return root.cerca-iniziale-menu(lettera, sotto, da); }
                rilascia-fuoco => {
                    if (da-tastiera) {
                        riga-alta.fuoco-sul-menu();
                    } else {
                        tasti.focus();
                    }
                }
            }
        }
    }

    // Fa partire l'arrivo animato del contenuto, 16 ms dopo il punto di partenza.
    arrivo := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            in-arrivo = true;
            scarto-contenuto = 0px;
            opacita-contenuto = 1;
        }
    }

    // Il fuoco vero sugli elementi solo a pannello sceso (vedi `Fuochi`): l'apertura dura 200 ms.
    // Se la voce ti aspetta già all'apertura, il fuoco parte dal suo bersaglio iniziale («Nega»).
    init => {
        Fuochi.pronti = false;
        if (voce-mostrata) {
            fuoco = bersaglio-iniziale-voce();
        }
    }
    Timer {
        interval: 220ms;
        running: aperto && !Fuochi.pronti;
        triggered => { Fuochi.pronti = true; }
    }

    // C'è un elemento per la zona e l'indice col fuoco da tastiera? Se no (clic col mouse, voce
    // sparita, Casa svuotata) il fuoco torna a `tasti`, che tiene comunque la tastiera.
    property <bool> bersaglio: zona == Zona.attesa ? ha-zona(Zona.attesa)
        : zona == Zona.stanze ? ha-zona(Zona.stanze)
        : zona == Zona.contenuto ? ha-zona(Zona.contenuto) && (vista == "panoramica" || vista == "collegamenti" || vista == "agenti" || vista == "pc" || vista == "coda"
            || (griglia.length > 0 ? (fuoco-casa >= 0 || riprova-visibile) : !casa-pronta))
        : zona == Zona.volume ? volume-disponibile
        : true;
    property <bool> fuoco-su-elemento: da-tastiera && bersaglio;
    changed fuoco-su-elemento => {
        if (!self.fuoco-su-elemento) {
            tasti.focus();
        }
    }

    Timer {
        interval: 160ms;
        running: aperto && !occhi-al-centro;
        triggered => {
            occhi-al-centro = true;
        }
    }

}
