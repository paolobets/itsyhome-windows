// Il pannello unico dell'assistente (spec §3bis). Riga alta: «‹ Indietro» a sinistra solo dentro
// un'app, occhi al centro (dove stavano quelli della pillola), l'ora a destra. Centro: la
// Panoramica (riga «In attesa» se c'è qualcosa, poi il layout Orologio o Quadranti, cambiabili
// con i puntini, le frecce e la rotella) o la vista di un'app. In basso il dock di sole icone.
//
// Tastiera: Tab / Maiusc+Tab fra «Indietro», «In attesa», contenuto e dock; frecce dentro la zona
// (in «In attesa» ←/→ fra le voci e, a voce espansa, ↓ ai pulsanti e ↑ di nuovo alla voce; nella
// Panoramica ←/→ cambiano layout, nel dock cambiano icona; in Casa Tab passa dalle stanze alle
// card: ↑/↓ fra le stanze e → alle card, le frecce fra le card, ← dalla prima colonna alle stanze
// e ↑ dalla prima riga a «Riprova» quando c'è; Casa vuota e non connessa: «Apri Impostazioni»);
// Invio o Spazio attivano (su una stanza: la apre o la chiude; su una voce: la espande o la
// riduce; un permesso, «Consenti», solo con Ctrl+Invio, e la voce che lo chiede si apre col fuoco
// su «Nega»); Backspace o Alt+← = Indietro (prima chiude la stanza aperta); Esc un livello alla
// volta: riduce la voce espansa, chiude la stanza, poi il pannello; ↑/↓ sulla voce espansa
// scorrono il testo lungo.
// Un unico FocusScope tiene il fuoco e l'anello (visibile solo da tastiera) segue la
// zona scelta.
import { Tema, Movimento } from "tema.slint";
import { Faccia, Occhi } from "faccia.slint";
import { Anello, Fuoco, Fuochi } from "componenti.slint";
import { VoceAppUi, StatPcUi, PreferitoUi, SensoreUi, PulsanteUi, VoceAttesaUi, UmoreUi, StanzaUi } from "voci.slint";
import { RigaAttesa, VoceEspansa } from "attesa.slint";
import { VistaPc } from "viste/pc.slint";
import { VistaCasa } from "viste/casa.slint";
import { LayoutOrologio } from "layout/orologio.slint";
import { LayoutQuadranti } from "layout/quadranti.slint";

export { VoceAppUi, StatPcUi, PreferitoUi, SensoreUi, PulsanteUi, VoceAttesaUi, StanzaUi }

// Una scheda del dock: solo l'icona (bersaglio 36 × 32, icona 20); quella attiva sta in una
// capsula "vetro" e diventa bianca. Il nome compare in un suggerimento dopo una breve sosta del
// mouse, o subito quando la scheda ha il fuoco da tastiera.
component Scheda inherits Rectangle {
    in property <image> icona;
    in property <string> nome;
    in property <bool> attiva;
    in property <bool> anello;
    // Posizione nel dock (per Narrator: «scheda 2 di 4»).
    in property <int> indice;
    in property <int> quante;
    callback scelta();
    property <bool> sosta: false;

    width: 36px;
    height: 32px;
    border-radius: self.height / 2;
    background: attiva ? Tema.scheda-attiva : area.has-hover ? Tema.scheda-sopra : transparent;
    accessible-role: tab;
    accessible-label: nome;
    accessible-item-selectable: true;
    accessible-item-selected: attiva;
    accessible-item-index: indice;
    accessible-item-count: quante;
    accessible-action-default => { root.scelta(); }

    Fuoco { chiede: anello; }

    Image {
        source: icona;
        width: 20px;
        height: 20px;
        accessible-role: none;
        colorize: attiva ? Tema.icona-attiva : Tema.icona;
        image-rendering: smooth;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta(); }
        changed has-hover => {
            if (!self.has-hover) {
                root.sosta = false;
            }
        }
    }

    // Gira solo mentre il mouse è fermo sopra la scheda e il suggerimento non c'è ancora.
    Timer {
        interval: 600ms;
        running: area.has-hover && !root.sosta;
        triggered => { root.sosta = true; }
    }

    if anello: Anello { raggio: parent.border-radius; }

    if (sosta && area.has-hover) || anello: Rectangle {
        y: -32px;
        height: 24px;
        width: suggerimento.preferred-width + 18px;
        x: (parent.width - self.width) / 2;
        border-radius: Tema.raggio-s;
        background: Tema.suggerimento;
        border-width: 1px;
        border-color: Tema.vetro-bordo;

        suggerimento := Text {
            text: root.nome;
            font-size: Tema.testo-piccolo;
            color: Tema.testo;
        }
    }
}

// Zona del pannello col fuoco da tastiera.
enum Zona { indietro, attesa, stanze, contenuto, dock }

export component Pannello inherits Window {
    in property <UmoreUi> umore: UmoreUi.tranquillo;
    in property <string> ora;
    in property <string> data;
    // Layout della Panoramica (indice del puntino: 0 Orologio, 1 Quadranti, come `layout.rs`).
    in-out property <int> layout: 0;
    out property <int> numero-layout: 2;
    // L'app mostrata al centro; "panoramica" è la schermata principale. È l'id di un'app del
    // registro (un dato, non uno stato con un nome: resta una stringa).
    in-out property <string> vista: "panoramica";
    // L'app aperta per ultima dal dock (indice in `app`) e se non ha una vista sua (oggi nessuna:
    // le Impostazioni hanno una finestra loro).
    property <int> indice-vista: 0;
    property <bool> vista-vuota: vista != "panoramica" && vista != "casa" && vista != "pc"
        && indice-vista >= 0 && indice-vista < app.length && app[indice-vista].id == vista;
    in property <[VoceAppUi]> app;
    // Statistiche del PC, aggiornate ogni 2 s solo a pannello aperto.
    in property <StatPcUi> pc;
    // Vero mentre il pannello è aperto: guida l'animazione di apertura e il battito degli occhi.
    in-out property <bool> aperto;
    // Casa: i preferiti (al massimo 8), la riga di stato, i sensori dei Quadranti (al massimo 3).
    in property <[PreferitoUi]> preferiti;
    in property <[SensoreUi]> sensori;
    // Le stanze della vista Casa e i dispositivi della stanza aperta (li dà Rust a `apri-stanza`).
    in property <[StanzaUi]> stanze;
    in property <[PreferitoUi]> dispositivi;
    // La stanza aperta (indice in `stanze`, -1 = nessuna). Rust la riallinea se le stanze cambiano.
    in-out property <int> stanza-aperta: -1;
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    // Senza connessione: l'ora degli ultimi dati («dati delle 10:42») e se ha senso «Riprova».
    in property <string> dati-delle;
    in property <bool> casa-riprovabile;
    // Da dove partono gli occhi all'apertura, rispetto al centro: aprendo da "ti cerca" sono
    // dove stavano quelli della pillola allargata e, appena il pannello è comparso, scivolano al centro.
    in property <length> partenza-occhi: 0px;
    // Lo stesso in altezza, rispetto al centro della riga alta: la pillola che chiama è più alta.
    in property <length> partenza-occhi-y: 0px;
    // Le voci «In attesa», già in ordine (bloccante, attenzione, informazione; poi le più recenti).
    in property <[VoceAttesaUi]> attese;
    // Id della voce espansa sul posto ("" = nessuna). Rust la azzera se la voce sparisce e la
    // imposta quando il pannello si apre dalla pillola che chiama.
    in-out property <string> voce-aperta;
    // Posizione della voce espansa in `attese` (-1 = nessuna): va sempre insieme a `voce-aperta`.
    in-out property <int> indice-aperta: -1;
    callback tocca(string);
    // Un pulsante di una voce in attesa: (id della voce, id del pulsante).
    callback azione(string, string);
    // Clic su un puntino: quel layout.
    callback scegli-layout(int);
    // Frecce, rotella e Invio sui puntini: +1 il successivo, -1 il precedente (lo decide Rust).
    callback scorri-layout(int);
    callback apri-app(string);
    callback chiudi();
    // «Riprova» nella testata della vista Casa (stessa azione della voce «Casa non raggiungibile»).
    callback riprova-casa();
    // Una stanza della vista Casa aperta (area) o chiusa.
    callback apri-stanza(string);
    callback chiudi-stanza();

    // Geometria (logica). La riga alta è alta quanto la pillola a riposo, così gli occhi cadono dove
    // stavano i suoi (vedi `posizione_pannello` in finestre.rs). Pannello 800 × 300: zona
    // centrale 764 × 188, poi la riga dei puntini (solo nella Panoramica) e il dock.
    out property <length> larghezza-pannello: 800px;
    property <length> margine: 18px;
    out property <length> altezza-riga: Faccia.altezza-pillola;
    property <length> altezza-dock: 38px;
    property <length> dock-y: root.height - altezza-dock - 12px;
    property <length> altezza-puntini: 20px;
    property <length> puntini-y: dock-y - altezza-puntini - 4px;
    out property <length> centro-x: margine;
    out property <length> centro-y: altezza-riga + 4px;
    out property <length> centro-l: root.width - 2 * margine;
    out property <length> centro-a: puntini-y - 2px - centro-y;
    // Riga «In attesa» (solo nella Panoramica e solo se c'è qualcosa): il layout sta sotto.
    property <bool> con-attese: vista == "panoramica" && attese.length > 0;
    property <length> altezza-attese: 42px;
    property <length> sotto-attese: con-attese ? altezza-attese + 6px : 0px;
    property <bool> espansa: con-attese && indice-aperta >= 0 && indice-aperta < attese.length;

    // Diventa vero poco dopo l'apertura, quando i primi fotogrammi hanno già disegnato gli occhi
    // al punto di partenza: solo allora lo scarto si anima (le proprietà si calcolano solo
    // quando servono, quindi un cambio nello stesso istante dell'apertura non si vedrebbe).
    property <bool> occhi-al-centro: partenza-occhi == 0px && partenza-occhi-y == 0px;

    // ─── Tastiera ───
    // Zona col fuoco: Zona.indietro, Zona.contenuto o Zona.dock. All'apertura il fuoco va sul contenuto.
    property <Zona> zona: Zona.contenuto;
    // L'anello si vede solo dopo un tasto; un clic lo spegne.
    property <bool> da-tastiera: false;
    property <int> fuoco-dock: 0;
    property <int> fuoco-casa: 0;
    property <int> colonne-casa: 4;
    // Le card della vista Casa: i dispositivi della stanza aperta, altrimenti i preferiti.
    property <bool> in-stanza: stanza-aperta >= 0 && stanza-aperta < stanze.length;
    property <[PreferitoUi]> griglia: in-stanza ? dispositivi : preferiti;
    property <int> fuoco-casa-valido: min(fuoco-casa, griglia.length - 1);
    property <int> fuoco-stanza: 0;
    property <int> fuoco-stanza-valido: min(fuoco-stanza, stanze.length - 1);
    // «Riprova» nella testata della vista Casa: casa non connessa che si può riprovare.
    property <bool> riprova-visibile: !casa-pronta && casa-riprovabile && (griglia.length > 0 || stanze.length > 0);
    // «In attesa»: voce col fuoco (da chiusa 0..2, 3 = «+N») e pulsante della voce espansa
    // (-1 = la voce stessa).
    property <int> fuoco-attesa: 0;
    property <int> fuoco-pulsante: -1;
    // Testo della voce espansa: richieste di scorrimento da tastiera (contatori: ogni scatto è un
    // passo) e se è già in fondo (lo dice la voce stessa).
    property <int> testo-su: 0;
    property <int> testo-giu: 0;
    property <bool> testo-a-fondo: true;
    // Rotella: spostamento accumulato e pausa dopo un cambio (un touchpad manda molti piccoli passi).
    property <length> rotella: 0px;
    property <bool> rotella-ferma: false;

    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "ItsyHome — pannello";
    default-font-family: Tema.carattere;
    width: larghezza-pannello;
    height: 300px;
    forward-focus: tasti;

    pure function ha-zona(z: Zona) -> bool {
        if (z == Zona.indietro) {
            return vista != "panoramica";
        }
        if (z == Zona.attesa) {
            return con-attese;
        }
        if (z == Zona.stanze) {
            return vista == "casa" && stanze.length > 0;
        }
        if (z == Zona.contenuto) {
            // Con una voce espansa il layout è coperto: niente fuoco lì.
            if (espansa) {
                return false;
            }
            // Casa vuota e non connessa: il fuoco va su «Apri Impostazioni».
            return vista == "panoramica" || (vista == "casa" && (griglia.length > 0 || !casa-pronta));
        }
        return true;
    }

    pure function zona-dopo(z: Zona, avanti: bool) -> Zona {
        if (avanti) {
            return z == Zona.indietro ? Zona.attesa : z == Zona.attesa ? Zona.stanze : z == Zona.stanze ? Zona.contenuto
                : z == Zona.contenuto ? Zona.dock : Zona.indietro;
        }
        return z == Zona.dock ? Zona.contenuto : z == Zona.contenuto ? Zona.stanze : z == Zona.stanze ? Zona.attesa
            : z == Zona.attesa ? Zona.indietro : Zona.dock;
    }

    // Tab: la zona seguente che esiste in questa vista (il dock c'è sempre).
    function passa-zona(avanti: bool) {
        zona = zona-dopo(zona, avanti);
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        if (!ha-zona(zona)) {
            zona = zona-dopo(zona, avanti);
        }
        fuoco-pulsante = -1;
    }

    // La voce `i` chiede un permesso (ha un pulsante delicato; al massimo 2 pulsanti per voce).
    pure function chiede-permesso(i: int) -> bool {
        if (i < 0 || i >= attese.length) {
            return false;
        }
        return (attese[i].pulsanti.length > 0 && attese[i].pulsanti[0].delicato)
            || (attese[i].pulsanti.length > 1 && attese[i].pulsanti[1].delicato);
    }

    // Il primo pulsante non delicato della voce `i` («Nega»), qualunque sia l'ordine scelto dalla
    // fonte; -1 se sono tutti delicati (allora il fuoco resta sulla voce).
    pure function primo-non-delicato(i: int) -> int {
        if (attese[i].pulsanti.length > 0 && !attese[i].pulsanti[0].delicato) {
            return 0;
        }
        if (attese[i].pulsanti.length > 1 && !attese[i].pulsanti[1].delicato) {
            return 1;
        }
        return -1;
    }

    // Espande la voce `i`: il fuoco da tastiera va su «In attesa» (il layout sotto è coperto).
    // Se la voce chiede un permesso il fuoco parte da «Nega» (il pulsante non delicato): Invio lì nega,
    // e «Consenti» vuole Ctrl+Invio.
    function apri-voce(i: int) {
        if (i >= 0 && i < attese.length) {
            voce-aperta = attese[i].id;
            indice-aperta = i;
            zona = Zona.attesa;
            fuoco-attesa = min(i, 3);
            fuoco-pulsante = chiede-permesso(i) ? primo-non-delicato(i) : -1;
        }
    }

    // Da Rust: il pannello si apre dalla pillola che chiama, sulla voce `i` già espansa.
    public function espandi(i: int) {
        apri-voce(i);
    }

    function riduci-voce() {
        voce-aperta = "";
        indice-aperta = -1;
        fuoco-pulsante = -1;
    }

    // Apre la stanza `i` della vista Casa; `alle-card`: da tastiera il fuoco passa ai suoi dispositivi.
    function apri-stanza-i(i: int, alle-card: bool) {
        if (i >= 0 && i < stanze.length) {
            // Le card cambiano tutte: se una aveva il fuoco sparisce, il fuoco passa prima a `tasti`.
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            stanza-aperta = i;
            fuoco-stanza = i;
            fuoco-casa = 0;
            root.apri-stanza(stanze[i].area-id);
            if (alle-card) {
                zona = Zona.contenuto;
            }
        }
    }

    // Chiude la stanza aperta: tornano i preferiti; da tastiera il fuoco torna sulla stanza.
    function chiudi-stanza-ora() {
        if (stanza-aperta >= 0) {
            if (zona == Zona.contenuto) {
                tasti.focus();
            }
            fuoco-stanza = stanza-aperta;
            stanza-aperta = -1;
            fuoco-casa = 0;
            root.chiudi-stanza();
            if (zona == Zona.contenuto && ha-zona(Zona.stanze)) {
                zona = Zona.stanze;
            }
        }
    }

    // Clic o Invio su una stanza: la apre, o la chiude se è già aperta (come la v2).
    function scegli-stanza(i: int, alle-card: bool) {
        if (i == stanza-aperta) {
            chiudi-stanza-ora();
        } else {
            apri-stanza-i(i, alle-card);
        }
    }

    function vai(v: string) {
        // La vista che se ne va (con «In attesa» e «Indietro») può avere l'elemento col fuoco:
        // distrutto lui, il pannello resterebbe senza fuoco e senza tastiera. Il fuoco passa prima
        // a `tasti`; l'elemento scelto nella vista nuova lo riprende da sé (`Fuoco`). Il dock resta.
        if (zona != Zona.dock) {
            tasti.focus();
        }
        if (stanza-aperta >= 0) {
            stanza-aperta = -1;
            root.chiudi-stanza();
        }
        vista = v;
        fuoco-casa = 0;
        if (!ha-zona(zona)) {
            zona = ha-zona(Zona.contenuto) ? Zona.contenuto : Zona.dock;
        }
    }

    // «‹ Indietro» un livello alla volta: prima la stanza aperta, poi la Panoramica.
    function indietro() {
        if (stanza-aperta >= 0) {
            chiudi-stanza-ora();
        } else if (vista != "panoramica") {
            fuoco-dock = 0;
            vai("panoramica");
        }
    }

    function apri(i: int, id: string) {
        fuoco-dock = i;
        indice-vista = i;
        // «Impostazioni» non è una vista: apre la sua finestra (e il pannello si chiude).
        if (id != "impostazioni") {
            vai(id);
        }
        root.apri-app(id);
    }

    function scegli(i: int) {
        root.layout = i;
        root.scegli-layout(i);
    }

    function freccia(k: string) {
        if (zona == Zona.dock) {
            if (k == Key.LeftArrow) {
                fuoco-dock = max(0, fuoco-dock - 1);
            } else if (k == Key.RightArrow) {
                fuoco-dock = min(app.length - 1, fuoco-dock + 1);
            }
        } else if (zona == Zona.attesa && espansa) {
            if (fuoco-pulsante >= 0) {
                if (k == Key.LeftArrow) {
                    fuoco-pulsante = max(0, fuoco-pulsante - 1);
                } else if (k == Key.RightArrow) {
                    fuoco-pulsante = min(attese[indice-aperta].pulsanti.length - 1, fuoco-pulsante + 1);
                } else if (k == Key.UpArrow) {
                    fuoco-pulsante = -1;
                }
            } else if (k == Key.LeftArrow && indice-aperta > 0) {
                apri-voce(indice-aperta - 1);
            } else if (k == Key.RightArrow && indice-aperta < attese.length - 1) {
                apri-voce(indice-aperta + 1);
            } else if (k == Key.UpArrow) {
                // Sulla voce ↑/↓ scorrono il testo lungo; ↓ in fondo al testo passa ai pulsanti.
                testo-su += 1;
            } else if (k == Key.DownArrow && !testo-a-fondo) {
                testo-giu += 1;
            } else if (k == Key.DownArrow && indice-aperta >= 0 && attese[indice-aperta].pulsanti.length > 0) {
                fuoco-pulsante = 0;
            }
        } else if (zona == Zona.attesa) {
            if (k == Key.LeftArrow) {
                fuoco-attesa = max(0, min(fuoco-attesa, 3) - 1);
            } else if (k == Key.RightArrow) {
                fuoco-attesa = min(min(attese.length, 4) - 1, fuoco-attesa + 1);
            }
        } else if (zona == Zona.contenuto && vista == "panoramica") {
            if (k == Key.LeftArrow) {
                root.scorri-layout(-1);
            } else if (k == Key.RightArrow) {
                root.scorri-layout(1);
            }
        } else if (zona == Zona.stanze) {
            if (k == Key.UpArrow) {
                fuoco-stanza = max(0, fuoco-stanza-valido - 1);
            } else if (k == Key.DownArrow) {
                fuoco-stanza = min(stanze.length - 1, fuoco-stanza-valido + 1);
            } else if (k == Key.RightArrow && ha-zona(Zona.contenuto)) {
                zona = Zona.contenuto;
                fuoco-casa = 0;
            }
        } else if (zona == Zona.contenuto && vista == "casa" && griglia.length > 0) {
            // -1 = «Riprova» nella testata (solo se c'è): ↑ dalla prima riga, ↓ torna alle card.
            if (fuoco-casa < 0) {
                if (k == Key.DownArrow) {
                    fuoco-casa = 0;
                }
            } else if (k == Key.LeftArrow && mod(fuoco-casa-valido, colonne-casa) == 0 && ha-zona(Zona.stanze)) {
                // Dalla prima colonna alle stanze, su quella aperta se c'è.
                zona = Zona.stanze;
                if (stanza-aperta >= 0) {
                    fuoco-stanza = stanza-aperta;
                }
            } else if (k == Key.LeftArrow) {
                fuoco-casa = max(0, fuoco-casa-valido - 1);
            } else if (k == Key.RightArrow) {
                fuoco-casa = min(griglia.length - 1, fuoco-casa-valido + 1);
            } else if (k == Key.UpArrow && fuoco-casa-valido >= colonne-casa) {
                fuoco-casa = fuoco-casa-valido - colonne-casa;
            } else if (k == Key.UpArrow && riprova-visibile) {
                fuoco-casa = -1;
            } else if (k == Key.DownArrow && fuoco-casa-valido + colonne-casa < griglia.length) {
                fuoco-casa = fuoco-casa-valido + colonne-casa;
            }
        }
    }

    // Invio / Spazio sulla zona col fuoco; `ctrl`: Ctrl+Invio, l'unico tasto che concede un
    // permesso (su un pulsante delicato Invio e Spazio da soli non fanno nulla).
    function attiva(ctrl: bool) {
        if (ctrl) {
            if (zona == Zona.attesa && espansa && fuoco-pulsante >= 0 && indice-aperta >= 0
                    && attese[indice-aperta].pulsanti[fuoco-pulsante].delicato) {
                root.azione(voce-aperta, attese[indice-aperta].pulsanti[fuoco-pulsante].id);
            }
            return;
        }
        if (zona == Zona.indietro) {
            indietro();
        } else if (zona == Zona.attesa && espansa) {
            if (fuoco-pulsante >= 0 && indice-aperta >= 0) {
                if (!attese[indice-aperta].pulsanti[fuoco-pulsante].delicato) {
                    root.azione(voce-aperta, attese[indice-aperta].pulsanti[fuoco-pulsante].id);
                }
            } else {
                riduci-voce();
            }
        } else if (zona == Zona.attesa) {
            apri-voce(min(fuoco-attesa, attese.length - 1));
        } else if (zona == Zona.dock) {
            apri(fuoco-dock, app[fuoco-dock].id);
        } else if (zona == Zona.stanze) {
            scegli-stanza(fuoco-stanza-valido, true);
        } else if (vista == "panoramica") {
            root.scorri-layout(1);
        } else if (vista == "casa" && griglia.length == 0) {
            root.apri-app("impostazioni");
        } else if (vista == "casa" && fuoco-casa < 0) {
            if (riprova-visibile) {
                root.riprova-casa();
            }
        } else if (vista == "casa" && fuoco-casa-valido >= 0 && griglia[fuoco-casa-valido].toccabile) {
            root.tocca(griglia[fuoco-casa-valido].entity-id);
        }
    }

    // Tiene la tastiera di tutto il pannello: intercetta ogni tasto prima dell'elemento col fuoco
    // (`capture-key-pressed`), che sia lui o un elemento dentro. Il fuoco vero va sull'elemento
    // scelto da tastiera (FE13: Narrator ne legge ruolo e nome); col mouse, o se quell'elemento
    // non c'è più, torna qui.
    tasti := FocusScope {
        accessible-role: groupbox;
        accessible-label: "Pannello di ItsyHome";
        capture-key-pressed(evento) => {
            // Un livello alla volta: con una voce espansa il primo Esc la riduce; con una stanza
            // aperta la chiude; poi chiude il pannello.
            if (evento.text == Key.Escape) {
                if (espansa) {
                    riduci-voce();
                } else if (stanza-aperta >= 0) {
                    chiudi-stanza-ora();
                } else {
                    root.chiudi();
                }
                return accept;
            }
            if (evento.text == Key.Tab || evento.text == Key.Backtab) {
                da-tastiera = true;
                passa-zona(evento.text == Key.Tab && !evento.modifiers.shift);
                return accept;
            }
            if (evento.text == Key.Backspace || (evento.text == Key.LeftArrow && evento.modifiers.alt)) {
                if (vista == "panoramica") {
                    return reject;
                }
                da-tastiera = true;
                indietro();
                return accept;
            }
            // Ctrl+Invio esatto (niente Alt, AltGr, Maiusc o Win) prima del rifiuto dei modificatori:
            // concede il permesso col fuoco.
            if (evento.text == Key.Return && evento.modifiers.control && !evento.modifiers.alt
                    && !evento.modifiers.meta && !evento.modifiers.shift) {
                da-tastiera = true;
                attiva(true);
                return accept;
            }
            // Invio o Spazio con qualunque altro modificatore: presi qui e ignorati. Rifiutati,
            // arriverebbero all'elemento col fuoco vero (un pulsante, magari «Consenti»).
            if (evento.text == Key.Return || evento.text == Key.Space) {
                if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta || evento.modifiers.shift) {
                    return accept;
                }
            }
            if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
                return reject;
            }
            if (evento.text == Key.LeftArrow || evento.text == Key.RightArrow || evento.text == Key.UpArrow || evento.text == Key.DownArrow) {
                da-tastiera = true;
                freccia(evento.text);
                return accept;
            }
            if (evento.text == Key.Return || evento.text == Key.Space) {
                da-tastiera = true;
                attiva(false);
                return accept;
            }
            return reject;
        }

        // Apertura: il pannello scende dalla riga degli occhi e compare (opacità + altezza, 200 ms).
        // Con il movimento ridotto non scende: compare soltanto, in dissolvenza (120 ms).
        corpo := Rectangle {
            y: 0;
            height: aperto ? root.height : altezza-riga;
            opacity: aperto ? 1 : 0;
            animate height { duration: Movimento.ridotto ? 0ms : 200ms; easing: ease-out; }
            animate opacity { duration: Movimento.ridotto ? 120ms : 200ms; easing: ease-out; }
            border-radius: Tema.raggio-pannello;
            clip: true;
            // Anello sottile con i colori dei petali, come il bordo dell'isola nella bozza (fermo).
            background: Tema.petali;

            // Filo di 1,5 px arrotondato al pixel fisico (FE27): a 1,25 e 1,75 non si sfoca.
            Rectangle {
                property <length> filo: Tema.sul-pixel(1.5px);
                x: filo;
                y: filo;
                width: parent.width - 2 * filo;
                height: parent.height - 2 * filo;
                border-radius: parent.border-radius - filo;
                clip: true;
                background: Tema.corpo;

                // Due bagliori appena percettibili (indaco in alto a sinistra, verde acqua in basso a destra).
                // Quadrati con la sfumatura che svanisce prima dei lati: nessun bordo visibile.
                Rectangle {
                    x: -100px;
                    y: -220px;
                    width: 440px;
                    height: 440px;
                    background: @radial-gradient(circle, Tema.bagliore-indaco 0%, transparent 60%);
                }

                Rectangle {
                    x: parent.width - 230px;
                    y: parent.height - 190px;
                    width: 400px;
                    height: 400px;
                    background: @radial-gradient(circle, Tema.bagliore-acqua 0%, transparent 60%);
                }
            }

            // Riga alta: occhi al centro, ora a destra («Indietro» a sinistra è più sotto).
            // Il battito di ciglia (dentro Occhi) solo a pannello aperto.
            occhi := Occhi {
                umore: root.umore;
                attivo: aperto;
                // Restano sugli occhi della pillola mentre il pannello compare, poi vanno al centro
                // (solo lo scarto è animato: un cambio d'umore li ricentra subito).
                property <length> scarto: occhi-al-centro ? 0px : partenza-occhi;
                property <length> scarto-y: occhi-al-centro ? 0px : partenza-occhi-y;
                animate scarto, scarto-y { duration: Movimento.ridotto ? 0ms : 240ms; easing: ease-in-out; }
                x: (parent.width - self.ingombro) / 2 + self.scarto;
                y: self.scarto-y;
                width: self.ingombro;
                height: altezza-riga;
                accessible-role: button;
                accessible-label: "Chiudi il pannello";
                accessible-action-default => { root.chiudi(); }

                TouchArea {
                    // Un po' più larga degli occhi, per non doverli centrare al pixel.
                    x: -12px;
                    width: parent.width + 24px;
                    mouse-cursor: pointer;
                    clicked => { root.chiudi(); }
                }
            }

            Text {
                x: 0;
                y: 0;
                width: parent.width - margine;
                height: altezza-riga;
                text: ora;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: Tema.carattere-mono;
                font-size: Tema.testo-corpo;
                color: Tema.testo-ora;
            }

            // «‹ Indietro» a sinistra della riga alta, solo dentro un'app: torna alla Panoramica.
            // Alto 28 nella riga da 32: 2 px sopra e sotto, così né lo sfondo dell'hover né l'anello
            // del fuoco toccano il filo colorato del bordo (1,5 px) o la curva dell'angolo.
            if vista != "panoramica": Rectangle {
                x: margine - 8px;
                y: (altezza-riga - self.height) / 2;
                height: 28px;
                width: etichetta-indietro.preferred-width + 20px;
                border-radius: self.height / 2;
                background: area-indietro.has-hover ? Tema.scheda-sopra : transparent;
                accessible-role: button;
                accessible-label: "Indietro";
                accessible-action-default => { indietro(); }

                Fuoco { chiede: da-tastiera && zona == Zona.indietro; }

                etichetta-indietro := Text {
                    text: "‹ Indietro";
                    font-size: Tema.testo-corpo;
                    color: Tema.testo-ora;
                }

                area-indietro := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        da-tastiera = false;
                        indietro();
                    }
                }

                // Anello del fuoco sul contorno del pulsante (dentro, non fuori): fuori sarebbe
                // tagliato dal bordo alto del pannello, che ha `clip`.
                if da-tastiera && zona == Zona.indietro: Anello {
                    raggio: parent.border-radius;
                    distanza: -2px;
                }
            }

            // «In attesa»: in cima alla Panoramica, solo se c'è qualcosa.
            if con-attese && !espansa: RigaAttesa {
                x: centro-x;
                y: centro-y;
                width: centro-l;
                height: altezza-attese;
                voci: root.attese;
                fuoco: da-tastiera && zona == Zona.attesa ? fuoco-attesa : -1;
                scelta(i) => {
                    da-tastiera = false;
                    apri-voce(i);
                }
            }

            // Una voce espansa sul posto: copre la riga e il layout (nessuna vista nuova).
            if espansa: VoceEspansa {
                x: centro-x;
                y: centro-y;
                width: centro-l;
                height: centro-a;
                voce: root.attese[indice-aperta];
                posizione: indice-aperta;
                totale: root.attese.length;
                fuoco: !(da-tastiera && zona == Zona.attesa) ? -1 : fuoco-pulsante >= 0 ? fuoco-pulsante : -2;
                scorri-su: root.testo-su;
                scorri-giu: root.testo-giu;
                fondo(a-fondo) => { root.testo-a-fondo = a-fondo; }
                riduci => {
                    da-tastiera = false;
                    riduci-voce();
                }
                precedente => {
                    da-tastiera = false;
                    apri-voce(indice-aperta > 0 ? indice-aperta - 1 : root.attese.length - 1);
                }
                successiva => {
                    da-tastiera = false;
                    apri-voce(indice-aperta < root.attese.length - 1 ? indice-aperta + 1 : 0);
                }
                azione(p) => {
                    da-tastiera = false;
                    root.azione(voce-aperta, p);
                }
            }

            // Centro: la Panoramica (solo sintesi, nessun comando) o la vista dell'app.
            Rectangle {
                x: centro-x;
                y: centro-y + sotto-attese;
                width: centro-l;
                height: centro-a - sotto-attese;
                visible: !espansa;

                if vista == "panoramica" && layout == 0: LayoutOrologio {
                    width: parent.width;
                    height: parent.height;
                    ora: root.ora;
                    data: root.data;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    pc: root.pc;
                }
                if vista == "panoramica" && layout == 1: LayoutQuadranti {
                    width: parent.width;
                    height: parent.height;
                    stat: root.pc;
                    sensori: root.sensori;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                }

                // La rotella sulla Panoramica cambia layout (in giù il successivo).
                if vista == "panoramica": TouchArea {
                    width: parent.width;
                    height: parent.height;
                    scroll-event(evento) => {
                        if (rotella-ferma) {
                            return accept;
                        }
                        rotella += abs(evento.delta-x) > abs(evento.delta-y) ? evento.delta-x : evento.delta-y;
                        silenzio-rotella.running = true;
                        silenzio-rotella.restart();
                        if (abs(rotella) >= 24px) {
                            root.scorri-layout(rotella < 0 ? 1 : -1);
                            rotella = 0px;
                            rotella-ferma = true;
                        }
                        return accept;
                    }
                }

                if vista == "casa": VistaCasa {
                    width: parent.width;
                    height: parent.height;
                    voci: root.griglia;
                    stanze: root.stanze;
                    stanza-aperta: root.stanza-aperta;
                    // Ogni fuoco della vista chiede anche `vista == "casa"`: lasciando la vista, la
                    // zona nuova non deve accendere il fuoco su un elemento che sta sparendo (il suo
                    // `changed` girerebbe dopo, su un elemento distrutto, e il pannello resterebbe
                    // senza tastiera).
                    fuoco-stanza: da-tastiera && zona == Zona.stanze && vista == "casa" ? fuoco-stanza-valido : -1;
                    stato-casa: root.stato-casa;
                    casa-pronta: root.casa-pronta;
                    dati-delle: root.dati-delle;
                    riprova: riprova-visibile;
                    colonne: root.colonne-casa;
                    fuoco: da-tastiera && zona == Zona.contenuto && vista == "casa" ? fuoco-casa-valido : -1;
                    fuoco-riprova: da-tastiera && zona == Zona.contenuto && vista == "casa" && fuoco-casa < 0;
                    fuoco-impostazioni: da-tastiera && zona == Zona.contenuto && vista == "casa";
                    tocca(id) => {
                        da-tastiera = false;
                        root.tocca(id);
                    }
                    scegli-stanza(i) => {
                        da-tastiera = false;
                        scegli-stanza(i, false);
                    }
                    riprova-casa => {
                        da-tastiera = false;
                        root.riprova-casa();
                    }
                    apri-impostazioni => {
                        da-tastiera = false;
                        root.apri-app("impostazioni");
                    }
                }

                if vista == "pc": VistaPc {
                    width: parent.width;
                    height: parent.height;
                    stat: root.pc;
                }

                // Vista di un'app senza contenuti propri: solo il titolo (oggi nessuna; le Impostazioni
                // hanno una finestra loro).
                // Una sola, e creata solo se serve (FE4): l'app è quella scelta per ultima nel dock.
                if vista-vuota: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: center;

                        Image {
                            source: app[indice-vista].icona;
                            accessible-role: none;
                            width: 38px;
                            height: 38px;
                            colorize: Tema.icona;
                            image-rendering: smooth;
                        }
                    }

                    Text {
                        text: app[indice-vista].nome;
                        horizontal-alignment: center;
                        font-weight: 500;
                        font-size: Tema.testo-vuoto;
                        color: Tema.testo;
                    }
                }
            }

            // Puntini dei layout, solo nella Panoramica e non sotto una voce espansa (il layout è
            // coperto): quello attivo è allungato. Bersagli 24 × 24 (WCAG 2.2), disegno invariato.
            if vista == "panoramica" && !espansa: HorizontalLayout {
                x: 0;
                width: parent.width;
                y: puntini-y;
                height: altezza-puntini;
                alignment: center;

                Rectangle {
                    // Gruppo dei puntini: l'anello del fuoco li circonda tutti.
                    accessible-role: tab-list;
                    accessible-label: "Layout della Panoramica";

                    HorizontalLayout {
                        for nome[i] in ["Orologio", "Quadranti"]: Rectangle {
                            property <bool> attivo: i == layout;
                            width: max(24px, (attivo ? 14px : 6px) + 8px);
                            height: altezza-puntini;
                            accessible-role: tab;
                            accessible-label: "Layout " + nome;
                            accessible-item-selectable: true;
                            accessible-item-selected: attivo;
                            accessible-item-index: i;
                            accessible-item-count: 2;
                            accessible-action-default => { scegli(i); }

                            // Il fuoco vero sul layout attivo: ←/→ lo cambiano e il fuoco lo segue.
                            Fuoco { chiede: attivo && da-tastiera && zona == Zona.contenuto; }

                            Rectangle {
                                width: attivo ? 14px : 6px;
                                height: 6px;
                                border-radius: self.height / 2;
                                background: attivo ? Tema.testo : Tema.puntino;
                            }

                            // Più alta della riga (20): 24 × 24 senza spostare dock e layout.
                            TouchArea {
                                y: (parent.height - self.height) / 2;
                                height: 24px;
                                mouse-cursor: pointer;
                                clicked => {
                                    da-tastiera = false;
                                    scegli(i);
                                }
                            }
                        }
                    }

                    // Solo ai lati: sopra e sotto c'è appena posto fra layout e dock.
                    if da-tastiera && zona == Zona.contenuto: Anello {
                        distanza-y: -2px;
                        raggio-anello: self.height / 2;
                    }
                }
            }

            // Dock centrato: solo le app del registro, solo icone (il nome nel suggerimento).
            HorizontalLayout {
                x: 0;
                width: parent.width;
                y: dock-y;
                height: altezza-dock;
                alignment: center;

                Rectangle {
                    border-radius: altezza-dock / 2;
                    background: Tema.capsula;
                    accessible-role: tab-list;
                    accessible-label: "App";
                    // Mezzo pixel come prima: `sul-pixel` lo porterebbe a 1 px pieno a scala 1.
                    border-width: 0.5px;
                    border-color: Tema.vetro-bordo;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 4px;

                        for voce[i] in app: Scheda {
                            icona: voce.icona;
                            nome: voce.nome;
                            indice: i;
                            quante: app.length;
                            attiva: vista == voce.id;
                            anello: da-tastiera && zona == Zona.dock && fuoco-dock == i;
                            scelta => {
                                da-tastiera = false;
                                apri(i, voce.id);
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 400ms;
        running: rotella-ferma;
        triggered => {
            rotella-ferma = false;
            rotella = 0px;
        }
    }

    // Dopo un breve silenzio della rotella l'accumulo riparte da zero: piccoli passi di gesti
    // diversi del touchpad non si sommano fino a cambiare layout. Gira solo durante lo scorrimento.
    silenzio-rotella := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            rotella = 0px;
            self.running = false;
        }
    }

    // Il fuoco vero sugli elementi solo a pannello sceso (vedi `Fuochi`): l'apertura dura 200 ms.
    init => { Fuochi.pronti = false; }
    Timer {
        interval: 220ms;
        running: aperto && !Fuochi.pronti;
        triggered => { Fuochi.pronti = true; }
    }

    // C'è un elemento per la zona e l'indice col fuoco da tastiera? Se no (clic col mouse, voce
    // sparita, Casa svuotata) il fuoco torna a `tasti`, che tiene comunque la tastiera.
    property <bool> bersaglio: zona == Zona.indietro ? vista != "panoramica"
        : zona == Zona.attesa ? (espansa || (con-attese && (fuoco-attesa < min(3, attese.length) || (fuoco-attesa == 3 && attese.length > 3))))
        : zona == Zona.stanze ? ha-zona(Zona.stanze)
        : zona == Zona.contenuto ? ha-zona(Zona.contenuto) && (vista == "panoramica"
            || (griglia.length > 0 ? (fuoco-casa >= 0 || riprova-visibile) : !casa-pronta))
        : true;
    property <bool> fuoco-su-elemento: da-tastiera && bersaglio;
    changed fuoco-su-elemento => {
        if (!self.fuoco-su-elemento) {
            tasti.focus();
        }
    }

    Timer {
        interval: 160ms;
        running: aperto && !occhi-al-centro;
        triggered => {
            occhi-al-centro = true;
        }
    }

}
