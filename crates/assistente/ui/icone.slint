// Icone leggere in stile SF Symbols: contorni a tratto sottile (1,55 su 24), un solo colore.
// I file SVG sono bianchi: il colore lo decide chi le usa (`colorize`), il colore solo per lo stato.
import { Tema } from "tema.slint";
import { GenereUi } from "voci.slint";

export global Icone {
    out property <image> casa: @image-url("../assets/icone/casa.svg");
    out property <image> pc: @image-url("../assets/icone/pc.svg");
    // Claude Code (M3): la stella a otto raggi, anche nello stato vuoto della vista Claude.
    out property <image> claude: @image-url("../assets/icone/claude.svg");
    // Il terminale usato da una sessione di Claude Code, quando è l'ultimo e non il suo (Lucide
    // «terminal», ISC).
    out property <image> terminale: @image-url("../assets/icone/lucide/terminal.svg");
    // Quadranti del PC: un'icona per ciascuno (prima erano tutti «pc»).
    out property <image> chip: @image-url("../assets/icone/chip.svg");
    out property <image> memoria: @image-url("../assets/icone/memoria.svg");
    out property <image> disco: @image-url("../assets/icone/disco.svg");
    // La GPU (M2, Task 10; Lucide «monitor», ISC: la stessa delle stanze).
    out property <image> schermo: @image-url("../assets/icone/lucide/monitor.svg");
    // Quadranti configurabili (M2, Task 4; Lucide, ISC): la rete e la temperatura esterna.
    out property <image> onde: @image-url("../assets/icone/lucide/waves.svg");
    out property <image> sole: @image-url("../assets/icone/lucide/sun.svg");

    // Dispositivi della casa.
    out property <image> luce: @image-url("../assets/icone/luce.svg");
    out property <image> presa: @image-url("../assets/icone/presa.svg");
    // Le scene con le scintille, come il «✨» della v2 (Lucide, ISC): la stella resta solo per i
    // preferiti.
    out property <image> scena: @image-url("../assets/icone/lucide/sparkles.svg");
    out property <image> termo: @image-url("../assets/icone/termo.svg");
    out property <image> goccia: @image-url("../assets/icone/goccia.svg");
    out property <image> sensore: @image-url("../assets/icone/sensore.svg");

    // Comandi della scheda Dispositivi delle Impostazioni (Lucide, licenza ISC).
    out property <image> su: @image-url("../assets/icone/lucide/chevron-up.svg");
    out property <image> giu: @image-url("../assets/icone/lucide/chevron-down.svg");
    out property <image> destra: @image-url("../assets/icone/lucide/chevron-right.svg");
    out property <image> occhio: @image-url("../assets/icone/lucide/eye.svg");
    out property <image> occhio-chiuso: @image-url("../assets/icone/lucide/eye-off.svg");
    out property <image> stella: @image-url("../assets/icone/lucide/star.svg");
    out property <image> stella-piena: @image-url("../assets/icone/lucide/star-piena.svg");

    // Collegamenti veloci (Task 14f, Lucide, licenza ISC): la catena del dock e delle card,
    // matita e cestino della scheda delle Impostazioni.
    out property <image> collegamento: @image-url("../assets/icone/lucide/link.svg");
    out property <image> matita: @image-url("../assets/icone/lucide/pencil.svg");
    out property <image> cestino: @image-url("../assets/icone/lucide/trash-2.svg");

    // «⋯» in alto a destra del pannello: apre il menu dell'isola (Task 14i, Lucide, ISC).
    out property <image> altre-opzioni: @image-url("../assets/icone/lucide/ellipsis.svg");

    // Il volume del PC nella vista PC (M2, Task 7; da Lucide «volume-2» e «volume-x», ISC).
    out property <image> altoparlante: @image-url("../assets/icone/altoparlante.svg");
    out property <image> altoparlante-muto: @image-url("../assets/icone/altoparlante-muto.svg");

    // Rete, Wi-Fi e Bluetooth (M2, Task 8; da Lucide «wifi», «ethernet-port», «bluetooth», ISC):
    // le tacche spente sono al 30% nello stesso SVG.
    out property <[image]> wifi: [
        @image-url("../assets/icone/wifi-0.svg"),
        @image-url("../assets/icone/wifi-1.svg"),
        @image-url("../assets/icone/wifi-2.svg"),
        @image-url("../assets/icone/wifi-3.svg")
    ];
    out property <image> cavo: @image-url("../assets/icone/cavo.svg");
    out property <image> bluetooth: @image-url("../assets/icone/bluetooth.svg");

    // Le 60 icone delle stanze, nell'ordine di `stanze::ICONE` (le emoji della v2 ridisegnate
    // con le icone a contorno di Lucide, licenza ISC: assets/icone/lucide/LICENSE-lucide.txt).
    out property <[image]> stanze: [
        @image-url("../assets/icone/lucide/sofa.svg"),
        @image-url("../assets/icone/lucide/house.svg"),
        @image-url("../assets/icone/lucide/fence.svg"),
        @image-url("../assets/icone/lucide/building-2.svg"),
        @image-url("../assets/icone/lucide/castle.svg"),
        @image-url("../assets/icone/lucide/tree-palm.svg"),
        @image-url("../assets/icone/lucide/cooking-pot.svg"),
        @image-url("../assets/icone/lucide/utensils.svg"),
        @image-url("../assets/icone/lucide/coffee.svg"),
        @image-url("../assets/icone/lucide/wine.svg"),
        @image-url("../assets/icone/lucide/soup.svg"),
        @image-url("../assets/icone/lucide/cookie.svg"),
        @image-url("../assets/icone/lucide/bed-double.svg"),
        @image-url("../assets/icone/lucide/moon.svg"),
        @image-url("../assets/icone/lucide/toy-brick.svg"),
        @image-url("../assets/icone/lucide/baby.svg"),
        @image-url("../assets/icone/lucide/bed-single.svg"),
        @image-url("../assets/icone/lucide/star.svg"),
        @image-url("../assets/icone/lucide/shower-head.svg"),
        @image-url("../assets/icone/lucide/bath.svg"),
        @image-url("../assets/icone/lucide/droplets.svg"),
        @image-url("../assets/icone/lucide/scan-face.svg"),
        @image-url("../assets/icone/lucide/spray-can.svg"),
        @image-url("../assets/icone/lucide/sparkles.svg"),
        @image-url("../assets/icone/lucide/monitor.svg"),
        @image-url("../assets/icone/lucide/laptop.svg"),
        @image-url("../assets/icone/lucide/library.svg"),
        @image-url("../assets/icone/lucide/notebook-pen.svg"),
        @image-url("../assets/icone/lucide/graduation-cap.svg"),
        @image-url("../assets/icone/lucide/microscope.svg"),
        @image-url("../assets/icone/lucide/tree-deciduous.svg"),
        @image-url("../assets/icone/lucide/leaf.svg"),
        @image-url("../assets/icone/lucide/sprout.svg"),
        @image-url("../assets/icone/lucide/sun.svg"),
        @image-url("../assets/icone/lucide/flower.svg"),
        @image-url("../assets/icone/lucide/flower-2.svg"),
        @image-url("../assets/icone/lucide/gamepad-2.svg"),
        @image-url("../assets/icone/lucide/tv.svg"),
        @image-url("../assets/icone/lucide/clapperboard.svg"),
        @image-url("../assets/icone/lucide/drama.svg"),
        @image-url("../assets/icone/lucide/music.svg"),
        @image-url("../assets/icone/lucide/guitar.svg"),
        @image-url("../assets/icone/lucide/biceps-flexed.svg"),
        @image-url("../assets/icone/lucide/dumbbell.svg"),
        @image-url("../assets/icone/lucide/person-standing.svg"),
        @image-url("../assets/icone/lucide/waves.svg"),
        @image-url("../assets/icone/lucide/bike.svg"),
        @image-url("../assets/icone/lucide/volleyball.svg"),
        @image-url("../assets/icone/lucide/car.svg"),
        @image-url("../assets/icone/lucide/door-open.svg"),
        @image-url("../assets/icone/lucide/package.svg"),
        @image-url("../assets/icone/lucide/washing-machine.svg"),
        @image-url("../assets/icone/lucide/brush.svg"),
        @image-url("../assets/icone/lucide/wrench.svg"),
        @image-url("../assets/icone/lucide/lock.svg"),
        @image-url("../assets/icone/lucide/lightbulb.svg"),
        @image-url("../assets/icone/lucide/key-round.svg"),
        @image-url("../assets/icone/lucide/flame.svg"),
        @image-url("../assets/icone/lucide/thermometer.svg"),
        @image-url("../assets/icone/lucide/droplet.svg")
    ];

    // L'icona di una stanza dal suo indice in `stanze`; -1 = «Altro» (la casa), -2 = le scene.
    public pure function di-stanza(i: int) -> image {
        if (i >= 0 && i < stanze.length) { return stanze[i]; }
        if (i == -2) { return scena; }
        return casa;
    }

    // L'icona di un preferito dal suo genere (vedi `ponte::genere`).
    public pure function di-genere(genere: GenereUi) -> image {
        if (genere == GenereUi.luce) { return luce; }
        if (genere == GenereUi.presa) { return presa; }
        if (genere == GenereUi.scena) { return scena; }
        if (genere == GenereUi.termo) { return termo; }
        if (genere == GenereUi.goccia) { return goccia; }
        if (genere == GenereUi.sensore) { return sensore; }
        return casa;
    }
}

// Un'icona del set, nel colore neutro delle icone.
export component Icona inherits Image {
    width: 20px;
    height: 20px;
    colorize: Tema.icona;
    image-rendering: smooth;
    // Decorativa: il nome lo dice l'elemento che la contiene (Narrator non legge un'immagine vuota).
    accessible-role: none;
}

// Card "vetro" leggera dei layout (bordo sottile, riflesso appena accennato).
export component Vetro inherits Rectangle {
    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: Tema.vetro-bordo;
    background: Tema.card-vetro;
}
