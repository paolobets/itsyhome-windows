// Componenti comuni dell'assistente e della cornice della gestione (FE8): un solo anello del
// fuoco, un solo pulsante di testo, una sola etichetta maiuscola. Gli occhi stanno in faccia.slint.
import { Tema } from "tema.slint";
import { LivelloUi, TintaBatteriaUi } from "voci.slint";

// Il pannello tiene i tasti in un solo FocusScope (`tasti`, che li intercetta tutti) ma porta il
// fuoco vero sull'elemento scelto da tastiera, perché Narrator lo legga (FE13). Falso nei primi
// istanti dell'apertura: mentre il pannello scende il contenuto è fuori dal ritaglio e Slint
// toglierebbe il fuoco a un elemento non visibile. Fuori dal pannello resta vero.
export global Fuochi {
    in-out property <bool> pronti: true;
}

// Prende il fuoco vero quando `chiede` diventa vero (o nasce già vero): va dentro l'elemento che lo
// riceve (pulsante, card, scheda), così Narrator legge ruolo e nome di quell'elemento. Non prende
// tasti né clic: li gestisce chi tiene la tastiera.
export component Fuoco inherits FocusScope {
    in property <bool> chiede;
    property <bool> vuole: chiede && Fuochi.pronti;
    changed vuole => {
        if (self.vuole) {
            self.focus();
        }
    }
    init => {
        if (self.vuole) {
            self.focus();
        }
    }
    focus-on-click: false;
    focus-on-tab-navigation: false;
}

// Tipo di un pulsante: neutro (bianco tenue), azione (verde acqua, con il bordo), pericolo (rosso).
export enum TipoPulsante { neutro, azione, pericolo }

// Anello del fuoco da tastiera: 2 px, a `distanza` dall'elemento che lo contiene. Si mette dentro
// l'elemento (`if …: Anello { raggio: parent.border-radius; }`) e ne prende le misure: senza
// larghezza e altezza un elemento fuori da un layout riempie il genitore.
export component Anello inherits Rectangle {
    // Raggio dell'elemento circondato: l'anello lo segue, più largo di quanto sta fuori.
    in property <length> raggio;
    // Spazio fra l'elemento e l'anello (negativo meno di 2 = dentro l'elemento).
    in property <length> distanza: 2px;
    in property <length> distanza-y: distanza;
    in property <length> raggio-anello: raggio + distanza + spessore;
    property <length> spessore: Tema.sul-pixel(2px);

    Rectangle {
        x: -(distanza + spessore);
        y: -(distanza-y + spessore);
        width: root.width + 2 * (distanza + spessore);
        height: root.height + 2 * (distanza-y + spessore);
        border-radius: raggio-anello;
        border-width: spessore;
        border-color: Tema.anello;
    }
}

// Il pulsante di testo (UX16: una sola forma). Alto 30 e raggio 10 (nella pillola 26/28 e 8);
// neutro bianco al 9%, azione verde acqua al 20% con il bordo, pericolo rosso con il bordo. Fra
// due pulsanti affiancati ha la tinta d'azione l'ultimo. Il clic non gli dà il fuoco: l'anello
// si vede solo da tastiera (`anello`, di norma quando ha il fuoco).
export component Pulsante inherits FocusScope {
    in property <string> testo;
    in property <TipoPulsante> tipo: TipoPulsante.neutro;
    in property <length> altezza: 30px;
    in property <length> raggio: Tema.raggio-m;
    // Larghezza: il testo più `margine-testo`, fra `largo-min` e `largo-max` (oltre si accorcia).
    in property <length> largo-min: 84px;
    in property <length> largo-max: 360px;
    in property <length> margine-testo: 24px;
    in property <length> corpo-testo: Tema.testo-corpo;
    in property <bool> anello: root.has-focus;
    // Il pannello decide da sé dove sta il fuoco (FE13): vero = questo pulsante lo prende.
    in property <bool> chiede-fuoco;
    // Tastiera propria (Invio o Spazio, senza modificatori, lo premono): vero dove nessun altro
    // governa i tasti (Impostazioni). Falso nel pannello, dove li governa `tasti`, e nella
    // pillola, dove nessun pulsante si preme da tastiera.
    in property <bool> tasti-propri: true;
    // Concede un permesso: mai premuto dalla sua tastiera. Nel pannello lo concede solo
    // Ctrl+Invio, gestito da `tasti`; altrimenti il clic.
    in property <bool> delicato;
    // Tab può portargli il fuoco. Falso nella pillola, dove nessun pulsante deve avere il fuoco
    // né l'anello (lì il fuoco lo tiene la `tastiera` della pillola: vedi pillola.slint).
    in property <bool> focalizzabile: true;
    property <bool> vuole-fuoco: chiede-fuoco && Fuochi.pronti;
    callback premuto();
    // Ha appena preso il fuoco (Tab): chi lo contiene lo porta in vista.
    callback fuoco-preso();
    changed has-focus => {
        if (self.has-focus) {
            root.fuoco-preso();
        }
    }
    changed vuole-fuoco => {
        if (self.vuole-fuoco) {
            self.focus();
        }
    }
    init => {
        if (self.vuole-fuoco) {
            self.focus();
        }
    }

    height: altezza;
    width: min(largo-max, max(largo-min, etichetta.preferred-width + margine-testo));
    focus-on-click: false;
    focus-on-tab-navigation: focalizzabile;
    accessible-role: button;
    accessible-label: testo;
    accessible-action-default => { root.premuto(); }
    key-pressed(evento) => {
        if (!tasti-propri || delicato) {
            return reject;
        }
        if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta || evento.modifiers.shift) {
            return reject;
        }
        if (evento.text == Key.Return || evento.text == Key.Space) {
            root.premuto();
            return accept;
        }
        return reject;
    }

    fondo := Rectangle {
        border-radius: raggio;
        border-width: tipo == TipoPulsante.neutro ? 0px : 1px;
        border-color: tipo == TipoPulsante.azione ? Tema.azione-bordo : Tema.pericolo-bordo;
        background: tipo == TipoPulsante.azione
            ? (area.has-hover ? Tema.azione-sopra : Tema.azione-fondo)
            : tipo == TipoPulsante.pericolo
                ? (area.has-hover ? Tema.pericolo-sopra : Tema.pericolo-fondo)
                : (area.has-hover ? Tema.neutro-sopra : Tema.neutro-fondo);

        etichetta := Text {
            width: min(self.preferred-width, root.width - 12px);
            text: testo;
            horizontal-alignment: center;
            overflow: elide;
            // Esplicito: la pillola non ha un carattere predefinito, e senza questo il testo dei suoi
            // pulsanti andava nel carattere di sistema (un font in più caricato, circa 1 MB).
            font-family: Tema.carattere;
            font-weight: 500;
            font-size: corpo-testo;
            color: Tema.testo;
            accessible-role: none;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.premuto(); }
    }

    if root.anello: Anello { raggio: root.raggio; }
}

// Il glifo della batteria: corpo 17 × 8 col bordo al pixel fisico, beccuccio 2 × 4, riempimento
// proporzionale a `frazione` (0..1). `tinta` come `StatPcUi.tinta-batteria`: carica (verde),
// normale (testo), informazione, attenzione. Solo decorativo: il testo accanto dice già
// percentuale e stato, per Narrator il glifo non esiste.
export component GlifoBatteria inherits Rectangle {
    in property <float> frazione;
    in property <TintaBatteriaUi> tinta: TintaBatteriaUi.normale;
    property <color> colore: tinta == TintaBatteriaUi.carica ? Tema.batteria-carica
        : tinta == TintaBatteriaUi.informazione ? Tema.colore-livello(LivelloUi.informazione)
        : tinta == TintaBatteriaUi.attenzione ? Tema.colore-livello(LivelloUi.attenzione)
        : Tema.testo;
    property <length> filo: Tema.sul-pixel(1px);
    accessible-role: none;
    width: 19px;
    height: 8px;

    Rectangle {
        x: 0;
        y: 0;
        width: 17px;
        height: 8px;
        border-radius: 2px;
        border-width: root.filo;
        border-color: root.colore;

        // Il riempimento sta dentro il bordo, con un pixel di respiro.
        Rectangle {
            x: root.filo + 1px;
            y: root.filo + 1px;
            width: max(0px, (parent.width - 2 * (root.filo + 1px)) * min(max(root.frazione, 0), 1));
            height: parent.height - 2 * (root.filo + 1px);
            border-radius: 1px;
            background: root.colore;
        }
    }

    // Il beccuccio.
    Rectangle {
        x: 17px;
        y: 2px;
        width: 2px;
        height: 4px;
        border-top-right-radius: 1px;
        border-bottom-right-radius: 1px;
        background: root.colore;
    }
}

// Etichetta di sezione in maiuscoletto mono (12 px, spaziata).
export component Etichetta inherits Text {
    font-family: Tema.carattere-mono;
    font-size: Tema.testo-piccolo;
    letter-spacing: 0.6px;
    color: Tema.testo-etichetta;
    vertical-alignment: center;
}
