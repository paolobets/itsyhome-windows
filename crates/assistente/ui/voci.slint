// Una app del registro, come la vede l'interfaccia (le icone del dock).
export struct VoceAppUi {
    id: string,
    nome: string,
    icona: image,
}

// Le statistiche del PC già formattate (italiano) per quadranti e vista PC; `cpu`, `ram` e
// `disco` sono frazioni 0..1 per gli archi. `pronta`: dal secondo campione la CPU ha un valore.
export struct StatPcUi {
    pronta: bool,
    cpu: float,
    ram: float,
    disco: float,
    cpu-testo: string,
    ram-testo: string,
    ram-dettaglio: string,
    disco-testo: string,
    disco-dettaglio: string,
    rete-giu: string,
    rete-su: string,
    ha-batteria: bool,
    batteria-testo: string,
    batteria-frazione: float,
    in-carica: bool,
}

// Un preferito della casa, già pronto per l'interfaccia (vedi `ponte::voce_ui`).
// `genere`: "luce" | "presa" | "scena" | "termo" | "goccia" | "sensore" | "casa" (icona e tinta).
// `stato`: il testo sotto il nome; `errore`: vuoto se l'ultimo comando non è fallito.
// `toccabile`: un tocco manda un comando (luci, interruttori, scene disponibili, casa connessa).
// `tenue`: non disponibile o casa non connessa (la voce si mostra spenta e non risponde).
export struct PreferitoUi {
    entity-id: string,
    nome: string,
    genere: string,
    acceso: bool,
    stato: string,
    disponibile: bool,
    errore: string,
    toccabile: bool,
    tenue: bool,
}

// Un sensore preferito nei Quadranti: la voce e la frazione 0..1 dell'arco (-1 = niente arco).
export struct SensoreUi {
    voce: PreferitoUi,
    frazione: float,
}

// Un pulsante di una voce «In attesa» (al massimo 2 per voce, anche nella pillola).
// `delicato`: concede un permesso; nel pannello mai con Invio da solo, solo Ctrl+Invio o clic.
export struct PulsanteUi {
    id: string,
    testo: string,
    delicato: bool,
}

// Una voce «In attesa» per la riga in cima alla Panoramica (vedi `attenzione.rs`).
// `livello`: "bloccante" | "attenzione" | "informazione" (colore della barretta e parola);
// `sotto`: la riga piccola sotto il titolo, «attenzione · pc»; `icona`: la fonte.
export struct VoceAttesaUi {
    id: string,
    livello: string,
    titolo: string,
    sotto: string,
    dettaglio: string,
    icona: image,
    pulsanti: [PulsanteUi],
}

// Un ambiente di Home Assistant nelle Impostazioni (vedi `ponte::aggiorna_ambienti`).
// `stato`: la parola dello stato («Connesso», «Non attivo»…); `tono`: "ok" | "attesa" | "errore" |
// "spento" (colore del pallino); `collegato`: connesso o che ci prova (pulsante «Disconnetti»).
export struct AmbienteUi {
    id: string,
    nome: string,
    url: string,
    stato: string,
    tono: string,
    attivo: bool,
    collegato: bool,
}
