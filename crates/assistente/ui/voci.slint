// Stati con un nome (FE9): un errore di battitura non compila, invece di cadere nel ramo
// «altrimenti». Rust usa gli enum generati (UmoreUi, AspettoPillolaUi…).

// L'umore della faccia (pillola e pannello).
export enum UmoreUi { tranquillo, pensa, ti-cerca, contento, dorme }

// Come la pillola mostra le voci «In attesa»: piccola, col puntino sotto gli occhi, allargata.
export enum AspettoPillolaUi { riposo, puntino, allargata }

// Livello di una voce «In attesa»; `nessuno` = nessuna voce (linea della ritirata neutra).
export enum LivelloUi { nessuno, informazione, attenzione, bloccante }

// Che cosa è un preferito della casa (icona e tinta), vedi `ponte::genere`.
export enum GenereUi { casa, luce, presa, scena, termo, goccia, sensore }

// Tono di uno stato nelle Impostazioni: decide solo il colore del pallino (la parola c'è sempre).
export enum TonoUi { spento, ok, attesa, errore }

// Una scheda della barra della cornice (ridisegno F1): la Panoramica e i moduli del registro,
// nell'ordine. Tutto lo calcola Rust (`Ponte::scrivi_schede`): `nome` è il nome breve maiuscolo
// mostrato sulla scheda attiva, `x` e `larghezza` la geometria (`panoramica::geometria_schede`,
// la capsula scivola fra una e l'altra), `segno` gli occhietti (0 nessuno, 1 ti aspetta, 2 guarda
// presto), `narratore` il nome intero per Narrator («Agenti, ti aspetta, scheda 2 di 5»).
export struct SchedaBarraUi {
    id: string,
    nome: string,
    icona: image,
    x: length,
    larghezza: length,
    segno: int,
    narratore: string,
}

// Il tono di un modulo (spec §5.3, `moduli::Tono`): vocabolario chiuso, uguale per ogni modulo.
export enum TonoModuloUi { vuoto, calmo, attivo, guarda, aspetta, fatto, errore, fermo }

// Un modulo per le carte della Panoramica (ridisegno F1), già pronto da `Registro::moduli_ui`.
// `tono` è quello effettivo (il riassunto alzato dalle voci in attesa); `parola` la capsula («» se
// calmo o vuoto); `titolo` e `sec` già nei limiti in pixel; `numerico`: il titolo è un numero (mono).
// `narratore`: il nome intero per Narrator; `narratore-azione`: «{azione}, {nome}».
export struct ModuloUi {
    id: string,
    nome: string,
    nome-breve: string,
    icona: image,
    tono: TonoModuloUi,
    parola: string,
    titolo: string,
    numerico: bool,
    sec: string,
    con-azione: bool,
    // L'id dell'azione (`agenti::TERMINALE`…), per `azione-modulo`.
    azione-id: string,
    azione-testo: string,
    azione-icona: image,
    narratore: string,
    narratore-azione: string,
}

// Una riga del menu «⋯» del pannello (Task 8), nell'ordine di `voci_pannello`. `id` è quello che
// Rust ritraduce nel suo comando (`menu::comando`); `sotto`: apre il sottomenu «Schermo» (nessun
// comando suo); `separatore`: il filo sta sopra la riga (prima di «Esci»).
export struct VoceMenuUi {
    id: string,
    testo: string,
    separatore: bool,
    sotto: bool,
}

// Una riga del sottomenu «Schermo»: `scelto` = la spunta (il monitor dove stanno pillola e pannello).
export struct SchermoMenuUi {
    id: string,
    testo: string,
    scelto: bool,
}

// Tinta del glifo della batteria; `normale` per prima: è il valore predefinito di uno struct nuovo.
export enum TintaBatteriaUi { normale, carica, informazione, attenzione }

// Le statistiche del PC già formattate (italiano) per quadranti e vista PC; `cpu`, `ram` e
// `disco` sono frazioni 0..1 per gli archi. `pronta`: dal secondo campione la CPU ha un valore.
export struct StatPcUi {
    pronta: bool,
    cpu: float,
    ram: float,
    disco: float,
    cpu-testo: string,
    ram-testo: string,
    ram-dettaglio: string,
    disco-testo: string,
    disco-dettaglio: string,
    rete-giu: string,
    rete-su: string,
    ha-batteria: bool,
    batteria-testo: string,
    batteria-frazione: float,
    in-carica: bool,
    // Tinta del glifo della batteria (vedi `pc_stats::TintaBatteria`); il valore predefinito è
    // il neutro.
    tinta-batteria: TintaBatteriaUi,
    // GPU (M2, Task 10, solo Windows): `ha-gpu` falso = nessun dato (fuori da Windows, GPU non
    // mostrata, lettura fallita o primo campione), e allora riga e arco non ci sono; `gpu` è la
    // frazione 0..1, `gpu-testo` «37%».
    ha-gpu: bool,
    gpu: float,
    gpu-testo: string,
}

// Un preferito della casa, già pronto per l'interfaccia (vedi `ponte::voce_ui`).
// `genere`: icona e tinta.
// `stato`: il testo sotto il nome; `errore`: vuoto se l'ultimo comando non è fallito.
// `toccabile`: un tocco manda un comando (luci, interruttori, scene disponibili, casa connessa).
// `tenue`: non disponibile o casa non connessa (la voce si mostra spenta e non risponde).
export struct PreferitoUi {
    entity-id: string,
    nome: string,
    genere: GenereUi,
    acceso: bool,
    stato: string,
    disponibile: bool,
    errore: string,
    toccabile: bool,
    tenue: bool,
}

// Un pulsante di una voce «In attesa» (al massimo 2 per voce, anche nella pillola).
// `delicato`: concede un permesso; nel pannello mai con Invio da solo, solo Ctrl+Invio o clic.
export struct PulsanteUi {
    id: string,
    testo: string,
    delicato: bool,
}

// I dati di un permesso di Claude Code per il componente del guscio (vedi `DatiPermesso` in
// `attenzione.rs`): `sessione` = titolo della scheda di Claude Code, altrimenti la cartella;
// `comando`: il riassunto ripulito ("" se Claude non l'ha dato); `cartella`: solo il nome finale;
// `chiesto`: «alle 14:32», ora fissa della richiesta. `sessione == ""`: voce senza dati di permesso.
export struct PermessoUi {
    sessione: string,
    strumento: string,
    // L'etichetta sopra il testo: «TERMINALE», «FILE», «INDIRIZZO», «RICERCA» o vuota.
    campo: string,
    comando: string,
    cartella: string,
    chiesto: string,
}

// Una voce «In attesa» per la riga in cima alla Panoramica (vedi `attenzione.rs`).
// `livello`: colore della barretta (la parola è in `sotto`);
// `sotto`: la riga piccola sotto il titolo, «attenzione · pc»; `icona`: la fonte; `modulo`: il
// nome del modulo da cui viene («Agenti»: la capsula della voce che ti aspetta); `permesso`: i dati
// divisi di un permesso di Claude (vuoti per le altre voci).
export struct VoceAttesaUi {
    id: string,
    livello: LivelloUi,
    titolo: string,
    sotto: string,
    modulo: string,
    dettaglio: string,
    icona: image,
    pulsanti: [PulsanteUi],
    permesso: PermessoUi,
}

// Un ambiente di Home Assistant nelle Impostazioni (vedi `ponte::aggiorna_ambienti`).
// `stato`: la parola dello stato («Connesso», «Non attivo»…); `tono`: colore del pallino;
// `collegato`: connesso o che ci prova (pulsante «Disconnetti»).
export struct AmbienteUi {
    id: string,
    nome: string,
    url: string,
    stato: string,
    tono: TonoUi,
    attivo: bool,
    collegato: bool,
}

// Una stanza della vista Casa (vedi `ponte::stanze_ui`): `icona` è l'indice in `Icone.stanze`
// (-1 «Altro», -2 le scene); `quanti`: i dispositivi mostrati.
export struct StanzaUi {
    area-id: string,
    nome: string,
    icona: int,
    quanti: int,
}

// Il tipo di una riga di Impostazioni › Dispositivi (vedi `dispositivi::TipoRiga`).
export enum TipoRigaUi { testata-preferiti, preferito, testata-stanza, dispositivo }

// Una riga di Impostazioni › Dispositivi, già pronta (vedi `ponte::riga_ui`).
// `id`: unico nell'elenco («d:light.x», «p:light.x», «s:cucina», «h:»), per riportarci il fuoco;
// `chiave`: l'entità o l'area su cui agiscono i pulsanti; `area`: la stanza della riga;
// `icona`: per le testate di stanza l'indice in `Icone.stanze` (-1 «Altro», -2 scene);
// `puo-icona`: la stanza è vera (icona da scegliere, si sposta); `su`/`giu`: c'è un posto dove andare.
export struct RigaDispositivoUi {
    id: string,
    tipo: TipoRigaUi,
    chiave: string,
    area: string,
    nome: string,
    sotto: string,
    icona: int,
    genere: GenereUi,
    nascosto: bool,
    preferito: bool,
    su: bool,
    giu: bool,
    compressa: bool,
    puo-icona: bool,
}

// Un collegamento veloce (Task 14f), già pronto (vedi `ponte::aggiorna_collegamenti`): `url` è
// l'indirizzo intero (Impostazioni), `corto` quello accorciato (pannello: host, porta, percorso).
export struct CollegamentoUi {
    id: string,
    nome: string,
    url: string,
    corto: string,
    // L'iniziale del nome e il colore del suo cerchio (indice in `Tema.colore-collegamento`).
    iniziale: string,
    tono: int,
}

// Come è collegato il PC (vedi `radio::StatoRete`): l'icona della rete, mai il nome della rete.
export enum TipoReteUi { nessuna, cavo, wifi }

// Che cosa mostra un lato della pillola a riposo (vedi `lati::ContenutoLato`): `tipo` 0 vuoto,
// 1 testo («CPU 23%», «14:05», «21,5°»), 2 batteria (glifo + percentuale), 3 rete (Task 8: solo
// l'icona, `rete` e `tacche` 0..3; `con-rete` ne riserva il posto anche prima della lettura).
// `campione`: il valore più largo del tipo scelto («CPU 100%», «00:00»…, `lati::campione`), su
// cui si misura il lato: la larghezza cambia con la scelta, mai col valore; con `tipo` 0 e un
// campione il posto resta e il testo è vuoto (i lati a tempo in «dorme»). `con-glifo`: il posto
// del glifo della batteria resta anche senza lettura.
export struct ContenutoLatoUi {
    tipo: int,
    testo: string,
    frazione: float,
    tinta: TintaBatteriaUi,
    campione: string,
    con-glifo: bool,
    rete: TipoReteUi,
    tacche: int,
    con-rete: bool,
}

// ─── La pagina Agenti sull'impianto Elenco + dettaglio (ridisegno F2) ─────────────────────────
// Tutto già pronto da `moduli::pagina_agenti`. Niente array nelle strutture (si confrontano prima
// di scriverle): il dettaglio ha tre posti fissi, la sintesi due posti di limite.

// Un campo del dettaglio di una riga: «Contesto» «42 %»; `caldo`: il valore nel colore del tono
// attivo. Etichetta vuota = posto vuoto.
export struct CampoDettaglioUi {
    etichetta: string,
    valore: string,
    caldo: bool,
}

// Una riga della pagina Agenti (una sessione). `tono` e `parola` (la capsula, vuota se calmo);
// `nome` è il titolo della scheda di Claude Code, altrimenti la cartella, e `sotto` la cartella
// quando c'è un titolo; `chi` il fornitore come parola («Claude»); `cosa` e `valore` (la durata in
// mono per chi lavora); `narratore` il nome intero per Narrator; `nota` cosa fa il terminale
// (solo per Narrator); `azione-id`/`azione-testo` l'azione del dettaglio; `voce` l'id della voce
// del permesso in attesa ("" senza) e `attesa` il suo indice nel modello delle attese (-1 senza).
export struct RigaModuloUi {
    id: string,
    tono: TonoModuloUi,
    parola: string,
    nome: string,
    chi: string,
    cosa: string,
    valore: string,
    narratore: string,
    sotto: string,
    d1: CampoDettaglioUi,
    d2: CampoDettaglioUi,
    d3: CampoDettaglioUi,
    nota: string,
    azione-id: string,
    azione-testo: string,
    voce: string,
    attesa: int,
}

// Un limite a barra nella sintesi: `presente` falso = nessun elemento (mai «0 %»); `fornitore`
// in grassetto solo sul primo; `testo` «61 %»; `caldo` oltre la soglia dell'utente; `vecchio` il
// valore ricordato da prima del riavvio (tenue); `narratore` «Claude, limite 5 ore, 61 %, si
// azzera alle 14:30».
export struct LimiteUi {
    presente: bool,
    fornitore: string,
    nome: string,
    frazione: float,
    testo: string,
    caldo: bool,
    vecchio: bool,
    narratore: string,
}

// La riga di sintesi in cima alla pagina Agenti: titolo e sotto-testo, due limiti, la spesa API
// del mese con la nota e l'azione «Dettagli» (solo con la chiave da amministratore).
export struct SintesiUi {
    tono: TonoModuloUi,
    titolo: string,
    sotto: string,
    l1: LimiteUi,
    l2: LimiteUi,
    spesa: string,
    spesa-nota: string,
    azione-id: string,
    azione-testo: string,
    // Ridisegno F3: l'azione primaria (bianca) con la sua icona, come «Spegni tutte» di Casa.
    // Agenti: falso e vuota.
    azione-primaria: bool,
    azione-icona: image,
}

// ─── La pagina Casa sull'impianto Comandi (ridisegno F3) ──────────────────────────────────────
// Tutto già pronto da `moduli::pagina_casa`.

// La forma di una card dei Comandi: l'interruttore (luci e prese: la card è l'interruttore), la
// scena (un tocco la attiva), la lettura (solo da leggere) e il lancio (Collegamenti).
export enum TipoCardUi { interruttore, scena, lettura, lancio }

// Una card dei Comandi. `stato`: la parola sotto il nome («Accesa», «Non disponibile»; per un
// sensore numerico il nome stesso); `valore`: «80 %» accanto alla parola, o il numero grande di
// una lettura («21,5°»); `acceso`: riquadro bianco; `toccabile`: un tocco manda un comando;
// `tenue`: non disponibile o casa scollegata; `errore`: «Non riuscito». `iniziale` e `tinta` (indice
// in `Tema.colore-collegamento`) servono solo al lancio. `narratore`: il nome intero per Narrator.
export struct CardUi {
    id: string,
    tipo: TipoCardUi,
    genere: GenereUi,
    nome: string,
    stato: string,
    valore: string,
    acceso: bool,
    toccabile: bool,
    tenue: bool,
    errore: bool,
    iniziale: string,
    tinta: int,
    narratore: string,
}

// Un filtro della colonna di sinistra dei Comandi. `icona`: indice in `Icone.stanze` per le
// stanze, un codice negativo per gli altri (vedi `pagina_casa::ICONA_*`); `numero`: «4» o vuoto;
// `filo`: il filo di separazione sta sopra il filtro; `narratore`: «Soggiorno, 6 dispositivi».
export struct FiltroUi {
    id: string,
    nome: string,
    icona: int,
    numero: string,
    filo: bool,
    narratore: string,
}

// Lo stato di una pagina: `pieno` mostra l'elenco; gli altri una frase con al più un'azione.
export enum TipoStatoPaginaUi { pieno, vuoto, fuori-servizio, primo-avvio }

export struct StatoPaginaUi {
    tipo: TipoStatoPaginaUi,
    frase: string,
    sotto: string,
    azione-id: string,
    azione-testo: string,
}
