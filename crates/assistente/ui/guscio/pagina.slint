// La testata e lo stato di una pagina del guscio (ridisegno F2, Task 6; spec §5.6–§5.7, bozza
// `tc-isola`, `.sintesi`). Comuni a tutti gli impianti: la Coda (Elenco) e la pagina Agenti
// (Elenco + dettaglio).
//
// `TestataPagina`: occhietti del tono (se non è calmo né vuoto), titolo Inter 700 18 e sotto 13
// tenue a sinistra; a destra i limiti a barra (`.lim` della bozza), la spesa in mono e un pulsante
// d'azione 32 r9 neutro. Lo spazio che manca lo cede prima il sotto, poi il gruppo di destra fino
// a lasciare al titolo il suo spazio garantito (`spazio-titolo`), poi il titolo (ellissi); l'azione
// mai. Alta 40 (la Coda la tiene a 28 fino a F5, pre-flight C11).
//
// `StatoPagina`: una pagina senza elenco (scollegata, vuota): una frase, un sotto e al più un
// pulsante, centrati nel corpo sotto la testata.
import { Tema } from "../tema.slint";
import { TonoModuloUi, LimiteUi, StatoPaginaUi } from "../voci.slint";
import { Pulsante, TipoPulsante } from "../componenti.slint";
import { Occhietti } from "occhietti.slint";

// Un limite a barra: fornitore (in grassetto, solo sul primo), nome, barra 44 × 4 e numero mono.
// Caldo oltre la soglia dell'utente (barra e numero nel colore del lavoro); il valore ricordato da
// prima del riavvio è tenue. Per Narrator una riga sola: «Claude, limite 5 ore, 34 %, si azzera…».
component LimiteBarra inherits Rectangle {
    in property <LimiteUi> limite;
    property <color> tinta: limite.caldo ? Tema.attivo : limite.vecchio ? Tema.testo-tenue : Tema.testo-2;

    // Larghezza preferita quella piena; stretto dal gruppo di destra si accorcia solo la barra
    // (minimo zero), i testi no.
    preferred-width: riga.preferred-width;
    min-width: riga.min-width;
    horizontal-stretch: 1;
    accessible-role: text;
    accessible-label: limite.narratore;

    riga := HorizontalLayout {
        spacing: 8px;

        if limite.fornitore != "": Text {
            text: limite.fornitore;
            vertical-alignment: center;
            font-weight: 700;
            font-size: Tema.testo-piccolo;
            color: limite.vecchio ? Tema.testo-tenue : Tema.testo;
            accessible-role: none;
        }

        Text {
            text: limite.nome;
            vertical-alignment: center;
            font-size: Tema.testo-piccolo;
            color: limite.vecchio ? Tema.testo-tenue : Tema.testo-2;
            accessible-role: none;
        }

        Rectangle {
            preferred-width: 44px;
            min-width: 0px;
            horizontal-stretch: 1;

            // Una barra più stretta di 12 px non dice più nulla: sparisce, resta il numero.
            Rectangle {
                visible: parent.width >= 12px;
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 4px;
                border-radius: 2px;
                background: Tema.traccia;
                clip: true;

                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, limite.frazione));
                    height: parent.height;
                    border-radius: 2px;
                    background: tinta;
                }
            }
        }

        Text {
            text: limite.testo;
            vertical-alignment: center;
            font-family: Tema.carattere-mono;
            font-weight: 500;
            font-size: Tema.testo-piccolo;
            color: limite.caldo ? Tema.attivo : limite.vecchio ? Tema.testo-tenue : Tema.testo;
            accessible-role: none;
        }
    }
}

export component TestataPagina inherits Rectangle {
    in property <string> titolo;
    in property <string> sotto;
    in property <TonoModuloUi> tono: TonoModuloUi.calmo;
    in property <LimiteUi> l1;
    in property <LimiteUi> l2;
    // La spesa API del mese («412,80 $», vuota senza dati) e la sua nota (solo per Narrator).
    in property <string> spesa;
    in property <string> spesa-nota;
    // Il pulsante d'azione della pagina («Dettagli»); vuoto = nessuno.
    in property <string> azione-testo;
    // L'azione principale della pagina (ridisegno F3: «Spegni tutte» di Casa): pulsante bianco con
    // l'icona `azione-icona` prima del testo. Le altre azioni sono neutre e senza icona. L'icona si
    // mostra solo se l'azione c'è ed è primaria, mai in base all'immagine (Agenti e le secondarie
    // passano l'icona «nessuna», uno SVG che non disegna nulla: un'`Image` vuota non è mai uguale a
    // se stessa in Slint e non si può confrontare).
    in property <bool> azione-primaria;
    in property <image> azione-icona;
    in property <bool> fuoco-azione;
    // L'altezza: 40, la Coda 28 fino a F5 (pre-flight C11).
    in property <length> alta: 40px;
    callback azione();

    height: alta;

    property <bool> con-occhi: tono != TonoModuloUi.calmo && tono != TonoModuloUi.vuoto;
    // Lo spazio che resta a sinistra del gruppo di destra (16 di respiro se il gruppo c'è).
    property <length> libero: max(0px, root.width - destra.width - (destra.width > 0px ? 16px : 0px));
    property <length> x-titolo: con-occhi ? 15px + 9px : 0px;
    // Lo spazio che il registro garantisce al titolo (`moduli::misura::SPAZIO_R1`, 320: un `fatto`
    // di 32 caratteri ci sta intero). Il gruppo di destra non può prendersi più di quel che avanza:
    // se non ci sta si stringe lui (le barre dei limiti si accorciano fino a sparire), non il
    // titolo. Il titolo corto non chiede 320 ma la sua larghezza: finché ci sta tutto, le barre
    // restano intere. Lo controlla `testata_lascia_spazio_al_titolo_col_gruppo_piu_largo`.
    property <length> spazio-titolo: min(titolo-testo.preferred-width, 320px);
    property <length> massimo-destra: max(0px, root.width - x-titolo - spazio-titolo - 16px);

    if con-occhi: Occhietti {
        x: 0;
        y: (parent.height - self.height) / 2;
        tono: root.tono;
    }

    titolo-testo := Text {
        x: root.x-titolo;
        y: 0;
        width: min(self.preferred-width, max(0px, root.libero - root.x-titolo));
        height: parent.height;
        text: root.titolo;
        vertical-alignment: center;
        overflow: elide;
        font-weight: 700;
        font-size: 18px;
        // Lo stesso tracking dello stile Titolo della carta (`misura.slint`): la misura in pixel
        // di `moduli::misura` (SPAZIO_R1) vale così anche qui.
        letter-spacing: -0.27px;
        color: Tema.testo;
    }

    // Il sotto prende quel che avanza dopo il titolo: si accorcia per primo.
    if root.sotto != "": Text {
        x: titolo-testo.x + titolo-testo.width + 10px;
        y: 0;
        width: max(0px, root.libero - self.x);
        height: parent.height;
        text: root.sotto;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-corpo;
        color: Tema.testo-tenue;
    }

    // A destra: limiti, spesa, azione. Si accorcia fino a `massimo-destra` (lo spazio garantito al
    // titolo): prima le barre dei limiti, poi un po' l'importo; l'azione mai.
    destra := HorizontalLayout {
        x: root.width - self.width;
        y: (parent.height - self.height) / 2;
        width: min(self.preferred-width, root.massimo-destra);
        height: 32px;
        spacing: 14px;

        if root.l1.presente: LimiteBarra { limite: root.l1; }
        if root.l2.presente: LimiteBarra { limite: root.l2; }

        // L'importo in mono; senza (nessuna chiave, nessun dato) la nota al suo posto, tenue, su
        // due righe al più in 200 px (come diceva la card della vista di prima). Narrator legge
        // sempre come valore quello che si vede.
        // Se il gruppo non ci sta si stringono prima le barre dei limiti (hanno lo stretch); solo
        // se non basta cede un po' anche l'importo (l'ellissi), mai l'azione.
        if root.spesa != "" || root.spesa-nota != "": Rectangle {
            preferred-width: root.spesa != "" ? spesa-testo.preferred-width : min(spesa-testo.preferred-width, 200px);
            min-width: min(self.preferred-width, 48px);
            accessible-role: text;
            accessible-label: "Spesa API del mese";
            accessible-value: root.spesa != "" ? root.spesa : root.spesa-nota;
            accessible-description: root.spesa != "" ? root.spesa-nota : "";

            spesa-testo := Text {
                width: parent.width;
                height: parent.height;
                text: root.spesa != "" ? root.spesa : root.spesa-nota;
                vertical-alignment: center;
                wrap: root.spesa != "" ? no-wrap : word-wrap;
                overflow: elide;
                font-family: root.spesa != "" ? Tema.carattere-mono : Tema.carattere;
                font-weight: 500;
                font-size: Tema.testo-piccolo;
                color: root.spesa != "" ? Tema.testo : Tema.testo-tenue;
                accessible-role: none;
            }
        }

        if root.azione-testo != "": Pulsante {
            testo: root.azione-testo;
            tipo: root.azione-primaria ? TipoPulsante.azione : TipoPulsante.neutro;
            con-icona: root.azione-primaria;
            icona: root.azione-icona;
            altezza: 32px;
            raggio: 9px;
            largo-min: 72px;
            anello: root.fuoco-azione;
            chiede-fuoco: root.fuoco-azione;
            // La tastiera la governa il pannello.
            tasti-propri: false;
            premuto => { root.azione(); }
        }
    }
}

export component StatoPagina inherits Rectangle {
    in property <StatoPaginaUi> stato;
    // Il fuoco da tastiera è sul suo pulsante (se c'è).
    in property <bool> con-fuoco;
    callback azione();

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 16px;
        padding-right: 16px;

        Text {
            text: root.stato.frase;
            horizontal-alignment: center;
            wrap: word-wrap;
            font-weight: 700;
            font-size: Tema.testo-sottotitolo;
            color: Tema.testo;
        }

        if root.stato.sotto != "": Text {
            text: root.stato.sotto;
            horizontal-alignment: center;
            wrap: word-wrap;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
        }

        if root.stato.azione-testo != "": HorizontalLayout {
            alignment: center;
            padding-top: 8px;

            Pulsante {
                testo: root.stato.azione-testo;
                tipo: TipoPulsante.azione;
                altezza: 32px;
                raggio: 9px;
                anello: root.con-fuoco;
                chiede-fuoco: root.con-fuoco;
                tasti-propri: false;
                premuto => { root.azione(); }
            }
        }
    }
}
