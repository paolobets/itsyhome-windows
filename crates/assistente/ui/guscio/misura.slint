// Misura di un testo con gli stessi caratteri, pesi, corpi e tracking di `moduli/misura.rs`:
// serve solo al test che confronta la misura di Rust con la resa di Slint (che applica anche la
// crenatura). Gli stili: 0 titolo, 1 titolo numerico, 2 riga, 3 etichetta, 4 capsula.
import { Tema } from "../tema.slint";
import { EtichettaMono } from "../componenti.slint";

export component MisuraTesto inherits Window {
    in property <string> testo;
    in property <int> stile;
    // L'etichetta (3) si misura con l'`EtichettaMono` vera, quella con cui si disegnano le schede e
    // le carte; gli altri stili col testo qui sotto.
    out property <length> larghezza: root.stile == 3 ? etichetta.preferred-width : misura.preferred-width;

    etichetta := EtichettaMono {
        text: root.stile == 3 ? root.testo : "";
    }

    misura := Text {
        text: root.stile == 3 ? "" : root.testo;
        font-family: root.stile == 1 ? Tema.carattere-mono : Tema.carattere;
        font-weight: (root.stile == 0 || root.stile == 4) ? 700 : 500;
        font-size: root.stile == 0 ? 18px : (root.stile == 1 ? 26px : (root.stile == 2 ? 12px : 11px));
        letter-spacing: root.stile == 0 ? -0.27px : (root.stile == 1 ? -0.52px : 0px);
    }
}
