// Vista Claude (M3, Task 9): Claude Code in un colpo d'occhio, nel pannello 800 × 300. A sinistra
// le sessioni, tutte, in una colonna che scorre (rotella e frecce; la riga col fuoco resta in
// vista): il nome (il titolo della sessione, se ne ha uno, con la cartella attenuata nella seconda riga;
// sennò la cartella), stato col colore del suo livello, strumento, durata, contesto (caldo oltre
// l'80 %). L'ordine lo decide Rust e sta fermo a pannello aperto. A destra i due limiti
// dell'abbonamento ad anello («Limite 5 ore», «Limite 7 giorni», con quando si azzerano; dopo un
// riavvio, finché non arriva un dato nuovo, l'ultimo valore ricordato, attenuato e con «visto
// alle…») e sotto la spesa delle API del mese. Un limite assente o già azzerato non ha l'anello
// (mai «0%»); senza nessuno la card dice «Limiti non disponibili». Stati vuoti: scollegato
// («Collega Claude Code dalle Impostazioni» con «Impostazioni» sotto) e nessuna sessione
// («Nessuna sessione aperta»).
// Da tastiera (in pannello.slint): ↑/↓ fra le righe, Invio apre la sessione (`apri-sessione`); da
// ultima riga ↓ porta su «Dettagli» (con la chiave da amministratore), Invio apre le schede.
// La vista non ha timer: i dati li scrive Rust, e solo mentre la vista è aperta.
import { Tema } from "../tema.slint";
import { Icone, Icona } from "../icone.slint";
import { LivelloUi, RigaSessioneUi, LimiteClaudeUi } from "../voci.slint";
import { Anello, Fuoco, Pulsante, TipoPulsante, Etichetta } from "../componenti.slint";

// Una sessione: due righe in una card alta 48. La durata e il contesto stanno a destra.
component RigaClaude inherits Rectangle {
    in property <RigaSessioneUi> riga;
    in property <bool> anello;
    callback apri();

    // Chi lavora ha la tinta del lavoro; gli altri quella del loro livello (la parola c'è sempre).
    property <color> tinta-stato: riga.livello == LivelloUi.nessuno ? Tema.petalo-5 : Tema.colore-livello(riga.livello);
    // Il mouse è sull'icona del terminale (ha il suo suggerimento): la riga resta «sopra».
    property <bool> sopra-icona;

    // Un solo raggio in tutta la vista, quello delle card di destra (RC-48).
    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: Tema.vetro-bordo;
    background: area.has-hover || sopra-icona ? Tema.g2 : Tema.g1;
    accessible-role: button;
    // Col titolo della sessione: «titolo, cartella, stato»; senza, come sempre «cartella, stato».
    accessible-label: (riga.titolo != "" ? riga.titolo + ", " : "") + riga.cartella + ", " + riga.stato;
    // Senza la durata: cambia ogni secondo e Narrator non deve ripeterla.
    property <string> dettagli: riga.strumento != "" && riga.contesto != "" ? riga.strumento + ", contesto " + riga.contesto
        : riga.strumento != "" ? riga.strumento : riga.contesto != "" ? "contesto " + riga.contesto : "";
    // Dove il clic porta davanti la finestra e non la scheda lo si dice; senza, niente. Il
    // terminale «ultimo usato» ha la sua icona col nome.
    property <string> note: riga.avviso;
    accessible-description: dettagli != "" && note != "" ? dettagli + ". " + note : dettagli + note;
    accessible-action-default => { root.apri(); }

    Fuoco { chiede: anello; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.apri(); }
    }

    HorizontalLayout {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: 20px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            preferred-width: 0px;
            // Il nome della sessione è il suo titolo, se ne ha uno; sennò la cartella.
            text: riga.titolo != "" ? riga.titolo : riga.cartella;
            vertical-alignment: center;
            overflow: elide;
            font-weight: 500;
            font-size: Tema.testo-medio;
            color: Tema.testo;
            accessible-role: none;
        }

        Text {
            text: riga.durata;
            vertical-alignment: center;
            font-size: Tema.testo-corpo;
            color: Tema.testo-tenue;
            accessible-role: none;
        }
    }

    HorizontalLayout {
        x: 12px;
        y: 26px;
        width: parent.width - 24px;
        height: 16px;
        spacing: 6px;

        Text {
            text: riga.stato;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-piccolo;
            color: tinta-stato;
            accessible-role: none;
        }

        // Chi non lavora non ha lo strumento: niente testo vuoto, che terrebbe il suo spazio (RC-37).
        if riga.strumento != "": Text {
            text: "· " + riga.strumento;
            vertical-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            accessible-role: none;
        }

        // Col titolo, la cartella sta qui, attenuata, nel vuoto della seconda riga: il titolo in alto
        // resta largo quanto prima. Senza titolo il vuoto è solo spazio.
        if riga.titolo != "": Text {
            horizontal-stretch: 1;
            preferred-width: 0px;
            text: "· " + riga.cartella;
            vertical-alignment: center;
            overflow: elide;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            accessible-role: none;
        }

        if riga.titolo == "": Rectangle { horizontal-stretch: 1; }

        // Il clic ripiega sull'ultimo terminale usato (RC-57): un'icona col suo suggerimento, non
        // la frase su ogni riga; il nome lo legge Narrator.
        if riga.terminale != "": Rectangle {
            width: 16px;
            accessible-role: image;
            accessible-label: riga.terminale;

            Icona {
                x: 1px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: Icone.terminale;
                colorize: Tema.testo-tenue;
            }

            icona := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.apri(); }
                changed has-hover => { root.sopra-icona = self.has-hover; }
            }

            if icona.has-hover: Rectangle {
                x: parent.width - self.width - 20px;
                y: -2px;
                height: 20px;
                width: suggerimento.preferred-width + 16px;
                border-radius: Tema.raggio-s;
                background: Tema.suggerimento;
                border-width: 1px;
                border-color: Tema.vetro-bordo;

                suggerimento := Text {
                    text: "Apre l'ultimo terminale usato";
                    font-size: Tema.testo-piccolo;
                    color: Tema.testo;
                    accessible-role: none;
                }
            }
        }

        if riga.contesto != "": Text {
            text: "Contesto " + riga.contesto;
            vertical-alignment: center;
            font-size: Tema.testo-piccolo;
            // Oltre l'80 % il contesto sta per finire (RC-55).
            color: riga.contesto-caldo ? Tema.caldo-2 : Tema.testo-tenue;
            accessible-role: none;
        }
    }

    if anello: Anello {
        raggio: parent.border-radius;
        // Dentro la riga: la colonna scorre in un Flickable e un anello da fuori verrebbe tagliato.
        distanza: -2px;
    }
}

// Un limite: l'anello (arco di 270° aperto in basso, come nei quadranti) con la percentuale, il
// nome e quando si azzera. Alta 52; l'anello occupa tutta l'altezza (l'arco disegnato è un po' più
// piccolo del suo riquadro) così la percentuale ha il suo respiro dentro il tratto (RC-49).
// L'ultimo valore ricordato da prima del riavvio (`vecchio`) è attenuato.
component CardLimite inherits Rectangle {
    in property <string> titolo;
    in property <LimiteClaudeUi> limite;
    // Sopra questa frazione l'arco è caldo: la soglia d'avviso dell'utente (RC-44).
    in property <float> soglia: 0.8;

    property <length> arco: 52px;
    // Come nei quadranti: parte da 135° e gira in senso orario.
    property <angle> fine: 135deg + 270deg * min(limite.frazione, 1);
    property <bool> acceso: limite.frazione >= 0.01;

    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: Tema.vetro-bordo;
    background: Tema.g1;
    accessible-role: progress-indicator;
    accessible-label: titolo;
    accessible-value: limite.testo;
    accessible-description: limite.azzera;

    // Il valore ricordato da prima del riavvio si attenua: non è un dato di adesso.
    opacity: limite.vecchio ? 0.6 : 1;

    Rectangle {
        x: 6px;
        y: (parent.height - arco) / 2;
        width: arco;
        height: arco;

        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 110;
            viewbox-height: 110;
            commands: "M 23.89 86.11 A 44 44 0 1 1 86.11 86.11";
            stroke: Tema.traccia;
            stroke-width: 4px;
            stroke-line-cap: round;
        }

        if acceso: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 110;
            viewbox-height: 110;
            commands: "M 23.89 86.11 A 44 44 0 " + (limite.frazione > 0.6667 ? 1 : 0) + " 1 " + (55 + 44 * cos(fine)) + " " + (55 + 44 * sin(fine));
            stroke: Tema.oltre-soglia(limite.frazione, soglia) ? Tema.caldo-2 : Tema.petalo-2;
            stroke-width: 4px;
            stroke-line-cap: round;
        }

        Text {
            x: (parent.width - self.width) / 2;
            width: parent.width - 8px;
            height: parent.height;
            text: limite.testo;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-piccolo;
            color: Tema.testo;
            accessible-role: none;
        }
    }

    Text {
        x: 66px;
        y: 8px;
        width: parent.width - self.x - 12px;
        height: 18px;
        text: titolo;
        vertical-alignment: center;
        font-weight: 500;
        font-size: Tema.testo-corpo;
        color: Tema.testo;
        accessible-role: none;
    }

    Text {
        x: 66px;
        y: 28px;
        width: parent.width - self.x - 12px;
        height: 16px;
        text: limite.azzera;
        vertical-alignment: center;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
        accessible-role: none;
    }
}

// Il posto di un limite che non c'è: lo dice, senza anello né numeri.
component CardLimiteAssente inherits Rectangle {
    in property <string> testo;
    in property <string> dettaglio;

    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: Tema.vetro-bordo;
    background: Tema.card-fondo;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: testo;
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-corpo;
            color: Tema.testo-tenue;
            wrap: word-wrap;
        }

        if dettaglio != "": Text {
            text: dettaglio;
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            wrap: word-wrap;
        }
    }
}

export component VistaClaude inherits Rectangle {
    // Claude Code è collegato (Impostazioni › Claude).
    in property <bool> collegato;
    // Tutte le sessioni, nell'ordine fermo deciso da Rust: la colonna scorre.
    in property <[RigaSessioneUi]> righe;
    in property <LimiteClaudeUi> cinque-ore;
    in property <LimiteClaudeUi> sette-giorni;
    // La soglia d'avviso dell'utente (frazione 0..1): sopra, l'arco dei limiti è caldo.
    in property <float> soglia: 0.8;
    // La spesa API del mese («412,80 $», vuoto se non c'è) e la sua nota («aggiornato alle 14:02», ora
    // locale, «nessun dato» o la frase per aggiungere la chiave).
    in property <string> spesa;
    in property <string> spesa-nota;
    // Riga col fuoco da tastiera (-1 = nessuna) e fuoco su «Impostazioni» (stato scollegato).
    in property <int> fuoco: -1;
    in property <bool> fuoco-impostazioni;
    // La chiave da amministratore c'è: «Dettagli» apre le schede delle API nella finestra di gestione.
    in property <bool> dettagli-visibili;
    in property <bool> fuoco-dettagli;
    callback dettagli();
    callback apri-sessione(string);
    // Le Impostazioni sulla scheda Claude.
    callback gestisci();

    property <length> alto-riga: 48px;
    property <length> spazio: 8px;
    property <length> larghezza-sinistra: floor(root.width / 1px * 0.56) * 1px;
    property <length> x-destra: larghezza-sinistra + 16px;
    property <length> larghezza-destra: root.width - x-destra;
    // 52 + 8 + 52 + 8 + 68 = 188, l'altezza della zona centrale del pannello.
    property <length> alto-card-limite: 52px;
    property <length> alto-spesa: 68px;
    property <bool> con-righe: collegato && righe.length > 0;
    property <length> alto-elenco: righe.length * (alto-riga + spazio) - spazio;
    property <int> n-righe: righe.length;

    // Porta in vista la riga `i` (la colonna scorre: la riga col fuoco non resta mai fuori).
    function porta-in-vista(i: int) {
        if (i < 0 || i >= righe.length) {
            return;
        }
        if (i * (alto-riga + spazio) + elenco.content-y < 0px) {
            elenco.content-y = -(i * (alto-riga + spazio));
        } else if ((i + 1) * (alto-riga + spazio) - spazio + elenco.content-y > elenco.height) {
            elenco.content-y = elenco.height - ((i + 1) * (alto-riga + spazio) - spazio);
        }
    }
    changed fuoco => { porta-in-vista(fuoco); }
    changed n-righe => { porta-in-vista(fuoco); }

    // Sinistra: le sessioni, tutte; scorrono con la rotella e, col fuoco, con le frecce.
    elenco := Flickable {
        visible: collegato;
        x: 0;
        y: 0;
        width: larghezza-sinistra;
        height: root.height;
        content-width: self.width;
        content-height: max(self.height, alto-elenco);

        for riga[i] in righe: RigaClaude {
            x: 0;
            y: i * (alto-riga + spazio);
            width: larghezza-sinistra;
            height: alto-riga;
            riga: riga;
            anello: i == root.fuoco;
            apri => { root.apri-sessione(riga.id); }
        }
    }

    // Quante ce ne sono oltre la finestra: un filo a destra della colonna, solo se scorre. Sta nello
    // spazio vuoto fra le due colonne (16 px), non sopra il bordo delle righe.
    if con-righe && alto-elenco > root.height: Rectangle {
        x: larghezza-sinistra + 6px;
        y: 4px + (root.height - 8px - self.height) * (-elenco.content-y / (alto-elenco - root.height));
        width: 3px;
        height: max(16px, (root.height - 8px) * root.height / alto-elenco);
        border-radius: 1.5px;
        background: Tema.testo-tenue.with-alpha(0.5);
    }

    // Nessuna sessione (collegato).
    if collegato && righe.length == 0: VerticalLayout {
        x: 0;
        width: larghezza-sinistra;
        height: root.height;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Icona {
                source: Icone.claude;
                width: 34px;
                height: 34px;
            }
        }

        Text {
            text: "Nessuna sessione aperta";
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }

        Text {
            text: "Le sessioni di Claude Code compaiono qui mentre lavorano.";
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            wrap: word-wrap;
        }
    }

    // Scollegato: come si collega, col pulsante sotto il messaggio.
    if !collegato: VerticalLayout {
        x: 0;
        width: larghezza-sinistra;
        height: root.height;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Icona {
                source: Icone.claude;
                width: 34px;
                height: 34px;
            }
        }

        Text {
            text: "Collega Claude Code dalle Impostazioni";
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
            wrap: word-wrap;
        }

        Text {
            text: "Qui vedrai le sessioni al lavoro, i limiti e la spesa.";
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            padding-top: 4px;

            Pulsante {
                testo: "Impostazioni";
                tipo: TipoPulsante.neutro;
                anello: fuoco-impostazioni;
                chiede-fuoco: fuoco-impostazioni;
                tasti-propri: false;
                premuto => { root.gestisci(); }
            }
        }
    }

    // Destra: i due limiti, poi la spesa.
    if cinque-ore.presente: CardLimite {
        x: x-destra;
        y: 0;
        width: larghezza-destra;
        height: alto-card-limite;
        titolo: "Limite 5 ore";
        limite: cinque-ore;
        soglia: root.soglia;
    }

    if sette-giorni.presente: CardLimite {
        x: x-destra;
        y: alto-card-limite + spazio;
        width: larghezza-destra;
        height: alto-card-limite;
        titolo: "Limite 7 giorni";
        limite: sette-giorni;
        soglia: root.soglia;
    }

    // Un solo limite c'è: l'altro posto lo dice. Nessuno: una card sola.
    if !cinque-ore.presente && sette-giorni.presente: CardLimiteAssente {
        x: x-destra;
        y: 0;
        width: larghezza-destra;
        height: alto-card-limite;
        testo: "Limite 5 ore non disponibile";
    }

    if cinque-ore.presente && !sette-giorni.presente: CardLimiteAssente {
        x: x-destra;
        y: alto-card-limite + spazio;
        width: larghezza-destra;
        height: alto-card-limite;
        testo: "Limite 7 giorni non disponibile";
    }

    if !cinque-ore.presente && !sette-giorni.presente: CardLimiteAssente {
        x: x-destra;
        y: 0;
        width: larghezza-destra;
        height: 2 * alto-card-limite + spazio;
        testo: "Limiti non disponibili";
        dettaglio: collegato ? "Compaiono dopo la prima risposta di una sessione, con un abbonamento Claude." : "Si vedono dopo aver collegato Claude Code.";
    }

    // La spesa API del mese: il valore e, sotto, da quando sono i dati (o perché non c'è).
    Rectangle {
        x: x-destra;
        y: root.height - alto-spesa;
        width: larghezza-destra;
        height: alto-spesa;
        border-radius: Tema.raggio-xl;
        border-width: 1px;
        border-color: Tema.vetro-bordo;
        background: Tema.g1;
        accessible-role: text;
        accessible-label: "Spesa API del mese";
        accessible-value: spesa != "" ? spesa : spesa-nota;
        accessible-description: spesa != "" ? spesa-nota : "";

        // Margini veri (RC-35): 12 ai lati, 8 sopra e sotto; il blocco è alto 52 dentro i 68.
        Etichetta {
            x: 12px;
            y: 8px;
            width: parent.width - 24px - (dettagli-visibili ? 84px : 0px);
            height: 14px;
            text: "SPESA API DEL MESE";
            accessible-role: none;
        }

        if dettagli-visibili: Pulsante {
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            testo: "Dettagli";
            // Per Narrator dice cosa apre.
            accessible-label: "Dettagli delle API";
            tipo: TipoPulsante.neutro;
            altezza: 28px;
            largo-min: 72px;
            anello: fuoco-dettagli;
            chiede-fuoco: fuoco-dettagli;
            tasti-propri: false;
            premuto => { root.dettagli(); }
        }

        if spesa != "": Text {
            x: 12px;
            y: 24px;
            width: parent.width - 24px - (dettagli-visibili ? 84px : 0px);
            height: 22px;
            text: spesa;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-vuoto;
            color: Tema.testo;
            accessible-role: none;
        }

        Text {
            x: 12px;
            y: spesa != "" ? 46px : 24px;
            width: parent.width - 24px - (dettagli-visibili ? 84px : 0px);
            height: spesa != "" ? 14px : 36px;
            text: spesa-nota;
            // Senza valore la nota sta al centro dello spazio sotto l'etichetta (non in alto col
            // vuoto sotto); col valore resta sotto di lui.
            vertical-alignment: spesa != "" ? top : center;
            wrap: word-wrap;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
            accessible-role: none;
        }
    }
}
