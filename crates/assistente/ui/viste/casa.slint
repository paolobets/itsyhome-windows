// Vista Casa (M1): i preferiti in una griglia di card. Un tocco accende/spegne luci e
// interruttori e attiva le scene; i sensori si leggono soltanto. Il colore compare solo sui
// dispositivi accesi; quelli non disponibili (o tutti, a casa non connessa) restano tenui e non
// rispondono al tocco. Da tastiera: frecce fra le card, Invio o Spazio = tocco (in pannello.slint).
import { Tema } from "../tema.slint";
import { Icone, Icona } from "../icone.slint";
import { PreferitoUi } from "../voci.slint";
import { Anello, Pulsante, TipoPulsante, Etichetta } from "../componenti.slint";

// Una card dispositivo: icona in alto, nome e stato in basso.
export component Dispositivo inherits Rectangle {
    in property <PreferitoUi> voce;
    // Fuoco da tastiera su questa card: anello visibile.
    in property <bool> anello;
    callback tocca();

    property <bool> luce: voce.genere == "luce";
    property <bool> sopra: area.has-hover && voce.toccabile;
    // Il colore dello stato solo se il dato è vivo: a casa non connessa una luce «Acceso» è un
    // valore vecchio e resta neutra, come una non disponibile.
    property <bool> colorata: voce.acceso && !voce.tenue;
    // Tenue = colori con trasparenza (non opacity, che disegna in uno strato a parte). A 0,85 il
    // testo dello stato (testo-tenue) sulla card tenue (bianco al 4%) è 5,6:1 sul corpo (Tema.corpo) e
    // 5,0:1 nel punto peggiore, sotto il bagliore indaco del pannello (+10%); il nome 11:1.
    // (A 0,78 era 4,9 / 4,5:1: al limite.)
    property <float> velatura: voce.tenue ? 0.85 : 1.0;

    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: !colorata ? Tema.vetro-bordo : luce ? Tema.luce-bordo : Tema.presa-bordo;
    background: voce.tenue ? Tema.card-fondo
        : !colorata ? (sopra ? Tema.card-vetro-sopra : Tema.card-vetro)
        : luce ? Tema.luce-card : Tema.presa-card;
    accessible-role: button;
    accessible-enabled: voce.toccabile;
    accessible-label: voce.nome + ", " + voce.stato;
    accessible-action-default => { if (voce.toccabile) { root.tocca(); } }

    // Card alte ~69 px: icona e nome non devono toccarsi.
    Icona {
        x: 11px;
        y: 8px;
        width: 22px;
        height: 22px;
        source: Icone.di-genere(voce.genere);
        colorize: voce.tenue ? Tema.icona-spenta
            : colorata ? (luce ? Tema.luce-accesa : Tema.presa-accesa)
            : voce.genere == "luce" || voce.genere == "presa" ? Tema.icona-spenta : Tema.icona;
    }

    Text {
        x: 11px;
        y: parent.height - 38px;
        width: parent.width - 22px;
        text: voce.nome;
        overflow: elide;
        font-weight: 500;
        font-size: Tema.testo-corpo;
        color: Tema.testo.with-alpha(velatura);
    }

    Text {
        x: 11px;
        y: parent.height - 21px;
        width: parent.width - 22px;
        text: voce.stato;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: voce.errore != "" ? Tema.caldo-2 : Tema.testo-tenue.with-alpha(velatura);
    }

    area := TouchArea {
        enabled: voce.toccabile;
        mouse-cursor: voce.toccabile ? pointer : default;
        clicked => { root.tocca(); }
    }

    if anello: Anello { raggio: parent.border-radius; }
}

export component VistaCasa inherits Rectangle {
    in property <[PreferitoUi]> preferiti;
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    // Ora degli ultimi dati («10:42»; vuota se non ne sono mai arrivati).
    in property <string> dati-delle;
    // «Riprova» nella testata: casa non connessa che si può riprovare.
    in property <bool> riprova;
    // Card col fuoco da tastiera (-1 = nessuna); fuoco su «Riprova» e su «Apri Impostazioni».
    in property <int> fuoco: -1;
    in property <bool> fuoco-riprova;
    in property <bool> fuoco-impostazioni;
    callback tocca(string);
    callback riprova-casa();
    callback apri-impostazioni();

    // Pannello largo e basso: 4 colonne, così gli 8 preferiti stanno in due righe.
    in property <int> colonne: 4;
    property <length> spazio: 8px;
    property <length> lato: (self.width - (colonne - 1) * spazio) / colonne;
    property <length> testata: 32px;
    property <length> alto-card: min(76px, (self.height - testata - spazio) / 2);
    // Senza connessione la testata dice di quando sono i dati mostrati.
    property <string> riga-testata: casa-pronta || dati-delle == "" ? stato-casa : stato-casa + " · dati delle " + dati-delle;

    // Testata: titolo a sinistra, stato della casa (e «Riprova») a destra.
    Etichetta {
        x: 2px;
        y: 0;
        height: 28px;
        text: "PREFERITI";
    }

    Text {
        x: (riprova ? pulsante-riprova.x - 10px : parent.width - 2px) - self.width;
        y: 0;
        width: parent.width * 0.65;
        height: 28px;
        text: preferiti.length > 0 ? riga-testata : "";
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    // Alto 28 come la testata.
    pulsante-riprova := Pulsante {
        visible: riprova;
        x: parent.width - self.width - 2px;
        y: 0;
        altezza: 28px;
        testo: "Riprova";
        anello: fuoco-riprova;
        premuto => { root.riprova-casa(); }
    }

    for voce[i] in preferiti: Dispositivo {
        x: mod(i, colonne) * (lato + spazio);
        y: testata + floor(i / colonne) * (alto-card + spazio);
        width: lato;
        height: alto-card;
        voce: voce;
        anello: i == root.fuoco;
        tocca => { root.tocca(voce.entity-id); }
    }

    // Nessun preferito: si dice perché (casa non connessa, in connessione o senza dispositivi).
    if preferiti.length == 0: VerticalLayout {
        y: testata;
        height: parent.height - testata;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Icona {
                source: Icone.casa;
                width: 34px;
                height: 34px;
            }
        }

        Text {
            text: casa-pronta ? "Nessun dispositivo da mostrare" : stato-casa;
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }

        Text {
            text: casa-pronta
                ? "Aggiungi dei preferiti o delle stanze in Home Assistant."
                : "La connessione si configura nelle Impostazioni.";
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
        }

        // Una via d'uscita: le Impostazioni, dove la casa si collega.
        if !casa-pronta: HorizontalLayout {
            alignment: center;
            padding-top: 4px;

            Pulsante {
                testo: "Apri Impostazioni";
                tipo: TipoPulsante.azione;
                anello: fuoco-impostazioni;
                premuto => { root.apri-impostazioni(); }
            }
        }
    }
}
