// Vista Casa: a sinistra le stanze (nell'ordine salvato, senza le nascoste, poi «Altro» e le
// scene), a destra i preferiti in una griglia di card; una stanza aperta prende il posto dei
// preferiti con i suoi dispositivi (come il pannello di dettaglio della v2, che si apriva accanto
// all'elenco delle stanze). Così stanze e preferiti si vedono insieme nel pannello fisso 800 × 300
// senza schede da cambiare. Un tocco accende/spegne luci e interruttori e attiva le scene; il
// resto si legge soltanto. Il colore compare solo sui dispositivi accesi; quelli non disponibili
// (o tutti, a casa non connessa) restano tenui e non rispondono al tocco. Da tastiera (in
// pannello.slint): Tab fra stanze e card, frecce dentro, Invio o Spazio apre la stanza o tocca la
// card; Esc o «‹ Indietro» chiudono prima la stanza.
import { Tema } from "../tema.slint";
import { Icone, Icona } from "../icone.slint";
import { PreferitoUi, GenereUi, StanzaUi } from "../voci.slint";
import { Anello, Fuoco, Pulsante, TipoPulsante, Etichetta } from "../componenti.slint";

// Una card dispositivo: icona in alto, nome e stato in basso.
export component Dispositivo inherits Rectangle {
    in property <PreferitoUi> voce;
    // Fuoco da tastiera su questa card: anello visibile.
    in property <bool> anello;
    callback tocca();

    property <bool> luce: voce.genere == GenereUi.luce;
    property <bool> sopra: area.has-hover && voce.toccabile;
    // Il colore dello stato solo se il dato è vivo: a casa non connessa una luce «Acceso» è un
    // valore vecchio e resta neutra, come una non disponibile.
    property <bool> colorata: voce.acceso && !voce.tenue;
    // Tenue = colori con trasparenza (non opacity, che disegna in uno strato a parte). A 0,85 il
    // testo dello stato (testo-tenue) sulla card tenue (bianco al 4%) è 5,6:1 sul corpo (Tema.corpo) e
    // 5,0:1 nel punto peggiore, sotto il bagliore indaco del pannello (+10%); il nome 11:1.
    // (A 0,78 era 4,9 / 4,5:1: al limite.)
    property <float> velatura: voce.tenue ? 0.85 : 1.0;

    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: !colorata ? Tema.vetro-bordo : luce ? Tema.luce-bordo : Tema.presa-bordo;
    background: voce.tenue ? Tema.card-fondo
        : !colorata ? (sopra ? Tema.card-vetro-sopra : Tema.card-vetro)
        : luce ? Tema.luce-card : Tema.presa-card;
    accessible-role: button;
    accessible-enabled: voce.toccabile;
    accessible-label: voce.nome + ", " + voce.stato;
    accessible-action-default => { if (voce.toccabile) { root.tocca(); } }

    Fuoco { chiede: anello; }

    // Card alte ~69 px: icona e nome non devono toccarsi.
    Icona {
        x: 11px;
        y: 8px;
        width: 22px;
        height: 22px;
        source: Icone.di-genere(voce.genere);
        colorize: voce.tenue ? Tema.icona-spenta
            : colorata ? (luce ? Tema.luce-accesa : Tema.presa-accesa)
            : voce.genere == GenereUi.luce || voce.genere == GenereUi.presa ? Tema.icona-spenta : Tema.icona;
    }

    Text {
        x: 11px;
        y: parent.height - 38px;
        width: parent.width - 22px;
        text: voce.nome;
        overflow: elide;
        font-weight: 500;
        font-size: Tema.testo-corpo;
        color: Tema.testo.with-alpha(velatura);
    }

    Text {
        x: 11px;
        y: parent.height - 21px;
        width: parent.width - 22px;
        text: voce.stato;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: voce.errore != "" ? Tema.caldo-2 : Tema.testo-tenue.with-alpha(velatura);
    }

    area := TouchArea {
        enabled: voce.toccabile;
        mouse-cursor: voce.toccabile ? pointer : default;
        clicked => { root.tocca(); }
    }

    if anello: Anello { raggio: parent.border-radius; }
}

// Una stanza nell'elenco: icona, nome, quanti dispositivi e «›». Quella aperta resta evidenziata.
component RigaStanza inherits Rectangle {
    in property <StanzaUi> stanza;
    in property <bool> aperta;
    in property <bool> anello;
    in property <bool> tenue;
    callback scelta();

    border-radius: Tema.raggio-m;
    background: aperta ? Tema.scheda-attiva : area.has-hover ? Tema.scheda-sopra : transparent;
    accessible-role: button;
    accessible-label: stanza.nome + ", " + (stanza.quanti == 1 ? "1 dispositivo" : stanza.quanti + " dispositivi");
    accessible-expandable: true;
    accessible-expanded: aperta;
    accessible-action-default => { root.scelta(); }
    // Narrator la apre anche con «Espandi» (il pulsante è espandibile).
    accessible-action-expand => {
        if (!aperta) {
            root.scelta();
        }
    }

    Fuoco { chiede: anello; }

    Icona {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: Icone.di-stanza(stanza.icona);
        colorize: aperta ? Tema.icona-attiva : Tema.icona;
    }

    Text {
        x: 34px;
        width: parent.width - self.x - 44px;
        height: parent.height;
        text: stanza.nome;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-corpo;
        font-weight: aperta ? 500 : 400;
        color: tenue ? Tema.testo-tenue : Tema.testo;
    }

    Text {
        x: parent.width - 40px;
        width: 22px;
        height: parent.height;
        text: stanza.quanti;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-family: Tema.carattere-mono;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    Text {
        x: parent.width - 14px;
        width: 8px;
        height: parent.height;
        text: "›";
        vertical-alignment: center;
        font-size: Tema.testo-corpo;
        color: Tema.testo-tenue;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta(); }
    }

    if anello: Anello { raggio: parent.border-radius; distanza: -2px; }
}

export component VistaCasa inherits Rectangle {
    // Le card della griglia: i preferiti, o i dispositivi della stanza aperta.
    in property <[PreferitoUi]> voci;
    in property <[StanzaUi]> stanze;
    // La stanza aperta (indice in `stanze`, -1 = nessuna: si vedono i preferiti).
    in property <int> stanza-aperta: -1;
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    // Ora degli ultimi dati («10:42»; vuota se non ne sono mai arrivati).
    in property <string> dati-delle;
    // «Riprova» nella testata: casa non connessa che si può riprovare.
    in property <bool> riprova;
    // Card col fuoco da tastiera (-1 = nessuna), stanza col fuoco (-1 = nessuna); fuoco su
    // «Riprova» e su «Apri Impostazioni».
    in property <int> fuoco: -1;
    in property <int> fuoco-stanza: -1;
    in property <bool> fuoco-riprova;
    in property <bool> fuoco-impostazioni;
    callback tocca(string);
    // Clic su una stanza (pannello.slint decide: aprirla, o chiuderla se è già aperta).
    callback scegli-stanza(int);
    callback riprova-casa();
    callback apri-impostazioni();

    // 4 colonne: 8 preferiti in due righe; una stanza con più dispositivi scorre in verticale.
    in property <int> colonne: 4;
    property <bool> con-stanze: stanze.length > 0;
    property <length> largo-stanze: 196px;
    property <length> griglia-x: con-stanze ? largo-stanze + 12px : 0px;
    property <length> griglia-l: self.width - griglia-x;
    property <length> spazio: 8px;
    property <length> lato: (griglia-l - (colonne - 1) * spazio) / colonne;
    property <length> testata: 32px;
    property <length> alto-card: min(76px, (self.height - testata - spazio) / 2);
    property <length> passo-riga: alto-card + spazio;
    property <length> passo-stanza: 32px;
    property <length> bordo: 5px;
    property <bool> in-stanza: stanza-aperta >= 0 && stanza-aperta < stanze.length;
    // Senza connessione la testata dice di quando sono i dati mostrati.
    property <string> riga-testata: casa-pronta || dati-delle == "" ? stato-casa : stato-casa + " · dati delle " + dati-delle;

    // ─── Stanze ───
    if con-stanze: Etichetta {
        x: 2px;
        y: 0;
        height: 28px;
        text: "STANZE";
    }

    elenco-stanze := Flickable {
        x: 0;
        y: testata;
        width: con-stanze ? largo-stanze : 0px;
        height: parent.height - testata;
        visible: con-stanze;
        content-height: max(self.height, stanze.length * passo-stanza);
        interactive: stanze.length * passo-stanza > self.height;

        for stanza[i] in stanze: RigaStanza {
            y: i * passo-stanza;
            width: largo-stanze;
            height: 30px;
            stanza: stanza;
            aperta: i == root.stanza-aperta;
            anello: i == root.fuoco-stanza;
            tenue: !root.casa-pronta;
            scelta => { root.scegli-stanza(i); }
        }
    }

    // Barretta di scorrimento (3 px) quando le stanze non stanno tutte: dice che ce ne sono altre.
    if con-stanze && stanze.length * passo-stanza > elenco-stanze.height + 0.5px: Rectangle {
        x: largo-stanze + 4px;
        y: elenco-stanze.y + (-elenco-stanze.content-y / (stanze.length * passo-stanza)) * elenco-stanze.height;
        width: 3px;
        height: elenco-stanze.height * elenco-stanze.height / (stanze.length * passo-stanza);
        border-radius: self.width / 2;
        background: Tema.traccia;
    }

    // La stanza col fuoco da tastiera scorre in vista.
    changed fuoco-stanza => {
        if (fuoco-stanza >= 0) {
            if (fuoco-stanza * passo-stanza + elenco-stanze.content-y < 0) {
                elenco-stanze.content-y = -fuoco-stanza * passo-stanza;
            } else if ((fuoco-stanza + 1) * passo-stanza + elenco-stanze.content-y > elenco-stanze.height) {
                elenco-stanze.content-y = elenco-stanze.height - (fuoco-stanza + 1) * passo-stanza;
            }
        }
    }

    // ─── Griglia: preferiti o dispositivi della stanza aperta ───
    // Testata: titolo a sinistra, stato della casa (e «Riprova») a destra.
    if voci.length > 0 || con-stanze: Etichetta {
        x: griglia-x + 2px;
        y: 0;
        width: griglia-l * 0.4;
        height: 28px;
        text: in-stanza ? stanze[stanza-aperta].nome : "PREFERITI";
        overflow: elide;
    }

    Text {
        x: (riprova ? pulsante-riprova.x - 10px : parent.width - 2px) - self.width;
        y: 0;
        width: griglia-l * 0.55;
        height: 28px;
        text: voci.length > 0 || con-stanze ? riga-testata : "";
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    // Alto 28 come la testata.
    pulsante-riprova := Pulsante {
        visible: riprova;
        x: parent.width - self.width - 2px;
        y: 0;
        altezza: 28px;
        testo: "Riprova";
        anello: fuoco-riprova;
        chiede-fuoco: fuoco-riprova;
        tasti-propri: false;
        premuto => { root.riprova-casa(); }
    }

    // La griglia sporge di `bordo` su ogni lato: l'anello del fuoco, fuori dalla card, non viene
    // tagliato dal ritaglio della Flickable.
    griglia := Flickable {
        x: griglia-x - bordo;
        y: testata - bordo;
        width: griglia-l + 2 * bordo;
        height: parent.height - testata + 2 * bordo;
        content-height: max(self.height, ceil(voci.length / colonne) * passo-riga - spazio + 2 * bordo);
        interactive: ceil(voci.length / colonne) * passo-riga - spazio + 2 * bordo > self.height + 0.5px;

        for voce[i] in voci: Dispositivo {
            x: bordo + mod(i, colonne) * (lato + spazio);
            y: bordo + floor(i / colonne) * passo-riga;
            width: lato;
            height: alto-card;
            voce: voce;
            anello: i == root.fuoco;
            tocca => { root.tocca(voce.entity-id); }
        }
    }

    // Lo stesso per i dispositivi di una stanza con più di due righe.
    if griglia.content-height > griglia.height + 0.5px: Rectangle {
        x: parent.width + 2px;
        y: griglia.y + (-griglia.content-y / griglia.content-height) * griglia.height;
        width: 3px;
        height: griglia.height * griglia.height / griglia.content-height;
        border-radius: self.width / 2;
        background: Tema.traccia;
    }

    // La card col fuoco da tastiera scorre in vista (una stanza con più di due righe).
    changed fuoco => {
        if (fuoco >= 0) {
            if (floor(fuoco / colonne) * passo-riga + griglia.content-y < 0) {
                griglia.content-y = -floor(fuoco / colonne) * passo-riga;
            } else if (floor(fuoco / colonne) * passo-riga + alto-card + 2 * bordo + griglia.content-y > griglia.height) {
                griglia.content-y = griglia.height - floor(fuoco / colonne) * passo-riga - alto-card - 2 * bordo;
            }
        }
    }
    // Una stanza nuova parte dall'alto.
    changed stanza-aperta => {
        griglia.content-y = 0;
    }

    // Niente da mostrare: si dice perché (casa non connessa, in connessione o senza dispositivi).
    if voci.length == 0 && !con-stanze: VerticalLayout {
        y: testata;
        height: parent.height - testata;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Icona {
                source: Icone.casa;
                width: 34px;
                height: 34px;
            }
        }

        Text {
            text: casa-pronta ? "Nessun dispositivo da mostrare" : stato-casa;
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }

        Text {
            text: casa-pronta
                ? "Aggiungi dei dispositivi alle stanze in Home Assistant."
                : "La connessione si configura nelle Impostazioni.";
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
        }

        // Una via d'uscita: le Impostazioni, dove la casa si collega.
        if !casa-pronta: HorizontalLayout {
            alignment: center;
            padding-top: 4px;

            Pulsante {
                testo: "Apri Impostazioni";
                tipo: TipoPulsante.azione;
                anello: fuoco-impostazioni;
                chiede-fuoco: fuoco-impostazioni;
                tasti-propri: false;
                premuto => { root.apri-impostazioni(); }
            }
        }
    }
}
