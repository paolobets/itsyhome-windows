// Vista Collegamenti (Task 14f): le pagine web delle gestioni, nell'ordine salvato, in una griglia
// di card (iniziale del nome in un cerchio colorato, nome in evidenza, sotto l'indirizzo
// accorciato; la testata ha solo «Modifica»). Un tocco o Invio apre la pagina nel
// browser predefinito del sistema e il pannello si chiude; mai nella finestra di gestione (lì
// JavaScript è spento). «Modifica» nella testata e «Aggiungi un collegamento» nello stato vuoto
// aprono le Impostazioni sulla scheda Collegamenti. Da tastiera (in pannello.slint): frecce fra le
// card, ↑ dalla prima riga a «Modifica», Invio o Spazio apre.
import { Tema } from "../tema.slint";
import { Icone, Icona } from "../icone.slint";
import { CollegamentoUi } from "../voci.slint";
import { Anello, Fuoco, Pulsante, TipoPulsante } from "../componenti.slint";

// Un collegamento: cerchio con l'iniziale, nome e indirizzo accorciato (i puntini se non ci sta).
component CardCollegamento inherits Rectangle {
    in property <CollegamentoUi> voce;
    in property <bool> anello;
    callback apri();

    border-radius: Tema.raggio-xl;
    border-width: 1px;
    border-color: Tema.vetro-bordo;
    background: area.has-hover ? Tema.g2 : Tema.g1;
    accessible-role: button;
    accessible-label: voce.nome + ", " + voce.corto;
    accessible-description: "Si apre nel browser";
    accessible-action-default => { root.apri(); }

    Fuoco { chiede: anello; }

    // Il cerchio: l'iniziale del nome (scura, `Tema.nero`) su un colore che dipende dal nome.
    // Nessuna rete: niente icone del sito.
    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: 26px;
        border-radius: self.width / 2;
        background: Tema.colore-collegamento(voce.tono);

        Text {
            width: parent.width;
            height: parent.height;
            text: voce.iniziale;
            // Decorativa: il nome della card dice già tutto (come l'icona di prima).
            accessible-role: none;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 700;
            font-size: Tema.testo-corpo;
            color: Tema.nero;
        }
    }

    Text {
        x: 46px;
        y: 6px;
        width: parent.width - self.x - 12px;
        height: 18px;
        text: voce.nome;
        overflow: elide;
        font-weight: 500;
        font-size: Tema.testo-corpo;
        color: Tema.testo;
    }

    Text {
        x: 46px;
        y: 24px;
        width: parent.width - self.x - 12px;
        height: 15px;
        text: voce.corto;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.apri(); }
    }

    if anello: Anello { raggio: parent.border-radius; }
}

export component VistaCollegamenti inherits Rectangle {
    in property <[CollegamentoUi]> voci;
    // Un collegamento che non si è aperto: lo dice la testata (il dettaglio è nelle Impostazioni).
    in property <string> errore;
    // Card col fuoco da tastiera (-1 = nessuna); fuoco su «Modifica» e su «Aggiungi un collegamento».
    in property <int> fuoco: -1;
    in property <bool> fuoco-modifica;
    in property <bool> fuoco-aggiungi;
    in property <int> colonne: 3;
    callback apri(string);
    // Le Impostazioni sulla scheda Collegamenti.
    callback gestisci();

    property <length> testata: 32px;
    property <length> spazio: 8px;
    property <length> bordo: 5px;
    property <length> lato: (self.width - (colonne - 1) * spazio) / colonne;
    property <length> alto-card: 44px;
    property <length> passo-riga: alto-card + spazio;
    property <int> righe: ceil(voci.length / colonne);

    // La testata ha solo «Modifica» (il titolo e «si aprono nel browser» non servono: le card si
    // spiegano da sole). A sinistra di «Modifica», l'errore dell'ultima apertura, se c'è.
    if voci.length > 0 && errore != "": Text {
        x: pulsante-modifica.x - 10px - self.width;
        y: 0;
        width: root.width * 0.6;
        height: 28px;
        text: errore;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.caldo-2;
    }

    // Alto 28 come la testata.
    pulsante-modifica := Pulsante {
        visible: voci.length > 0;
        x: parent.width - self.width - 2px;
        y: 0;
        altezza: 28px;
        testo: "Modifica";
        accessible-label: "Modifica i collegamenti";
        anello: fuoco-modifica;
        chiede-fuoco: fuoco-modifica;
        tasti-propri: false;
        premuto => { root.gestisci(); }
    }

    // Sporge di `bordo` su ogni lato: l'anello del fuoco, fuori dalla card, non viene tagliato.
    griglia := Flickable {
        x: -bordo;
        y: testata - bordo;
        width: parent.width + 2 * bordo;
        height: parent.height - testata + 2 * bordo;
        content-height: max(self.height, righe * passo-riga - spazio + 2 * bordo);
        interactive: righe * passo-riga - spazio + 2 * bordo > self.height + 0.5px;

        for voce[i] in voci: CardCollegamento {
            x: bordo + mod(i, colonne) * (lato + spazio);
            y: bordo + floor(i / colonne) * passo-riga;
            width: lato;
            height: alto-card;
            voce: voce;
            anello: i == root.fuoco;
            apri => { root.apri(voce.id); }
        }
    }

    // Barretta di scorrimento (3 px) quando non stanno tutti.
    if griglia.content-height > griglia.height + 0.5px: Rectangle {
        x: parent.width + 2px;
        y: griglia.y + (-griglia.content-y / griglia.content-height) * griglia.height;
        width: 3px;
        height: griglia.height * griglia.height / griglia.content-height;
        border-radius: self.width / 2;
        background: Tema.traccia;
    }

    // La card col fuoco da tastiera scorre in vista.
    changed fuoco => {
        if (fuoco >= 0) {
            if (floor(fuoco / colonne) * passo-riga + griglia.content-y < 0) {
                griglia.content-y = -floor(fuoco / colonne) * passo-riga;
            } else if (floor(fuoco / colonne) * passo-riga + alto-card + 2 * bordo + griglia.content-y > griglia.height) {
                griglia.content-y = griglia.height - floor(fuoco / colonne) * passo-riga - alto-card - 2 * bordo;
            }
        }
    }

    // Nessun collegamento: a cosa serve e come se ne aggiunge uno.
    if voci.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;

            Icona {
                source: Icone.collegamento;
                width: 34px;
                height: 34px;
            }
        }

        Text {
            text: "Nessun collegamento";
            horizontal-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }

        Text {
            text: "Le pagine delle tue gestioni a portata di clic: si aprono nel browser.";
            horizontal-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
        }

        HorizontalLayout {
            alignment: center;
            padding-top: 4px;

            Pulsante {
                testo: "Aggiungi un collegamento";
                tipo: TipoPulsante.azione;
                anello: fuoco-aggiungi;
                chiede-fuoco: fuoco-aggiungi;
                tasti-propri: false;
                premuto => { root.gestisci(); }
            }
        }
    }
}
