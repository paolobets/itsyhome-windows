// Vista PC, la «card del PC»: tutta la gestione del PC in tre colonne (M2, Task 8, decisione di
// Paolo che sostituisce il pannellino sopra il dock). «Sistema»: CPU, RAM, disco (poi la GPU,
// Task 10). «Energia e audio»: batteria (se c'è), volume (Task 7) e cuffie Bluetooth (Task 9).
// «Connessioni»: la rete (icona con le tacche e velocità), i riquadri Wi-Fi e Bluetooth e le
// righe che aprono le pagine di Windows (solo su Windows: altrove la colonna ha solo la rete).
// Le righe sono alte 38 (testi ≥ 12 px): con l'intestazione stanno quattro righe per colonna nei
// 172 px della card.
import { Tema } from "../tema.slint";
import { Icone, Icona, Vetro } from "../icone.slint";
import { StatPcUi, TintaBatteriaUi, TipoReteUi } from "../voci.slint";
import { Etichetta, GlifoBatteria, Fuoco, Anello, IconaRete, NomeRete } from "../componenti.slint";

// La colonna del valore (testo e barra) di ogni riga, a destra.
global MisurePc {
    out property <length> colonna: 120px;
    out property <length> alto-riga: 38px;
    out property <length> margine: 14px;
}

// L'intestazione di una colonna («Sistema», «Energia e audio», «Connessioni»).
component Intestazione inherits Rectangle {
    in property <string> text;
    height: 18px;

    Text {
        x: MisurePc.margine;
        width: parent.width - 2 * MisurePc.margine;
        text: root.text;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        font-weight: 600;
        color: Tema.testo-tenue;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Una riga: etichetta, valore e (se serve) una barra sottile con la frazione usata.
component Riga inherits Rectangle {
    in property <string> etichetta;
    in property <string> valore;
    in property <string> dettaglio;
    in property <float> frazione: -1;
    in property <color> colore: Tema.petalo-2;
    // Batteria: l'avviso scatta quando è quasi scarica, non quando è piena.
    in property <bool> invertita: false;
    // Batteria: glifo accanto al valore, con la sua tinta (vedi `GlifoBatteria`).
    in property <bool> con-glifo: false;
    in property <TintaBatteriaUi> tinta: TintaBatteriaUi.normale;
    // Cuffie: il glifo dice la carica ma senza la barra sotto; per Narrator l'elenco intero.
    in property <bool> senza-barra: false;
    in property <string> descrizione;
    property <length> colonna-x: root.width - MisurePc.margine - MisurePc.colonna;
    height: MisurePc.alto-riga;
    // Per Narrator: nome, valore e dettaglio (FE16).
    accessible-role: progress-indicator;
    accessible-label: etichetta;
    accessible-value: valore;
    accessible-description: descrizione != "" ? descrizione : dettaglio;

    Etichetta {
        x: MisurePc.margine;
        y: 3px;
        height: 18px;
        text: etichetta;
    }

    // Il dettaglio si ferma prima della colonna del valore e della barra.
    Text {
        x: MisurePc.margine;
        y: 20px;
        width: max(0px, colonna-x - MisurePc.margine - 8px);
        text: dettaglio;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    if !con-glifo: Text {
        x: parent.width - MisurePc.margine - self.width;
        y: 2px;
        width: MisurePc.colonna;
        text: valore;
        horizontal-alignment: right;
        font-weight: 500;
        font-size: Tema.testo-titolo;
        color: Tema.testo;
    }

    // Con il glifo (batteria): glifo e valore insieme, a destra, sulla stessa linea di base.
    if con-glifo: HorizontalLayout {
        x: colonna-x;
        y: 2px;
        width: MisurePc.colonna;
        height: 20px;
        alignment: end;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            GlifoBatteria {
                frazione: root.frazione;
                tinta: root.tinta;
            }
        }

        Text {
            text: valore;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }
    }

    if frazione >= 0 && !senza-barra: Rectangle {
        x: colonna-x;
        y: 27px;
        width: MisurePc.colonna;
        height: 4px;
        border-radius: self.height / 2;
        background: Tema.traccia;

        Rectangle {
            x: 0;
            width: parent.width * min(max(frazione, 0), 1);
            border-radius: self.height / 2;
            background: (invertita ? frazione < 0.15 : frazione > 0.85) ? Tema.caldo-2 : colore;
        }
    }
}

// La riga del volume del PC (M2, Task 7; solo Windows con un'uscita audio, altrimenti non c'è):
// alta e impaginata come le altre righe (etichetta a sinistra; nella colonna del valore
// l'altoparlante e la percentuale in alto e il cursore al posto della barra). Il cursore è sempre
// visibile. Altoparlante: clic o Narrator = muto sì/no. Cursore: clic o trascinamento; la tastiera
// la tiene il pannello (←/→ ±2 punti, Home/Fine 0/100, Invio o Spazio muto sì/no), qui solo il
// fuoco vero (`fuoco`, per Narrator) e l'anello.
component RigaVolume inherits Rectangle {
    // 0..1 come lo dice Rust (l'ultimo stato letto, o l'ultimo comando dato da qui).
    in property <float> livello;
    in property <bool> muto;
    in property <bool> fuoco;
    callback imposta(float);
    callback cambia-muto(bool);
    // Durante il trascinamento il cursore segue il mouse, non gli stati che tornano da Windows
    // (arrivano in ritardo e lo farebbero tremare).
    property <bool> trascina: false;
    property <float> posizione;
    property <float> mostrato: trascina ? posizione : min(max(livello, 0), 1);
    property <int> pct: round(mostrato * 100);
    property <length> colonna-x: root.width - MisurePc.margine - MisurePc.colonna;
    property <length> lato-pomello: 12px;
    height: MisurePc.alto-riga;

    function al-punto(x: length) {
        posizione = round(min(max(x / MisurePc.colonna, 0), 1) * 100) / 100;
        root.imposta(posizione);
    }

    function passo(punti: int) {
        root.imposta(min(max((round(livello * 100) + punti) / 100, 0), 1));
    }

    Etichetta {
        x: MisurePc.margine;
        y: 3px;
        height: 18px;
        text: "VOLUME";
    }

    if muto: Text {
        x: MisurePc.margine;
        y: 20px;
        width: max(0px, colonna-x - MisurePc.margine - 10px);
        text: "Audio disattivato";
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
        accessible-role: none;
    }

    // L'altoparlante: bersaglio 28 × 22, icona 18, all'inizio della colonna del valore.
    Rectangle {
        x: colonna-x - 6px;
        y: 1px;
        width: 28px;
        height: 22px;
        border-radius: Tema.raggio-s;
        background: tocco-altoparlante.has-hover ? Tema.scheda-sopra : transparent;
        accessible-role: button;
        accessible-label: "Volume " + pct + "%" + (muto ? ", muto" : "");
        accessible-description: muto ? "Riattiva l'audio" : "Disattiva l'audio";
        accessible-action-default => { root.cambia-muto(!muto); }

        Image {
            width: 18px;
            height: 18px;
            source: muto ? Icone.altoparlante-muto : Icone.altoparlante;
            colorize: Tema.icona;
            image-rendering: smooth;
            accessible-role: none;
        }

        tocco-altoparlante := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cambia-muto(!muto); }
        }
    }

    Text {
        x: root.width - MisurePc.margine - self.width;
        y: 2px;
        width: 70px;
        text: pct + "%";
        horizontal-alignment: right;
        font-weight: 500;
        font-size: Tema.testo-titolo;
        color: muto ? Tema.testo-tenue : Tema.testo;
        accessible-role: none;
    }

    // Il cursore: traccia larga quanto la colonna dove le altre righe hanno la barra,
    // riempimento e pomello.
    cursore := Rectangle {
        x: colonna-x;
        y: 19px;
        width: MisurePc.colonna;
        height: 18px;
        accessible-role: slider;
        accessible-label: "Volume";
        accessible-description: "Invio: silenzia o riattiva";
        accessible-value: pct + "%";
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 2;
        accessible-action-increment => { passo(2); }
        accessible-action-decrement => { passo(-2); }
        accessible-action-set-value(v) => { root.imposta(min(max(v.to-float() / 100, 0), 1)); }

        fuoco-volume := Fuoco { chiede: fuoco; }

        Rectangle {
            y: 7px;
            height: 4px;
            border-radius: self.height / 2;
            background: Tema.traccia;

            if !muto: Rectangle {
                x: 0;
                width: parent.width * mostrato;
                border-radius: parent.border-radius;
                background: Tema.petalo-2;
            }
        }

        Rectangle {
            x: (parent.width - self.width) * mostrato;
            y: (parent.height - self.height) / 2;
            width: lato-pomello;
            height: lato-pomello;
            border-radius: self.height / 2;
            background: muto ? Tema.testo-tenue : Tema.testo;
        }

        // Più larga della traccia di mezzo pomello per lato: gli estremi si prendono bene.
        TouchArea {
            x: -6px;
            width: parent.width + 12px;
            mouse-cursor: pointer;
            pointer-event(evento) => {
                if (evento.button == PointerEventButton.left && evento.kind == PointerEventKind.down) {
                    trascina = true;
                    al-punto(self.mouse-x - 6px);
                } else if (evento.button == PointerEventButton.left && evento.kind == PointerEventKind.up) {
                    trascina = false;
                }
            }
            moved => {
                if (self.pressed) {
                    al-punto(self.mouse-x - 6px);
                }
            }
        }

        if fuoco: Anello { raggio: Tema.raggio-s; }
    }
}

// La riga della rete in «Connessioni»: etichetta, icona (cavo o Wi-Fi con le tacche, solo su
// Windows) e velocità. Per Narrator è testo: velocità e, se nota, la rete (mai il nome).
component RigaRete inherits Rectangle {
    in property <string> velocita;
    in property <bool> con-icona;
    in property <TipoReteUi> tipo;
    in property <int> tacche;
    height: 26px;
    accessible-role: text;
    accessible-label: "RETE";
    accessible-value: velocita + (con-icona ? ", " + NomeRete.di(tipo, tacche) : "");

    Etichetta {
        x: MisurePc.margine;
        height: parent.height;
        text: "RETE";
        accessible-role: none;
    }

    HorizontalLayout {
        x: MisurePc.margine + 44px;
        width: parent.width - 2 * MisurePc.margine - 44px;
        alignment: end;
        spacing: 6px;

        if con-icona: VerticalLayout {
            alignment: center;
            IconaRete {
                tipo: root.tipo;
                tacche: root.tacche;
            }
        }

        Text {
            text: velocita;
            overflow: elide;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-corpo;
            color: Tema.testo;
            accessible-role: none;
        }
    }
}

// Un riquadro Wi-Fi o Bluetooth (M2, Task 8): raggio 14, interruttore per Narrator (`switch`,
// acceso = `checked`). Acceso: fondo, bordo e icona nel token `radio-acceso`. Radio assente:
// «Non presente», spento e non cliccabile. Il clic e Invio li gira al pannello (`commuta`).
component Riquadro inherits Rectangle {
    in property <string> nome;
    in property <image> icona;
    // Stato letto (finché non è letto il riquadro dice «—» e non risponde).
    in property <bool> letto;
    in property <bool> presente;
    in property <bool> acceso;
    // La riga sotto il nome: il nome della rete, «Acceso», «Spento», «Non presente».
    in property <string> stato;
    in property <bool> fuoco;
    callback commuta();
    property <bool> attivo: letto && presente;
    border-radius: 14px;
    border-width: 1px;
    border-color: attivo && acceso ? Tema.radio-acceso-bordo : Tema.vetro-bordo;
    background: attivo && acceso ? Tema.radio-acceso-fondo
        : attivo && tocco.has-hover ? Tema.scheda-sopra : Tema.card-fondo;
    accessible-role: switch;
    accessible-label: nome;
    accessible-checked: attivo && acceso;
    accessible-enabled: attivo;
    accessible-description: stato;
    accessible-action-default => {
        if (attivo) {
            root.commuta();
        }
    }

    fuoco-riquadro := Fuoco { chiede: fuoco; }

    Image {
        x: 10px;
        y: 9px;
        width: 16px;
        height: 16px;
        source: icona;
        colorize: attivo && acceso ? Tema.radio-acceso : attivo ? Tema.icona : Tema.icona-spenta;
        image-rendering: smooth;
        accessible-role: none;
    }

    Text {
        x: 32px;
        y: 7px;
        width: parent.width - 32px - 8px;
        height: 20px;
        text: nome;
        overflow: elide;
        vertical-alignment: center;
        font-weight: 600;
        font-size: Tema.testo-corpo;
        color: attivo ? Tema.testo : Tema.testo-tenue;
        accessible-role: none;
    }

    Text {
        x: 10px;
        y: 31px;
        width: parent.width - 20px;
        height: 16px;
        text: stato;
        overflow: elide;
        vertical-alignment: center;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
        accessible-role: none;
    }

    tocco := TouchArea {
        enabled: attivo;
        mouse-cursor: attivo ? pointer : default;
        clicked => { root.commuta(); }
    }

    if fuoco: Anello { raggio: root.border-radius; }
}

// Una riga che apre una pagina di Windows («Reti Wi-Fi ›», «Dispositivi Bluetooth ›»): un
// collegamento per Narrator, bersaglio alto 24.
component Collegamento inherits Rectangle {
    in property <string> testo;
    in property <bool> fuoco;
    callback apri();
    width: scritta.preferred-width + 12px;
    height: 24px;
    border-radius: Tema.raggio-s;
    background: tocco.has-hover ? Tema.scheda-sopra : transparent;
    accessible-role: button;
    accessible-label: testo;
    accessible-description: "Apre le Impostazioni di Windows";
    accessible-action-default => { root.apri(); }

    fuoco-collegamento := Fuoco { chiede: fuoco; }

    scritta := Text {
        x: 6px;
        text: testo;
        vertical-alignment: center;
        font-size: Tema.testo-piccolo;
        font-weight: 500;
        color: Tema.testo-ora;
        accessible-role: none;
    }

    tocco := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.apri(); }
    }

    if fuoco: Anello { raggio: Tema.raggio-s; distanza: 0px; }
}

export component VistaPc inherits Rectangle {
    in property <StatPcUi> stat;
    // Il volume del PC (M2, Task 7): la riga c'è solo se disponibile (Windows con un'uscita
    // audio).
    in property <bool> volume-disponibile: false;
    in property <float> volume;
    in property <bool> volume-muto;
    // Le connessioni (M2, Task 8, solo Windows): riquadri e righe ci sono solo se disponibili.
    in property <bool> connessioni-disponibili: false;
    in property <bool> radio-lette;
    in property <bool> wifi-presente;
    in property <bool> wifi-acceso;
    in property <bool> bt-presente;
    in property <bool> bt-acceso;
    // Le cuffie Bluetooth (M2, Task 9, solo Windows): la riga c'è solo con almeno un dispositivo
    // connesso con la batteria leggibile; letta una volta entrando nella vista.
    in property <bool> cuffie-presenti: false;
    in property <string> cuffie-dettaglio;
    in property <string> cuffie-testo;
    in property <float> cuffie-frazione;
    in property <TintaBatteriaUi> cuffie-tinta: TintaBatteriaUi.normale;
    in property <string> cuffie-descrizione;
    // Il nome della rete Wi-Fi (solo qui, mai nella pillola né nei log); vuoto se non si sa.
    in property <string> nome-rete;
    in property <bool> rete-nota;
    in property <TipoReteUi> rete;
    in property <int> tacche;
    // Un cambio rifiutato da Windows: la riga in ambra.
    in property <bool> errore-radio;
    // Elemento col fuoco da tastiera del pannello (-1 nessuno): 0 volume, 1 Wi-Fi, 2 Bluetooth,
    // 3 «Reti Wi-Fi ›», 4 «Dispositivi Bluetooth ›».
    in property <int> fuoco: -1;
    callback imposta-volume(float);
    callback muto-volume(bool);
    // (0 Wi-Fi / 1 Bluetooth, acceso voluto).
    callback commuta-radio(int, bool);
    // 0 reti Wi-Fi, 1 Bluetooth.
    callback apri-pagina(int);

    out property <length> largo-colonna: 240px;
    property <string> stato-wifi: !radio-lette ? "—" : !wifi-presente ? "Non presente" : !wifi-acceso ? "Spento"
        : nome-rete != "" ? nome-rete : "Acceso";
    property <string> stato-bt: !radio-lette ? "—" : !bt-presente ? "Non presente" : bt-acceso ? "Acceso" : "Spento";

    Vetro {
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;

            // Sistema (la GPU del Task 10 andrà sotto il disco: c'è il posto per una riga).
            VerticalLayout {
                width: largo-colonna;
                alignment: start;
                accessible-role: groupbox;
                accessible-label: "Sistema";

                Intestazione { text: "Sistema"; }

                // Prima del primo campione i testi sono vuoti: «—» e niente barra, come nei
                // Quadranti e nell'Orologio.
                Riga {
                    etichetta: "CPU";
                    valore: stat.cpu-testo != "" ? stat.cpu-testo : "—";
                    frazione: stat.pronta ? stat.cpu : 0;
                }

                Riga {
                    etichetta: "RAM";
                    valore: stat.ram-testo != "" ? stat.ram-testo : "—";
                    dettaglio: stat.ram-dettaglio;
                    frazione: stat.ram-testo != "" ? stat.ram : -1;
                }

                Riga {
                    etichetta: "DISCO";
                    valore: stat.disco-testo != "" ? stat.disco-testo : "—";
                    dettaglio: stat.disco-dettaglio;
                    frazione: stat.disco-testo != "" ? stat.disco : -1;
                }
            }

            // Energia e audio.
            VerticalLayout {
                width: largo-colonna;
                alignment: start;
                accessible-role: groupbox;
                accessible-label: "Energia e audio";

                Intestazione { text: "Energia e audio"; }

                if stat.ha-batteria: Riga {
                    etichetta: "BATTERIA";
                    valore: stat.batteria-testo;
                    dettaglio: stat.in-carica ? "In carica" : "A batteria";
                    frazione: stat.batteria-frazione;
                    invertita: true;
                    con-glifo: true;
                    tinta: stat.tinta-batteria;
                }

                if volume-disponibile: RigaVolume {
                    livello: root.volume;
                    muto: root.volume-muto;
                    fuoco: root.fuoco == 0;
                    imposta(v) => { root.imposta-volume(v); }
                    cambia-muto(si) => { root.muto-volume(si); }
                }

                if cuffie-presenti: Riga {
                    etichetta: "CUFFIE";
                    valore: cuffie-testo;
                    dettaglio: cuffie-dettaglio;
                    descrizione: cuffie-descrizione;
                    frazione: cuffie-frazione;
                    senza-barra: true;
                    invertita: true;
                    con-glifo: true;
                    tinta: cuffie-tinta;
                }
            }

            // Connessioni.
            colonna-connessioni := VerticalLayout {
                alignment: start;
                accessible-role: groupbox;
                accessible-label: "Connessioni";

                Intestazione { text: "Connessioni"; }

                // Giù e su con lo stesso peso, sulla stessa riga (UX22). Frecce solo con un valore
                // accanto (mai «↓ » orfano).
                RigaRete {
                    velocita: stat.rete-giu == "" ? "—"
                        : stat.rete-su == "" ? "↓ " + stat.rete-giu
                        : "↓ " + stat.rete-giu + " · ↑ " + stat.rete-su;
                    con-icona: connessioni-disponibili && rete-nota;
                    tipo: root.rete;
                    tacche: root.tacche;
                }

                if connessioni-disponibili: VerticalLayout {
                    padding-left: MisurePc.margine - 2px;
                    padding-right: MisurePc.margine - 2px;
                    padding-top: 4px;
                    spacing: 6px;

                    riquadri := HorizontalLayout {
                        spacing: 8px;
                        height: 52px;

                        Riquadro {
                            nome: "Wi-Fi";
                            icona: Icone.wifi[3];
                            letto: root.radio-lette;
                            presente: root.wifi-presente;
                            acceso: root.wifi-acceso;
                            stato: root.stato-wifi;
                            fuoco: root.fuoco == 1;
                            commuta => { root.commuta-radio(0, !root.wifi-acceso); }
                        }

                        Riquadro {
                            nome: "Bluetooth";
                            icona: Icone.bluetooth;
                            letto: root.radio-lette;
                            presente: root.bt-presente;
                            acceso: root.bt-acceso;
                            stato: root.stato-bt;
                            fuoco: root.fuoco == 2;
                            commuta => { root.commuta-radio(1, !root.bt-acceso); }
                        }
                    }

                    collegamenti := HorizontalLayout {
                        alignment: space-between;
                        height: 24px;

                        Collegamento {
                            testo: "Reti Wi-Fi ›";
                            fuoco: root.fuoco == 3;
                            apri => { root.apri-pagina(0); }
                        }

                        Collegamento {
                            testo: "Dispositivi Bluetooth ›";
                            fuoco: root.fuoco == 4;
                            apri => { root.apri-pagina(1); }
                        }
                    }

                    // Un cambio rifiutato: in ambra, e la pagina giusta di Windows è già aperta.
                    if errore-radio: errore := Text {
                        text: "Non riuscito: apro le Impostazioni di Windows";
                        wrap: word-wrap;
                        font-size: Tema.testo-piccolo;
                        color: Tema.attenzione;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }
            }
        }
    }
}
