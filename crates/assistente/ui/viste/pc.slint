// Vista PC, la «card del PC»: l'elenco dettagliato delle statistiche (CPU, RAM, disco, rete,
// batteria se c'è) e i comandi del PC (M2, Task 7: il volume; poi Wi-Fi/Bluetooth, cuffie, GPU).
import { Tema } from "../tema.slint";
import { Icone, Icona, Vetro } from "../icone.slint";
import { StatPcUi, TintaBatteriaUi } from "../voci.slint";
import { Etichetta, GlifoBatteria, Fuoco, Anello } from "../componenti.slint";

// Una riga: etichetta, valore e (se serve) una barra sottile con la frazione usata.
component Riga inherits Rectangle {
    in property <string> etichetta;
    in property <string> valore;
    in property <string> dettaglio;
    in property <float> frazione: -1;
    in property <color> colore: Tema.petalo-2;
    // Batteria: l'avviso scatta quando è quasi scarica, non quando è piena.
    in property <bool> invertita: false;
    // Batteria: glifo accanto al valore, con la sua tinta (vedi `GlifoBatteria`).
    in property <bool> con-glifo: false;
    in property <TintaBatteriaUi> tinta: TintaBatteriaUi.normale;
    height: 44px;
    // Per Narrator: nome, valore e dettaglio (FE16).
    accessible-role: progress-indicator;
    accessible-label: etichetta;
    accessible-value: valore;
    accessible-description: dettaglio;

    Etichetta {
        x: 14px;
        y: 7px;
        text: etichetta;
    }

    // Il dettaglio si ferma prima della colonna del valore e della barra.
    Text {
        x: 14px;
        y: 24px;
        width: max(0px, parent.width - 14px - 150px - 22px);
        text: dettaglio;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    // Il valore: largo quanto la barra; senza barra (rete) può prendersi tutta la riga dopo
    // l'etichetta, così «↓ 1,6 KB/s · ↑ 286 B/s» sta su una riga sola.
    if !con-glifo: Text {
        x: parent.width - 14px - self.width;
        y: 7px;
        width: frazione >= 0 ? 150px : max(150px, parent.width - 28px - 110px);
        text: valore;
        horizontal-alignment: right;
        font-weight: 500;
        font-size: Tema.testo-titolo;
        color: Tema.testo;
    }

    // Con il glifo (batteria): glifo e valore insieme, a destra, sulla stessa linea di base.
    if con-glifo: HorizontalLayout {
        x: parent.width - 14px - 150px;
        y: 7px;
        width: 150px;
        height: 22px;
        alignment: end;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            GlifoBatteria {
                frazione: root.frazione;
                tinta: root.tinta;
            }
        }

        Text {
            text: valore;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }
    }

    if frazione >= 0: Rectangle {
        x: parent.width - 14px - 150px;
        y: 29px;
        width: 150px;
        height: 4px;
        border-radius: self.height / 2;
        background: Tema.traccia;

        Rectangle {
            x: 0;
            width: parent.width * min(max(frazione, 0), 1);
            border-radius: self.height / 2;
            background: (invertita ? frazione < 0.15 : frazione > 0.85) ? Tema.caldo-2 : colore;
        }
    }
}

// La riga del volume del PC (M2, Task 7; solo Windows con un'uscita audio, altrimenti non c'è):
// alta e impaginata come le altre righe (etichetta a sinistra; nella colonna del valore,
// larga 150, l'altoparlante e la percentuale in alto e il cursore al posto della barra). Il cursore
// è sempre visibile. Altoparlante: clic o Narrator = muto sì/no. Cursore: clic o trascinamento;
// la tastiera la tiene il pannello (←/→ ±2 punti, Home/Fine 0/100, Invio o Spazio muto sì/no),
// qui solo il fuoco vero (`fuoco`, per Narrator) e l'anello.
component RigaVolume inherits Rectangle {
    // 0..1 come lo dice Rust (l'ultimo stato letto, o l'ultimo comando dato da qui).
    in property <float> livello;
    in property <bool> muto;
    in property <bool> fuoco;
    callback imposta(float);
    callback cambia-muto(bool);
    // Durante il trascinamento il cursore segue il mouse, non gli stati che tornano da Windows
    // (arrivano in ritardo e lo farebbero tremare).
    property <bool> trascina: false;
    property <float> posizione;
    property <float> mostrato: trascina ? posizione : min(max(livello, 0), 1);
    property <int> pct: round(mostrato * 100);
    property <length> colonna-x: root.width - 14px - 150px;
    property <length> lato-pomello: 12px;
    height: 44px;

    function al-punto(x: length) {
        posizione = round(min(max(x / 150px, 0), 1) * 100) / 100;
        root.imposta(posizione);
    }

    function passo(punti: int) {
        root.imposta(min(max((round(livello * 100) + punti) / 100, 0), 1));
    }

    Etichetta {
        x: 14px;
        y: 7px;
        text: "VOLUME";
    }

    if muto: Text {
        x: 14px;
        y: 24px;
        width: max(0px, colonna-x - 14px - 22px);
        text: "Audio disattivato";
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
        accessible-role: none;
    }

    // L'altoparlante: bersaglio 28 × 24, icona 18, all'inizio della colonna del valore.
    Rectangle {
        x: colonna-x - 6px;
        y: 4px;
        width: 28px;
        height: 24px;
        border-radius: Tema.raggio-s;
        background: tocco-altoparlante.has-hover ? Tema.scheda-sopra : transparent;
        accessible-role: button;
        accessible-label: "Volume " + pct + "%" + (muto ? ", muto" : "");
        accessible-description: muto ? "Riattiva l'audio" : "Disattiva l'audio";
        accessible-action-default => { root.cambia-muto(!muto); }

        Image {
            width: 18px;
            height: 18px;
            source: muto ? Icone.altoparlante-muto : Icone.altoparlante;
            colorize: Tema.icona;
            image-rendering: smooth;
            accessible-role: none;
        }

        tocco-altoparlante := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cambia-muto(!muto); }
        }
    }

    Text {
        x: root.width - 14px - self.width;
        y: 7px;
        width: 100px;
        text: pct + "%";
        horizontal-alignment: right;
        font-weight: 500;
        font-size: Tema.testo-titolo;
        color: muto ? Tema.testo-tenue : Tema.testo;
        accessible-role: none;
    }

    // Il cursore: traccia 150 × 4 dove le altre righe hanno la barra, riempimento e pomello.
    cursore := Rectangle {
        x: colonna-x;
        y: 21px;
        width: 150px;
        height: 20px;
        accessible-role: slider;
        accessible-label: "Volume";
        accessible-value: pct + "%";
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 2;
        accessible-action-increment => { passo(2); }
        accessible-action-decrement => { passo(-2); }
        accessible-action-set-value(v) => { root.imposta(min(max(v.to-float() / 100, 0), 1)); }

        fuoco-volume := Fuoco { chiede: fuoco; }

        Rectangle {
            y: 8px;
            height: 4px;
            border-radius: self.height / 2;
            background: Tema.traccia;

            if !muto: Rectangle {
                x: 0;
                width: parent.width * mostrato;
                border-radius: parent.border-radius;
                background: Tema.petalo-2;
            }
        }

        Rectangle {
            x: (parent.width - self.width) * mostrato;
            y: (parent.height - self.height) / 2;
            width: lato-pomello;
            height: lato-pomello;
            border-radius: self.height / 2;
            background: muto ? Tema.testo-tenue : Tema.testo;
        }

        // Più larga della traccia di mezzo pomello per lato: gli estremi si prendono bene.
        TouchArea {
            x: -6px;
            width: parent.width + 12px;
            mouse-cursor: pointer;
            pointer-event(evento) => {
                if (evento.button == PointerEventButton.left && evento.kind == PointerEventKind.down) {
                    trascina = true;
                    al-punto(self.mouse-x - 6px);
                } else if (evento.button == PointerEventButton.left && evento.kind == PointerEventKind.up) {
                    trascina = false;
                }
            }
            moved => {
                if (self.pressed) {
                    al-punto(self.mouse-x - 6px);
                }
            }
        }

        if fuoco: Anello { raggio: Tema.raggio-s; }
    }
}

export component VistaPc inherits Rectangle {
    in property <StatPcUi> stat;
    // Il volume del PC (M2, Task 7): la riga c'è solo se disponibile (Windows con un'uscita
    // audio); `fuoco-volume`: il cursore ha il fuoco da tastiera del pannello.
    in property <bool> volume-disponibile: false;
    in property <float> volume;
    in property <bool> volume-muto;
    in property <bool> fuoco-volume;
    callback imposta-volume(float);
    callback muto-volume(bool);
    property <length> alto-riga: 44px;

    // Pannello basso: le righe stanno su due colonne (PC a sinistra, rete, batteria e volume a destra),
    // tre posti per colonna distribuiti su tutta l'altezza della card (UX22: niente terzo
    // inferiore vuoto) e allineati fra le colonne (i posti senza riga restano vuoti).
    Vetro {
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: space-around;

                // Prima del primo campione i testi sono vuoti: «—» e niente barra, come nei
                // Quadranti e nell'Orologio.
                Riga {
                    etichetta: "CPU";
                    valore: stat.cpu-testo != "" ? stat.cpu-testo : "—";
                    frazione: stat.pronta ? stat.cpu : 0;
                }

                Riga {
                    etichetta: "RAM";
                    valore: stat.ram-testo != "" ? stat.ram-testo : "—";
                    dettaglio: stat.ram-dettaglio;
                    frazione: stat.ram-testo != "" ? stat.ram : -1;
                }

                Riga {
                    etichetta: "DISCO";
                    valore: stat.disco-testo != "" ? stat.disco-testo : "—";
                    dettaglio: stat.disco-dettaglio;
                    frazione: stat.disco-testo != "" ? stat.disco : -1;
                }
            }

            VerticalLayout {
                alignment: space-around;

                // Giù e su con lo stesso peso, sulla stessa riga (UX22). Frecce solo con un valore
                // accanto (mai «↓ » orfano).
                Riga {
                    etichetta: "RETE";
                    // Una velocità, non un avanzamento: per Narrator è testo.
                    accessible-role: text;
                    valore: stat.rete-giu == "" ? "—"
                        : stat.rete-su == "" ? "↓ " + stat.rete-giu
                        : "↓ " + stat.rete-giu + " · ↑ " + stat.rete-su;
                }

                if stat.ha-batteria: Riga {
                    etichetta: "BATTERIA";
                    valore: stat.batteria-testo;
                    dettaglio: stat.in-carica ? "In carica" : "A batteria";
                    frazione: stat.batteria-frazione;
                    invertita: true;
                    con-glifo: true;
                    tinta: stat.tinta-batteria;
                }

                if volume-disponibile: RigaVolume {
                    livello: root.volume;
                    muto: root.volume-muto;
                    fuoco: root.fuoco-volume;
                    imposta(v) => { root.imposta-volume(v); }
                    cambia-muto(si) => { root.muto-volume(si); }
                }

                // Posti vuoti: le righe restano allineate a quelle della colonna del PC (tre posti
                // per colonna).
                if !stat.ha-batteria && !volume-disponibile: Rectangle { height: alto-riga; }
                if !(stat.ha-batteria && volume-disponibile): Rectangle { height: alto-riga; }
            }
        }
    }
}
