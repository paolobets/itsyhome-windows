// Vista PC: l'elenco dettagliato delle statistiche (CPU, RAM, disco, rete, batteria se c'è).
import { Tema } from "../tema.slint";
import { Icone, Icona, Vetro } from "../icone.slint";
import { StatPcUi, TintaBatteriaUi } from "../voci.slint";
import { Etichetta, GlifoBatteria } from "../componenti.slint";

// Una riga: etichetta, valore e (se serve) una barra sottile con la frazione usata.
component Riga inherits Rectangle {
    in property <string> etichetta;
    in property <string> valore;
    in property <string> dettaglio;
    in property <float> frazione: -1;
    in property <color> colore: Tema.petalo-2;
    // Batteria: l'avviso scatta quando è quasi scarica, non quando è piena.
    in property <bool> invertita: false;
    // Batteria: glifo accanto al valore, con la sua tinta (vedi `GlifoBatteria`).
    in property <bool> con-glifo: false;
    in property <TintaBatteriaUi> tinta: TintaBatteriaUi.normale;
    height: 44px;
    // Per Narrator: nome, valore e dettaglio (FE16).
    accessible-role: progress-indicator;
    accessible-label: etichetta;
    accessible-value: valore;
    accessible-description: dettaglio;

    Etichetta {
        x: 14px;
        y: 7px;
        text: etichetta;
    }

    // Il dettaglio si ferma prima della colonna del valore e della barra.
    Text {
        x: 14px;
        y: 24px;
        width: max(0px, parent.width - 14px - 150px - 22px);
        text: dettaglio;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    // Il valore: largo quanto la barra; senza barra (rete) può prendersi tutta la riga dopo
    // l'etichetta, così «↓ 1,6 KB/s · ↑ 286 B/s» sta su una riga sola.
    if !con-glifo: Text {
        x: parent.width - 14px - self.width;
        y: 7px;
        width: frazione >= 0 ? 150px : max(150px, parent.width - 28px - 110px);
        text: valore;
        horizontal-alignment: right;
        font-weight: 500;
        font-size: Tema.testo-titolo;
        color: Tema.testo;
    }

    // Con il glifo (batteria): glifo e valore insieme, a destra, sulla stessa linea di base.
    if con-glifo: HorizontalLayout {
        x: parent.width - 14px - 150px;
        y: 7px;
        width: 150px;
        height: 22px;
        alignment: end;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            GlifoBatteria {
                frazione: root.frazione;
                tinta: root.tinta;
            }
        }

        Text {
            text: valore;
            vertical-alignment: center;
            font-weight: 500;
            font-size: Tema.testo-titolo;
            color: Tema.testo;
        }
    }

    if frazione >= 0: Rectangle {
        x: parent.width - 14px - 150px;
        y: 29px;
        width: 150px;
        height: 4px;
        border-radius: self.height / 2;
        background: Tema.traccia;

        Rectangle {
            x: 0;
            width: parent.width * min(max(frazione, 0), 1);
            border-radius: self.height / 2;
            background: (invertita ? frazione < 0.15 : frazione > 0.85) ? Tema.caldo-2 : colore;
        }
    }
}

export component VistaPc inherits Rectangle {
    in property <StatPcUi> stat;
    property <length> alto-riga: 44px;

    // Pannello basso: le righe stanno su due colonne (PC a sinistra, rete e batteria a destra),
    // tre posti per colonna distribuiti su tutta l'altezza della card (UX22: niente terzo
    // inferiore vuoto) e allineati fra le colonne (i posti senza riga restano vuoti).
    Vetro {
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: space-around;

                // Prima del primo campione i testi sono vuoti: «—» e niente barra, come nei
                // Quadranti e nell'Orologio.
                Riga {
                    etichetta: "CPU";
                    valore: stat.cpu-testo != "" ? stat.cpu-testo : "—";
                    frazione: stat.pronta ? stat.cpu : 0;
                }

                Riga {
                    etichetta: "RAM";
                    valore: stat.ram-testo != "" ? stat.ram-testo : "—";
                    dettaglio: stat.ram-dettaglio;
                    frazione: stat.ram-testo != "" ? stat.ram : -1;
                }

                Riga {
                    etichetta: "DISCO";
                    valore: stat.disco-testo != "" ? stat.disco-testo : "—";
                    dettaglio: stat.disco-dettaglio;
                    frazione: stat.disco-testo != "" ? stat.disco : -1;
                }
            }

            VerticalLayout {
                alignment: space-around;

                // Giù e su con lo stesso peso, sulla stessa riga (UX22). Frecce solo con un valore
                // accanto (mai «↓ » orfano).
                Riga {
                    etichetta: "RETE";
                    // Una velocità, non un avanzamento: per Narrator è testo.
                    accessible-role: text;
                    valore: stat.rete-giu == "" ? "—"
                        : stat.rete-su == "" ? "↓ " + stat.rete-giu
                        : "↓ " + stat.rete-giu + " · ↑ " + stat.rete-su;
                }

                if stat.ha-batteria: Riga {
                    etichetta: "BATTERIA";
                    valore: stat.batteria-testo;
                    dettaglio: stat.in-carica ? "In carica" : "A batteria";
                    frazione: stat.batteria-frazione;
                    invertita: true;
                    con-glifo: true;
                    tinta: stat.tinta-batteria;
                }

                // Posti vuoti: le righe restano allineate a quelle della colonna del PC.
                if !stat.ha-batteria: Rectangle { height: alto-riga; }
                Rectangle { height: alto-riga; }
            }
        }
    }
}
