// Layout Tutte le app: griglia di card con le sole app che esistono (`app_disponibili()`).
import { Tema } from "../tema.slint";
import { Icona, Vetro } from "../icone.slint";
import { VoceAppUi } from "../voci.slint";

export component LayoutTutte inherits Rectangle {
    in property <[VoceAppUi]> app;
    callback apri-app(string);

    property <int> colonne: 4;
    property <length> spazio: 10px;
    property <length> lato: (self.width - (colonne - 1) * spazio) / colonne;

    for voce[i] in app: Vetro {
        x: mod(i, colonne) * (lato + spazio);
        y: floor(i / colonne) * (122px + spazio);
        width: lato;
        height: 122px;
        background: area.has-hover
            ? @linear-gradient(160deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.04) 100%)
            : @linear-gradient(160deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 100%);
        accessible-role: button;
        accessible-label: voce.nome;
        accessible-action-default => { root.apri-app(voce.id); }

        Icona {
            x: 12px;
            y: 12px;
            source: voce.icona;
            width: 38px;
            height: 38px;
        }

        Text {
            x: 12px;
            y: 12px + 38px + 9px;
            text: voce.nome;
            font-weight: 500;
            font-size: 13.5px;
            color: Tema.testo;
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.apri-app(voce.id); }
        }
    }
}
