// Layout Orologio della Panoramica (bozza bozza-in-attesa.html): a sinistra l'ora grande e la
// data, a destra una riga di stato per app (Casa, PC). Solo sintesi, nessun comando.
import { Tema } from "../tema.slint";
import { Anello } from "../componenti.slint";
import { StatPcUi, Bersaglio } from "../voci.slint";

export component LayoutOrologio inherits Rectangle {
    in property <string> ora;
    in property <string> data;
    // Riga della casa (vedi `ponte::riga_stato`) e se la casa è connessa coi dati.
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    in property <StatPcUi> pc;
    // Ci sono luci accese: la riga della casa si può cliccare e porta alla Casa filtrata sulle luci
    // accese (il «›» in fondo lo dice).
    in property <bool> luci-cliccabili;
    // Casa non configurata: la riga è un invito («Collega la casa ›») che porta alle Impostazioni.
    in property <bool> casa-invito;
    // Il fuoco da tastiera è sulla riga (anello visibile).
    in property <bool> anello-luci;
    // Dove sta la riga della casa (il bersaglio del clic), nelle coordinate del layout: il
    // pannello ci mette il pulsante accessibile e il fuoco da tastiera (`fuoco-luci-el`), così
    // Narrator evidenzia la riga e non tutta la Panoramica.
    // Somma delle posizioni dei layout che la contengono (niente `absolute-position`: il pannello
    // la legge appena il layout nasce, quando la catena degli antenati non è ancora pronta).
    out property <Bersaglio> bersaglio: {
        x: fila.x + colonna-stato.x + riga-casa-elemento.x,
        y: fila.y + colonna-stato.y + riga-casa-elemento.y + (riga-casa-elemento.height - max(24px, riga-casa-elemento.height)) / 2,
        larghezza: riga-casa-elemento.width,
        altezza: max(24px, riga-casa-elemento.height),
    };
    callback apri-luci();

    // Con la casa connessa la riga dice solo i fatti ("2 luci accese · 21.5 °C"): le si mette
    // davanti il nome; gli altri stati ("Casa non connessa", …) lo contengono già.
    property <bool> cliccabile: luci-cliccabili || casa-invito;
    property <string> riga-casa: casa-invito ? "Collega la casa" : casa-pronta ? "Casa · " + stato-casa : stato-casa;
    property <string> riga-pc: "PC · CPU " + (pc.pronta ? pc.cpu-testo : "—")
        + " · RAM " + (pc.ram-testo != "" ? pc.ram-testo : "—");
    // La colonna di stato è larga quanto la sua riga più lunga (fra 160 e 340): con un minimo
    // fisso di 220 il blocco ora + stato restava spostato a sinistra.
    property <length> largo-stato: min(340px, max(160px, max(misura-casa.preferred-width + (cliccabile ? 14px : 0px), misura-pc.preferred-width)));

    // Solo per misurare le due righe (mai disegnate).
    misura-casa := Text {
        visible: false;
        accessible-role: none;
        text: riga-casa;
        font-size: Tema.testo-corpo;
    }

    misura-pc := Text {
        visible: false;
        accessible-role: none;
        text: riga-pc;
        font-size: Tema.testo-corpo;
    }

    fila := HorizontalLayout {
        alignment: center;
        spacing: 40px;

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            Text {
                text: ora;
                font-family: Tema.carattere;
                font-weight: 500;
                font-size: Tema.testo-ora-grande;
                letter-spacing: -1.5px;
                color: Tema.ora-grande;
            }

            Text {
                text: data;
                font-size: Tema.testo-corpo;
                color: Tema.testo-tenue;
            }
        }

        colonna-stato := VerticalLayout {
            alignment: center;
            spacing: 8px;

            riga-casa-elemento := HorizontalLayout {
                // Larghezza fissa della colonna: una riga lunga si accorcia invece di spingere l'ora.
                min-width: largo-stato;
                max-width: largo-stato;
                spacing: 4px;
                alignment: start;

                Text {
                    text: riga-casa;
                    overflow: elide;
                    font-size: Tema.testo-corpo;
                    // L'invito ha il verde acqua dell'azione: è l'unica cosa da fare.
                    color: casa-invito ? Tema.petalo-5 : Tema.testo-ora;
                }

                // Il «›» che dice che la riga si apre: a parte, così non si accorcia coi testi lunghi
                // e Narrator non lo legge.
                if cliccabile: Text {
                    accessible-role: none;
                    horizontal-stretch: 0;
                    text: "›";
                    font-size: Tema.testo-corpo;
                    color: casa-invito ? Tema.petalo-5 : Tema.testo-ora;
                }
            }

            Text {
                min-width: largo-stato;
                max-width: largo-stato;
                text: riga-pc;
                overflow: elide;
                font-size: Tema.testo-corpo;
                color: Tema.testo-ora;
            }
        }
    }

    // Il clic sulla riga della casa, sopra il testo (che sta in un layout: se ne prende il posto
    // in coordinate assolute). Un bersaglio di 24 px almeno in altezza (WCAG 2.2). Solo mouse: il
    // pulsante per Narrator è `fuoco-luci-el` del pannello, sullo stesso posto (uno solo).
    if cliccabile: TouchArea {
        x: bersaglio.x;
        y: bersaglio.y;
        width: bersaglio.larghezza;
        height: bersaglio.altezza;
        mouse-cursor: pointer;
        clicked => { root.apri-luci(); }

        if anello-luci: Anello { raggio: 6px; distanza: 2px; }
    }
}
