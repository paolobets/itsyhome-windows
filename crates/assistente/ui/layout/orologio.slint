// Layout Orologio: l'ora grande, poi la data e una riga di stato della casa (come nella bozza:
// "Venerdì 13 novembre · 2 luci accese · 21.5 °C").
import { Tema } from "../tema.slint";

export component LayoutOrologio inherits Rectangle {
    in property <string> ora;
    in property <string> data;
    in property <string> stato;

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-bottom: 24px;

        Text {
            text: ora;
            horizontal-alignment: center;
            font-family: Tema.carattere;
            font-weight: 500;
            font-size: 88px;
            letter-spacing: -2.5px;
            color: @linear-gradient(90deg, #e9d5ff 0%, #a5b4fc 50%, #67e8f9 100%);
        }

        Text {
            text: stato == "" ? data : data + " · " + stato;
            horizontal-alignment: center;
            font-size: 13px;
            color: Tema.testo-tenue;
        }
    }
}
