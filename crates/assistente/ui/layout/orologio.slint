// Layout Orologio della Panoramica (bozza bozza-in-attesa.html): a sinistra l'ora grande e la
// data, a destra una riga di stato per app (Casa, PC). Solo sintesi, nessun comando.
import { Tema } from "../tema.slint";
import { StatPcUi } from "../voci.slint";

export component LayoutOrologio inherits Rectangle {
    in property <string> ora;
    in property <string> data;
    // Riga della casa (vedi `ponte::riga_stato`) e se la casa è connessa coi dati.
    in property <string> stato-casa;
    in property <bool> casa-pronta;
    in property <StatPcUi> pc;

    // Con la casa connessa la riga dice solo i fatti ("2 luci accese · 21.5 °C"): le si mette
    // davanti il nome; gli altri stati ("Casa non connessa", …) lo contengono già.
    property <string> riga-casa: casa-pronta ? "Casa · " + stato-casa : stato-casa;
    property <string> riga-pc: "PC · CPU " + (pc.pronta ? pc.cpu-testo : "—")
        + " · RAM " + (pc.ram-testo != "" ? pc.ram-testo : "—");
    // La colonna di stato è larga quanto la sua riga più lunga (fra 160 e 340): con un minimo
    // fisso di 220 il blocco ora + stato restava spostato a sinistra.
    property <length> largo-stato: min(340px, max(160px, max(misura-casa.preferred-width, misura-pc.preferred-width)));

    // Solo per misurare le due righe (mai disegnate).
    misura-casa := Text {
        visible: false;
        text: riga-casa;
        font-size: Tema.testo-corpo;
    }

    misura-pc := Text {
        visible: false;
        text: riga-pc;
        font-size: Tema.testo-corpo;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 40px;

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            Text {
                text: ora;
                font-family: Tema.carattere;
                font-weight: 500;
                font-size: Tema.testo-ora-grande;
                letter-spacing: -1.5px;
                color: Tema.ora-grande;
            }

            Text {
                text: data;
                font-size: Tema.testo-corpo;
                color: Tema.testo-tenue;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                // Larghezza fissa della colonna: una riga lunga si accorcia invece di spingere l'ora.
                min-width: largo-stato;
                max-width: largo-stato;
                text: riga-casa;
                overflow: elide;
                font-size: Tema.testo-corpo;
                color: Tema.testo-ora;
            }

            Text {
                min-width: largo-stato;
                max-width: largo-stato;
                text: riga-pc;
                overflow: elide;
                font-size: Tema.testo-corpo;
                color: Tema.testo-ora;
            }
        }
    }
}
