// Layout Quadranti della Panoramica: tre quadranti configurabili (Impostazioni › Isola; di serie
// CPU, RAM e disco del PC come in M1) e fino a 3 sensori fra i preferiti della casa (senza
// sensori, un quadrante CASA con lo stato). Solo sintesi, nessun comando.
// Senza dati l'arco è solo la traccia spenta e il valore è "—": nessun numero inventato.
import { Tema } from "../tema.slint";
import { Icone, Icona, Vetro } from "../icone.slint";
import { StatPcUi, SensoreUi, QuadranteUi, FonteQuadranteUi } from "../voci.slint";
import { Anello, Etichetta } from "../componenti.slint";

component Quadrante inherits Vetro {
    in property <string> etichetta;
    in property <image> icona;
    in property <string> valore: "—";
    // Riga piccola sotto l'etichetta (nome del sensore, stato della casa).
    in property <string> dettaglio;
    // Frazione 0..1 dell'arco acceso; negativa = nessun dato (solo la traccia).
    in property <float> frazione: -1;
    // Lato dell'arco: 96 px, meno quando sopra c'è la riga «In attesa».
    in property <length> arco: 96px;
    // Valore vecchio (casa non connessa): colori tenui ma leggibili (FE18: il valore in
    // testo-tenue pieno, circa 7:1 sulla card, invece di `opacity` 0,55 che dava 2,9:1).
    in property <bool> tenue;
    // Il quadrante si clicca (solo il quadrante CASA con luci accese, o da configurare): un TouchArea
    // su tutta la card.
    in property <bool> cliccabile;
    // Il clic porta alle Impostazioni (casa non configurata) invece che alle luci accese.
    in property <bool> invito;
    // L'arco diventa caldo sopra questa frazione: 85 % per il PC, la soglia d'avviso dell'utente
    // per i limiti e la spesa di Claude (RC-44).
    in property <float> caldo-da: 0.85;
    // Il fuoco da tastiera è sul quadrante (anello visibile).
    in property <bool> anello;
    callback clic();

    // Per Narrator: un indicatore col nome (etichetta e dettaglio) e il valore (FE16).
    accessible-role: progress-indicator;
    accessible-label: dettaglio == "" ? etichetta : etichetta + ", " + dettaglio;
    accessible-value: invito ? "" : valore;
    accessible-description: tenue ? "non aggiornato" : "";

    // Arco di 270° aperto in basso (raggio 44, centro 55,55 nel riquadro 110 × 110, disegnato a
    // `arco` px): parte da 135° e gira in senso orario.
    property <angle> fine: 135deg + 270deg * min(frazione, 1);
    property <bool> acceso: frazione >= 0.01;

    VerticalLayout {
        alignment: center;
        spacing: arco < 90px ? 4px : 8px;
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            height: arco;

            // L'invito non è un indicatore vuoto: la casa in verde acqua al posto dell'arco.
            if invito: Icona {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                source: icona;
                colorize: Tema.petalo-5;
            }

            if !invito: Path {
                x: (parent.width - arco) / 2;
                width: arco;
                height: arco;
                viewbox-width: 110;
                viewbox-height: 110;
                commands: "M 23.89 86.11 A 44 44 0 1 1 86.11 86.11";
                stroke: Tema.traccia;
                stroke-width: arco < 90px ? 7px : 8px;
                stroke-line-cap: round;
            }

            if acceso && !invito: Path {
                x: (parent.width - arco) / 2;
                width: arco;
                height: arco;
                viewbox-width: 110;
                viewbox-height: 110;
                commands: "M 23.89 86.11 A 44 44 0 " + (frazione > 0.6667 ? 1 : 0) + " 1 " + (55 + 44 * cos(fine)) + " " + (55 + 44 * sin(fine));
                stroke: tenue ? Tema.icona-spenta : Tema.oltre-soglia(frazione, caldo-da) ? Tema.caldo-2 : Tema.petalo-2;
                stroke-width: arco < 90px ? 7px : 8px;
                stroke-line-cap: round;
            }

            // Dentro l'arco: largo quanto lui, più piccolo se il valore è lungo («1013,2 hPa»,
            // «Non disponibile»), accorciato se non ci sta comunque.
            if !invito: Text {
                x: (parent.width - self.width) / 2;
                width: arco - 16px;
                text: valore;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                font-weight: 500;
                font-size: arco < 90px || valore.character-count > 5 ? Tema.testo-titolo : Tema.testo-intestazione;
                color: tenue ? Tema.testo-tenue : Tema.testo;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            Icona {
                source: icona;
                width: 16px;
                height: 16px;
                colorize: tenue ? Tema.icona-spenta : Tema.icona;
                y: (parent.height - self.height) / 2;
            }

            Etichetta {
                text: etichetta;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                // Un nome lungo si accorcia invece di allargare la card; l'«›» sta subito dopo.
                max-width: root.width - 16px - (cliccabile ? 12px : 0px);
                text: dettaglio;
                horizontal-alignment: center;
                overflow: elide;
                font-size: Tema.testo-piccolo;
                color: invito ? Tema.petalo-5 : Tema.testo-tenue;
            }

            // Il «›» che dice che il quadrante si apre: a parte, non si accorcia e Narrator non lo legge.
            if cliccabile: Text {
                accessible-role: none;
                horizontal-stretch: 0;
                text: "›";
                font-size: Tema.testo-piccolo;
                color: invito ? Tema.petalo-5 : Tema.testo-tenue;
            }
        }
    }

    if cliccabile: TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: etichetta + ", " + dettaglio + (invito ? ": apri le Impostazioni" : ": mostra le luci accese");
        accessible-action-default => { root.clic(); }
        clicked => { root.clic(); }

    }

    if cliccabile && anello: Anello { raggio: Tema.raggio-xl; distanza: -3px; }
}

export component LayoutQuadranti inherits Rectangle {
    in property <StatPcUi> stat;
    in property <[SensoreUi]> sensori;
    // I quadranti configurabili (solo quelli da mostrare: «niente» non c'è) e l'ora del pannello.
    in property <[QuadranteUi]> quadranti;
    in property <string> ora;
    in property <string> stato-casa;
    // Casa connessa coi dati: altrimenti i valori dei sensori sono vecchi e si mostrano tenui.
    in property <bool> casa-pronta;
    // Ci sono luci accese: il quadrante CASA (quello senza sensori, che dice «N luci accese») si
    // può cliccare e porta alla Casa filtrata sulle luci accese.
    in property <bool> luci-cliccabili;
    // Casa non configurata: il quadrante CASA invita a collegarla e porta alle Impostazioni.
    in property <bool> casa-invito;
    in property <bool> anello-luci;
    callback apri-luci();

    property <int> quanti: quadranti.length + max(1, sensori.length);

    // Valore, arco e icona di un quadrante configurabile: per il PC e l'ora li legge da qui, per
    // meteo e sensori li ha già scritti Rust.
    pure function valore-di(q: QuadranteUi) -> string {
        if (q.fonte == FonteQuadranteUi.cpu) {
            return stat.pronta ? stat.cpu-testo : "—";
        } else if (q.fonte == FonteQuadranteUi.ram) {
            return stat.ram-testo != "" ? stat.ram-testo : "—";
        } else if (q.fonte == FonteQuadranteUi.disco) {
            return stat.disco-testo != "" ? stat.disco-testo : "—";
        } else if (q.fonte == FonteQuadranteUi.rete-giu) {
            return stat.rete-giu != "" ? stat.rete-giu : "—";
        } else if (q.fonte == FonteQuadranteUi.rete-su) {
            return stat.rete-su != "" ? stat.rete-su : "—";
        } else if (q.fonte == FonteQuadranteUi.batteria) {
            return stat.ha-batteria ? stat.batteria-testo : "—";
        } else if (q.fonte == FonteQuadranteUi.gpu) {
            return stat.ha-gpu ? stat.gpu-testo : "—";
        } else if (q.fonte == FonteQuadranteUi.ora) {
            return ora != "" ? ora : "—";
        }
        return q.valore != "" ? q.valore : "—";
    }
    pure function frazione-di(q: QuadranteUi) -> float {
        if (q.fonte == FonteQuadranteUi.cpu) {
            return stat.pronta ? stat.cpu : -1;
        } else if (q.fonte == FonteQuadranteUi.ram) {
            return stat.ram-testo != "" ? stat.ram : -1;
        } else if (q.fonte == FonteQuadranteUi.disco) {
            return stat.disco-testo != "" ? stat.disco : -1;
        } else if (q.fonte == FonteQuadranteUi.batteria) {
            return stat.ha-batteria ? stat.batteria-frazione : -1;
        } else if (q.fonte == FonteQuadranteUi.gpu) {
            return stat.ha-gpu ? stat.gpu : -1;
        } else if (q.fonte == FonteQuadranteUi.meteo || q.fonte == FonteQuadranteUi.sensore || q.fonte == FonteQuadranteUi.limite-5h || q.fonte == FonteQuadranteUi.limite-7g || q.fonte == FonteQuadranteUi.spesa-api) {
            return q.frazione;
        }
        return -1;
    }
    pure function icona-di(q: QuadranteUi) -> image {
        if (q.fonte == FonteQuadranteUi.cpu) {
            return Icone.chip;
        } else if (q.fonte == FonteQuadranteUi.ram) {
            return Icone.memoria;
        } else if (q.fonte == FonteQuadranteUi.disco) {
            return Icone.disco;
        } else if (q.fonte == FonteQuadranteUi.gpu) {
            return Icone.schermo;
        } else if (q.fonte == FonteQuadranteUi.rete-giu || q.fonte == FonteQuadranteUi.rete-su) {
            return Icone.onde;
        } else if (q.fonte == FonteQuadranteUi.meteo) {
            return Icone.sole;
        } else if (q.fonte == FonteQuadranteUi.sensore) {
            return Icone.di-genere(q.genere);
        } else if (q.fonte == FonteQuadranteUi.limite-5h || q.fonte == FonteQuadranteUi.limite-7g || q.fonte == FonteQuadranteUi.spesa-api) {
            return Icone.claude;
        }
        return Icone.pc;
    }
    // Ritmo 4/8 (RC-50): 8 px fra le card, come fra le voci «In attesa» sopra.
    property <length> spazio: 8px;
    // Card uguali, qualunque sia la lunghezza dei valori. Tre card riempiono tutta la larghezza,
    // bordo a bordo con la riga «In attesa» (R1-11); con meno card non diventano più grandi di così.
    property <length> lato: min((self.width - 2 * spazio) / 3, (self.width - (quanti - 1) * spazio) / quanti);
    // L'arco si adatta all'altezza (con la riga «In attesa» il centro è più basso): sotto ci
    // stanno etichetta e dettaglio.
    property <length> arco: max(56px, min(96px, self.height - 54px));

    HorizontalLayout {
        alignment: center;
        spacing: spazio;

        for q in quadranti: Quadrante {
            width: root.lato;
            arco: root.arco;
            // I valori della casa (meteo, sensori) senza connessione sono vecchi: tenui.
            tenue: (q.fonte == FonteQuadranteUi.meteo || q.fonte == FonteQuadranteUi.sensore) && !casa-pronta;
            caldo-da: q.fonte == FonteQuadranteUi.limite-5h || q.fonte == FonteQuadranteUi.limite-7g || q.fonte == FonteQuadranteUi.spesa-api ? q.caldo-da : 0.85;
            etichetta: q.etichetta;
            icona: icona-di(q);
            valore: valore-di(q);
            frazione: frazione-di(q);
            dettaglio: q.dettaglio;
        }

        for s in sensori: Quadrante {
            width: root.lato;
            arco: root.arco;
            tenue: !casa-pronta;
            etichetta: "CASA";
            icona: Icone.di-genere(s.voce.genere);
            valore: s.voce.stato;
            frazione: s.frazione;
            dettaglio: s.voce.nome;
        }

        if sensori.length == 0: Quadrante {
            width: root.lato;
            arco: root.arco;
            etichetta: "CASA";
            icona: Icone.casa;
            dettaglio: casa-invito ? "Collega la casa" : stato-casa;
            cliccabile: luci-cliccabili || casa-invito;
            invito: casa-invito;
            anello: anello-luci;
            clic => { root.apri-luci(); }
        }
    }
}
