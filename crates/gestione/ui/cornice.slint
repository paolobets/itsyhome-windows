// Cornice fidata della finestra di gestione (spec §3bis): la disegna l'assistente, non il
// contenuto. Fondo scuro, bordo coi colori dei petali, titolo e pulsante chiudi; sotto la testata
// l'area del contenuto ostile, coperta dal riquadro web (wry, figlio di questa finestra) o, se il
// motore web manca, dal testo semplice del piano B.
//
// Tastiera: Esc chiude (anche col fuoco nel riquadro web: lo intercetta Rust); Tab raggiunge il
// pulsante chiudi, Invio o Spazio lo premono; Tab da «Chiudi», o PagSu/PagGiù/frecce sulla
// cornice, portano il fuoco nel contenuto, che allora si scorre da tastiera.
//
// Separazione fidata: il contenuto ostile non tocca mai la testata. Sta rientrato di `rientro`
// sotto una linea di separazione disegnata qui, con un filo intorno: appare come una scheda
// dentro la cornice, e tutto ciò che sta fuori da quel rettangolo è dell'assistente. REGOLA: i
// futuri pulsanti d'azione (Archivia, Rispondi…) stanno solo in una barra fidata della cornice,
// fuori dal riquadro web, mai nell'HTML.
//
// I token del tema sono quelli dell'assistente (un solo file: stessi colori e caratteri).
import { Tema } from "../../assistente/ui/tema.slint";

component Anello inherits Rectangle {
    border-width: 2px;
    border-color: Tema.anello;
}

// Pulsante chiudi della testata: icona a croce nel colore delle icone, rosso tenue al passaggio.
component Chiudi inherits FocusScope {
    callback premuto();
    // Tab (senza Maiusc) dal pulsante: il fuoco va nel contenuto.
    callback avanti();

    width: 40px;
    height: 30px;
    focus-on-click: false;
    accessible-role: button;
    accessible-label: "Chiudi";
    accessible-action-default => { root.premuto(); }
    key-pressed(evento) => {
        if (evento.text == Key.Return || evento.text == Key.Space) {
            root.premuto();
            return accept;
        }
        if (evento.text == Key.Tab && !evento.modifiers.shift) {
            root.avanti();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: 8px;
        background: area.pressed ? rgba(248, 113, 113, 0.40)
            : area.has-hover ? rgba(248, 113, 113, 0.26) : transparent;
    }

    Path {
        width: 11px;
        height: 11px;
        viewbox-width: 11;
        viewbox-height: 11;
        commands: "M 0.8 0.8 L 10.2 10.2 M 10.2 0.8 L 0.8 10.2";
        stroke: area.has-hover ? Tema.icona-attiva : Tema.icona;
        stroke-width: 1.55px;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.premuto(); }
    }

    if root.has-focus: Anello { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; border-radius: 11px; }
}

export component Cornice inherits Window {
    // Titolo NON fidato: con la Mail sarà l'oggetto della mail, cioè testo ostile. Arriva già
    // ripulito dall'assistente (controlli, direzione, larghezza zero, al più 200 caratteri); si
    // mostra solo in un `Text` e nel titolo della finestra di sistema (mai in HTML). Contro
    // l'imitazione della cornice (un oggetto «Reinserisci il token») sta dopo un'etichetta fidata
    // fissa, in uno stile diverso.
    in property <string> titolo;
    // Piano B: il contenuto come testo semplice, mostrato al posto del riquadro web.
    in property <bool> piano-b;
    in property <string> testo-semplice;

    // Geometria dell'area del contenuto: Rust ci appoggia il riquadro web, rientrato di `rientro`
    // dai bordi e `sotto-linea` sotto la linea di separazione (1 px a `alto-testata`).
    out property <length> bordo: 2px;
    out property <length> alto-testata: 46px;
    out property <length> rientro: 8px;
    out property <length> sotto-linea: 7px;
    property <length> contenuto-x: bordo + rientro;
    property <length> contenuto-y: alto-testata + sotto-linea;
    property <length> contenuto-l: root.width - 2 * contenuto-x;
    property <length> contenuto-a: root.height - contenuto-y - bordo - rientro;

    callback chiudi();
    // Pressione sulla testata: Rust avvia lo spostamento della finestra.
    callback trascina();
    // Il fuoco va nel contenuto (riquadro web): da lì si scorre con la tastiera.
    callback al-contenuto();

    title: titolo == "" ? "ItsyHome" : "ItsyHome — " + titolo;
    no-frame: true;
    // Rust la adatta all'area di lavoro del monitor (al più 780 × 680, vedi misure.rs).
    preferred-width: 780px;
    preferred-height: 680px;
    min-width: 480px;
    min-height: 360px;
    default-font-family: Tema.carattere;
    background: Tema.fondo-basso;
    forward-focus: radice;

    // Bordo: i sei petali in fila, sotto il fondo.
    Rectangle {
        background: @linear-gradient(120deg, Tema.petalo-1 0%, Tema.petalo-2 20%, Tema.petalo-3 40%,
            Tema.petalo-4 60%, Tema.petalo-5 80%, Tema.petalo-6 100%);
    }

    Rectangle {
        x: bordo;
        y: bordo;
        width: root.width - 2 * bordo;
        height: root.height - 2 * bordo;
        background: @linear-gradient(160deg, Tema.fondo-alto 0%, Tema.fondo-basso 55%);
    }

    radice := FocusScope {
        key-pressed(evento) => {
            if (evento.text == Key.Escape) {
                root.chiudi();
                return accept;
            }
            // Tasti di scorrimento sulla cornice: il fuoco passa al contenuto (il tasto dopo scorre).
            if (evento.text == Key.PageDown || evento.text == Key.PageUp || evento.text == Key.DownArrow
                    || evento.text == Key.UpArrow || evento.text == Key.Home || evento.text == Key.End) {
                root.al-contenuto();
                return accept;
            }
            return reject;
        }

        // Testata: si trascina per spostare la finestra.
        TouchArea {
            x: bordo;
            y: bordo;
            width: root.width - 2 * bordo;
            height: alto-testata - bordo;
            pointer-event(evento) => {
                if (evento.kind == PointerEventKind.down && evento.button == PointerEventButton.left) {
                    root.trascina();
                }
            }
        }

        // Segno dell'assistente: un puntino coi colori dei petali.
        Rectangle {
            x: 18px;
            y: (alto-testata - self.height) / 2 + bordo / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: @linear-gradient(135deg, Tema.petalo-1 0%, Tema.petalo-3 50%, Tema.petalo-5 100%);
        }

        // Etichetta fidata (fissa, dell'assistente) e poi il titolo non fidato, in un altro stile.
        etichetta := Text {
            x: 38px;
            y: bordo;
            height: alto-testata - bordo;
            text: "CONTENUTO ESTERNO";
            vertical-alignment: center;
            font-family: Tema.carattere-mono;
            font-size: 12px;
            letter-spacing: 0.6px;
            color: Tema.testo-etichetta;
        }

        Text {
            x: etichetta.x + etichetta.width + 12px;
            y: bordo;
            width: max(0px, pulsante-chiudi.x - self.x - 14px);
            height: alto-testata - bordo;
            text: titolo;
            overflow: elide;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 400;
            color: Tema.testo-ora;
        }

        pulsante-chiudi := Chiudi {
            x: root.width - self.width - 10px;
            y: bordo + (alto-testata - bordo - self.height) / 2;
            premuto => { root.chiudi(); }
            avanti => { root.al-contenuto(); }
        }

        // Linea di separazione fidata fra testata e contenuto.
        Rectangle {
            x: bordo;
            y: alto-testata;
            width: root.width - 2 * bordo;
            height: 1px;
            background: Tema.vetro-bordo;
        }

        // Filo intorno al contenuto: il riquadro web sta dentro, la cornice tutt'intorno.
        Rectangle {
            x: contenuto-x - 1px;
            y: contenuto-y - 1px;
            width: contenuto-l + 2px;
            height: contenuto-a + 2px;
            border-width: 1px;
            border-color: Tema.vetro-bordo;
        }

        // Piano B: testo semplice, solo se il motore web manca (stesso posto del riquadro web).
        if piano-b: Flickable {
            x: contenuto-x;
            y: contenuto-y;
            width: contenuto-l;
            height: contenuto-a;
            content-height: max(self.height, corpo.preferred-height + 40px);

            corpo := Text {
                x: 24px;
                y: 20px;
                width: parent.width - 48px;
                text: testo-semplice;
                wrap: word-wrap;
                font-size: 14px;
                color: Tema.testo;
            }
        }
    }
}
