// Cornice fidata della finestra di gestione (spec §3bis): la disegna l'assistente, non il
// contenuto. Sotto la barra del titolo di Windows (R1-19, decisioni §14: Snap, ridimensiona, riduci
// e chiudi sono quelli di sistema) il filo coi colori dei petali, come il pannello, poi la testata
// fidata e sotto l'area del contenuto ostile, coperta dal riquadro web (wry, figlio di questa
// finestra) o, se il motore web manca, dal testo semplice del piano B.
//
// Tastiera: Esc chiude (anche col fuoco nel riquadro web: lo intercetta Rust), come la croce della
// barra; Tab, PagSu/PagGiù/frecce sulla cornice portano il fuoco nel contenuto, che allora si
// scorre da tastiera.
//
// Separazione fidata: il contenuto ostile non tocca mai la testata. Sta rientrato di `rientro`
// sotto una linea di separazione disegnata qui, con un filo intorno: appare come una scheda
// dentro la cornice, e tutto ciò che sta fuori da quel rettangolo è dell'assistente. La barra di
// Windows sta sopra a tutto, fuori dalla finestra di Slint e dal riquadro web: la disegna il
// sistema e il riquadro (finestra figlia, ritagliata sul suo rettangolo) non ci arriva. REGOLA: i
// futuri pulsanti d'azione (Archivia, Rispondi…) stanno solo in una barra fidata della cornice,
// fuori dal riquadro web, mai nell'HTML.
//
// I token del tema sono quelli dell'assistente (un solo file: stessi colori e caratteri).
import { Tema } from "../../assistente/ui/tema.slint";
export { Tema }
import { Etichetta } from "../../assistente/ui/componenti.slint";
import { Schede, SchedaUi, RigaUi } from "schede.slint";
export { SchedaUi, RigaUi }

export component Cornice inherits Window {
    // Titolo NON fidato: con la Mail sarà l'oggetto della mail, cioè testo ostile. Arriva già
    // ripulito dall'assistente (controlli, direzione, larghezza zero, al più 200 caratteri); si
    // mostra solo in un `Text` e nel titolo della finestra di sistema (mai in HTML). Contro
    // l'imitazione della cornice (un oggetto «Reinserisci il token») sta dopo un'etichetta fidata
    // fissa, in uno stile diverso; e nella barra di sistema dopo la stessa parte fidata.
    in property <string> titolo;
    // UX23 (milestone Mail): mittente e data, anche loro NON fidati. Il protocollo oggi non li
    // porta: restano vuoti e non occupano spazio; quando ci saranno stanno a destra del titolo,
    // nello stesso stile non fidato, e il titolo si accorcia per far loro posto.
    in property <string> mittente;
    in property <string> data;
    property <string> mittente-e-data: mittente == "" ? data : data == "" ? mittente : mittente + " · " + data;
    // Piano B: il contenuto come testo semplice, mostrato al posto del riquadro web.
    in property <bool> piano-b;
    in property <string> testo-semplice;
    // Dettaglio delle API (Task 11): schede native al posto del riquadro web, in sola lettura.
    in property <bool> con-schede;
    in property <[SchedaUi]> schede;

    // Il titolo della barra di Windows (e della barra delle applicazioni, di Alt+Tab): prima la
    // parte fidata, poi il titolo non fidato. Un oggetto «Impostazioni» non dà la barra delle
    // Impostazioni vere («ItsyHome — Impostazioni»).
    out property <string> titolo-finestra: "ItsyHome · " + (con-schede ? "Dettaglio" : "Contenuto esterno")
        + (titolo == "" ? "" : " — " + titolo);

    // Geometria dell'area del contenuto: Rust ci appoggia il riquadro web, rientrato di `rientro`
    // dai bordi e `sotto-linea` sotto la linea di separazione (1 px a `alto-testata`). Le misure
    // partono dalla cima del contenuto della finestra, sotto la barra di Windows.
    out property <length> alto-testata: 40px;
    out property <length> rientro: 8px;
    out property <length> sotto-linea: 7px;
    // Il filo dei petali, come il bordo del pannello: 1,5 px arrotondato al pixel fisico.
    property <length> filo: Tema.sul-pixel(1.5px);
    property <length> contenuto-x: rientro;
    property <length> contenuto-y: alto-testata + sotto-linea;
    property <length> contenuto-l: root.width - 2 * contenuto-x;
    property <length> contenuto-a: root.height - contenuto-y - rientro;

    // Appena le schede compaiono il fuoco va alla loro riga (←/→ cambiano scheda, Tab prosegue).
    changed con-schede => {
        if (self.con-schede) {
            elenco-schede.focus-linguette();
        }
    }

    callback chiudi();
    // Il fuoco va nel contenuto (riquadro web): da lì si scorre con la tastiera.
    callback al-contenuto();
    // «Apri la Console» (con l'id della pagina) e «Aggiorna» delle schede: vanno all'assistente.
    callback apri-console(string);
    callback aggiorna();

    title: titolo-finestra;
    // Rust la adatta all'area di lavoro del monitor (al più 780 × 680 più la barra, vedi misure.rs).
    preferred-width: 780px;
    preferred-height: 680px;
    min-width: 480px;
    min-height: 360px;
    default-font-family: Tema.carattere;
    background: Tema.fondo-finestra;
    forward-focus: radice;

    radice := FocusScope {
        key-pressed(evento) => {
            if (evento.text == Key.Escape) {
                root.chiudi();
                return accept;
            }
            // Tab sulla cornice (il fuoco è qui, non su una scheda): al contenuto. Con le schede ci
            // pensa la navigazione di Slint (la linguetta scelta è raggiungibile con Tab).
            if (evento.text == Key.Tab && !evento.modifiers.shift && self.has-focus && !con-schede) {
                root.al-contenuto();
                return accept;
            }
            // Tasti di scorrimento sulla cornice: il fuoco passa al contenuto (il tasto dopo scorre).
            if (evento.text == Key.PageDown || evento.text == Key.PageUp || evento.text == Key.DownArrow
                    || evento.text == Key.UpArrow || evento.text == Key.Home || evento.text == Key.End) {
                if (con-schede) {
                    elenco-schede.focus-tabella();
                } else {
                    root.al-contenuto();
                }
                return accept;
            }
            return reject;
        }

        // Il filo dei petali sotto la barra di Windows.
        Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: filo;
            background: Tema.petali;
        }

        // Segno dell'assistente: un puntino coi colori dei petali.
        Rectangle {
            x: 16px;
            y: filo + (alto-testata - filo - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: self.height / 2;
            background: @linear-gradient(135deg, Tema.petalo-1 0%, Tema.petalo-3 50%, Tema.petalo-5 100%);
        }

        // Etichetta fidata (fissa, dell'assistente) e poi il titolo non fidato, in un altro stile.
        etichetta := Etichetta {
            x: 36px;
            y: filo;
            height: alto-testata - filo;
            text: con-schede ? "DETTAGLIO" : "CONTENUTO ESTERNO";
        }

        titolo-testo := Text {
            x: etichetta.x + etichetta.width + 12px;
            y: filo;
            width: max(0px, (mittente-e-data == "" ? root.width : meta.x) - self.x - 14px);
            height: alto-testata - filo;
            text: titolo;
            overflow: elide;
            vertical-alignment: center;
            font-size: Tema.testo-medio;
            font-weight: 400;
            color: Tema.testo-ora;
        }

        // Mittente · data (vuoti finché il protocollo non li porta): larghi al più un terzo.
        meta := Text {
            visible: mittente-e-data != "";
            x: root.width - self.width - 14px;
            y: filo;
            width: mittente-e-data == "" ? 0px : min(self.preferred-width, root.width / 3);
            height: alto-testata - filo;
            text: mittente-e-data;
            overflow: elide;
            vertical-alignment: center;
            font-size: Tema.testo-piccolo;
            color: Tema.testo-tenue;
        }

        // Linea di separazione fidata fra testata e contenuto.
        Rectangle {
            x: 0;
            y: alto-testata;
            width: root.width;
            height: 1px;
            background: Tema.vetro-bordo;
        }

        // Filo intorno al contenuto: il riquadro web sta dentro, la cornice tutt'intorno.
        Rectangle {
            visible: !con-schede;
            x: contenuto-x - 1px;
            y: contenuto-y - 1px;
            width: contenuto-l + 2px;
            height: contenuto-a + 2px;
            border-width: 1px;
            border-color: Tema.vetro-bordo;
        }

        // Dettaglio delle API: schede Slint, nello stesso posto del riquadro web.
        elenco-schede := Schede {
            visible: con-schede;
            x: contenuto-x;
            y: contenuto-y;
            width: contenuto-l;
            height: contenuto-a;
            schede: root.schede;
            apri-console(id) => { root.apri-console(id); }
            aggiorna => { root.aggiorna(); }
        }

        // Piano B: testo semplice, solo se il motore web manca (stesso posto del riquadro web).
        if piano-b: Flickable {
            x: contenuto-x;
            y: contenuto-y;
            width: contenuto-l;
            height: contenuto-a;
            content-height: max(self.height, corpo.preferred-height + 40px);

            corpo := Text {
                x: 24px;
                y: 20px;
                width: parent.width - 48px;
                text: testo-semplice;
                wrap: word-wrap;
                font-size: Tema.testo-medio;
                color: Tema.testo;
            }
        }
    }
}
