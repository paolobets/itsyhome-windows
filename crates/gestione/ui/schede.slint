// Le schede del dettaglio delle API Claude (M3, Task 11): Spesa, Token, Chiavi, Workspace e membri,
// Limiti. Sola lettura: ogni modifica si fa nella Console («Apri la Console»). I testi vengono dalle
// API (non fidati), ma qui sono solo `Text`: nessun HTML, nessun collegamento, e al più 200 righe
// per 6 colonne per scheda (lo garantisce `scheda_pulita`, prima di arrivare qui).
//
// Tastiera e Narrator (stesso schema di impostazioni.slint e casa.slint): le schede stanno in un
// `tab-list` e ognuna è un elemento `tab` col fuoco (uno solo raggiungibile con Tab, quello scelto);
// ←/→/Home/Fine spostano insieme fuoco e scelta. La tabella è una `list` e ogni riga un `list-item`
// col fuoco, la cui etichetta legge le celle con il nome della colonna («Nome: …, Stato: …»);
// ↑/↓/PagSu/PagGiù/Home/Fine spostano il fuoco da una riga all'altra e la riga si porta in vista.
// Il fuoco non sparisce mai (RC-41): se la riga che lo ha esce con un aggiornamento passa subito
// alla riga più vicina, o alla scheda scelta se la tabella resta vuota. Un solo anello in tutta la
// finestra (RC-42): righe e linguette usano `Anello`.
//
// Gruppi (RC-54): una riga può portare sopra di sé l'intestazione del suo gruppo («Per modello»);
// l'intestazione non è una riga (il fuoco la salta) ma Narrator la legge davanti a ogni riga del
// gruppo. Le righe prima del primo gruppo sono il riepilogo, in evidenza. Le colonne numeriche
// (RC-43) si allineano a destra, intestazione compresa.
import { Tema } from "../../assistente/ui/tema.slint";
import { Anello, Etichetta, Pulsante, TipoPulsante } from "../../assistente/ui/componenti.slint";

// Una riga della tabella: le celle da mostrare e, per Narrator, il testo che le legge tutte.
// `gruppo`: l'intestazione che sta sopra questa riga ("" = nessuna); `prima`: quante intestazioni
// stanno sopra le righe precedenti (per la posizione); `evidenza`: riga del riepilogo in testa;
// `striscia`: sfondo alterno, contato dalla prima riga del gruppo (che non l'ha mai).
export struct RigaUi {
    celle: [string],
    testo: string,
    gruppo: string,
    prima: int,
    evidenza: bool,
    striscia: bool,
}

export struct SchedaUi {
    nome: string,
    nota: string,
    colonne: [string],
    // Per colonna: vero = numeri o importi, allineati a destra (mancante = testo).
    numeriche: [bool],
    righe: [RigaUi],
    azione-console: string,
}

// Una scheda della riga in alto: un elemento `tab` col fuoco.
component Linguetta inherits FocusScope {
    in property <string> testo;
    in property <bool> scelta;
    in property <int> indice;
    in property <int> quante;
    // Il contatore sale ogni volta che il fuoco deve tornare sulla scheda scelta.
    in property <int> tocco;
    callback scelta-da-tasti(int);
    callback scelta-da-clic();

    changed tocco => {
        if (self.scelta) {
            self.focus();
        }
    }

    height: 28px;
    width: etichetta.preferred-width + 24px;
    // Con Tab si raggiunge solo la scheda scelta; le altre si raggiungono con le frecce.
    focus-on-tab-navigation: scelta;
    focus-on-click: false;
    accessible-role: tab;
    accessible-label: testo;
    accessible-item-selectable: true;
    accessible-item-selected: scelta;
    accessible-item-index: indice;
    accessible-item-count: quante;
    accessible-action-default => { root.scelta-da-clic(); }
    key-pressed(evento) => {
        if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
            return reject;
        }
        if (evento.text == Key.LeftArrow) {
            root.scelta-da-tasti(indice - 1);
            return accept;
        }
        if (evento.text == Key.RightArrow) {
            root.scelta-da-tasti(indice + 1);
            return accept;
        }
        if (evento.text == Key.Home) {
            root.scelta-da-tasti(0);
            return accept;
        }
        if (evento.text == Key.End) {
            root.scelta-da-tasti(quante - 1);
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: Tema.raggio-s;
        background: scelta ? Tema.scheda-attiva : area.has-hover ? Tema.scheda-sopra : transparent;

        etichetta := Text {
            text: root.testo;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Tema.testo-corpo;
            font-weight: scelta ? 700 : 500;
            color: scelta ? Tema.testo : Tema.testo-tenue;
            accessible-role: none;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.scelta-da-clic(); }
    }

    if root.has-focus: Anello { raggio: Tema.raggio-s; distanza: 1px; }
}

// Una riga della tabella: un elemento `list-item` col fuoco che legge tutte le sue celle.
component RigaTabella inherits FocusScope {
    in property <RigaUi> riga;
    in property <[bool]> numeriche;
    in property <int> indice;
    in property <int> quante;
    in property <bool> ultima;
    in property <length> unita;
    in property <length> alto-riga;
    in property <length> alto-gruppo;
    in property <int> tocco;
    in property <int> richiesta;
    // Il fuoco è stato chiesto a una riga che forse non c'era ancora (le righe fuori vista nascono
    // solo quando ci si scorre): chi nasce adesso e è quella chiesta lo prende.
    in property <bool> pendente;
    callback spostata(int);
    callback in-vista();
    // Il fuoco è andato altrove (non per la finestra che passa in secondo piano).
    callback lasciata();
    // L'intestazione del gruppo, se c'è, sta sopra la riga vera.
    property <length> testa: riga.gruppo != "" ? alto-gruppo : 0px;

    init => {
        if (self.pendente && self.indice == self.richiesta) {
            self.focus();
        }
    }

    changed tocco => {
        if (self.indice == self.richiesta) {
            self.focus();
        }
    }
    changed has-focus => {
        if (self.has-focus) {
            root.in-vista();
        }
    }
    focus-lost(motivo) => {
        if (motivo != FocusReason.window-activation) {
            root.lasciata();
        }
    }

    focus-on-tab-navigation: ultima;
    focus-on-click: false;
    accessible-role: list-item;
    accessible-label: riga.testo;
    accessible-item-index: indice;
    accessible-item-count: quante;
    key-pressed(evento) => {
        if (evento.modifiers.alt || evento.modifiers.control || evento.modifiers.meta) {
            return reject;
        }
        if (evento.text == Key.DownArrow) {
            root.spostata(indice + 1);
            return accept;
        }
        if (evento.text == Key.UpArrow) {
            root.spostata(indice - 1);
            return accept;
        }
        if (evento.text == Key.PageDown) {
            root.spostata(indice + 8);
            return accept;
        }
        if (evento.text == Key.PageUp) {
            root.spostata(indice - 8);
            return accept;
        }
        if (evento.text == Key.Home) {
            root.spostata(0);
            return accept;
        }
        if (evento.text == Key.End) {
            root.spostata(quante - 1);
            return accept;
        }
        return reject;
    }

    if riga.gruppo != "": Etichetta {
        x: 12px;
        y: 0;
        width: root.width - 24px;
        height: alto-gruppo - 6px;
        vertical-alignment: bottom;
        // Mono sempre maiuscolo (Narrator legge il gruppo dal testo della riga).
        text: riga.gruppo.to-uppercase();
        overflow: elide;
        accessible-role: none;
    }

    Rectangle {
        y: testa;
        height: alto-riga;
        border-radius: Tema.raggio-s;
        background: root.has-focus ? Tema.scheda-attiva : riga.striscia ? Tema.card-fondo : transparent;
    }

    for cella[ci] in riga.celle: Text {
        x: 12px + (ci == 0 ? 0px : (ci + 0.6) * unita);
        y: testa;
        width: (ci == 0 ? 1.6 : 1.0) * unita - 8px;
        height: alto-riga;
        text: cella;
        horizontal-alignment: numeriche[ci] ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-corpo;
        font-weight: riga.evidenza ? 700 : 500;
        color: ci == 0 || riga.evidenza ? Tema.testo : Tema.testo-2;
        accessible-role: none;
    }

    // Lo stesso anello delle linguette, dentro la riga (le righe si toccano e la tabella taglia
    // ai lati).
    if root.has-focus: Anello {
        x: 0;
        y: testa;
        width: root.width;
        height: alto-riga;
        raggio: Tema.raggio-s;
        distanza: -Tema.sul-pixel(2px);
    }
}

export component Schede inherits Rectangle {
    in property <[SchedaUi]> schede;
    // Indice della scheda mostrata: sopravvive a un aggiornamento dei dati.
    in-out property <int> corrente: 0;
    // «Apri la Console» con l'id della pagina; «Aggiorna».
    callback apri-console(string);
    callback aggiorna();

    property <int> scelta: min(max(0, corrente), max(0, schede.length - 1));
    property <SchedaUi> attiva: schede[scelta];
    property <length> alto-riga: 28px;
    // L'intestazione di un gruppo (RC-54): un po' d'aria sopra e l'etichetta.
    property <length> alto-gruppo: 32px;
    property <length> alto-pie: 30px;
    property <length> alto-testa: 32px;
    property <int> colonne: max(1, attiva.colonne.length);
    // La prima colonna (il nome) pesa un po' di più.
    property <length> unita: (self.width - 24px) / (colonne + 0.6);
    // Il fuoco delle schede e quello delle righe si chiedono con un contatore e un indice.
    property <int> tocco-schede: 0;
    property <int> tocco-righe: 0;
    property <int> riga-richiesta: 0;
    // L'ultima riga che ha avuto il fuoco: quella che Tab raggiunge.
    property <int> riga-ultima: 0;
    property <bool> riga-pendente: false;
    property <int> n-righe: attiva.righe.length;
    // Le intestazioni di gruppo di tutta la tabella (quelle prima dell'ultima riga più la sua).
    property <int> n-gruppi: n-righe == 0 ? 0
        : attiva.righe[n-righe - 1].prima + (attiva.righe[n-righe - 1].gruppo != "" ? 1 : 0);
    // Una riga ha il fuoco (o l'aveva quando è sparsa con un aggiornamento): nessun altro elemento
    // l'ha preso dopo. Una riga distrutta non dice di averlo perso, quindi resta vero.
    property <bool> fuoco-in-tabella: false;

    // RC-41: le righe calano (un aggiornamento, non un cambio di scheda: lì il fuoco è sulla
    // linguetta). Col fuoco in tabella va subito alla riga rimasta più vicina, o alla scheda scelta
    // se non ne resta nessuna; il primo tasto dopo sposta davvero. Senza fuoco in tabella, la riga
    // che Tab raggiunge rientra fra quelle che ci sono.
    changed n-righe => {
        if (fuoco-in-tabella) {
            if (n-righe > 0) {
                riga-a(min(riga-ultima, n-righe - 1));
            } else {
                fuoco-in-tabella = false;
                riga-ultima = 0;
                focus-linguette();
            }
        } else if (riga-ultima >= n-righe) {
            riga-ultima = max(0, n-righe - 1);
        }
    }

    public function focus-linguette() {
        tocco-schede += 1;
    }

    public function focus-tabella() {
        riga-a(min(riga-ultima, n-righe - 1));
    }

    function vai(i: int) {
        if (schede.length > 0) {
            corrente = max(0, min(schede.length - 1, i));
        }
        flick.content-y = 0;
        riga-ultima = 0;
    }

    // Porta il fuoco sulla riga `i`: prima la mette in vista (le righe fuori vista non esistono
    // ancora), poi la chiede; se nasce dopo, `init` la prende.
    function riga-a(i: int) {
        if (n-righe > 0) {
            riga-richiesta = max(0, min(n-righe - 1, i));
            riga-pendente = true;
            scorri-a(riga-richiesta);
            tocco-righe += 1;
        }
    }

    // La cima della riga `i` (con la sua intestazione, se ne ha una) nella tabella.
    function cima(i: int) -> length {
        i * alto-riga + attiva.righe[i].prima * alto-gruppo
    }

    function scorri-a(i: int) {
        let alto = cima(i);
        let basso = alto + alto-riga + (attiva.righe[i].gruppo != "" ? alto-gruppo : 0px);
        if (alto < -flick.content-y) {
            flick.content-y = -alto;
        } else if (basso > -flick.content-y + flick.height) {
            flick.content-y = flick.height - basso;
        }
    }

    // La riga `i` ha il fuoco: è l'ultima, e si porta in vista.
    function mostra(i: int) {
        riga-ultima = i;
        riga-pendente = false;
        fuoco-in-tabella = true;
        scorri-a(i);
    }

    // La riga delle schede.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: alto-testa;
        accessible-role: tab-list;
        accessible-label: "Schede del dettaglio delle API";

        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            padding-left: 4px;
            padding-top: 2px;

            for s[i] in schede: Linguetta {
                testo: s.nome;
                scelta: i == root.scelta;
                indice: i;
                quante: schede.length;
                tocco: root.tocco-schede;
                scelta-da-tasti(j) => {
                    root.vai(j);
                    root.tocco-schede += 1;
                }
                scelta-da-clic => {
                    root.vai(i);
                    root.tocco-schede += 1;
                }
            }
        }
    }

    // Da quando sono i dati (o perché non ci sono).
    Text {
        x: 8px;
        y: alto-testa + 4px;
        width: root.width - 16px;
        height: 18px;
        text: attiva.nota;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tema.testo-piccolo;
        color: Tema.testo-tenue;
    }

    // Intestazione della tabella.
    for c[ci] in attiva.colonne: Etichetta {
        x: 12px + (ci == 0 ? 0px : (ci + 0.6) * unita);
        y: alto-testa + 30px;
        width: (ci == 0 ? 1.6 : 1.0) * unita - 8px;
        height: 20px;
        // Mono sempre maiuscolo (Narrator legge le colonne dal testo della riga).
        text: c.to-uppercase();
        horizontal-alignment: attiva.numeriche[ci] ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        overflow: elide;
        accessible-role: none;
    }

    Rectangle {
        x: 8px;
        y: alto-testa + 52px;
        width: root.width - 16px;
        height: 1px;
        background: Tema.vetro-bordo;
    }

    // Il corpo: scorrevole; le righe hanno il fuoco una alla volta.
    Rectangle {
        x: 0;
        y: alto-testa + 54px;
        width: root.width;
        height: root.height - self.y - alto-pie - 12px;
        accessible-role: list;
        accessible-label: attiva.nome;

        flick := Flickable {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: max(self.height, n-righe * alto-riga + n-gruppi * alto-gruppo);

            for riga[ri] in attiva.righe: RigaTabella {
                x: 0;
                y: ri * alto-riga + riga.prima * alto-gruppo;
                width: flick.content-width;
                height: alto-riga + (riga.gruppo != "" ? alto-gruppo : 0px);
                riga: riga;
                numeriche: attiva.numeriche;
                indice: ri;
                quante: n-righe;
                ultima: ri == riga-ultima;
                unita: root.unita;
                alto-riga: root.alto-riga;
                alto-gruppo: root.alto-gruppo;
                tocco: root.tocco-righe;
                richiesta: root.riga-richiesta;
                pendente: root.riga-pendente;
                spostata(j) => { root.riga-a(j); }
                in-vista => { root.mostra(ri); }
                lasciata => { root.fuoco-in-tabella = false; }
            }
        }

        if attiva.righe.length == 0: Text {
            width: parent.width;
            height: 40px;
            text: "Nessun dato";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Tema.testo-corpo;
            color: Tema.testo-tenue;
        }
    }

    // Pie: i pulsanti, neutri, col verbo.
    HorizontalLayout {
        x: 8px;
        y: root.height - alto-pie - 4px;
        width: root.width - 16px;
        height: alto-pie;
        alignment: start;
        spacing: 8px;

        Pulsante {
            testo: "Apri la Console";
            tipo: TipoPulsante.neutro;
            premuto => { root.apri-console(attiva.azione-console); }
        }

        Pulsante {
            testo: "Aggiorna";
            tipo: TipoPulsante.neutro;
            premuto => { root.aggiorna(); }
        }
    }
}
